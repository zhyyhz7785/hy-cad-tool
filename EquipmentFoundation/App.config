<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<!-- AutoCAD插件的应用程序设置 -->
	<appSettings>
		<!-- 默认图层名称 -->
		<add key="WallLayer" value="Walls" />
		<add key="BaseLayer" value="Base" />
		<add key="SectionLayer" value="Section" />

		<!-- 默认几何参数 -->
		<add key="DefaultWallThickness" value="300.0" />
		<add key="DefaultBaseThickness" value="400.0" />

		<!-- 日志设置 -->
		<add key="EnableLogging" value="true" />
		<add key="LogLevel" value="Info" />
	</appSettings>
</configuration>