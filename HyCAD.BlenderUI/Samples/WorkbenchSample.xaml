<bui:BlenderWindow x:Class="HyCAD.BlenderUI.Samples.WorkbenchSample"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls"
                   mc:Ignorable="d"
                   Title="HyCAD.BlenderUI — Workbench Sample"
                   HeaderTitle="完整工作区样本（顶 WorkspaceTabBar 切 layout）"
                   Width="1280"
                   Height="800"
                   Background="{DynamicResource Brush_WindowBack}"
                   FontFamily="{DynamicResource Font_Main}"
                   FontSize="{DynamicResource Metric_FontMain}"
                   Foreground="{DynamicResource Brush_TextPrimary}">

    <!--
      WorkbenchSample：顶部 WorkspaceTabBar 切换三种 layout（Layout / Modeling / Sculpting）。
      每个 layout 是独立 Grid，通过 IndexToVisibility + WorkspaceTabBar.SelectedIndex 互斥显示。
    -->

    <bui:BlenderWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/BlenderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </bui:BlenderWindow.Resources>

    <bui:BlenderWindow.FooterRightContent>
        <Button Width="80" Content="关闭" Style="{StaticResource BlenderButton}"/>
    </bui:BlenderWindow.FooterRightContent>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部 WorkspaceTabBar -->
        <bui:WorkspaceTabBar x:Name="WsTabs" Grid.Row="0" SelectedIndex="0">
            <bui:WorkspaceTabItem Title="Layout" TooltipText="基础布局工作区">
                <bui:WorkspaceTabItem.Icon>
                    <Path Width="14" Height="14"
                          Data="M 0,0 L 6,0 L 6,14 L 0,14 Z M 8,0 L 14,0 L 14,6 L 8,6 Z M 8,8 L 14,8 L 14,14 L 8,14 Z"
                          Fill="{DynamicResource Brush_TextPrimary}" Stretch="Uniform"/>
                </bui:WorkspaceTabItem.Icon>
            </bui:WorkspaceTabItem>
            <bui:WorkspaceTabItem Title="Modeling" TooltipText="建模工作区">
                <bui:WorkspaceTabItem.Icon>
                    <Path Width="14" Height="14"
                          Data="M 0,8 L 7,1 L 14,8 L 7,15 Z M 7,1 L 7,15 M 0,8 L 14,8"
                          Stroke="{DynamicResource Brush_TextPrimary}" StrokeThickness="1.4"
                          Fill="Transparent" Stretch="Uniform"/>
                </bui:WorkspaceTabItem.Icon>
            </bui:WorkspaceTabItem>
            <bui:WorkspaceTabItem Title="Sculpting" TooltipText="雕刻工作区">
                <bui:WorkspaceTabItem.Icon>
                    <Path Width="14" Height="14"
                          Data="M 7,1 A 6,6 0 1 1 7,13 A 6,6 0 1 1 7,1 M 4,5 A 1.2,1.2 0 1 1 4,7 A 1.2,1.2 0 1 1 4,5 M 10,5 A 1.2,1.2 0 1 1 10,7 A 1.2,1.2 0 1 1 10,5 M 4,9 Q 7,11 10,9"
                          Stroke="{DynamicResource Brush_TextPrimary}" StrokeThickness="1.2"
                          Fill="Transparent" Stretch="Uniform"/>
                </bui:WorkspaceTabItem.Icon>
            </bui:WorkspaceTabItem>
        </bui:WorkspaceTabBar>

        <!-- Body：3 个 layout 互斥切换 -->
        <Grid Grid.Row="1">

            <!-- Layout 0：Property + Inspector -->
            <Grid Visibility="{Binding SelectedIndex, ElementName=WsTabs, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <bui:PropertyEditor Grid.Column="0"
                                    Title="Layout 参数"
                                    ShowIconBar="False"
                                    ShowSearch="False">
                    <StackPanel>
                        <Expander Header="对象列表" IsExpanded="True" Style="{StaticResource BlenderExpander}">
                            <StackPanel>
                                <bui:PropertyRow Label="活动对象">
                                    <ComboBox SelectedIndex="0" Style="{StaticResource BlenderComboBox}">
                                        <ComboBoxItem Content="Cube"/>
                                        <ComboBoxItem Content="Sphere"/>
                                    </ComboBox>
                                </bui:PropertyRow>
                                <bui:PropertyRow Label="可见">
                                    <CheckBox Content="Visible" IsChecked="True" Style="{StaticResource BlenderCheckBox}"/>
                                </bui:PropertyRow>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </bui:PropertyEditor>
                <GridSplitter Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Cursor="SizeWE"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              Style="{StaticResource BlenderSplitter}"/>
                <Border Grid.Column="2"
                        Background="{DynamicResource Brush_RegionBack}">
                    <TextBlock Margin="20"
                               Foreground="{DynamicResource Brush_TextSecondary}"
                               Text="Layout Workspace · 大致是 Single Editor 风格"
                               TextWrapping="Wrap"/>
                </Border>
            </Grid>

            <!-- Layout 1：Modeling 三区 -->
            <Grid Visibility="{Binding SelectedIndex, ElementName=WsTabs, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>
                <bui:PropertyEditor Grid.Column="0"
                                    Title="Modeling 参数"
                                    ShowIconBar="False"
                                    ShowSearch="False">
                    <StackPanel>
                        <bui:PropertyRow Label="切片数">
                            <bui:NumericSlider Decimals="0"
                                               Maximum="64" Minimum="3" Step="1"
                                               Value="32"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="平滑度">
                            <bui:NumericSlider Decimals="2"
                                               Maximum="1" Minimum="0" Step="0.05"
                                               Value="0.50"/>
                        </bui:PropertyRow>
                    </StackPanel>
                </bui:PropertyEditor>
                <GridSplitter Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Cursor="SizeWE"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              Style="{StaticResource BlenderSplitter}"/>
                <Border Grid.Column="2"
                        Background="{DynamicResource Brush_RegionBack}">
                    <Canvas>
                        <Path Stroke="{DynamicResource Brush_AccentBlue}" StrokeThickness="2"
                              Data="M 100,300 L 250,150 L 400,300 L 250,450 Z M 100,300 L 250,300 M 250,150 L 250,450"
                              Fill="Transparent"/>
                        <TextBlock Canvas.Left="20" Canvas.Top="20"
                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                   Text="Modeling Workspace · 中部 3D Viewport"/>
                    </Canvas>
                </Border>
                <GridSplitter Grid.Column="3"
                              Width="4"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Cursor="SizeWE"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              Style="{StaticResource BlenderSplitter}"/>
                <bui:PropertyEditor Grid.Column="4"
                                    Title="Outliner"
                                    ShowIconBar="False"
                                    ShowSearch="True">
                    <TreeView Style="{StaticResource BlenderOutliner}">
                        <TreeViewItem Header="Mesh" IsExpanded="True">
                            <TreeViewItem Header="Verts: 24"/>
                            <TreeViewItem Header="Edges: 36"/>
                            <TreeViewItem Header="Faces: 14"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Modifier" IsExpanded="False">
                            <TreeViewItem Header="Subdivision Surface"/>
                            <TreeViewItem Header="Mirror"/>
                        </TreeViewItem>
                    </TreeView>
                </bui:PropertyEditor>
            </Grid>

            <!-- Layout 2：Sculpting 全功能 -->
            <Grid Visibility="{Binding SelectedIndex, ElementName=WsTabs, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>
                <bui:Toolbar Grid.Column="0">
                    <ToggleButton IsChecked="True" Style="{StaticResource BlenderToolbarIconButton}" ToolTip="抓取">
                        <Path Width="16" Height="16"
                              Data="M 4,2 L 4,9 L 6,11 L 6,5 L 7,5 L 7,12 L 9,12 L 9,5 L 10,5 L 10,12 L 12,12 L 12,7 L 13,7 L 13,12 L 13,15 L 4,15 L 2,11 L 2,5 Z"
                              Fill="{DynamicResource Brush_TextPrimary}" Stretch="Uniform"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource BlenderToolbarIconButton}" ToolTip="平滑">
                        <Ellipse Width="14" Height="14"
                                 Stroke="{DynamicResource Brush_TextPrimary}" StrokeThickness="1.6"
                                 Fill="Transparent"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource BlenderToolbarIconButton}" ToolTip="刻线">
                        <Path Width="16" Height="16"
                              Data="M 1,15 L 15,1 M 12,1 L 15,1 L 15,4"
                              Stroke="{DynamicResource Brush_TextPrimary}" StrokeThickness="1.6"
                              Fill="Transparent" Stretch="Uniform"/>
                    </ToggleButton>
                </bui:Toolbar>
                <Border Grid.Column="1"
                        Background="{DynamicResource Brush_RegionBack}">
                    <Canvas>
                        <Path Stroke="{DynamicResource Brush_AccentBlue}" StrokeThickness="2"
                              Data="M 200,200 A 100,100 0 1 1 200,201 Z M 150,180 A 12,12 0 1 1 150,181 M 250,180 A 12,12 0 1 1 250,181 M 170,240 Q 200,260 230,240"
                              Fill="Transparent"/>
                        <TextBlock Canvas.Left="20" Canvas.Top="20"
                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                   Text="Sculpting Workspace · 左 Toolbar + 中 Viewport + 右 Brush"/>
                    </Canvas>
                </Border>
                <GridSplitter Grid.Column="2"
                              Width="4"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Cursor="SizeWE"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              Style="{StaticResource BlenderSplitter}"/>
                <bui:PropertyEditor Grid.Column="3"
                                    Title="Brush"
                                    ShowIconBar="False"
                                    ShowSearch="False">
                    <StackPanel>
                        <bui:PropertyRow Label="Radius">
                            <bui:NumericSlider Decimals="1"
                                               Maximum="200" Minimum="1" Step="1"
                                               Unit="px" Value="50"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="Strength">
                            <bui:NumericSlider Decimals="2"
                                               Maximum="1" Minimum="0" Step="0.01"
                                               Value="0.50"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="Falloff">
                            <ComboBox SelectedIndex="0" Style="{StaticResource BlenderComboBox}">
                                <ComboBoxItem Content="Smooth"/>
                                <ComboBoxItem Content="Sphere"/>
                                <ComboBoxItem Content="Linear"/>
                            </ComboBox>
                        </bui:PropertyRow>
                    </StackPanel>
                </bui:PropertyEditor>
            </Grid>

        </Grid>
    </Grid>
</bui:BlenderWindow>
