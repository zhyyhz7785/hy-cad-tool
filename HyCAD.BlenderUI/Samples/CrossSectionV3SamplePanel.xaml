<bui:BlenderWindow x:Class="HyCAD.BlenderUI.Samples.CrossSectionV3SamplePanel"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls"
                   xmlns:smp="clr-namespace:HyCAD.BlenderUI.Samples"
                   mc:Ignorable="d"
                   Title="HyCAD.BlenderUI - rCs 横断面 v3 建模工作台"
                   HeaderTitle="rCs 横断面 v3 - 建模工作台原型（先优化左大纲 / 右属性）"
                   Width="1460"
                   Height="860"
                   MinWidth="1180"
                   MinHeight="680"
                   Background="{DynamicResource Brush_WindowBack}"
                   FontFamily="{DynamicResource Font_Main}"
                   FontSize="{DynamicResource Metric_FontMain}"
                   Foreground="{DynamicResource Brush_TextPrimary}">

    <bui:BlenderWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/BlenderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </bui:BlenderWindow.Resources>

    <bui:BlenderWindow.HeaderRightContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       Foreground="{DynamicResource Brush_TextSecondary}"
                       Text="比例 1 :"/>
            <ComboBox Width="92"
                      ItemsSource="{Binding AvailableScales}"
                      SelectedItem="{Binding ScaleDenominator, Mode=TwoWay}"
                      Style="{StaticResource BlenderComboBox}"/>

            <TextBlock VerticalAlignment="Center"
                       Margin="12,0,6,0"
                       Foreground="{DynamicResource Brush_TextSecondary}"
                       Text="V (km/h)："/>
            <ComboBox Width="76"
                      ItemsSource="{Binding AvailableSpeeds}"
                      SelectedItem="{Binding DesignSpeed, Mode=TwoWay}"
                      Style="{StaticResource BlenderComboBox}"/>
        </StackPanel>
    </bui:BlenderWindow.HeaderRightContent>

    <bui:BlenderWindow.FooterLeftContent>
        <TextBlock VerticalAlignment="Center"
                   FontFamily="Consolas"
                   FontSize="{DynamicResource Metric_FontSmall}"
                   Foreground="{DynamicResource Brush_TextSecondary}"
                   Text="{Binding FootprintSummary}"/>
    </bui:BlenderWindow.FooterLeftContent>

    <bui:BlenderWindow.StatusContent>
        <TextBlock VerticalAlignment="Center"
                   FontSize="{DynamicResource Metric_FontSmall}"
                   Foreground="{DynamicResource Brush_TextSecondary}"
                   Text="{Binding SelectionPath, StringFormat=当前焦点：{0}}"/>
    </bui:BlenderWindow.StatusContent>

    <bui:BlenderWindow.FooterRightContent>
        <Button Content="关闭"
                Width="80"
                Style="{StaticResource BlenderButton}"
                Click="CloseButton_Click"/>
    </bui:BlenderWindow.FooterRightContent>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="280"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*" MinWidth="380"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="430" MinWidth="340"/>
        </Grid.ColumnDefinitions>

        <bui:PropertyEditor Grid.Column="0"
                            Title="建模大纲（板块 / 结构组 / 结构层）"
                            ShowSearch="False"
                            ShowPin="False"
                            ShowIconBar="False">
            <DockPanel LastChildFill="True">
                <bui:Toolbar DockPanel.Dock="Top">
                    <Button Content="＋左"
                            ToolTip="在左侧末尾追加一个机动车道板块"
                            Command="{Binding AddLeftBandCommand}"
                            Style="{StaticResource BlenderButtonFlat}"
                            Padding="6,2"
                            Margin="2"/>
                    <Button Content="＋右"
                            ToolTip="在右侧末尾追加一个机动车道板块"
                            Command="{Binding AddRightBandCommand}"
                            Style="{StaticResource BlenderButtonFlat}"
                            Padding="6,2"
                            Margin="2"/>
                    <Button Content="× 删"
                            ToolTip="删除当前选中的板块或结构层"
                            Command="{Binding RemoveSelectedCommand}"
                            Style="{StaticResource BlenderButtonFlat}"
                            Padding="6,2"
                            Margin="2"/>
                    <Button Content="↑ 内"
                            ToolTip="板块向中心移动一格"
                            Command="{Binding MoveUpCommand}"
                            Style="{StaticResource BlenderButtonFlat}"
                            Padding="6,2"
                            Margin="2"/>
                    <Button Content="↓ 外"
                            ToolTip="板块向边界移动一格"
                            Command="{Binding MoveDownCommand}"
                            Style="{StaticResource BlenderButtonFlat}"
                            Padding="6,2"
                            Margin="2"/>
                </bui:Toolbar>

                <TreeView x:Name="OutlinerTree"
                          ItemsSource="{Binding OutlineRoots}"
                          SelectedItemChanged="OutlinerTree_SelectedItemChanged"
                          Style="{StaticResource BlenderOutliner}"
                          BorderThickness="0"
                          Background="Transparent">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource BlenderOutlinerItem}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <TreeView.Resources>
                        <DataTemplate DataType="{x:Type smp:V3MedianNode}">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsActive, Mode=TwoWay}"
                                          Style="{StaticResource BlenderCheckBox}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    <TextBlock Text="启用后参与总路幅与中心线定位"
                                               Foreground="{DynamicResource Brush_TextSecondary}"
                                               FontSize="{DynamicResource Metric_FontCaption}"/>
                                </StackPanel>
                                <TextBox Grid.Column="2"
                                         Text="{Binding WidthText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource BlenderTextBox}"
                                         HorizontalContentAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         Margin="6,0,2,0"/>
                                <TextBlock Grid.Column="3"
                                           Text="m"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush_TextSecondary}"/>
                            </Grid>
                        </DataTemplate>

                        <HierarchicalDataTemplate DataType="{x:Type smp:V3SideNode}"
                                                  ItemsSource="{Binding Bands}">
                            <Grid Margin="0,4,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SideLabel}"
                                               Foreground="{DynamicResource Brush_TextSecondary}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DirectionLabel}"
                                               Foreground="{DynamicResource Brush_TextSecondary}"
                                               FontSize="{DynamicResource Metric_FontCaption}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Summary}"
                                           Foreground="{DynamicResource Brush_TextSecondary}"
                                           FontSize="{DynamicResource Metric_FontSmall}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </HierarchicalDataTemplate>

                        <HierarchicalDataTemplate DataType="{x:Type smp:V3BandNode}"
                                                  ItemsSource="{Binding LayerGroups}">
                            <Grid Margin="0,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.RowSpan="2"
                                          Grid.Column="0"
                                          IsChecked="{Binding IsActive, Mode=TwoWay}"
                                          Style="{StaticResource BlenderCheckBox}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0"/>

                                <Border Grid.Column="1"
                                        Width="22"
                                        Height="18"
                                        Margin="0,0,6,0"
                                        Background="{DynamicResource Brush_RegionBackAlt}"
                                        BorderBrush="{DynamicResource Brush_BorderDark}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding KindShortLabel}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush_TextPrimary}"
                                               FontSize="{DynamicResource Metric_FontCaption}"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding DisplayTitle}"
                                           Foreground="{DynamicResource Brush_TextPrimary}"
                                           VerticalAlignment="Center"/>

                                <TextBox Grid.Column="3"
                                         Text="{Binding WidthText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource BlenderTextBox}"
                                         HorizontalContentAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         Margin="6,0,2,0"/>

                                <TextBlock Grid.Column="4"
                                           Text="m"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush_TextSecondary}"/>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="4"
                                           Text="{Binding DetailSummary}"
                                           Foreground="{DynamicResource Brush_TextSecondary}"
                                           FontSize="{DynamicResource Metric_FontCaption}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </HierarchicalDataTemplate>

                        <HierarchicalDataTemplate DataType="{x:Type smp:V3LayerGroupNode}"
                                                  ItemsSource="{Binding Layers}">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    <TextBlock Text="{Binding RuleSummary}"
                                               Foreground="{DynamicResource Brush_TextSecondary}"
                                               FontSize="{DynamicResource Metric_FontCaption}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Summary}"
                                           Foreground="{DynamicResource Brush_TextSecondary}"
                                           FontSize="{DynamicResource Metric_FontSmall}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </HierarchicalDataTemplate>

                        <DataTemplate DataType="{x:Type smp:V3LayerNode}">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding DisplayTitle}"
                                           Foreground="{DynamicResource Brush_TextPrimary}"
                                           FontSize="{DynamicResource Metric_FontSmall}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Summary}"
                                           Foreground="{DynamicResource Brush_TextSecondary}"
                                           FontSize="{DynamicResource Metric_FontSmall}"/>
                            </Grid>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>
        </bui:PropertyEditor>

        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource Brush_BorderDark}"
                      ShowsPreview="False"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"/>

        <bui:PropertyEditor Grid.Column="2"
                            Title="实时预览（先做 UI 原型，后接 AutoCAD 模型空间）"
                            ShowSearch="False"
                            ShowPin="False"
                            ShowIconBar="False">
            <Grid>
                <Border Background="{DynamicResource Brush_RegionBack}"
                        BorderBrush="{DynamicResource Brush_BorderDark}"
                        BorderThickness="1">
                    <Canvas x:Name="PreviewCanvas"
                            ClipToBounds="True"
                            Background="Transparent"
                            SizeChanged="PreviewCanvas_SizeChanged"/>
                </Border>
                <TextBlock HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,10,6"
                           Foreground="{DynamicResource Brush_TextSecondary}"
                           FontFamily="Consolas"
                           FontSize="{DynamicResource Metric_FontCaption}"
                           Text="v3 目标：左侧树负责 1/2/3 层建模，右侧上下文属性编辑，后续再接 AutoCAD 选图与模型空间预览"/>
            </Grid>
        </bui:PropertyEditor>

        <GridSplitter Grid.Column="3"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource Brush_BorderDark}"
                      ShowsPreview="False"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"/>

        <bui:PropertyEditor Grid.Column="4"
                            Title="属性 / 建模控制"
                            ShowSearch="False"
                            ShowPin="False"
                            ShowIconBar="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Expander Header="断面总控" Style="{StaticResource BlenderPropertyGroupLevel1}">
                        <StackPanel>
                            <Expander Header="基础设置" Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <StackPanel>
                                    <bui:PropertyRow Label="图名标题">
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource BlenderTextBox}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="比例尺 1 :">
                                        <ComboBox ItemsSource="{Binding AvailableScales}"
                                                  SelectedItem="{Binding ScaleDenominator, Mode=TwoWay}"
                                                  Style="{StaticResource BlenderComboBox}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="设计速度 V">
                                        <ComboBox ItemsSource="{Binding AvailableSpeeds}"
                                                  SelectedItem="{Binding DesignSpeed, Mode=TwoWay}"
                                                  Style="{StaticResource BlenderComboBox}"/>
                                    </bui:PropertyRow>
                                </StackPanel>
                            </Expander>

                            <Expander Header="出图目标" Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <StackPanel>
                                    <bui:PropertyRow Label="AutoCAD 标注">
                                        <CheckBox IsChecked="{Binding UseAutoCadDimension, Mode=TwoWay}"
                                                  Style="{StaticResource BlenderCheckBox}"
                                                  Content="宽度尺寸链优先走 AutoCAD 标注体系"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="标高引线">
                                        <CheckBox IsChecked="{Binding UseElevationLeader, Mode=TwoWay}"
                                                  Style="{StaticResource BlenderCheckBox}"
                                                  Content="标高标注优先走 MLeader / 引线"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="预览目标">
                                        <CheckBox IsChecked="{Binding PreferModelSpacePreview, Mode=TwoWay}"
                                                  Style="{StaticResource BlenderCheckBox}"
                                                  Content="优先模型空间实时预览（当前原型仅做 WPF 预览）"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="阶段说明">
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                                   FontSize="{DynamicResource Metric_FontSmall}"
                                                   Text="第一阶段只做建模体验：左大纲树和右属性面板。第二阶段再接 AutoCAD 命令：图上拾取、模型空间预览、标注与标高引线。"/>
                                    </bui:PropertyRow>
                                </StackPanel>
                            </Expander>

                            <Expander Header="统计" Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <StackPanel>
                                    <bui:PropertyRow Label="左半幅 (m)">
                                        <TextBlock Text="{Binding LeftHalfWidth, StringFormat={}{0:F2}}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="中分带 (m)">
                                        <TextBlock Text="{Binding MedianWidth, StringFormat={}{0:F2}}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="右半幅 (m)">
                                        <TextBlock Text="{Binding RightHalfWidth, StringFormat={}{0:F2}}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="总路幅 (m)">
                                        <TextBlock Text="{Binding TotalWidth, StringFormat={}{0:F2}}"
                                                   Foreground="{DynamicResource Brush_Success}"
                                                   FontWeight="SemiBold"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="当前焦点">
                                        <TextBlock Text="{Binding SelectionPath}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                                   FontSize="{DynamicResource Metric_FontSmall}"/>
                                    </bui:PropertyRow>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Expander>

                    <Expander Header="当前节点 · 中央隔离带"
                              Style="{StaticResource BlenderPropertyGroupLevel1}"
                              Visibility="{Binding IsMedianSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding SelectedMedian}">
                            <Expander Header="几何参数" Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <StackPanel>
                                    <bui:PropertyRow Label="启用">
                                        <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                  Style="{StaticResource BlenderCheckBox}"
                                                  Content="参与断面布置"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="宽度 (m)">
                                        <bui:NumericSlider Value="{Binding WidthM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Minimum="0"
                                                           Maximum="20"
                                                           Step="0.1"
                                                           Decimals="2"
                                                           Unit="m"/>
                                    </bui:PropertyRow>
                                </StackPanel>
                            </Expander>

                            <Expander Header="说明" Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush_TextSecondary}"
                                               FontSize="{DynamicResource Metric_FontSmall}"
                                               Text="中央隔离带单独成节点，避免和左右侧板块混在一起；宽度修改会直接影响中心线位置、左右净宽和总路幅。"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Expander>

                    <Expander Header="当前节点 · 侧别"
                              Style="{StaticResource BlenderPropertyGroupLevel1}"
                              Visibility="{Binding IsSideSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding SelectedSide}">
                            <Expander Header="侧向摘要" Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <StackPanel>
                                    <bui:PropertyRow Label="侧别">
                                        <TextBlock Text="{Binding SideLabel}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="方向">
                                        <TextBlock Text="{Binding DirectionLabel}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="板块数量">
                                        <TextBlock Text="{Binding BandCount}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="当前总宽">
                                        <TextBlock Text="{Binding ActiveWidth, StringFormat={}{0:F2} m}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                </StackPanel>
                            </Expander>

                            <Expander Header="快速插入板块" Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <WrapPanel>
                                    <Button Content="机动车道"
                                            Margin="0,0,4,4"
                                            MinWidth="74"
                                            Style="{StaticResource BlenderButton}"
                                            Command="{Binding DataContext.AddPavementBandCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                    <Button Content="非机动车道"
                                            Margin="0,0,4,4"
                                            MinWidth="88"
                                            Style="{StaticResource BlenderButton}"
                                            Command="{Binding DataContext.AddNonMotorizedBandCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                    <Button Content="人行道"
                                            Margin="0,0,4,4"
                                            MinWidth="68"
                                            Style="{StaticResource BlenderButton}"
                                            Command="{Binding DataContext.AddSidewalkBandCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                    <Button Content="绿化带"
                                            Margin="0,0,4,4"
                                            MinWidth="68"
                                            Style="{StaticResource BlenderButton}"
                                            Command="{Binding DataContext.AddGreenStripBandCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                    <Button Content="分隔带"
                                            Margin="0,0,4,4"
                                            MinWidth="68"
                                            Style="{StaticResource BlenderButton}"
                                            Command="{Binding DataContext.AddSeparatorBandCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                </WrapPanel>
                            </Expander>

                            <Expander Header="排序规则" Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush_TextSecondary}"
                                               FontSize="{DynamicResource Metric_FontSmall}"
                                               Text="左 / 右侧板块顺序一律按『从中心向边界』组织。左侧对应 e = (-1, 0)，右侧对应 e = (1, 0)。删除、上移、下移都只作用于当前侧的板块序列。"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Expander>

                    <Expander Header="当前节点 · 板块"
                              Style="{StaticResource BlenderPropertyGroupLevel1}"
                              Visibility="{Binding HasActiveBand, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding ActiveBand}">
                            <Expander Header="基础" Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <StackPanel>
                                    <bui:PropertyRow Label="启用">
                                        <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                  Style="{StaticResource BlenderCheckBox}"
                                                  Content="计入总路幅与出图"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="名称">
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource BlenderTextBox}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="类型">
                                        <ComboBox ItemsSource="{x:Static smp:V3CrossSectionSampleViewModel.AvailableKinds}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Kind"
                                                  SelectedValue="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource BlenderComboBox}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="序号">
                                        <TextBlock Text="{Binding OrderIndex}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="侧别">
                                        <TextBlock Text="{Binding OwnerSide.SideLabel}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                </StackPanel>
                            </Expander>

                            <Expander Header="几何参数" Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <StackPanel>
                                    <bui:PropertyRow Label="宽度 (m)">
                                        <bui:NumericSlider Value="{Binding WidthM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Minimum="0.1"
                                                           Maximum="30"
                                                           Step="0.1"
                                                           Decimals="2"
                                                           Unit="m"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="横坡 (%)">
                                        <bui:NumericSlider Value="{Binding SlopePct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Minimum="-20"
                                                           Maximum="20"
                                                           Step="0.1"
                                                           Decimals="1"
                                                           Unit="%"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="车道数"
                                                     Visibility="{Binding HasLaneCount, Converter={StaticResource BoolToVis}}">
                                        <bui:NumericSlider Value="{Binding LaneCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Minimum="0"
                                                           Maximum="6"
                                                           Step="1"
                                                           Decimals="0"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="来源">
                                        <ComboBox ItemsSource="{x:Static smp:V3CrossSectionSampleViewModel.AvailableSourceOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Kind"
                                                  SelectedValue="{Binding GeometrySource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource BlenderComboBox}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="图元备注">
                                        <TextBox Text="{Binding CadObjectHint, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource BlenderTextBox}"/>
                                    </bui:PropertyRow>
                                </StackPanel>
                            </Expander>

                            <Expander Header="结构摘要"
                                      Style="{StaticResource BlenderPropertyGroupLevel2}"
                                      Visibility="{Binding HasStructureGroups, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <bui:PropertyRow Label="组成摘要">
                                        <TextBlock Text="{Binding StructureSummary}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="总厚度">
                                        <TextBlock Text="{Binding TotalStructureThicknessM, StringFormat={}{0:F3} m}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="快速加层">
                                        <WrapPanel>
                                            <Button Content="＋面层"
                                                    Margin="0,0,4,0"
                                                    MinWidth="58"
                                                    Style="{StaticResource BlenderButton}"
                                                    Command="{Binding DataContext.AddSurfaceLayerCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                            <Button Content="＋基层"
                                                    Margin="0,0,4,0"
                                                    MinWidth="58"
                                                    Style="{StaticResource BlenderButton}"
                                                    Command="{Binding DataContext.AddBaseLayerCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                            <Button Content="＋垫层"
                                                    MinWidth="58"
                                                    Style="{StaticResource BlenderButton}"
                                                    Command="{Binding DataContext.AddSubbaseLayerCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                        </WrapPanel>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="层组摘要">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SurfaceGroup.Summary, FallbackValue=无面层组}"
                                                       Foreground="{DynamicResource Brush_TextSecondary}"
                                                       FontSize="{DynamicResource Metric_FontSmall}"/>
                                            <TextBlock Text="{Binding BaseGroup.Summary, FallbackValue=无基层组}"
                                                       Foreground="{DynamicResource Brush_TextSecondary}"
                                                       FontSize="{DynamicResource Metric_FontSmall}"/>
                                            <TextBlock Text="{Binding SubbaseGroup.Summary, FallbackValue=无垫层组}"
                                                       Foreground="{DynamicResource Brush_TextSecondary}"
                                                       FontSize="{DynamicResource Metric_FontSmall}"/>
                                        </StackPanel>
                                    </bui:PropertyRow>
                                </StackPanel>
                            </Expander>

                            <Expander Header="CAD 映射与出图预留" Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush_TextSecondary}"
                                               FontSize="{DynamicResource Metric_FontSmall}"
                                               Text="v3 把图形来源显式挂到板块层：后续命令可以从模型空间选折线 / 边界，回填宽度、厚度、坡度，再同步到这里的板块与结构树。"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Expander>

                    <Expander Header="当前节点 · 结构组"
                              Style="{StaticResource BlenderPropertyGroupLevel1}"
                              Visibility="{Binding HasActiveGroup, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding ActiveGroup}">
                            <Expander Header="规则" Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <StackPanel>
                                    <bui:PropertyRow Label="结构组">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="所属板块">
                                        <TextBlock Text="{Binding ParentBand.DisplayTitle}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="层数规则">
                                        <TextBlock Text="{Binding RuleSummary}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="当前层数">
                                        <TextBlock Text="{Binding LayerCount}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="总厚度">
                                        <TextBlock Text="{Binding TotalThicknessM, StringFormat={}{0:F3} m}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="操作">
                                        <WrapPanel>
                                            <Button Content="新增当前组一层"
                                                    MinWidth="120"
                                                    Margin="0,0,4,0"
                                                    Style="{StaticResource BlenderButton}"
                                                    Command="{Binding DataContext.AddLayerToSelectedGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                            <Button Content="删除当前层"
                                                    MinWidth="96"
                                                    Style="{StaticResource BlenderButton}"
                                                    Command="{Binding DataContext.RemoveSelectedLayerCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                        </WrapPanel>
                                    </bui:PropertyRow>
                                </StackPanel>
                            </Expander>

                            <Expander Header="当前组层清单" Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <ItemsControl ItemsSource="{Binding Layers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding DisplayTitle}"
                                                           Foreground="{DynamicResource Brush_TextPrimary}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Summary}"
                                                           Foreground="{DynamicResource Brush_TextSecondary}"
                                                           FontSize="{DynamicResource Metric_FontSmall}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Expander>

                    <Expander Header="当前节点 · 结构层"
                              Style="{StaticResource BlenderPropertyGroupLevel1}"
                              Visibility="{Binding HasActiveLayer, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding SelectedLayer}">
                            <Expander Header="基础" Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <StackPanel>
                                    <bui:PropertyRow Label="名称">
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource BlenderTextBox}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="所属结构组">
                                        <TextBlock Text="{Binding ParentGroup.DisplayTitle}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="所属板块">
                                        <TextBlock Text="{Binding ParentGroup.ParentBand.DisplayTitle}"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </bui:PropertyRow>
                                </StackPanel>
                            </Expander>

                            <Expander Header="厚度与材料" Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <StackPanel>
                                    <bui:PropertyRow Label="厚度 (m)">
                                        <bui:NumericSlider Value="{Binding ThicknessM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Minimum="0.001"
                                                           Maximum="1.000"
                                                           Step="0.01"
                                                           Decimals="3"
                                                           Unit="m"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="材料">
                                        <TextBox Text="{Binding Material, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource BlenderTextBox}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="填充符号">
                                        <TextBox Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource BlenderTextBox}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="备注">
                                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource BlenderTextBox}"/>
                                    </bui:PropertyRow>
                                    <bui:PropertyRow Label="操作">
                                        <Button Content="删除当前层"
                                                MinWidth="96"
                                                Style="{StaticResource BlenderButton}"
                                                Command="{Binding DataContext.RemoveSelectedLayerCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                    </bui:PropertyRow>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </bui:PropertyEditor>
    </Grid>
</bui:BlenderWindow>
