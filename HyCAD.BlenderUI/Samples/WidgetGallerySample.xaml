<bui:BlenderWindow x:Class="HyCAD.BlenderUI.Samples.WidgetGallerySample"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls"
                   xmlns:wg="clr-namespace:HyCAD.BlenderUI.Controls.Widgets"
                   Title="WidgetGallerySample"
                   HeaderTitle="uiBut P0/P2 展示"
                   Width="960" Height="800"
                   UseCustomChrome="False"
                   Background="{DynamicResource Brush_WindowBack}"
                   FontFamily="{DynamicResource Font_Main}">
    <bui:BlenderWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/BlenderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </bui:BlenderWindow.Resources>
    <ScrollViewer Style="{StaticResource BlenderScrollViewer}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
            <TextBlock Text="Color / HSV / 曲线" Foreground="{DynamicResource Brush_TextSecondary}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <wg:BlenderColorField Width="80" Margin="0,0,12,12"/>
                <wg:BlenderHsvCube Width="140" Height="140" Margin="0,0,12,12"/>
                <wg:BlenderHsvCircle Width="140" Height="140" Margin="0,0,12,12"/>
            </StackPanel>
            <wg:BlenderColorBand Height="28" Margin="0,0,0,12"/>
            <wg:BlenderCurveEditor Height="100" Margin="0,0,0,12"/>
            <wg:BlenderCurveProfile Height="80" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <wg:BlenderHistogram Width="200" Height="80" Margin="0,0,12,0"/>
                <wg:BlenderWaveform Width="200" Height="80" Margin="0,0,12,0"/>
                <wg:BlenderVectorscope Width="140" Height="140"/>
            </StackPanel>
            <wg:BlenderProgress Value="0.35" Maximum="1" Margin="0,0,0,12"/>
            <wg:BlenderSearchMenu Height="200" Margin="0,0,0,12"/>
            <wg:BlenderPreviewTile Title="Asset" Width="120" Height="100" Margin="0,0,0,12">
                <Border Background="{DynamicResource Brush_RegionBack}" Height="60"/>
            </wg:BlenderPreviewTile>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <wg:BlenderNodeSocket Margin="0,0,8,0"/>
                <wg:BlenderGripHandle Margin="0,0,8,0"/>
                <wg:BlenderDecorator Margin="0,0,8,0"/>
                <wg:BlenderKeyEventField Width="200"/>
            </StackPanel>
            <TextBlock Text="P2" Foreground="{DynamicResource Brush_TextSecondary}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <wg:BlenderSeparatorLine Width="120" Margin="0,0,12,0"/>
                <wg:BlenderSeparatorSpacer Width="20"/>
                <wg:BlenderIconSeparator Height="24" Margin="0,0,12,0"/>
                <wg:BlenderBlockButton Content="Block" Style="{StaticResource BlenderButton}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</bui:BlenderWindow>
