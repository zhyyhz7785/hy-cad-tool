<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
     主题 3：AutoCAD Light（参考 AutoCAD 经典 Light Ribbon UI）
     特征：白底面板 + 浅灰 Ribbon + Autodesk 蓝高亮（#2A6BBC）
    -->

    <!-- 窗口 / 编辑器 / 侧边栏 / 分组面板 -->
    <SolidColorBrush x:Key="Brush_WindowBack"           Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Brush_HeaderBack"           Color="#E5E5E5"/>
    <SolidColorBrush x:Key="Brush_RegionBack"           Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush_PanelBack"            Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Brush_PanelSubBack"         Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Brush_PanelHeaderBack"      Color="#DCDCDC"/>
    <SolidColorBrush x:Key="Brush_BorderDark"           Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Brush_BorderMid"            Color="#C0C0C0"/>

    <!-- 标签 / 选中高亮（沿用 AutoCAD/Autodesk 蓝） -->
    <SolidColorBrush x:Key="Brush_TabInactive"          Color="#E0E0E0"/>
    <SolidColorBrush x:Key="Brush_AccentBlue"           Color="#2A6BBC"/>
    <SolidColorBrush x:Key="Brush_AccentBlueHover"      Color="#3D7DCE"/>

    <!-- 按钮（Win Ribbon 风：浅灰底 + 选中淡蓝） -->
    <SolidColorBrush x:Key="Brush_ButtonIdle"           Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Brush_ButtonHover"          Color="#BEE6FD"/>
    <SolidColorBrush x:Key="Brush_ButtonPressed"        Color="#99D1F7"/>
    <SolidColorBrush x:Key="Brush_ButtonBorder"         Color="#A0A0A0"/>

    <!-- 输入 / 复选 -->
    <SolidColorBrush x:Key="Brush_InputBack"            Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush_InputBorder"          Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Brush_InputFocusBorder"     Color="#2A6BBC"/>
    <SolidColorBrush x:Key="Brush_CheckboxBack"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush_CheckboxChecked"      Color="#2A6BBC"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="Brush_TextPrimary"          Color="#000000"/>
    <SolidColorBrush x:Key="Brush_TextSecondary"        Color="#444444"/>
    <SolidColorBrush x:Key="Brush_TextDisabled"         Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Brush_TextOnAccent"         Color="#FFFFFF"/>

    <!-- 强调色 -->
    <SolidColorBrush x:Key="Brush_Warning"              Color="#D14013"/>
    <SolidColorBrush x:Key="Brush_Success"              Color="#3F8C3F"/>

    <!-- 滚动条 -->
    <SolidColorBrush x:Key="Brush_ScrollThumb"          Color="#C0C0C0"/>
    <SolidColorBrush x:Key="Brush_ScrollThumbHover"     Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Brush_ScrollTrack"          Color="#EAEAEA"/>

    <!-- Expander 头条 -->
    <SolidColorBrush x:Key="Brush_ExpanderHeader"       Color="#DCDCDC"/>
    <SolidColorBrush x:Key="Brush_ExpanderHeaderHover"  Color="#CFCFCF"/>

    <!-- ListBox / Selector 高亮 -->
    <SolidColorBrush x:Key="Brush_ItemHover"            Color="#E5F1FB"/>
    <SolidColorBrush x:Key="Brush_ItemSelected"         Color="#CDE8FF"/>
    <SolidColorBrush x:Key="Brush_ItemSelectedText"     Color="#000000"/>

    <!-- NumericSlider 专用 -->
    <SolidColorBrush x:Key="Brush_SliderBack"           Color="#E8E8E8"/>
    <SolidColorBrush x:Key="Brush_SliderFill"           Color="#2A6BBC"/>
    <SolidColorBrush x:Key="Brush_SliderFillHover"      Color="#3D7DCE"/>

</ResourceDictionary>
