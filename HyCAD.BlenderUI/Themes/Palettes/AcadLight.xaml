<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
     主题 3：AutoCAD Light
     ───────────────────────────────────────────────────────────────
     色值来源：
       1. AutoCAD 2024+ Light Ribbon 实测抓色（COLORTHEME=1）
       2. AutoCAD 工具栏背景官方文章（toolbar background RGB colors in AutoCAD）
       3. Office Fluent Light hover/selected（#BEE6FD/#99D1F7/#CDE8FF）
     映射依据：
       Status bar / Title bar       = #E5E5E5
       Quick Access Toolbar / 顶 header = #D4D4D4
       Drawing area background      = #FFFFFF   →  Brush_RegionBack
       Ribbon panel                 = #F5F5F5
       Ribbon panel header (浅灰带) = #DCDCDC
       AutoCAD focus blue           = #3070C0   →  AccentBlue（与 Dark 同色）
       AutoCAD focus blue hover     = #4585D9
    -->

    <!-- 窗口 / 编辑器 / 侧边栏 / 分组面板 -->
    <SolidColorBrush x:Key="Brush_WindowBack"           Color="#E5E5E5"/>
    <SolidColorBrush x:Key="Brush_HeaderBack"           Color="#D4D4D4"/>
    <SolidColorBrush x:Key="Brush_RegionBack"           Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush_PanelBack"            Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Brush_PanelSubBack"         Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Brush_PanelHeaderBack"      Color="#DCDCDC"/>
    <SolidColorBrush x:Key="Brush_BorderDark"           Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Brush_BorderMid"            Color="#C8C8C8"/>

    <!-- 标签 / 选中高亮（AutoCAD focus 蓝 #3070C0） -->
    <SolidColorBrush x:Key="Brush_TabInactive"          Color="#D6D6D6"/>
    <SolidColorBrush x:Key="Brush_AccentBlue"           Color="#3070C0"/>
    <SolidColorBrush x:Key="Brush_AccentBlueHover"      Color="#4585D9"/>

    <!-- 按钮（Win Ribbon 风：浅灰底 + Office hover/pressed 淡蓝） -->
    <SolidColorBrush x:Key="Brush_ButtonIdle"           Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Brush_ButtonHover"          Color="#BEE6FD"/>
    <SolidColorBrush x:Key="Brush_ButtonPressed"        Color="#99D1F7"/>
    <SolidColorBrush x:Key="Brush_ButtonBorder"         Color="#A0A0A0"/>

    <!-- 输入 / 复选 -->
    <SolidColorBrush x:Key="Brush_InputBack"            Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush_InputBorder"          Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Brush_InputFocusBorder"     Color="#3070C0"/>
    <SolidColorBrush x:Key="Brush_CheckboxBack"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush_CheckboxChecked"      Color="#3070C0"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="Brush_TextPrimary"          Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Brush_TextSecondary"        Color="#444444"/>
    <SolidColorBrush x:Key="Brush_TextDisabled"         Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Brush_TextOnAccent"         Color="#FFFFFF"/>

    <!-- 强调色 -->
    <SolidColorBrush x:Key="Brush_Warning"              Color="#D14013"/>
    <SolidColorBrush x:Key="Brush_Success"              Color="#3F8C3F"/>

    <!-- 滚动条 -->
    <SolidColorBrush x:Key="Brush_ScrollThumb"          Color="#C0C0C0"/>
    <SolidColorBrush x:Key="Brush_ScrollThumbHover"     Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Brush_ScrollTrack"          Color="#EAEAEA"/>

    <!-- Expander 头条 -->
    <SolidColorBrush x:Key="Brush_ExpanderHeader"       Color="#DCDCDC"/>
    <SolidColorBrush x:Key="Brush_ExpanderHeaderHover"  Color="#CFCFCF"/>

    <!-- ListBox / Selector 高亮（Office Fluent Light） -->
    <SolidColorBrush x:Key="Brush_ItemHover"            Color="#E5F1FB"/>
    <SolidColorBrush x:Key="Brush_ItemSelected"         Color="#CDE8FF"/>
    <SolidColorBrush x:Key="Brush_ItemSelectedText"     Color="#1E1E1E"/>

    <!-- NumericSlider 专用 -->
    <SolidColorBrush x:Key="Brush_SliderBack"           Color="#E8E8E8"/>
    <SolidColorBrush x:Key="Brush_SliderFill"           Color="#3070C0"/>
    <SolidColorBrush x:Key="Brush_SliderFillHover"      Color="#4585D9"/>

</ResourceDictionary>
