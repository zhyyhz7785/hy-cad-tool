<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="Metric_FontMain">12</sys:Double>
    <sys:Double x:Key="Metric_FontSmall">11</sys:Double>
    <sys:Double x:Key="Metric_FontHeader">12</sys:Double>
    <sys:Double x:Key="Metric_RowHeight">22</sys:Double>
    <sys:Double x:Key="Metric_ExpanderHeight">24</sys:Double>
    <sys:Double x:Key="Metric_IconBarWidth">32</sys:Double>
    <sys:Double x:Key="Metric_IconSize">20</sys:Double>
    <CornerRadius x:Key="Metric_CornerRadius">3</CornerRadius>
    <CornerRadius x:Key="Metric_CornerRadiusSmall">2</CornerRadius>
    <Thickness x:Key="Metric_ButtonPadding">8,3</Thickness>
    <Thickness x:Key="Metric_InputPadding">6,2</Thickness>

    <!--
      Workspace 体系度量（v1.2）
      用 Double 统一暴露；Sample 中分隔列宽（GridLength 类型）直接用字面量「Width="4"」，
      不引入 GridLength/Thickness 类型 DR（避免 pitfall B4 的类型错配）。
    -->
    <sys:Double x:Key="Metric_EditorHeaderHeight">24</sys:Double>
    <sys:Double x:Key="Metric_ToolbarWidth">40</sys:Double>
    <sys:Double x:Key="Metric_NPanelMinWidth">240</sys:Double>
    <sys:Double x:Key="Metric_OutlinerMinWidth">220</sys:Double>
    <sys:Double x:Key="Metric_TimelineHeight">28</sys:Double>
    <sys:Double x:Key="Metric_StatusBarHeight">22</sys:Double>
    <sys:Double x:Key="Metric_SplitterThickness">4</sys:Double>
    <sys:Double x:Key="Metric_WorkspaceTabHeight">26</sys:Double>

</ResourceDictionary>
