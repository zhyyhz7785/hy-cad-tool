<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:HyCAD.BlenderUI.Controls">

    <!--
      自包含 Merge（pitfall B5）：依赖端只 Merge 本字典也能拿到完整颜色 / 度量 / 字体。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Colors.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Metrics.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Fonts.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
      WorkspaceTabItem 默认样式（自定义类型 TargetType，不需 x:Key）：
        水平 StackPanel = [Icon 16] + [Title]，selected 时底部蓝色 2px 细线 + 文字高亮。
        Cursor=Hand；hover 背景轻变。
    -->
    <Style TargetType="{x:Type ctrl:WorkspaceTabItem}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush_TextSecondary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font_Main}"/>
        <Setter Property="FontSize"   Value="{DynamicResource Metric_FontMain}"/>
        <Setter Property="Padding"   Value="10,0"/>
        <Setter Property="Cursor"    Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ToolTip"   Value="{Binding TooltipText, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:WorkspaceTabItem}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="2"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="Bd"
                                Grid.Row="0"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentPresenter x:Name="IconHost"
                                                  Content="{TemplateBinding Icon}"
                                                  Width="16" Height="16"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center"/>
                                <TextBlock x:Name="Lbl"
                                           Text="{TemplateBinding Title}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="Underline"
                                Grid.Row="1"
                                Background="Transparent"
                                SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource Brush_ItemHover}"/>
                            <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource Brush_TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Lbl"        Property="Foreground" Value="{DynamicResource Brush_TextPrimary}"/>
                            <Setter TargetName="Underline"  Property="Background" Value="{DynamicResource Brush_AccentBlue}"/>
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      WorkspaceTabBar 默认样式：水平 StackPanel ItemsHost，整体高度由 Metric_WorkspaceTabHeight 决定，
      底部细线分隔（与下方业务区分隔）。
    -->
    <Style TargetType="{x:Type ctrl:WorkspaceTabBar}">
        <Setter Property="Background" Value="{DynamicResource Brush_HeaderBack}"/>
        <Setter Property="Height"     Value="{DynamicResource Metric_WorkspaceTabHeight}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush_BorderDark}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:WorkspaceTabBar}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,0,1"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter VerticalAlignment="Stretch"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
