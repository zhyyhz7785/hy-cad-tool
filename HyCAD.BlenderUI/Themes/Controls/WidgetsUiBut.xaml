<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:widgets="clr-namespace:HyCAD.BlenderUI.Controls.Widgets">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Controls/WidgetBackdrop.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Controls/Button.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Controls/TextBox.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Controls/ListBox.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type widgets:BlenderColorField}">
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type widgets:BlenderColorField}">
                    <Border x:Name="PART_Swatch"
                            Style="{StaticResource BlenderWidgetBackdropIdle}"
                            BorderBrush="{DynamicResource Brush_InputBorder}"
                            BorderThickness="1"
                            MinHeight="22" MinWidth="48"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type widgets:BlenderColorBand}">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type widgets:BlenderColorBand}">
                    <Border BorderBrush="{DynamicResource Brush_BorderMid}" BorderThickness="1" CornerRadius="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type widgets:BlenderHsvCube}">
        <Setter Property="MinHeight" Value="120"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="{x:Type widgets:BlenderHsvCircle}">
        <Setter Property="MinHeight" Value="120"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="{x:Type widgets:BlenderCurveEditor}">
        <Setter Property="MinHeight" Value="100"/>
        <Setter Property="MinWidth" Value="120"/>
    </Style>

    <Style TargetType="{x:Type widgets:BlenderCurveProfile}">
        <Setter Property="MinHeight" Value="80"/>
        <Setter Property="MinWidth" Value="120"/>
    </Style>

    <Style TargetType="{x:Type widgets:BlenderHistogram}">
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="MinWidth" Value="120"/>
    </Style>

    <Style TargetType="{x:Type widgets:BlenderWaveform}">
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="MinWidth" Value="120"/>
    </Style>

    <Style TargetType="{x:Type widgets:BlenderVectorscope}">
        <Setter Property="MinHeight" Value="100"/>
        <Setter Property="MinWidth" Value="100"/>
    </Style>

    <Style TargetType="{x:Type widgets:BlenderProgress}">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush_SliderFill}"/>
        <Setter Property="Background" Value="{DynamicResource Brush_SliderBack}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="{x:Type widgets:BlenderSearchMenu}">
        <Setter Property="MinHeight" Value="120"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type widgets:BlenderSearchMenu}">
                    <Border Style="{StaticResource BlenderWidgetBackdropIdle}" BorderBrush="{DynamicResource Brush_InputBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="PART_Text" Grid.Row="0" Style="{StaticResource BlenderTextBox}" Margin="4"/>
                            <ListBox x:Name="PART_List" Grid.Row="1" Style="{StaticResource BlenderListBox}" MaxHeight="160" Margin="4,0,4,4"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type widgets:BlenderPreviewTile}">
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type widgets:BlenderPreviewTile}">
                    <Border BorderBrush="{DynamicResource Brush_BorderMid}" BorderThickness="1" CornerRadius="2"
                            Background="{DynamicResource Brush_PanelSubBack}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0" Margin="4"/>
                            <TextBlock Grid.Row="1" Text="{TemplateBinding Title}" Margin="4"
                                       Foreground="{DynamicResource Brush_TextSecondary}"
                                       FontSize="{DynamicResource Metric_FontCaption}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type widgets:BlenderNodeSocket}">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type widgets:BlenderNodeSocket}">
                    <Border x:Name="Bd" Width="14" Height="14" CornerRadius="7"
                            BorderBrush="{DynamicResource Brush_TextSecondary}" BorderThickness="2"
                            Background="{DynamicResource Brush_RegionBack}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush_AccentBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type widgets:BlenderGripHandle}">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Cursor" Value="SizeNWSE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type widgets:BlenderGripHandle}">
                    <Canvas Width="12" Height="12">
                        <Path Stroke="{DynamicResource Brush_TextSecondary}" StrokeThickness="1"
                              Data="M 8,12 L 12,8 M 4,12 L 12,4 M 0,12 L 12,0"/>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type widgets:BlenderDecorator}" BasedOn="{StaticResource BlenderButton}">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Content" Value="◆"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <Style TargetType="{x:Type widgets:BlenderKeyEventField}" BasedOn="{StaticResource BlenderTextBox}">
        <Setter Property="MinWidth" Value="120"/>
    </Style>

</ResourceDictionary>
