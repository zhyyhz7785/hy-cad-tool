<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:HyCAD.BlenderUI.Controls">

    <!--
      自包含 Merge（pitfall B5）。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Colors.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Metrics.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Fonts.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
      EditorHeader 默认样式（自定义 TargetType 无 x:Key 安全）：
        24px 高 Border，背景 Brush_HeaderBack，底部细线。
        三槽位 Grid：左 EditorTypeIcon (20×20) | 中 LeftContent (Auto, 横向延伸) | 右 RightContent (Auto)。
    -->
    <Style TargetType="{x:Type ctrl:EditorHeader}">
        <Setter Property="Background"     Value="{DynamicResource Brush_HeaderBack}"/>
        <Setter Property="Foreground"     Value="{DynamicResource Brush_TextPrimary}"/>
        <Setter Property="FontFamily"     Value="{DynamicResource Font_Main}"/>
        <Setter Property="FontSize"       Value="{DynamicResource Metric_FontMain}"/>
        <Setter Property="Height"         Value="{DynamicResource Metric_EditorHeaderHeight}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:EditorHeader}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush_BorderDark}"
                            BorderThickness="0,0,0,1"
                            SnapsToDevicePixels="True">
                        <Grid Margin="6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="IconHost"
                                              Grid.Column="0"
                                              Content="{TemplateBinding EditorTypeIcon}"
                                              Width="18" Height="18"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"/>
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding LeftContent}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <ContentPresenter Grid.Column="2"
                                              Content="{TemplateBinding RightContent}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="EditorTypeIcon" Value="{x:Null}">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
