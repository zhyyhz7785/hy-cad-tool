<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:HyCAD.BlenderUI.Controls">

    <!--
      自包含 Merge（pitfall B5）。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Colors.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Metrics.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Fonts.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
      StatusBar 默认样式（自定义 TargetType 无 x:Key 安全）：
        Editor 内底部 22px 状态条；与 BlenderWindow.Footer 互不冲突。
        三槽位 Grid：左 LeftContent | 中 CenterContent | 右 RightContent。
    -->
    <Style TargetType="{x:Type ctrl:StatusBar}">
        <Setter Property="Background" Value="{DynamicResource Brush_PanelHeaderBack}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush_TextSecondary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font_Main}"/>
        <Setter Property="FontSize"   Value="{DynamicResource Metric_FontSmall}"/>
        <Setter Property="Height"     Value="{DynamicResource Metric_StatusBarHeight}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:StatusBar}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush_BorderDark}"
                            BorderThickness="0,1,0,0"
                            SnapsToDevicePixels="True">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding LeftContent}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding CenterContent}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                            <ContentPresenter Grid.Column="2"
                                              Content="{TemplateBinding RightContent}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
