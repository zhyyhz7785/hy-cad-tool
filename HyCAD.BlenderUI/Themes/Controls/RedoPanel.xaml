<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:HyCAD.BlenderUI.Controls">

    <Style TargetType="{x:Type ctrl:BlenderRedoPanel}">
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="MaxHeight" Value="120"/>
        <Setter Property="Background" Value="{DynamicResource Brush_PanelBack}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush_BorderDark}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:BlenderRedoPanel}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Metric_CornerRadius}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="Redo / 最近操作" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush_TextSecondary}"
                                       FontSize="{DynamicResource Metric_FontCaption}"/>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
