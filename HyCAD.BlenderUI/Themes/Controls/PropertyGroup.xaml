<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls">

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!--
      三级分组 Expander：色值与层级语义对齐 Blender 4.x userdef_default_theme.c
      （space_properties / tui.wcol_box / wcol_num / wcol_toolbar_item），
      头条背景由 PropertyGroupChrome.HeaderBackground 与内容区 Background 解耦。
    -->
    <Style x:Key="BlenderPropertyGroupBase" TargetType="{x:Type Expander}">
        <Setter Property="bui:PropertyGroupChrome.HeaderBackground" Value="{DynamicResource Brush_PropertyPanelHeader}"/>
        <Setter Property="bui:PropertyGroupChrome.ShowGrip" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush_TextPrimary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font_Main}"/>
        <Setter Property="FontSize" Value="{DynamicResource Metric_FontHeader}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="{DynamicResource Brush_PropertyPanelBody}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="IsExpanded" Value="True"/>
        <Setter Property="Margin" Value="0,0,0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <Grid x:Name="Root" Margin="{TemplateBinding Margin}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="HeaderChrome"
                                Grid.Row="0"
                                MinHeight="{DynamicResource Metric_ExpanderHeight}"
                                Background="{Binding Path=(bui:PropertyGroupChrome.HeaderBackground), RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ToggleButton x:Name="HeaderButton"
                                              Grid.Column="0"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Hand"
                                              Focusable="False"
                                              FontFamily="{TemplateBinding FontFamily}"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="Stretch"
                                              Padding="2,0,4,0"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="{TemplateBinding Background}">
                                                <Grid Margin="4,0,2,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="11"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path x:Name="Arrow"
                                                          Grid.Column="0"
                                                          Width="6"
                                                          Height="6"
                                                          VerticalAlignment="Center"
                                                          Data="M 0,0 L 5.5,3.25 L 0,6.5 Z"
                                                          Fill="{DynamicResource Brush_TextSecondary}"
                                                          Stretch="Uniform"/>
                                                    <ContentPresenter Grid.Column="2"
                                                                      VerticalAlignment="Center"
                                                                      ContentSource="Content"
                                                                      RecognizesAccessKey="True"
                                                                      TextElement.FontFamily="{TemplateBinding FontFamily}"
                                                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                                                      TextElement.FontWeight="{TemplateBinding FontWeight}"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Data" Value="M 0,0 L 6.5,0 L 3.25,5.5 Z"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <UniformGrid x:Name="GripHost"
                                             Grid.Column="1"
                                             Width="10"
                                             Height="14"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center"
                                             Columns="2"
                                             IsHitTestVisible="False"
                                             Rows="4"
                                             Visibility="{Binding Path=(bui:PropertyGroupChrome.ShowGrip), Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Ellipse Width="2" Height="2" Margin="1" Fill="{DynamicResource Brush_TextDisabled}"/>
                                    <Ellipse Width="2" Height="2" Margin="1" Fill="{DynamicResource Brush_TextDisabled}"/>
                                    <Ellipse Width="2" Height="2" Margin="1" Fill="{DynamicResource Brush_TextDisabled}"/>
                                    <Ellipse Width="2" Height="2" Margin="1" Fill="{DynamicResource Brush_TextDisabled}"/>
                                    <Ellipse Width="2" Height="2" Margin="1" Fill="{DynamicResource Brush_TextDisabled}"/>
                                    <Ellipse Width="2" Height="2" Margin="1" Fill="{DynamicResource Brush_TextDisabled}"/>
                                    <Ellipse Width="2" Height="2" Margin="1" Fill="{DynamicResource Brush_TextDisabled}"/>
                                    <Ellipse Width="2" Height="2" Margin="1" Fill="{DynamicResource Brush_TextDisabled}"/>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- 无描边分隔：仅靠底色层级（wcol_box well）；圆角贴近 roundness 0.2 换算 -->
                        <Border x:Name="ContentChrome"
                                Grid.Row="1"
                                Margin="0,0,0,0"
                                Padding="{DynamicResource Metric_PropertyGroupContentPadding}"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="{DynamicResource Metric_CornerRadiusWidget}"
                                Visibility="Collapsed">
                            <ContentPresenter ContentSource="Content"/>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ContentChrome" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <Trigger SourceName="HeaderChrome" Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource Brush_PropertyGroupHeaderHover}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush_TextDisabled}"/>
                            <Setter TargetName="HeaderChrome" Property="Opacity" Value="0.72"/>
                            <Setter TargetName="ContentChrome" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BlenderPropertyGroup"
           TargetType="{x:Type Expander}"
           BasedOn="{StaticResource BlenderPropertyGroupBase}"/>

    <Style x:Key="BlenderPropertyGroupLevel1"
           TargetType="{x:Type Expander}"
           BasedOn="{StaticResource BlenderPropertyGroupBase}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="BlenderPropertyGroupLevel2"
           TargetType="{x:Type Expander}"
           BasedOn="{StaticResource BlenderPropertyGroupBase}">
        <Setter Property="bui:PropertyGroupChrome.HeaderBackground" Value="{DynamicResource Brush_PropertyPanelBody}"/>
        <Setter Property="Background" Value="{DynamicResource Brush_PropertyWellBack}"/>
        <Setter Property="Margin" Value="4,0,0,1"/>
        <Setter Property="FontSize" Value="{DynamicResource Metric_FontMain}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="BlenderPropertyGroupLevel3"
           TargetType="{x:Type Expander}"
           BasedOn="{StaticResource BlenderPropertyGroupBase}">
        <Setter Property="bui:PropertyGroupChrome.HeaderBackground" Value="{DynamicResource Brush_PropertyWellBack}"/>
        <Setter Property="bui:PropertyGroupChrome.ShowGrip" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource Brush_PropertyWellBack}"/>
        <Setter Property="Margin" Value="8,0,0,1"/>
        <Setter Property="FontSize" Value="{DynamicResource Metric_FontSmall}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush_TextSecondary}"/>
    </Style>

</ResourceDictionary>
