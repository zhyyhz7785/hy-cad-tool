<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sv="clr-namespace:HyCAD.BlenderUI.Controls.ScreenView">

    <Style TargetType="{x:Type sv:BlenderScreen}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="{x:Type sv:BlenderArea}">
        <Setter Property="Background" Value="{DynamicResource Brush_RegionBack}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush_BorderDark}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type sv:BlenderArea}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="4">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top"
                                       Foreground="{DynamicResource Brush_TextSecondary}"
                                       FontSize="{DynamicResource Metric_FontCaption}"
                                       Text="{Binding SpaceType, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type sv:AreaCornerHandle}" BasedOn="{StaticResource BlenderButton}">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Content" Value="◢"/>
    </Style>

    <Style TargetType="{x:Type sv:RegionCollapseHandle}" BasedOn="{StaticResource BlenderToggleButton}">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="48"/>
    </Style>

    <Style TargetType="{x:Type sv:AreaHeaderFlipButton}" BasedOn="{StaticResource BlenderToggleButton}">
        <Setter Property="Content" Value="⇅"/>
    </Style>

</ResourceDictionary>
