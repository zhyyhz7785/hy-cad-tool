<ResourceDictionary x:Class="HyCAD.BlenderUI.Themes.ColorsHost"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
     主题色板入口（v2 — host-replace 实现）
     — XAML 编译期 Merge 默认主题 BlenderDark.xaml；
     — Code-behind ColorsHost 构造时把自己登记到 BlenderThemeManager；
     — BlenderThemeManager.Apply(...) 切换时直接 Clear 本字典 MergedDictionaries
       并 Add 目标主题调色板 → 所有引用 Brush_* 的 DynamicResource 自动刷新。
     — 设计器场景 BlenderThemeManager 未启动也无伤大雅：仍渲染 BlenderDark。
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
