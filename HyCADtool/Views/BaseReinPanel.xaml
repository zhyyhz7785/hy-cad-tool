<UserControl x:Class="HyCADTool.Views.BaseReinPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helper="clr-namespace:HyCADTool.HelpClass"
             xmlns:local="clr-namespace:HyCADTool.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignWidth="230"
             Background="#3b4453"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Resources/LibraryResources.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0" Background="#3b4453">
        <!--  第一分区  -->
        <Expander Margin="5"
                  Background="#3f4855"
                  BorderBrush="Gray"
                  BorderThickness="1"
                  Header="基本设置"
                  IsExpanded="True">
            <Border Background="#3f4855"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel>
                    <!--  主图形比例  -->
                    <Grid Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="White" Text="主图形比例" />
                        <TextBox x:Name="ScaleText"
                                 Grid.Column="1"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Text="100"
                                 TextChanged="ScaleText_TextChanged" />
                    </Grid>
                    <!--  设置样式按钮  -->
                    <Grid Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="Apply"
                                Grid.Column="0"
                                Click="Apply_Click"
                                Content="设置样式"
                                Foreground="White" />
                        <Button x:Name="ResetButton"
                                Grid.Column="1"
                                Click="ResetButton_Click"
                                Content="恢复默认值" />
                    </Grid>
                </StackPanel>
            </Border>
        </Expander>
        <!--  第二分区  -->
        <Expander Margin="5"
                  Background="#3f4855"
                  BorderBrush="Gray"
                  BorderThickness="1"
                  Header="操作"
                  IsExpanded="True">
            <Border Background="#3f4855"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel>
                    <Button x:Name="StepOne"
                            Grid.Column="1"
                            Click="StepOne_Click"
                            Content="整理底图"
                            Foreground="White" />
                    <!--  先输入公式  -->
                    <TextBox x:Name="FilterValuesTextBox"
                             Width="auto"
                             helper:TextBoxHelper.EnableCustomHandlers="True"
                             Text="&lt;5.65 7.5 9 12" />
                    <Button x:Name="StepTwo"
                            Grid.Column="2"
                            Click="StepTwo_Click"
                            Content="选择删除"
                            Foreground="White" />
                    <Button x:Name="StepFour"
                            Grid.Column="2"
                            Click="StepFour_Click"
                            Content="生成配筋面积" />
                </StackPanel>
            </Border>
        </Expander>
        <Expander Margin="5"
                  Background="#3f4855"
                  BorderBrush="Gray"
                  BorderThickness="1"
                  Header="钢筋及配筋区域绘制"
                  IsExpanded="True">
            <Border Background="#3f4855"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel>
                    <!--  钢筋方向  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="White" Text="钢筋方向" />
                        <ComboBox x:Name="DirectionComboBoxTry"
                                  Grid.Column="1"
                                  Width="90"
                                  Height="20"
                                  SelectedIndex="0"
                                  SelectionChanged="DirectionComboBoxTry_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Padding="2"
                                               Background="#7f4f3f"
                                               Foreground="White"
                                               Text="{Binding}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBoxItem Content="x向顶筋" Tag="TopX" />
                            <ComboBoxItem Content="y向顶筋" Tag="TopY" />
                            <ComboBoxItem Content="x向底筋" Tag="BottomX" />
                            <ComboBoxItem Content="y向底筋" Tag="BottomY" />
                        </ComboBox>
                    </Grid>
                    <!--  通长钢筋直径  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="通长:" />
                        <TextBlock Grid.Column="1" Text="直径" />
                        <TextBox x:Name="RebarDiameterText"
                                 Grid.Column="2"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Text="12"
                                 TextChanged="TextBox_TextChanged" />
                        <TextBlock Grid.Column="3" Foreground="White" Text="间距" />
                        <TextBox x:Name="RebarSpacingText"
                                 Grid.Column="4"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Text="200"
                                 TextChanged="TextBox_TextChanged" />
                    </Grid>
                    <!--  附加钢筋  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="White" Text="附加:" />
                        <TextBlock Grid.Column="1" Foreground="White" Text="直径" />
                        <TextBox x:Name="MinAdditionalDiameterText"
                                 Grid.Column="2"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Text="8"
                                 TextChanged="TextBox_TextChanged" />
                        <TextBlock Grid.Column="3" Foreground="White" Text="间距" />
                        <TextBox x:Name="AdditionalSpacingText"
                                 Grid.Column="4"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Text="200"
                                 TextChanged="TextBox_TextChanged" />
                    </Grid>
                    <!--  钢筋安全系数  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="White" Text="板厚" />
                        <TextBox Grid.Column="1"
                                 Height="20"
                                 x:Name="PlateThicknessText"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Background="#2e3440"
                                 Foreground="White"
                                 Text="350"
                                 TextChanged="TextBox_TextChanged" />
                        <TextBlock Grid.Column="2" Foreground="White" Text="放大" />
                        <TextBox x:Name="ReinforceSafetyText"
                                 Grid.Column="3"
                                 Height="20"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Background="#2e3440"
                                 Foreground="White"
                                 Text="1"
                                 TextChanged="TextBox_TextChanged" />
                   </Grid>
                    <!--  钢筋文字x平移  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="White" Text="文字：" />
                        <TextBlock Grid.Column="1" Foreground="White" Text="x平移" />
                        <TextBox x:Name="ReinforceTextDistanceXText"
                                 Grid.Column="2"
                                 Height="20"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Background="#2e3440"
                                 Foreground="White"
                                 Text="0"
                                 TextChanged="TextBox_TextChanged" />
                        <TextBlock Grid.Column="3" Foreground="White" Text="y平移" />
                        <TextBox x:Name="ReinforceTextDistanceYText"
                                 Grid.Column="4"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Background="#2e3440"
                                 Foreground="White"
                                 Text="0"
                                 TextChanged="TextBox_TextChanged" />
                    </Grid>
                    <!--  增加锚固  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="AddAnchorLengthCheckBox"
                                  Grid.Column="0"
                                  Height="20"
                                  HorizontalContentAlignment="Center"
                                  Checked="AddAnchorLengthCheckBox_Checked"
                                  Content="锚固"
                                  Foreground="White"
                                  IsChecked="True"
                                  Unchecked="AddAnchorLengthCheckBox_Unchecked" />
                        <CheckBox x:Name="DimAllCheckBox"
                                  Grid.Column="1"
                                  Height="20"
                                  HorizontalContentAlignment="Center"
                                  Checked="DimAllCheckBox_Checked"
                                  Content="全向"
                                  Foreground="White"
                                  IsChecked="False"
                                  Unchecked="DimAllCheckBox_Unchecked" />
                        <CheckBox x:Name="ExistingRebarCheckBox"
                                  Grid.Column="2"
                                  Height="20"
                                  HorizontalContentAlignment="Center"
                                  Checked="ExistingRebarCheckBox_Checked"
                                  Content="通筋"
                                  Foreground="White"
                                  IsChecked="True"
                                  Unchecked="ExistingRebarCheckBox_Unchecked" />
                    </Grid>
                    <!--  生成配筋面积  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StepFive"
                                Grid.Column="1"
                                Click="StepFive_Click"
                                Content="第绘制钢筋" />
                    </Grid>
                </StackPanel>
            </Border>
        </Expander>
        <Expander Margin="5"
                  Background="#3f4855"
                  BorderBrush="Gray"
                  BorderThickness="1"
                  Header="标注配筋区域"
                  IsExpanded="True">
            <Border Background="#3f4855"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel>
                    <!--  标注尺寸的取整间隔  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="White" Text="尺寸取整" />
                        <TextBox x:Name="IntervalText"
                                 Grid.Column="1"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Background="#2e3440"
                                 Foreground="White"
                                 Text="100"
                                 TextChanged="TextBox_TextChanged" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="White" Text="标注方向" />
                        <ComboBox x:Name="DimDirectionComboBox"
                                  Grid.Column="1"
                                  Width="90"
                                  Height="20"
                                  SelectedIndex="0"
                                  SelectionChanged="DimDirectionComboBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Padding="2"
                                               Background="#7f4f3f"
                                               Foreground="White"
                                               Text="{Binding}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBoxItem Content="Y向标注" Tag="LeftRight" />
                            <ComboBoxItem Content="X向标注" Tag="UpDown" />
                        </ComboBox>
                    </Grid>
                    <!--  生成配筋面积  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StepSix"
                                Grid.Column="1"
                                Click="StepSix_Click"
                                Content="标注配筋区域" />
                    </Grid>
                </StackPanel>
            </Border>
        </Expander>
        <!--  钢筋  -->
        <Expander Margin="5" Header="高级设置">
            <ScrollViewer Margin="0,5,0,5" VerticalScrollBarVisibility="Visible">
                <StackPanel>
                    <!--  附加钢筋间距  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <!--  锚固因子  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="White" Text="锚固因子" />
                        <TextBox x:Name="AnchorFactorText"
                                 Grid.Column="1"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Background="#2e3440"
                                 Foreground="White"
                                 Text="35"
                                 TextChanged="TextBox_TextChanged" />
                    </Grid>
                    <!--  配筋分区参数  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="White" Text="配筋分区参数" />
                        <TextBox x:Name="proximityThresholdText"
                                 Grid.Column="1"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Background="#2e3440"
                                 Foreground="White"
                                 Text="1000"
                                 TextChanged="TextBox_TextChanged" />
                    </Grid>
                    <!--  上下钢筋间距  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="White" Text="上下钢筋间距" />
                        <TextBox x:Name="ReinforceDistanceText"
                                 Grid.Column="1"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Background="#2e3440"
                                 Foreground="White"
                                 Text="3"
                                 TextChanged="TextBox_TextChanged" />
                    </Grid>
                    <!--  文字到线距离  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="White" Text="文字到线距离" />
                        <TextBox x:Name="TextToLineDistanceText"
                                 Grid.Column="1"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Background="#2e3440"
                                 Foreground="White"
                                 Text="1"
                                 TextChanged="TextBox_TextChanged" />
                    </Grid>
                    <!--  弯钩长度  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="White" Text="弯钩长度" />
                        <TextBox x:Name="HookLengthText"
                                 Grid.Column="1"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Background="#2e3440"
                                 Foreground="White"
                                 Text="1"
                                 TextChanged="TextBox_TextChanged" />
                    </Grid>
                    <!--  多段线宽度  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="White" Text="多段线宽度" />
                        <TextBox x:Name="PolylineWidthText"
                                 Grid.Column="1"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Background="#2e3440"
                                 Foreground="White"
                                 Text="0.4"
                                 TextChanged="TextBox_TextChanged" />
                    </Grid>
                    <!--  标注最远距离  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="White" Text="标注最远距离" />
                        <TextBox x:Name="AxisExtendText"
                                 Grid.Column="1"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Background="#2e3440"
                                 Foreground="White"
                                 Text="15000"
                                 TextChanged="TextBox_TextChanged" />
                    </Grid>
                    <!--  标注间距  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="White" Text="标注间距" />
                        <TextBox x:Name="DimensionDistanceWithDimText"
                                 Grid.Column="1"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Background="#2e3440"
                                 Foreground="White"
                                 Text="6"
                                 TextChanged="TextBox_TextChanged" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Expander>
    </StackPanel>
</UserControl>
