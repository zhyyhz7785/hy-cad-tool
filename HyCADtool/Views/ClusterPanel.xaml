<UserControl x:Class="HyCADTool.Views.ClusterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HyCADTool.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="1800" d:DesignWidth="250"
             Background="#3b4453">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Resources/LibraryResources.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <StackPanel Margin="5,10,5,5" Background="#3b4453">

        <Button Margin="0,2" Command="{Binding ExecuteDrawCommand}" Content="生成标注" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="比例" />
            <TextBox Grid.Column="1" Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- 聚类参数 -->
        <Expander Header="聚类参数" IsExpanded="True" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Margin="0,5,0,2" Text="X方向聚类参数" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="EpsilonX" />
                    <TextBox Grid.Column="1" Text="{Binding ClusterConfigX.EpsilonX, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="EpsilonY" />
                    <TextBox Grid.Column="1" Text="{Binding ClusterConfigX.EpsilonY, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock Margin="0,5,0,2" Text="Y方向聚类参数" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="EpsilonX" />
                    <TextBox Grid.Column="1" Text="{Binding ClusterConfigY.EpsilonX, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="EpsilonY" />
                    <TextBox Grid.Column="1" Text="{Binding ClusterConfigY.EpsilonY, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="过滤容差" />
                    <TextBox Grid.Column="1" Text="{Binding DistanceThreshold, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="最小点数" />
                    <TextBox Grid.Column="1" Text="{Binding MinPoints, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- 扩展边距拆分 -->
                <TextBlock Margin="0,5,0,2" Text="扩展边距 (单位 mm)" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="左边距" />
                    <TextBox Grid.Column="1" Text="{Binding ExpandMarginLeft, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="上边距" />
                    <TextBox Grid.Column="1" Text="{Binding ExpandMarginTop, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="右边距" />
                    <TextBox Grid.Column="1" Text="{Binding ExpandMarginRight, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="下边距" />
                    <TextBox Grid.Column="1" Text="{Binding ExpandMarginBottom, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <CheckBox Content="方案1"  />
                    <CheckBox Grid.Column="1" Content="方案2"  />
                    <CheckBox Grid.Column="2" Content="方案3"  />
                </Grid>
                


                <!-- 点类 -->
                <Separator Margin="0,5"/>
                <TextBlock Text="参与聚类点开关" Foreground="LightGray" Margin="0,5,0,2"/>
                <UniformGrid Columns="2">
                    <CheckBox Content="基础轮廓点" IsChecked="{Binding IncludeBPs}" />
                    <CheckBox Content="轴线交点" IsChecked="{Binding IncludeAAPs}" />
                    <CheckBox Content="基础轴线交点" IsChecked="{Binding IncludeBAPs}" />
                    <CheckBox Content="螺栓点" IsChecked="{Binding IncludeABs}" />
                    <CheckBox Content="钢板点" IsChecked="{Binding IncludeSteelPlatePs}" />
                </UniformGrid>

            </StackPanel>
        </Expander>

        <!-- 绘图开关 -->
        <Expander Header="绘图开关" IsExpanded="True" Margin="0,0,0,10">
            <StackPanel Margin="5">

                <!-- 点类 -->
                <TextBlock Text="点类" Foreground="LightGray" Margin="0,5,0,2"/>
                <UniformGrid Columns="2">
                    <CheckBox Content="基础轮廓点" IsChecked="{Binding DrawBPs}" />
                    <CheckBox Content="轴线交点" IsChecked="{Binding DrawAAPs}" />
                    <CheckBox Content="基础轴线交点" IsChecked="{Binding DrawBAPs}" />
                    <CheckBox Content="螺栓点" IsChecked="{Binding DrawABs}" />
                    <CheckBox Content="钢板点" IsChecked="{Binding DrawSteelPlatePs}" />
                </UniformGrid>
                <Separator Margin="0,5"/>

                <!-- 聚类图形 -->
                <TextBlock Text="聚类图形" Foreground="LightGray" Margin="0,5,0,2"/>
                <UniformGrid Columns="2">
                    <CheckBox Content="X向绘制" IsChecked="{Binding DrawClusterX}" />
                    <CheckBox Content="Y向绘制" IsChecked="{Binding DrawClusterY}" />                    
                    <CheckBox Content="外包矩形" IsChecked="{Binding DrawClusterEnvelopePolyline}" />
                    <CheckBox Content="扩展外包矩形" IsChecked="{Binding DrawClusterExpandedEnvelope}" />
                    <CheckBox Content="凸包" IsChecked="{Binding DrawClusterHull}" />
                    <CheckBox Content="交点" IsChecked="{Binding DrawClusterPts}" />
                </UniformGrid>
                <Separator Margin="0,5"/>

                <!-- 标注 -->
                <TextBlock Text="标注" Foreground="LightGray" Margin="0,5,0,2"/>
                <UniformGrid Columns="2">
                    <CheckBox Content="标注X" IsChecked="{Binding DrawDimX}" />
                    <CheckBox Content="标注Y" IsChecked="{Binding DrawDimY}" />
                </UniformGrid>
                <Separator Margin="0,5"/>

                <!-- 辅助图形 -->
                <TextBlock Text="辅助构件" Foreground="LightGray" Margin="0,5,0,2"/>
                <UniformGrid Columns="2">
                    <CheckBox Content="轴线圆" IsChecked="{Binding DrawAxisCircle}" />
                    <CheckBox Content="轴线文字" IsChecked="{Binding DrawAxisText}" />
                    <CheckBox Content="区域框" IsChecked="{Binding DrawRegionFrame}" />
                    <CheckBox Content="区域文字" IsChecked="{Binding DrawRegionText}" />
                </UniformGrid>

            </StackPanel>
        </Expander>

    </StackPanel>
</UserControl>
