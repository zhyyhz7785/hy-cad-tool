<Window x:Class="HyCADTool.Refactored.Presentation.Commands.HyovSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HYOV 参数设置" Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 参数设置区域 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- 绘图单位选择 -->
                <GroupBox Header="绘图单位" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="当前单位：" Width="150" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbDrawingUnit" Width="200" SelectionChanged="CmbDrawingUnit_SelectionChanged">
                                <ComboBoxItem Content="毫米 (mm)" Tag="Millimeter" IsSelected="True"/>
                                <ComboBoxItem Content="米 (m)" Tag="Meter"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="切换单位时，所有参数值将自动换算（1m = 1000mm）" Margin="150,0,0,5" Foreground="DarkOrange" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </GroupBox>
                
                <!-- OVERKILL 基础清理 -->
                <GroupBox Header="OVERKILL 基础清理" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="chkEnablePreClean" Content="启用预清理（合并重叠和平行线）" IsChecked="True" Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="几何容差：" Width="150" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtGeometricTolerance" Width="100" Text="0.000001"/>
                            <TextBlock Text=" (推荐 1e-6)" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="平行线合并距离：" Width="150" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtParallelMergeDistance" Width="100" Text="1.0"/>
                            <TextBlock Text=" (单位)" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- FILLET 自动连接 -->
                <GroupBox Header="FILLET 自动连接" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="chkEnableBreakLines" Content="启用打断相交线段" IsChecked="True" Margin="0,0,0,5"/>
                        <CheckBox x:Name="chkEnableExtendEndpoints" Content="启用端点延伸" IsChecked="True" Margin="0,0,0,5"/>
                        <CheckBox x:Name="chkEnableExtendToLine" Content="启用端点到线延伸" IsChecked="True" Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="最小线段长度：" Width="150" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtMinLineLength" Width="100" Text="5.0"/>
                            <TextBlock Text=" (单位)" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                        <TextBlock Text="长度 &lt; 此值的线段将被删除，≥ 此值的线段将被保留" Margin="150,0,0,5" Foreground="Gray" FontSize="11"/>
                        <TextBlock Text="（推荐：mm单位 5.0，m单位 0.005）" Margin="150,0,0,5" Foreground="DarkOrange" FontSize="11" FontWeight="Bold"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                            <TextBlock Text="端点延伸最大距离：" Width="150" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtMaxExtendDistance" Width="100" Text="10.0"/>
                            <TextBlock Text=" (单位)" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                        <TextBlock Text="端点距离小于此值时自动延伸连接" Margin="150,0,0,5" Foreground="Gray" FontSize="11"/>
                    </StackPanel>
                </GroupBox>

                <!-- 独立端点标记 -->
                <GroupBox Header="独立端点标记" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="chkShowIndependentEndpoints" Content="显示独立端点标记" IsChecked="True" Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="端点检测容差：" Width="150" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtIndependentEndpointTolerance" Width="100" Text="1.0"/>
                            <TextBlock Text=" (单位)" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                        <TextBlock Text="距离小于此值的端点视为连接" Margin="150,0,0,5" Foreground="Gray" FontSize="11"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                            <TextBlock Text="标记缩放倍数：" Width="150" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtMarkerScale" Width="100" Text="20.0"/>
                            <TextBlock Text=" (倍)" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                        <TextBlock Text="标记显示大小（基准：长10，宽3）" Margin="150,0,0,5" Foreground="Gray" FontSize="11"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnReset" Content="重置默认" Width="80" Height="30" Margin="0,0,10,0" Click="BtnReset_Click"/>
            <Button x:Name="btnOK" Content="确定" Width="80" Height="30" Margin="0,0,10,0" IsDefault="True" Click="BtnOK_Click"/>
            <Button x:Name="btnCancel" Content="取消" Width="80" Height="30" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>






