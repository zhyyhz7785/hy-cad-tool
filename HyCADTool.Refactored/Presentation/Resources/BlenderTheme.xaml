<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
    ============================================================
     BlenderTheme.xaml  —  HyCAD 面板用 Blender 4.x 深色主题资源字典
    ============================================================
     所有颜色画刷以 Brush_ 前缀命名，便于 Find/Replace 升级。
     数值（字号/圆角/行高）以 Metric_ 前缀命名。
     全部通过 DynamicResource 引用，便于后续切亮色主题。
    -->

    <!--#region 颜色画刷 Color Brushes -->

    <!-- 窗口 / 编辑器 / 侧边栏 / 分组面板 -->
    <SolidColorBrush x:Key="Brush_WindowBack"        Color="#303030"/>
    <SolidColorBrush x:Key="Brush_HeaderBack"        Color="#292929"/>
    <SolidColorBrush x:Key="Brush_RegionBack"        Color="#353535"/>
    <SolidColorBrush x:Key="Brush_PanelBack"         Color="#393939"/>
    <SolidColorBrush x:Key="Brush_PanelSubBack"      Color="#303030"/>
    <SolidColorBrush x:Key="Brush_PanelHeaderBack"   Color="#424242"/>
    <SolidColorBrush x:Key="Brush_BorderDark"        Color="#232323"/>
    <SolidColorBrush x:Key="Brush_BorderMid"         Color="#2E2E2E"/>

    <!-- 标签 / 选中高亮 -->
    <SolidColorBrush x:Key="Brush_TabInactive"       Color="#1F1F1F"/>
    <SolidColorBrush x:Key="Brush_AccentBlue"        Color="#4772B3"/>
    <SolidColorBrush x:Key="Brush_AccentBlueHover"   Color="#5680C2"/>

    <!-- 按钮 -->
    <SolidColorBrush x:Key="Brush_ButtonIdle"        Color="#545454"/>
    <SolidColorBrush x:Key="Brush_ButtonHover"       Color="#5680C2"/>
    <SolidColorBrush x:Key="Brush_ButtonPressed"     Color="#4772B3"/>
    <SolidColorBrush x:Key="Brush_ButtonBorder"      Color="#1F1F1F"/>

    <!-- 输入 / 复选 -->
    <SolidColorBrush x:Key="Brush_InputBack"         Color="#585858"/>
    <SolidColorBrush x:Key="Brush_InputBorder"       Color="#1F1F1F"/>
    <SolidColorBrush x:Key="Brush_InputFocusBorder"  Color="#5680C2"/>
    <SolidColorBrush x:Key="Brush_CheckboxBack"      Color="#3F3F3F"/>
    <SolidColorBrush x:Key="Brush_CheckboxChecked"   Color="#4772B3"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="Brush_TextPrimary"       Color="#E6E6E6"/>
    <SolidColorBrush x:Key="Brush_TextSecondary"     Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Brush_TextDisabled"      Color="#707070"/>
    <SolidColorBrush x:Key="Brush_TextOnAccent"      Color="#FFFFFF"/>

    <!-- 强调色 -->
    <SolidColorBrush x:Key="Brush_Warning"           Color="#E5734E"/>
    <SolidColorBrush x:Key="Brush_Success"           Color="#A3BE8C"/>

    <!-- 滚动条 -->
    <SolidColorBrush x:Key="Brush_ScrollThumb"       Color="#4A4A4A"/>
    <SolidColorBrush x:Key="Brush_ScrollThumbHover"  Color="#5A5A5A"/>
    <SolidColorBrush x:Key="Brush_ScrollTrack"       Color="#2A2A2A"/>

    <!-- Expander 头条 -->
    <SolidColorBrush x:Key="Brush_ExpanderHeader"       Color="#424242"/>
    <SolidColorBrush x:Key="Brush_ExpanderHeaderHover"  Color="#4A4A4A"/>

    <!-- ListBox / Selector 高亮 -->
    <SolidColorBrush x:Key="Brush_ItemHover"         Color="#3E3E3E"/>
    <SolidColorBrush x:Key="Brush_ItemSelected"      Color="#4772B3"/>
    <SolidColorBrush x:Key="Brush_ItemSelectedText"  Color="#FFFFFF"/>

    <!--#endregion-->

    <!--#region 度量值 Metrics -->

    <sys:Double x:Key="Metric_FontMain">12</sys:Double>
    <sys:Double x:Key="Metric_FontSmall">11</sys:Double>
    <sys:Double x:Key="Metric_FontHeader">12</sys:Double>
    <sys:Double x:Key="Metric_RowHeight">22</sys:Double>
    <sys:Double x:Key="Metric_ExpanderHeight">24</sys:Double>
    <sys:Double x:Key="Metric_IconBarWidth">32</sys:Double>
    <sys:Double x:Key="Metric_IconSize">20</sys:Double>
    <CornerRadius x:Key="Metric_CornerRadius">3</CornerRadius>
    <CornerRadius x:Key="Metric_CornerRadiusSmall">2</CornerRadius>
    <Thickness x:Key="Metric_ButtonPadding">8,3</Thickness>
    <Thickness x:Key="Metric_InputPadding">6,2</Thickness>

    <FontFamily x:Key="Font_Main">Microsoft YaHei UI, Segoe UI</FontFamily>

    <!--#endregion-->

    <!--#region TextBlock / Label -->

    <Style TargetType="{x:Type TextBlock}" x:Key="BlenderText">
        <Setter Property="Foreground" Value="{DynamicResource Brush_TextPrimary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font_Main}"/>
        <Setter Property="FontSize"   Value="{DynamicResource Metric_FontMain}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="{x:Type Label}" x:Key="BlenderLabel">
        <Setter Property="Foreground" Value="{DynamicResource Brush_TextSecondary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font_Main}"/>
        <Setter Property="FontSize"   Value="{DynamicResource Metric_FontSmall}"/>
        <Setter Property="Padding"    Value="0"/>
    </Style>

    <!--#endregion-->

    <!--#region Button -->

    <Style TargetType="{x:Type Button}" x:Key="BlenderButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush_TextPrimary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font_Main}"/>
        <Setter Property="FontSize"   Value="{DynamicResource Metric_FontMain}"/>
        <Setter Property="Background" Value="{DynamicResource Brush_ButtonIdle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush_ButtonBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{DynamicResource Metric_ButtonPadding}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Metric_CornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush_ButtonHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush_ButtonPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush_TextDisabled}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 小尺寸扁平按钮（用于命令列表行内） -->
    <Style TargetType="{x:Type Button}" x:Key="BlenderButtonFlat" BasedOn="{StaticResource BlenderButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!--#endregion-->

    <!--#region ToggleButton -->

    <Style TargetType="{x:Type ToggleButton}" x:Key="BlenderToggleButton" BasedOn="{StaticResource BlenderButton}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush_AccentBlue}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush_TextOnAccent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--#endregion-->

    <!--#region TextBox -->

    <Style TargetType="{x:Type TextBox}" x:Key="BlenderTextBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush_TextPrimary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font_Main}"/>
        <Setter Property="FontSize"   Value="{DynamicResource Metric_FontMain}"/>
        <Setter Property="Background" Value="{DynamicResource Brush_InputBack}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush_InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush_TextPrimary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush_AccentBlue}"/>
        <Setter Property="Padding" Value="{DynamicResource Metric_InputPadding}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Metric_CornerRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_InputFocusBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush_TextDisabled}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--#endregion-->

    <!--#region CheckBox -->

    <Style TargetType="{x:Type CheckBox}" x:Key="BlenderCheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush_TextPrimary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font_Main}"/>
        <Setter Property="FontSize"   Value="{DynamicResource Metric_FontMain}"/>
        <Setter Property="Background" Value="{DynamicResource Brush_CheckboxBack}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush_InputBorder}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="14" Height="14" Margin="0,0,6,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Metric_CornerRadiusSmall}"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Tick"
                                  Stroke="{DynamicResource Brush_TextOnAccent}" StrokeThickness="1.6"
                                  Data="M 2,6 L 5,9 L 11,3"
                                  SnapsToDevicePixels="True"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box"  Property="Background" Value="{DynamicResource Brush_CheckboxChecked}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush_AccentBlueHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush_TextDisabled}"/>
                            <Setter TargetName="Box" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--#endregion-->

    <!--#region ComboBox -->

    <Style TargetType="{x:Type ComboBox}" x:Key="BlenderComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush_TextPrimary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font_Main}"/>
        <Setter Property="FontSize"   Value="{DynamicResource Metric_FontMain}"/>
        <Setter Property="Background" Value="{DynamicResource Brush_InputBack}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush_InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{DynamicResource Metric_InputPadding}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>


    <!--#endregion-->

    <!--#region ScrollBar (8px 窄滚动条) -->

    <Style x:Key="BlenderScrollRepeatButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BlenderScrollThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Bd" Margin="2"
                            Background="{DynamicResource Brush_ScrollThumb}"
                            CornerRadius="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush_ScrollThumbHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}" x:Key="BlenderScrollBar">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource Brush_ScrollTrack}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource BlenderScrollRepeatButton}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource BlenderScrollRepeatButton}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource BlenderScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!--#endregion-->

    <!--#region Expander -->

    <Style TargetType="{x:Type Expander}" x:Key="BlenderExpander">
        <Setter Property="Foreground" Value="{DynamicResource Brush_TextPrimary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font_Main}"/>
        <Setter Property="FontSize"   Value="{DynamicResource Metric_FontHeader}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsExpanded" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="ContentRow" Height="*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="Header" Grid.Row="0"
                                Height="{DynamicResource Metric_ExpanderHeight}"
                                Background="{DynamicResource Brush_ExpanderHeader}"
                                CornerRadius="{DynamicResource Metric_CornerRadius}"
                                SnapsToDevicePixels="True">
                            <ToggleButton x:Name="HeaderBtn"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent"
                                          Foreground="{DynamicResource Brush_TextPrimary}"
                                          Cursor="Hand" Focusable="False"
                                          HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="{TemplateBinding Background}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,6,0">
                                                <TextBlock x:Name="Arrow" Text="▼"
                                                           Width="12" FontSize="10"
                                                           Foreground="{DynamicResource Brush_TextSecondary}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ContentPresenter ContentSource="Content" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Arrow" Property="Text" Value="▶"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </ToggleButton>
                        </Border>
                        <Border x:Name="Content" Grid.Row="1" Margin="0,2,0,6"
                                Visibility="Collapsed"
                                Background="{DynamicResource Brush_PanelBack}"
                                CornerRadius="{DynamicResource Metric_CornerRadius}">
                            <ContentPresenter Margin="6"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Content" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger SourceName="HeaderBtn" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Header" Property="Background" Value="{DynamicResource Brush_ExpanderHeaderHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--#endregion-->

    <!--#region ListBox / ListBoxItem -->

    <Style TargetType="{x:Type ListBoxItem}" x:Key="BlenderListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush_TextPrimary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font_Main}"/>
        <Setter Property="FontSize"   Value="{DynamicResource Metric_FontMain}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush_ItemHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush_ItemSelected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush_ItemSelectedText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="{x:Type ListBox}" x:Key="BlenderListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush_TextPrimary}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>


    <!--#endregion-->

    <!--#region Separator -->

    <Style TargetType="{x:Type Separator}" x:Key="BlenderSeparator">
        <Setter Property="Background" Value="{DynamicResource Brush_BorderDark}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Rectangle Fill="{TemplateBinding Background}" Height="1" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--#endregion-->

    <!--#region GroupBox -->

    <Style TargetType="{x:Type GroupBox}" x:Key="BlenderGroupBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush_TextPrimary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font_Main}"/>
        <Setter Property="FontSize"   Value="{DynamicResource Metric_FontMain}"/>
        <Setter Property="Background" Value="{DynamicResource Brush_PanelBack}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush_BorderDark}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
    </Style>


    <!--#endregion-->

</ResourceDictionary>
