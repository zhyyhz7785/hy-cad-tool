<UserControl x:Class="HyCADTool.Refactored.Presentation.Views.HyBlenderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:HyCADTool.Refactored.Presentation.Views"
             xmlns:vm="clr-namespace:HyCADTool.Refactored.Presentation.ViewModels"
             mc:Ignorable="d"
             Background="{DynamicResource Brush_WindowBack}"
             d:DesignHeight="650" d:DesignWidth="320"
             d:DataContext="{d:DesignInstance Type=vm:HyBlenderPanelViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool.Refactored;component/Presentation/Resources/BlenderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 左侧图标 Tab 项模板 -->
            <Style x:Key="IconTabItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush_TextSecondary}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Grid x:Name="Root" Height="32" Background="{TemplateBinding Background}">
                                <Border x:Name="ActiveBar" Width="3" HorizontalAlignment="Left"
                                        Background="{DynamicResource Brush_AccentBlue}"
                                        Visibility="Collapsed"/>
                                <TextBlock x:Name="IconText"
                                           Text="{Binding Icon}"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           ToolTip="{Binding Name}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush_ItemHover}"/>
                                    <Setter TargetName="IconText" Property="Foreground" Value="{DynamicResource Brush_TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush_RegionBack}"/>
                                    <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="IconText" Property="Foreground" Value="{DynamicResource Brush_TextPrimary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CommandRowButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BlenderButtonFlat}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Height" Value="{DynamicResource Metric_RowHeight}"/>
                <Setter Property="Margin" Value="0,1"/>
            </Style>

            <DataTemplate x:Key="CommandItemTemplate" DataType="{x:Type vm:CommandItemVm}">
                <Button Style="{StaticResource CommandRowButton}"
                        Command="{Binding ExecuteCommand}"
                        ToolTip="{Binding Tooltip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                   Foreground="{DynamicResource Brush_TextPrimary}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding Key}"
                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                   FontSize="11"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </DataTemplate>

            <Style x:Key="SearchClearButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush_TextSecondary}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid Background="Transparent">
                                <TextBlock Text="×" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush_TextPrimary}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧：图标 Tab ListBox ===== -->
        <Border Grid.Column="0" Background="{DynamicResource Brush_HeaderBack}">
            <ListBox x:Name="CategoryList"
                     ItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource IconTabItemStyle}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- ===== 右侧内容区 ===== -->
        <Grid Grid.Column="1" Background="{DynamicResource Brush_RegionBack}">

            <!-- ========== 模式 1：设置面板（IsPreferencesMode=True） ========== -->
            <views:HyPreferencesView DataContext="{Binding PreferencesVm}">
                <views:HyPreferencesView.Style>
                    <Style TargetType="{x:Type views:HyPreferencesView}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsPreferencesMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:HyPreferencesView.Style>
            </views:HyPreferencesView>

            <!-- ========== 模式 2：命令列表（IsPreferencesMode=False） ========== -->
        <Grid>
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPreferencesMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部搜索框 -->
            <Border Grid.Row="0" Padding="6,4" Background="{DynamicResource Brush_HeaderBack}">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource BlenderTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             Height="24"
                             VerticalContentAlignment="Center"
                             Padding="22,0,22,0"/>
                    <TextBlock Text="🔍"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource Brush_TextSecondary}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               FontSize="11"/>
                    <TextBlock Text="搜索命令…"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource Brush_TextDisabled}"
                               VerticalAlignment="Center"
                               Margin="24,0,0,0"
                               FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            Click="OnClearSearchClick">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SearchClearButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 中部内容：搜索中显示全局扁平列表，否则显示当前分类列表 -->
            <Grid Grid.Row="1">
                <!-- 状态 A：搜索中 → 全局扁平结果 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="{x:Type ScrollViewer}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="6,4">
                        <TextBlock Text="搜索结果（全部分类）"
                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                   FontSize="11"
                                   Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding GlobalSearchResults}"
                                      ItemTemplate="{StaticResource CommandItemTemplate}"/>
                        <TextBlock Text="（无匹配命令）"
                                   Foreground="{DynamicResource Brush_TextDisabled}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GlobalSearchResults.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- 状态 B：正常浏览 → 当前 Tab 的命令列表 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="{x:Type ScrollViewer}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="6,4">
                        <Expander Style="{StaticResource BlenderExpander}" IsExpanded="True">
                            <Expander.Header>
                                <TextBlock Text="{Binding SelectedTab.Name}" FontWeight="SemiBold"/>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding FilteredItems}"
                                          ItemTemplate="{StaticResource CommandItemTemplate}"/>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 底部状态条 -->
            <Border Grid.Row="2" Background="{DynamicResource Brush_HeaderBack}" Height="20">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource Brush_TextSecondary}"
                           FontSize="11"
                           Margin="8,0,8,0"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</UserControl>
