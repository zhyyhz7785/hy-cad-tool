<Window x:Class="HyCADTool.Refactored.Presentation.Views.SettlementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helper="clr-namespace:HyCADTool.Refactored.Presentation.Views.Helpers"
        xmlns:conv="clr-namespace:HyCADTool.Refactored.Presentation.Views.Converters"
        xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
        Title="基础沉降计算"
        Width="1060" Height="740"
        MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Brush_WindowBack}"
        Foreground="{DynamicResource Brush_TextPrimary}"
        btmetrics:BlenderMetricsOverlay.Attach="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{DynamicResource Metric_ButtonHeight}" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool.Refactored;component/Presentation/Resources/LibraryResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HyCADTool.Refactored;component/Presentation/Resources/BlenderTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:StringNotEmptyToVisibilityConverter x:Key="StringToVis" />

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#88c0d0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,6,0,4" />
            </Style>

            <Style x:Key="ParamLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#d8dee9" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="DarkDataGridColumnHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#3b4453" />
                <Setter Property="Foreground" Value="#88c0d0" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="BorderBrush" Value="#4c566a" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="11" />
            </Style>

            <Style x:Key="DarkDataGrid" TargetType="DataGrid">
                <Setter Property="Background" Value="#2e3440" />
                <Setter Property="Foreground" Value="#d8dee9" />
                <Setter Property="RowBackground" Value="#2e3440" />
                <Setter Property="AlternatingRowBackground" Value="#353d4a" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="#444" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#4c566a" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource DarkDataGridColumnHeader}" />
            </Style>

            <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="MinWidth" Value="50" />
            </Style>

            <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="16,6" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinWidth" Value="80" />
            </Style>

            <Style x:Key="TitleBarBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#d8dee9" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3b4453" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseTitleBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#bf616a" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ElevationTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="helper:TextBoxHelper.EnableCustomHandlers" Value="True" />
                <Style.Triggers>
                    <Trigger Property="IsReadOnly" Value="True">
                        <Setter Property="Opacity" Value="0.45" />
                        <Setter Property="Background" Value="#2a2e38" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ToggleSection" TargetType="CheckBox">
                <Setter Property="Foreground" Value="#88c0d0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,8,0,4" />
            </Style>

            <!-- 结果摘要：只读、可选中复制 -->
            <Style x:Key="SummaryCopyTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="helper:TextBoxHelper.EnableCustomHandlers" Value="True" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#d8dee9" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextBlock.LineHeight" Value="17" />
                <Setter Property="Padding" Value="2,6" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="CaretBrush" Value="#88c0d0" />
                <Setter Property="MinLines" Value="8" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#4c566a" BorderThickness="1">
        <DockPanel>

            <!-- ===== 自定义标题栏 ===== -->
            <Border DockPanel.Dock="Top" Background="#1e222a" Height="{DynamicResource Metric_ButtonHeight}">
                <Grid>
                    <TextBlock Text="基础沉降计算" Foreground="#d8dee9" FontSize="{DynamicResource Metric_FontHeader}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="—" Style="{StaticResource TitleBarBtn}" Click="BtnMinimize_Click" />
                        <Button Content="□" Style="{StaticResource TitleBarBtn}" Click="BtnMaximize_Click" />
                        <Button Content="✕" Style="{StaticResource CloseTitleBtn}" Click="BtnClose_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 底部按钮行 ===== -->
            <Border DockPanel.Dock="Bottom" Background="#3b4453" Padding="{DynamicResource Metric_Padding_8_6}"
                    BorderBrush="#4c566a" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="恢复默认" Style="{StaticResource ActionBtn}"
                                Command="{Binding ResetCommand}" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#a3be8c" FontSize="{DynamicResource Metric_FontSmall}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="350"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="计算" Style="{StaticResource ActionBtn}"
                                Command="{Binding CalculateCommand}" />
                        <Button Content="计算书" Style="{StaticResource ActionBtn}"
                                Click="BtnReport_Click" />
                        <Button Content="导出Word" Style="{StaticResource ActionBtn}"
                                Click="BtnExportWord_Click" />
                        <Button Content="绘制表格" Style="{StaticResource ActionBtn}"
                                Click="BtnDrawTable_Click" />
                        <Button Content="关闭" Style="{StaticResource ActionBtn}"
                                Click="BtnClose_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 三列主体 ===== -->
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="250" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="270" MinWidth="220" />
                </Grid.ColumnDefinitions>

                <!-- ========== 左列：示意图 + 复合/桩开关 ========== -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 基础截面示意图 -->
                    <Border Grid.Row="0" Background="#353d4a" CornerRadius="4" Padding="{DynamicResource Metric_Padding_6}" Margin="0,0,0,4">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="220">
                            <Canvas Width="170" Height="260" ClipToBounds="True">
                                <TextBlock Canvas.Left="60" Canvas.Top="8" Text="F + G"
                                           Foreground="#bf616a" FontSize="{DynamicResource Metric_FontMain}" FontWeight="SemiBold" />
                                <Line X1="85" Y1="25" X2="85" Y2="82" Stroke="#bf616a" StrokeThickness="1.5" />
                                <Polygon Points="80,82 90,82 85,90" Fill="#bf616a" />
                                <Line X1="0" Y1="90" X2="170" Y2="90" Stroke="#a3be8c" StrokeThickness="2" />
                                <TextBlock Canvas.Left="125" Canvas.Top="74" Text="±0.000" Foreground="#a3be8c" FontSize="{DynamicResource Metric_FontMicro}" />
                                <Line X1="5" Y1="95" X2="15" Y2="88" Stroke="#4c566a" StrokeThickness="0.7" />
                                <Line X1="20" Y1="95" X2="30" Y2="88" Stroke="#4c566a" StrokeThickness="0.7" />
                                <Line X1="35" Y1="95" X2="42" Y2="90" Stroke="#4c566a" StrokeThickness="0.7" />
                                <Line X1="128" Y1="95" X2="135" Y2="90" Stroke="#4c566a" StrokeThickness="0.7" />
                                <Line X1="140" Y1="95" X2="150" Y2="88" Stroke="#4c566a" StrokeThickness="0.7" />
                                <Line X1="155" Y1="95" X2="165" Y2="88" Stroke="#4c566a" StrokeThickness="0.7" />
                                <Polygon Points="42,90 128,90 118,155 52,155" Stroke="#88c0d0" StrokeThickness="1.5" Fill="#434c5e" />
                                <Line X1="52" Y1="160" X2="118" Y2="160" Stroke="#808080" StrokeThickness="0.8" />
                                <Line X1="52" Y1="155" X2="52" Y2="165" Stroke="#808080" StrokeThickness="0.5" />
                                <Line X1="118" Y1="155" X2="118" Y2="165" Stroke="#808080" StrokeThickness="0.5" />
                                <TextBlock Canvas.Left="79" Canvas.Top="160" Text="b" Foreground="#d8dee9" FontSize="{DynamicResource Metric_FontCaption}" FontStyle="Italic" />
                                <Line X1="135" Y1="90" X2="135" Y2="155" Stroke="#d08770" StrokeThickness="0.8" />
                                <Line X1="130" Y1="90" X2="140" Y2="90" Stroke="#d08770" StrokeThickness="0.5" />
                                <Line X1="130" Y1="155" X2="140" Y2="155" Stroke="#d08770" StrokeThickness="0.5" />
                                <TextBlock Canvas.Left="140" Canvas.Top="115" Text="dh" Foreground="#d08770" FontSize="{DynamicResource Metric_FontCaption}" FontStyle="Italic" />
                                <Line X1="0" Y1="200" X2="170" Y2="200" Stroke="#5e81ac" StrokeThickness="1" StrokeDashArray="6,3" />
                                <TextBlock Canvas.Left="5" Canvas.Top="203" Text="地下水位" Foreground="#5e81ac" FontSize="{DynamicResource Metric_FontMicro}" />
                                <Rectangle Canvas.Left="0" Canvas.Top="91" Width="170" Height="170" Opacity="0.15">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#a3be8c" Offset="0" />
                                            <GradientStop Color="#5e81ac" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <!-- 基础子类型 + 复合/桩基开关区 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource SmallScrollViewer}">
                        <StackPanel Margin="2,0,0,0">

                            <!-- 基础子类型 -->
                            <TextBlock Text="基础子类型" Style="{StaticResource SectionHeader}" />
                            <Border Background="#353d4a" CornerRadius="3" Padding="{DynamicResource Metric_Padding_6_4}" Margin="0,0,0,4">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Content="独立基础" GroupName="FoundSubtype"
                                                     IsChecked="{Binding IsIsolatedFoundation}"
                                                     Foreground="#d8dee9" FontSize="{DynamicResource Metric_FontSmall}" VerticalContentAlignment="Center" />
                                        <RadioButton Grid.Column="1" Content="箱型基础" GroupName="FoundSubtype"
                                                     IsChecked="{Binding IsBoxFoundation}"
                                                     Foreground="#d8dee9" FontSize="{DynamicResource Metric_FontSmall}" VerticalContentAlignment="Center" />
                                    </Grid>
                                    <Grid Margin="0,4,0,0"
                                          Visibility="{Binding IsBoxFoundation, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="折算厚(m)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding BoxConcreteThickness, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                    </Grid>
                                    <TextBlock Foreground="#808080" FontSize="{DynamicResource Metric_FontMicro}" Margin="0,3,0,0"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="独基: G=γm·A·(d−Δh/2), p₀=(F+G)/A−γm·d" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBoxFoundation}" Value="True">
                                                        <Setter Property="Text" Value="箱型: G=γc·tc·A, p₀=(F+G)/A−γm·d" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- 复合地基 -->
                            <CheckBox Style="{StaticResource ToggleSection}"
                                      Content="复合地基" IsChecked="{Binding IsCompositeEnabled}" />
                            <Border Background="#353d4a" CornerRadius="3" Padding="{DynamicResource Metric_Padding_6_4}" Margin="0,0,0,4"
                                    Visibility="{Binding IsCompositeEnabled, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="fspk(kPa)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding CompositeBearingCapacity, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="加固深(m)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding TreatedDepth, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                    </Grid>
                                    <TextBlock Foreground="#88c0d0" FontSize="{DynamicResource Metric_FontCaption}" Margin="0,3,0,0">
                                        <Run Text="ξ = fspk/fak = " />
                                        <Run Text="{Binding CompositeXi, Mode=OneWay, StringFormat=F3}" />
                                    </TextBlock>
                                    <!-- 承载力验算参数 -->
                                    <TextBlock Text="─ 承载力验算(§7.1.5) ─" Foreground="#5e81ac" FontSize="{DynamicResource Metric_FontCaption}"
                                               HorizontalAlignment="Center" Margin="0,6,0,2" />
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="λ" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                        <TextBox Grid.Column="1" Text="{Binding CompLambda, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                        <TextBlock Grid.Column="2" Text="β" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" Margin="4,0,0,0" />
                                        <TextBox Grid.Column="3" Text="{Binding CompBeta, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="fsk" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                        <TextBox Grid.Column="1" Text="{Binding CompFsk, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                        <TextBlock Grid.Column="2" Text="fcu" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" Margin="4,0,0,0" />
                                        <TextBox Grid.Column="3" Text="{Binding CompFcu, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="αp" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                        <TextBox Grid.Column="1" Text="{Binding CompAlphaP, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                        <TextBlock Grid.Column="2" Text="qp" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" Margin="4,0,0,0" />
                                        <TextBox Grid.Column="3" Text="{Binding CompQp, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="桩径m" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                        <TextBox Grid.Column="1" Text="{Binding CompPileDiameter, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                        <TextBlock Grid.Column="2" Text="桩距m" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" Margin="4,0,0,0" />
                                        <TextBox Grid.Column="3" Text="{Binding CompPileSpacing, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                    </Grid>
                                    <TextBlock Text="侧阻力(每行:名称,厚度,qsi)" Foreground="#888" FontSize="{DynamicResource Metric_FontMicro}" Margin="0,3,0,1" />
                                    <TextBox Text="{Binding CompSideResistanceText, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="36" MaxHeight="80" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" FontSize="{DynamicResource Metric_FontCaption}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                </StackPanel>
                            </Border>

                            <!-- 桩基础 -->
                            <CheckBox Style="{StaticResource ToggleSection}"
                                      Content="桩基础" IsChecked="{Binding IsPileEnabled}" />
                            <Border Background="#353d4a" CornerRadius="3" Padding="{DynamicResource Metric_Padding_6_4}"
                                    Visibility="{Binding IsPileEnabled, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="桩长m" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                        <TextBox Grid.Column="1" Text="{Binding PileLength, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                        <TextBlock Grid.Column="2" Text="桩径m" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" Margin="4,0,0,0" />
                                        <TextBox Grid.Column="3" Text="{Binding PileDiameter, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="桩距m" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                        <TextBox Grid.Column="1" Text="{Binding PileSpacing, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                        <TextBlock Grid.Column="2" Text="桩数" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" Margin="4,0,0,0" />
                                        <TextBox Grid.Column="3" Text="{Binding TotalPileCount, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="台长m" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                        <TextBox Grid.Column="1" Text="{Binding CapLength, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                        <TextBlock Grid.Column="2" Text="台宽m" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" Margin="4,0,0,0" />
                                        <TextBox Grid.Column="3" Text="{Binding CapWidth, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                    </Grid>
                                    <!-- 承载力验算参数 -->
                                    <TextBlock Text="─ 承载力验算(§5.2~5.4) ─" Foreground="#5e81ac" FontSize="{DynamicResource Metric_FontCaption}"
                                               HorizontalAlignment="Center" Margin="0,6,0,2" />
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="qp(kPa)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                        <TextBox Grid.Column="1" Text="{Binding PileQp, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                        <TextBlock Grid.Column="2" Text="Nk(kN)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" Margin="4,0,0,0" />
                                        <TextBox Grid.Column="3" Text="{Binding PileNk, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                    </Grid>
                                    <TextBlock Text="侧阻力(每行:名称,厚度,qsi,土类)" Foreground="#888" FontSize="{DynamicResource Metric_FontMicro}" Margin="0,3,0,1" />
                                    <TextBox Text="{Binding PileSideResistanceText, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="36" MaxHeight="80" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" FontSize="{DynamicResource Metric_FontCaption}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                    <!-- 桩身结构验算参数 -->
                                    <TextBlock Text="─ 桩身结构(§5.8~5.9) ─" Foreground="#5e81ac" FontSize="{DynamicResource Metric_FontCaption}"
                                               HorizontalAlignment="Center" Margin="0,6,0,2" />
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="N(kN)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                        <TextBox Grid.Column="1" Text="{Binding PileAxialForceDesign, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                        <TextBlock Grid.Column="2" Text="ψc" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" Margin="4,0,0,0" />
                                        <TextBox Grid.Column="3" Text="{Binding PilePsiC, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="fc(kPa)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                        <TextBox Grid.Column="1" Text="{Binding PileFc, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                        <TextBlock Grid.Column="2" Text="As(mm²)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" Margin="4,0,0,0" />
                                        <TextBox Grid.Column="3" Text="{Binding PileSteelArea, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 左-中 GridSplitter -->
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" Background="#4c566a" />

                <!-- ========== 中列：上(输入) + 下(输出) ========== -->
                <Grid Grid.Column="2" Margin="4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="180" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <!-- 上半：地层输入 -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}"
                                   Text="地层数据（粘贴 Markdown 表格）" />

                        <TextBox Grid.Row="1"
                                 Text="{Binding SoilLayerMarkdown, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap" MinLines="2" MaxLines="4"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="{DynamicResource Metric_FontSmall}"
                                 Background="#2e3440" Foreground="#d8dee9"
                                 BorderBrush="#4c566a" BorderThickness="1" Padding="{DynamicResource Metric_Padding_4}" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,3">
                            <Button Content="解析表格" Style="{StaticResource SmallBtn}"
                                    Command="{Binding ParseTableCommand}" />
                            <TextBlock Foreground="#808080" FontSize="{DynamicResource Metric_FontMicro}" VerticalAlignment="Center"
                                       Margin="6,0,0,0"
                                       Text="格式：| 编号 | 名称 | 厚度(m) | Es(MPa) | 描述 |" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,3">
                            <Button Content="增加" Style="{StaticResource SmallBtn}" Command="{Binding AddLayerCommand}" />
                            <Button Content="删除" Style="{StaticResource SmallBtn}" Command="{Binding DeleteLayerCommand}" />
                            <Button Content="上移" Style="{StaticResource SmallBtn}" Command="{Binding MoveLayerUpCommand}" />
                            <Button Content="下移" Style="{StaticResource SmallBtn}" Command="{Binding MoveLayerDownCommand}" />
                        </StackPanel>

                        <DataGrid Grid.Row="4" Style="{StaticResource DarkDataGrid}"
                                  ItemsSource="{Binding ParsedSoilLayers}"
                                  SelectedIndex="{Binding SelectedSoilLayerIndex}"
                                  IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="40" />
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="62" />
                                <DataGridTextColumn Header="厚(m)" Binding="{Binding Thickness, StringFormat=F2}" Width="48" />
                                <DataGridTextColumn Header="Es" Binding="{Binding Es, StringFormat=F1}" Width="42" />
                                <DataGridTextColumn Header="Eci" Binding="{Binding Eci, StringFormat=F1}" Width="42" />
                                <DataGridTextColumn Header="fak" Binding="{Binding Fak, StringFormat=F0}" Width="40" />
                                <DataGridTextColumn Header="γ" Binding="{Binding Gamma, StringFormat=F1}" Width="36" />
                                <DataGridTextColumn Header="qsik" Binding="{Binding Qsik, StringFormat=F0}" Width="40" />
                                <DataGridTextColumn Header="qpk" Binding="{Binding Qpk, StringFormat=F0}" Width="42" />
                                <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- 上-下 GridSplitter -->
                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center" Background="#4c566a" Margin="0,2" />

                    <!-- 下半：计算结果（三段摘要 + 表格） -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <!-- Auto + MinHeight：避免只读多行 TextBox 测量高度过小导致裁字 -->
                            <RowDefinition Height="Auto" MinHeight="160" MaxHeight="360" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="100" />
                        </Grid.RowDefinitions>

                        <!-- 三段结果摘要（三列水平排列） -->
                        <Grid Grid.Row="0" MinHeight="160">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 一、压缩沉降（只读 TextBox，可选中复制） -->
                            <Border Grid.Column="0" Background="#353d4a" CornerRadius="3" Padding="{DynamicResource Metric_Padding_6_6}" Margin="0,0,2,0"
                                    MinHeight="150"
                                    Visibility="{Binding CompressSummary, Converter={StaticResource StringToVis}}">
                                <TextBox Style="{StaticResource SummaryCopyTextBox}" MinHeight="130" MaxHeight="340"
                                         Text="{Binding CompressSummary, Mode=OneWay}"
                                         VerticalContentAlignment="Top" />
                            </Border>

                            <!-- 二、回弹量 -->
                            <Border Grid.Column="1" Background="#353d4a" CornerRadius="3" Padding="{DynamicResource Metric_Padding_6_6}" Margin="0,0,2,0"
                                    MinHeight="150"
                                    Visibility="{Binding ReboundSummary, Converter={StaticResource StringToVis}}">
                                <TextBox Style="{StaticResource SummaryCopyTextBox}" MinHeight="130" MaxHeight="340"
                                         Text="{Binding ReboundSummary, Mode=OneWay}"
                                         VerticalContentAlignment="Top" />
                            </Border>

                            <!-- 三、最终沉降 -->
                            <Border Grid.Column="2" Background="#353d4a" CornerRadius="3" Padding="{DynamicResource Metric_Padding_6_6}"
                                    MinHeight="150"
                                    Visibility="{Binding RecompSummary, Converter={StaticResource StringToVis}}">
                                <TextBox Style="{StaticResource SummaryCopyTextBox}" MinHeight="130" MaxHeight="340"
                                         Text="{Binding RecompSummary, Mode=OneWay}"
                                         VerticalContentAlignment="Top" />
                            </Border>
                        </Grid>

                        <!-- 摘要-表格 GridSplitter -->
                        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center" Background="#4c566a" Margin="0,2" />

                        <!-- 分层计算结果表 -->
                        <Grid Grid.Row="2">
                            <!-- 无结果提示 -->
                            <TextBlock Text="请先点击【计算】"
                                       Foreground="#808080" FontSize="{DynamicResource Metric_FontHeader}" FontStyle="Italic"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CalculationResults.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <DataGrid Style="{StaticResource DarkDataGrid}"
                                      ItemsSource="{Binding CalculationResults}" IsReadOnly="True"
                                      FontSize="{DynamicResource Metric_FontSettlementHint}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="26" />
                                    <DataGridTextColumn Header="地层" Binding="{Binding LayerId}" Width="38" />
                                    <DataGridTextColumn Header="z(m)" Binding="{Binding Zi, StringFormat=F2}" Width="46" />
                                    <DataGridTextColumn Header="l/b" Binding="{Binding M, StringFormat=F2}" Width="36" />
                                    <DataGridTextColumn Header="z/0.5b" Binding="{Binding NHalf, StringFormat=F2}" Width="46" />
                                    <DataGridTextColumn Header="ᾱ" Binding="{Binding AlphaBarCorner, StringFormat=F4}" Width="50" />
                                    <DataGridTextColumn Header="4ᾱ" Binding="{Binding AlphaBar, StringFormat=F4}" Width="50" />
                                    <DataGridTextColumn Header="4ᾱz(mm)" Binding="{Binding AlphaBarZi, StringFormat=F1}" Width="58" />
                                    <DataGridTextColumn Header="Δ4ᾱz" Binding="{Binding ZAlphaBarDiff, StringFormat=F1}" Width="50" />
                                    <DataGridTextColumn Header="p₀/Es" Binding="{Binding P0overEs, StringFormat=F4}" Width="48" />
                                    <DataGridTextColumn Header="Δs'" Binding="{Binding DeltaS, StringFormat=F2}" Width="42" />
                                    <DataGridTextColumn Header="Σ" Binding="{Binding CumulativeDeltaS, StringFormat=F2}" Width="44" />
                                    <DataGridTextColumn Header="Es" Binding="{Binding Es, StringFormat=F1}" Width="40" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 中-右 GridSplitter -->
                <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" Background="#4c566a" />

                <!-- ========== 右列：参数区 ========== -->
                <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource SmallScrollViewer}">
                    <StackPanel Margin="4,0,2,0">

                        <!-- 高程参数 -->
                        <TextBlock Text="高程参数" Style="{StaticResource SectionHeader}" />
                        <Border Background="#353d4a" CornerRadius="3" Padding="{DynamicResource Metric_Padding_8_6}" Margin="0,0,0,4">
                            <StackPanel>
                                <CheckBox Content="使用绝对高程" IsChecked="{Binding UseAbsoluteElevation}"
                                          Foreground="#d8dee9" FontSize="{DynamicResource Metric_FontSmall}" Margin="0,0,0,6" />

                                <TextBlock Text="绝对高程" Foreground="#808080" FontSize="{DynamicResource Metric_FontCaption}" Margin="0,0,0,2" />
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="孔点 (m)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource ElevationTextBox}"
                                             Text="{Binding AbsBoreholeElevation, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsRelativeMode}" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="±0.000 (m)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource ElevationTextBox}"
                                             Text="{Binding AbsStructureZero, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsRelativeMode}" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="室内外高差" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding IndoorOutdoorDiff, UpdateSourceTrigger=PropertyChanged}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="埋深高程" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}"
                                               Foreground="#808080" />
                                    <TextBox Grid.Column="1" Style="{StaticResource ElevationTextBox}"
                                             Text="{Binding AbsFoundationDepthElevation, Mode=OneWay, StringFormat=F3}"
                                             IsReadOnly="True" />
                                </Grid>

                                <TextBlock Text="相对高程" Foreground="#808080" FontSize="{DynamicResource Metric_FontCaption}" Margin="0,6,0,2" />
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="埋深 (m)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding FoundationDepth, UpdateSourceTrigger=PropertyChanged}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 基础尺寸 -->
                        <TextBlock Text="基础尺寸 (m)" Style="{StaticResource SectionHeader}" />
                        <Border Background="#353d4a" CornerRadius="3" Padding="{DynamicResource Metric_Padding_8_6}" Margin="0,0,0,4">
                            <StackPanel>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="55" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="宽度 b" Style="{StaticResource ParamLabel}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding FoundationWidth, UpdateSourceTrigger=PropertyChanged}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                    <TextBlock Grid.Column="2" Text="长度 l" Style="{StaticResource ParamLabel}" Margin="6,0,0,0" />
                                    <TextBox Grid.Column="3"
                                             Text="{Binding FoundationLength, UpdateSourceTrigger=PropertyChanged}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 土层参数 -->
                        <TextBlock Text="土层参数" Style="{StaticResource SectionHeader}" />
                        <Border Background="#353d4a" CornerRadius="3" Padding="{DynamicResource Metric_Padding_8_6}" Margin="0,0,0,4">
                            <StackPanel>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="fak (kPa)" Style="{StaticResource ParamLabel}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding BearingCapacity, UpdateSourceTrigger=PropertyChanged}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="γm (kN/m³)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}"
                                               ToolTip="基底以上土的加权平均重度，由土层γ加权计算（地下水位以下取有效重度）" />
                                    <TextBox Grid.Column="1" Style="{StaticResource ElevationTextBox}"
                                             Text="{Binding GammaM, Mode=OneWay, StringFormat=F2}"
                                             IsReadOnly="True"
                                             ToolTip="自动计算: Σ(γi·hi)/Σhi" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="地下水深 dw" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding GroundwaterDepth, UpdateSourceTrigger=PropertyChanged}"
                                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                                        <CheckBox Grid.Column="1" Content="有" Margin="4,0,0,0"
                                                  IsChecked="{Binding HasGroundwater}"
                                                  VerticalAlignment="Center" FontSize="{DynamicResource Metric_FontSmall}" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 荷载参数 -->
                        <TextBlock Text="荷载参数" Style="{StaticResource SectionHeader}" />
                        <Border Background="#353d4a" CornerRadius="3" Padding="{DynamicResource Metric_Padding_8_6}" Margin="0,0,0,4">
                            <StackPanel>
                                <Grid Margin="0,2"
                                      Visibility="{Binding IsP0Auto, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="柱轴力 F(kN)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding AxialForce, UpdateSourceTrigger=PropertyChanged}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                </Grid>
                                <Grid Margin="0,2"
                                      Visibility="{Binding IsP0Auto, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="覆土自重G(kN)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}"
                                               ToolTip="G = γm × A × (d − Δh/2)" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SelfWeightLoad, Mode=OneWay, StringFormat=F1}"
                                             IsReadOnly="True" Foreground="#808080"
                                             ToolTip="自动计算: γm × A × (d − Δh/2)" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="p₀ (kPa)" Style="{StaticResource ParamLabel}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding AdditionalPressure, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsP0Auto}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                    <CheckBox Grid.Column="2" Content="自动" Margin="4,0,0,0"
                                              IsChecked="{Binding IsP0Auto}" VerticalAlignment="Center" FontSize="{DynamicResource Metric_FontSmall}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ψs" Style="{StaticResource ParamLabel}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ManualPsiS, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsPsiSAuto}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                    <CheckBox Grid.Column="2" Content="自动" Margin="4,0,0,0"
                                              IsChecked="{Binding IsPsiSAuto}" VerticalAlignment="Center" FontSize="{DynamicResource Metric_FontSmall}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 回弹再压缩参数 -->
                        <CheckBox Style="{StaticResource ToggleSection}"
                                  Content="回弹再压缩 (§5.3.10)" IsChecked="{Binding EnableRebound}" />
                        <Border Background="#353d4a" CornerRadius="3" Padding="{DynamicResource Metric_Padding_8_6}" Margin="0,0,0,4"
                                Visibility="{Binding EnableRebound, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Eci/Esi 倍率" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding EciEsiRatio, UpdateSourceTrigger=PropertyChanged}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ψc" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding PsiC, UpdateSourceTrigger=PropertyChanged}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="κ (增大系数)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Kappa, UpdateSourceTrigger=PropertyChanged}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="η₁ (完成比)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Eta1, UpdateSourceTrigger=PropertyChanged}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="η₂ (清除比)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Eta2, UpdateSourceTrigger=PropertyChanged}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="R'₀ (临界荷比)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding R0PrimeRatio, UpdateSourceTrigger=PropertyChanged}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="r'₀ (临界压比)" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding R0PrimeR, UpdateSourceTrigger=PropertyChanged}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="深度比值" Style="{StaticResource ParamLabel}" FontSize="{DynamicResource Metric_FontSmall}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ReboundDepthRatio, UpdateSourceTrigger=PropertyChanged}"
                                             helper:TextBoxHelper.EnableCustomHandlers="True" />
                                </Grid>
                                <TextBlock Foreground="#808080" FontSize="{DynamicResource Metric_FontMicro}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="η₁: 回弹完成比(0~1)  η₂: 清除比(0~1)&#x0a;R'₀: 临界再加荷比(§5.3.11)&#x0a;r'₀: 临界再压缩比率(§5.3.11)&#x0a;κ: 黏性土1.19, 砂土1.10" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
