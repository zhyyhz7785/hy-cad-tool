<UserControl x:Class="HyCADTool.Refactored.Presentation.Views.Preferences.LayerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="520"
             btmetrics:BlenderMetricsOverlay.Attach="True"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool.Refactored;component/Presentation/Resources/BlenderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="{DynamicResource Metric_SectionInset}">
        <TextBlock Text="语义 ID 稳定不变；可改「图层名 / ACI 色 / 线型 / 线宽（-1=随层）」等。改后若开启自动保存会写入 hy-settings；也可点底栏「保存用户设置」。"
                   Foreground="{DynamicResource Brush_TextDisabled}"
                   FontSize="{DynamicResource Metric_FontCaption}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6"/>
        <DataGrid x:Name="LayerGrid"
                  Background="{DynamicResource Brush_RegionBack}"
                  Foreground="{DynamicResource Brush_TextPrimary}"
                  BorderBrush="{DynamicResource Brush_BorderDark}"
                  RowBackground="{DynamicResource Brush_RegionBack}"
                  AlternatingRowBackground="{DynamicResource Brush_ItemHover}"
                  GridLinesVisibility="Horizontal"
                  ItemsSource="{Binding Settings.LayerCatalogItems}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  MaxHeight="280"
                  CellEditEnding="LayerGrid_OnCellEditEnding"
                  MinHeight="120">
            <DataGrid.Columns>
                <DataGridTextColumn Header="语义 ID" Binding="{Binding SemanticId}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="图层名" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.2*"/>
                <DataGridTextColumn Header="ACI 色" Binding="{Binding AciColor, UpdateSourceTrigger=PropertyChanged}" Width="0.4*"/>
                <DataGridTextColumn Header="线型" Binding="{Binding LinetypeName, UpdateSourceTrigger=PropertyChanged}" Width="0.6*"/>
                <DataGridTextColumn Header="线宽" Binding="{Binding LineWeightRaw, UpdateSourceTrigger=PropertyChanged}" Width="0.35*"/>
                <DataGridCheckBoxColumn Header="出图" Binding="{Binding IsPlottable, UpdateSourceTrigger=PropertyChanged}" Width="0.35*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Left">
            <Button Style="{StaticResource BlenderButton}"
                    Content="恢复到默认层表"
                    Padding="{DynamicResource Metric_ButtonPaddingSmall}"
                    Command="{Binding Settings.RestoreDefaultLayerCatalogCommand}"/>
            <Button Style="{StaticResource BlenderButton}"
                    Content="应用图层到当前图纸"
                    Margin="8,0,0,0"
                    Padding="{DynamicResource Metric_ButtonPaddingSmall}"
                    Command="{Binding Settings.ApplyLayerCatalogToDocumentCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
