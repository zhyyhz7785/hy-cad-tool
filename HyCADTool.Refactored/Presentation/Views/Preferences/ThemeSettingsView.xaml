<UserControl x:Class="HyCADTool.Refactored.Presentation.Views.Preferences.ThemeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:HyCADTool.Refactored.Presentation.Views.Preferences"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="500">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool.Refactored;component/Presentation/Resources/BlenderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
              主题预览卡片数据：与 BlenderThemeManager.BlenderThemeName 一一对应。
              色块取自 Themes/Palettes/*.xaml 中具有代表性的 4 个 Brush_：
                C1 = Brush_WindowBack（窗口底）
                C2 = Brush_PanelBack（面板底）
                C3 = Brush_AccentBlue（强调色）
                C4 = Brush_TextPrimary（主文字色）
            -->
            <x:Array x:Key="ThemeOptions" Type="{x:Type local:ThemePresetVm}">
                <local:ThemePresetVm Key="BlenderDark"
                                     Name="Blender Dark"
                                     Subtitle="项目原始默认 — 深灰背景 + 蓝色高亮"
                                     C1="#303030" C2="#393939" C3="#4772B3" C4="#E6E6E6"/>
                <local:ThemePresetVm Key="BlenderLight"
                                     Name="Blender Light"
                                     Subtitle="参考 Blender 自带 Light 预设 — 浅灰底 + 蓝色高亮"
                                     C1="#C5C5C5" C2="#BABABA" C3="#4570B0" C4="#1A1A1A"/>
                <local:ThemePresetVm Key="AcadLight"
                                     Name="AutoCAD Light"
                                     Subtitle="参考 AutoCAD 经典白色界面 — 白底 + Autodesk 蓝"
                                     C1="#F0F0F0" C2="#F5F5F5" C3="#2A6BBC" C4="#000000"/>
                <local:ThemePresetVm Key="AcadDark"
                                     Name="AutoCAD Dark"
                                     Subtitle="参考 AutoCAD 2024+ Dark 主题 — 深灰 + Autodesk 蓝"
                                     C1="#2F2F2F" C2="#383838" C3="#2A6BBC" C4="#DCDCDC"/>
            </x:Array>

            <!-- ListBoxItem 模板：自带选中蓝色边框 + 4 色块预览 + 名称/副标题 -->
            <Style x:Key="ThemeListItem" TargetType="{x:Type ListBoxItem}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Root"
                                    Background="{DynamicResource Brush_PanelBack}"
                                    BorderBrush="{DynamicResource Brush_BorderDark}"
                                    BorderThickness="1"
                                    Padding="8,8"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 4 色块预览 -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" Background="{Binding C1}"
                                                BorderBrush="{DynamicResource Brush_BorderDark}" BorderThickness="1" Margin="0,0,2,0"/>
                                        <Border Width="22" Height="22" Background="{Binding C2}"
                                                BorderBrush="{DynamicResource Brush_BorderDark}" BorderThickness="1" Margin="0,0,2,0"/>
                                        <Border Width="22" Height="22" Background="{Binding C3}"
                                                BorderBrush="{DynamicResource Brush_BorderDark}" BorderThickness="1" Margin="0,0,2,0"/>
                                        <Border Width="22" Height="22" Background="{Binding C4}"
                                                BorderBrush="{DynamicResource Brush_BorderDark}" BorderThickness="1"/>
                                    </StackPanel>

                                    <!-- 名称 + 副标题 -->
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="11"
                                                   Margin="0,1,0,0"
                                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- 选中圆点指示器 -->
                                    <Border Grid.Column="2" Width="14" Height="14" Margin="8,0,2,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="7"
                                            BorderThickness="2">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush_BorderMid}"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush_AccentBlue}"/>
                                                        <Setter Property="Background" Value="{DynamicResource Brush_AccentBlue}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush_AccentBlueHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush_AccentBlue}"/>
                                    <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="选择界面颜色主题（实时生效，自动保存到 hy-settings.json）"
                   FontSize="11"
                   Margin="0,0,0,6"
                   Foreground="{DynamicResource Brush_TextSecondary}"/>

        <!--
            注意：SelectedValue 不再用 {Binding Settings.Theme, Mode=TwoWay}。
            原因：本 View 在 HyPreferencesView 的 ContentControl 模板里被实例化时，
            初始 DataContext 是 SettingsGroupVm（没有 Settings 属性），binding 一旦建立
            就进入 PathError sticky 状态；后续 code-behind 把 DataContext 改为
            HySettingsViewModel 也无法让 PathError binding 重新解析。
            改由 ThemeSettingsView.xaml.cs 的 Loaded / SelectionChanged 直接读写
            SettingsPanelViewModel.Current.Theme，绕开 binding 路径解析问题。
        -->
        <ListBox Grid.Row="1"
                 x:Name="ThemeList"
                 ItemsSource="{StaticResource ThemeOptions}"
                 ItemContainerStyle="{StaticResource ThemeListItem}"
                 SelectedValuePath="Key"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 HorizontalContentAlignment="Stretch"/>

        <TextBlock Grid.Row="2"
                   FontSize="10"
                   Margin="0,6,0,0"
                   Foreground="{DynamicResource Brush_TextDisabled}"
                   TextWrapping="Wrap">
            提示：颜色主题切换通过 BlenderThemeManager 在 Application 顶层 Merge 调色板字典实现，所有 DynamicResource Brush_* 引用自动刷新；当前选中将随 hy-settings.json 持久化，下次启动恢复。
        </TextBlock>
    </Grid>
</UserControl>
