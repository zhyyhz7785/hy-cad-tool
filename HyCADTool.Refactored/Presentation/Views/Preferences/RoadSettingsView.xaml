<UserControl x:Class="HyCADTool.Refactored.Presentation.Views.Preferences.RoadSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="420">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool.Refactored;component/Presentation/Resources/BlenderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush_TextSecondary}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="FieldRow" TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="0,2"/>
            </Style>

            <!-- 道路：人行横道 -->
            <DataTemplate x:Key="Section_RoadCrosswalk">
                <StackPanel Margin="8,6">
                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="间隙宽度 (Gap)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource BlenderTextBox}"
                                 Text="{Binding Settings.RoadGapWidth, UpdateSourceTrigger=LostFocus, FallbackValue=5}"/>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="人行横道宽" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource BlenderTextBox}"
                                 Text="{Binding Settings.RoadCrosswalkWidth, UpdateSourceTrigger=LostFocus, FallbackValue=5}"/>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="停车线距离" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource BlenderTextBox}"
                                 Text="{Binding Settings.RoadStopLineDistance, UpdateSourceTrigger=LostFocus, FallbackValue=2}"/>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="条纹间距" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource BlenderTextBox}"
                                 Text="{Binding Settings.RoadStripeSpacing, UpdateSourceTrigger=LostFocus, FallbackValue=1}"/>
                    </Grid>
                </StackPanel>
            </DataTemplate>

            <!-- 道路：市政道路 P0（接 Settings.RoadDesign 子 VM） -->
            <DataTemplate x:Key="Section_RoadMunicipal">
                <StackPanel Margin="8,6">
                    <TextBlock Text="（市政道路 P0：参数承载于 SettingsPanelViewModel.RoadDesign 子 VM，此处仅陈列入口；命令从常用栏触发）"
                               Foreground="{DynamicResource Brush_TextDisabled}"
                               FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="TODO: 待迁移 Alignment/Profile/Superelevation/Widening/CrossSection 等参数分段面板"
                               Foreground="{DynamicResource Brush_TextDisabled}"
                               FontSize="11" FontStyle="Italic" TextWrapping="Wrap"/>
                </StackPanel>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <ContentControl x:Name="Host"/>
</UserControl>
