<UserControl x:Class="HyCADTool.Refactored.Presentation.Views.Road.RoadAlignmentWorkbenchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
             xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
             xmlns:vm="clr-namespace:HyCADTool.Refactored.Presentation.ViewModels.Road"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=vm:RoadAlignmentWorkbenchViewModel, IsDesignTimeCreatable=False}"
             Background="{DynamicResource Brush_WindowBack}"
             Foreground="{DynamicResource Brush_TextPrimary}"
             FontFamily="{DynamicResource Font_Main}"
             FontSize="{DynamicResource Metric_FontMain}"
             btmetrics:BlenderMetricsOverlay.Attach="True">

    <!--
        路线工作台 UserControl：
        - 本地 Merge BlenderTheme + RoadDesignerStyles，避免宿主隐式 Style 污染（pitfall B1/B2）；由 PaletteSet 宿主（PanelManager.ShowAlignmentWorkbench）承载；
        - 三列 Blender 布局（参考 HyCAD.BlenderUI/Samples/SplitDesignerSample.xaml）；
        - 顶栏操作 / 底栏标注 / 中列 PI 编辑复用 PiThreeUnitViewModel。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/BlenderTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool.Refactored;component/Presentation/Resources/RoadDesignerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================= 顶栏（紧凑版：Padding 6,2 + Button MinWidth 下调） ============================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush_HeaderBack}"
                BorderBrush="{DynamicResource Brush_BorderDark}"
                BorderThickness="0,0,0,1"
                Padding="{DynamicResource Metric_ButtonPaddingSmall}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{DynamicResource Brush_TextSecondary}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding HeaderInfo}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!--
                        工作流三连（拾取 → 预览 → 应用）；其余「原线 / 单色 / 提交 / 刷新」按钮在
                        2026-04-21 工作流简化中移除。v2 简化：PI 调整只有瞬态黄，分段彩色由用户手动点
                        「预览」追加到 05_hy_道路_预览；原线层 05_hy_道路_原线 启动即锁定，只存 RawPick 档案，
                        Apply 定稿时临时解锁清掉本 Id。
                    -->
                    <Button Content="拾取" MinWidth="{DynamicResource Metric_ToolButtonMinWidth_M}" Margin="1,0"
                            Style="{StaticResource BlenderButton}"
                            Command="{Binding PickAlignmentCmd}"
                            ToolTip="拾取登记：在 CAD 中点选任意图层的 Polyline；若已有 HY_ROAD Alignment 标记则直接选中编辑，否则删除原图并转存到 05_hy_道路_原线 层（252 本色），登记为待定稿线位"/>
                    <Button Content="预览" MinWidth="{DynamicResource Metric_ToolButtonMinWidth_M}" Margin="1,0"
                            Style="{StaticResource BlenderButton}"
                            Command="{Binding DrawLivePreviewCmd}"
                            ToolTip="追加分段彩色快照到 05_hy_道路_预览 层（直/缓入/缓出/圆按 ACI 区分）；不清理任何图层，原线层由用户按需自行解锁 ERASE — 本按钮暗示&quot;需要手动优化路线&quot;，可叠加多组方案并排比对"/>
                    <Button Content="应用" MinWidth="{DynamicResource Metric_ToolButtonMinWidth_M}" Margin="1,0"
                            Style="{StaticResource BlenderButton}"
                            Command="{Binding ApplyAlignmentCmd}"
                            ToolTip="一键定稿：临时解锁 05_hy_道路_原线 清空本线位档案（RawPick + 历史预览残留），在 05_hy_道路_平面线位 层新建/就地更新正式 Polyline，同步 .roaddesign.json；这是唯一真正「保存」的动作，LivePreview 不动"/>
                    <Rectangle Width="1" Margin="4,2" Fill="{DynamicResource Brush_BorderDark}"/>
                    <Button Content="反转" MinWidth="{DynamicResource Metric_ToolButtonMinWidth_S}" Margin="1,0"
                            Style="{StaticResource BlenderButton}"
                            Command="{Binding ReverseCmd}"
                            ToolTip="反转当前线位前进方向（会镜像桩号方程）"/>
                    <Button Content="偏移" MinWidth="{DynamicResource Metric_ToolButtonMinWidth_S}" Margin="1,0"
                            Style="{StaticResource BlenderButton}"
                            Command="{Binding OffsetCmd}"
                            ToolTip="偏移副本：沿中心线生成平行偏移 Polyline（距离在命令行中输入）"/>
                    <Rectangle Width="1" Margin="4,2" Fill="{DynamicResource Brush_BorderDark}"/>
                    <Button Content="PI 表" MinWidth="{DynamicResource Metric_ToolButtonMinWidth_M}" Margin="1,0"
                            Style="{StaticResource BlenderButton}"
                            Command="{Binding ExportPiCsvCmd}"
                            ToolTip="导出 PI CSV"/>
                    <Button Content="段表" MinWidth="{DynamicResource Metric_ToolButtonMinWidth_M}" Margin="1,0"
                            Style="{StaticResource BlenderButton}"
                            Command="{Binding ExportFrameCsvCmd}"
                            ToolTip="导出段表 CSV"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================= 三列主体 ============================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="170"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"  MinWidth="240"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="240" MinWidth="190"/>
            </Grid.ColumnDefinitions>

            <!--
                左列：线位列表（上）+ PI 列表（下），拆成两个独立 bui:PropertyEditor，
                中间加水平 GridSplitter 可拖动调整比例。避免线位条数多时把 PI 列表挤出可视区。
                两个子列表各自带滚动条（BlenderListBox Template 内含 ScrollViewer）。
            -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="80"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*" MinHeight="80"/>
                </Grid.RowDefinitions>

                <!-- 上：平面线位列表 -->
                <bui:PropertyEditor Grid.Row="0"
                                    Title="平面线位列表"
                                    ShowIconBar="False"
                                    ShowSearch="False">
                    <ListBox Margin="{DynamicResource Metric_PropertyListMargin}"
                             ItemsSource="{Binding Alignments}"
                             SelectedItem="{Binding SelectedAlignment, Mode=TwoWay}"
                             Style="{StaticResource BlenderListBox}"
                             DisplayMemberPath="Header"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </bui:PropertyEditor>

                <GridSplitter Grid.Row="1"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Cursor="SizeNS"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows"
                              Style="{StaticResource BlenderSplitter}"/>

                <!-- 下：PI 列表（附 +PI / -PI 按钮） -->
                <bui:PropertyEditor Grid.Row="2"
                                    Title="PI 列表（* = 端点）"
                                    ShowIconBar="False"
                                    ShowSearch="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="6,4,6,2">
                            <Button Content="+PI" MinWidth="{DynamicResource Metric_ToolButtonMinWidth_XS}" Margin="2,0"
                                    Style="{StaticResource BlenderButton}"
                                    Command="{Binding InsertPiCmd}"
                                    ToolTip="插入 PI（在命令行继续点取坐标与参数）"/>
                            <Button Content="-PI" MinWidth="{DynamicResource Metric_ToolButtonMinWidth_XS}" Margin="2,0"
                                    Style="{StaticResource BlenderButton}"
                                    Command="{Binding DeletePiCmd}"
                                    ToolTip="删除当前选中的内部 PI"/>
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 Margin="{DynamicResource Metric_PropertyListMarginTight}"
                                 ItemsSource="{Binding PiItems}"
                                 SelectedItem="{Binding SelectedPi, Mode=TwoWay}"
                                 Style="{StaticResource BlenderListBox}"
                                 DisplayMemberPath="Header"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Grid>
                </bui:PropertyEditor>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Style="{StaticResource BlenderSplitter}"/>

            <!-- 中列：PI 三单元编辑器 -->
            <bui:PropertyEditor Grid.Column="2"
                                Title="PI 参数（三单元）"
                                ShowIconBar="False"
                                ShowSearch="False">
                <Grid>
                    <!-- 无选中时 -->
                    <TextBlock Margin="12,16"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush_TextSecondary}"
                               Text="请在左列选中一个内部 PI（带 * 的为端点，不可编辑）。"
                               Visibility="{Binding PiEditorVm, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"/>

                    <!-- 有选中时：标题 → 左「输入」右「派生量」→ 通栏「规范检查」→ 预览提示 -->
                    <Grid Visibility="{Binding PiEditorVm, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="{DynamicResource Metric_SectionInset}"
                                   Foreground="{DynamicResource Brush_AccentBlue}"
                                   Text="{Binding PiEditorVm.Title}"/>

                        <!-- 左：输入 | 竖分割 | 右：派生量（实时） -->
                        <Grid Grid.Row="1"
                              MinHeight="120"
                              DataContext="{Binding PiEditorVm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="160"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*" MinWidth="140"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <Expander Header="输入" IsExpanded="True" Style="{StaticResource BlenderExpander}">
                                    <StackPanel>
                                        <bui:PropertyRow Label="设计速度 V (km/h)">
                                            <ComboBox ItemsSource="{Binding AvailableSpeeds}"
                                                      SelectedItem="{Binding DesignSpeed, Mode=TwoWay}"
                                                      Style="{StaticResource BlenderComboBox}"/>
                                        </bui:PropertyRow>
                                        <bui:PropertyRow Label="圆曲线半径 R (m)">
                                            <bui:NumericSlider Value="{Binding Radius, Mode=TwoWay}"
                                                               Minimum="0" Maximum="5000" Step="5" Decimals="3" Unit="m"/>
                                        </bui:PropertyRow>
                                        <bui:PropertyRow Label="对称锁">
                                            <CheckBox Content="Ls1 = Ls2（对称）"
                                                      IsChecked="{Binding IsSymmetric}"
                                                      Style="{StaticResource BlenderCheckBox}"
                                                      VerticalAlignment="Center"/>
                                        </bui:PropertyRow>
                                        <bui:PropertyRow Label="入侧缓长 Ls1 (m)">
                                            <bui:NumericSlider Value="{Binding SpiralIn, Mode=TwoWay}"
                                                               Minimum="0" Maximum="500" Step="1" Decimals="3" Unit="m"/>
                                        </bui:PropertyRow>
                                        <bui:PropertyRow Label="出侧缓长 Ls2 (m)">
                                            <bui:NumericSlider Value="{Binding SpiralOut, Mode=TwoWay}"
                                                               Minimum="0" Maximum="500" Step="1" Decimals="3" Unit="m"
                                                               IsEnabled="{Binding IsSymmetric, Converter={StaticResource InverseBoolConverter}}"/>
                                        </bui:PropertyRow>
                                    </StackPanel>
                                </Expander>
                            </ScrollViewer>

                            <GridSplitter Grid.Column="1"
                                          Width="4"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Cursor="SizeWE"
                                          ResizeBehavior="PreviousAndNext"
                                          ResizeDirection="Columns"
                                          Style="{StaticResource BlenderSplitter}"/>

                            <ScrollViewer Grid.Column="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <Expander Header="派生量（实时）" IsExpanded="True" Style="{StaticResource BlenderExpander}">
                                    <StackPanel>
                                        <bui:PropertyRow Label="转角 α">
                                            <TextBlock Text="{Binding TurnAngleText}" Style="{StaticResource RoadDerivedTextStyle}"/>
                                        </bui:PropertyRow>
                                        <bui:PropertyRow Label="入切线 T1 (m)">
                                            <TextBlock Text="{Binding T1, StringFormat=F3}" Style="{StaticResource RoadDerivedTextStyle}"/>
                                        </bui:PropertyRow>
                                        <bui:PropertyRow Label="出切线 T2 (m)">
                                            <TextBlock Text="{Binding T2, StringFormat=F3}" Style="{StaticResource RoadDerivedTextStyle}"/>
                                        </bui:PropertyRow>
                                        <bui:PropertyRow Label="圆曲线长 Ly (m)">
                                            <TextBlock Text="{Binding Ly, StringFormat=F3}" Style="{StaticResource RoadDerivedTextStyle}"/>
                                        </bui:PropertyRow>
                                        <bui:PropertyRow Label="前直线段 (m)">
                                            <TextBlock Text="{Binding PrevTangent, StringFormat=F3}" Style="{StaticResource RoadDerivedSecondaryTextStyle}"/>
                                        </bui:PropertyRow>
                                        <bui:PropertyRow Label="后直线段 (m)">
                                            <TextBlock Text="{Binding NextTangent, StringFormat=F3}" Style="{StaticResource RoadDerivedSecondaryTextStyle}"/>
                                        </bui:PropertyRow>
                                    </StackPanel>
                                </Expander>
                            </ScrollViewer>
                        </Grid>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      MaxHeight="180"
                                      DataContext="{Binding PiEditorVm}">
                            <Expander Header="规范检查" IsExpanded="True" Style="{StaticResource BlenderExpander}">
                                <ItemsControl ItemsSource="{Binding CheckItems}"
                                              ItemTemplate="{StaticResource RoadCheckItemTemplate}"/>
                            </Expander>
                        </ScrollViewer>

                        <!--
                            PI 编辑器底部提示区：解释两层预览 + 顶栏「应用」按钮的语义（v2 简化）。
                        -->
                        <Border Grid.Row="3"
                                Background="{DynamicResource Brush_RegionBack}"
                                BorderBrush="{DynamicResource Brush_BorderDark}"
                                BorderThickness="0,1,0,0"
                                Padding="{DynamicResource Metric_Padding_8_6}">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush_TextSecondary}"
                                       Text="调 PI：瞬态黄实时反馈；「撤销」回退未提交值；点顶栏「预览」追加分段彩色到 05_hy_道路_预览；点顶栏「应用」定稿到 05_hy_道路_平面线位 层"/>
                        </Border>
                    </Grid>
                </Grid>
            </bui:PropertyEditor>

            <GridSplitter Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Style="{StaticResource BlenderSplitter}"/>

            <!-- 右列：分段 / 方程 / 几何点 -->
            <bui:PropertyEditor Grid.Column="4"
                                Title="只读表"
                                ShowIconBar="False"
                                ShowSearch="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Expander Header="分段表" IsExpanded="True" Style="{StaticResource BlenderExpander}">
                            <ListBox ItemsSource="{Binding Segments}"
                                     MaxHeight="140"
                                     Style="{StaticResource BlenderListBox}"
                                     DisplayMemberPath="Header"/>
                        </Expander>

                        <Expander Header="桩号方程" IsExpanded="True" Style="{StaticResource BlenderExpander}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox Grid.Row="0"
                                         ItemsSource="{Binding StationEquations}"
                                         SelectedItem="{Binding SelectedStationEquation, Mode=TwoWay}"
                                         MaxHeight="110"
                                         Style="{StaticResource BlenderListBox}"
                                         DisplayMemberPath="Header"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                    <Button Content="+" MinWidth="{DynamicResource Metric_ToolButtonMinWidth_XXS}" Margin="1,0"
                                            Style="{StaticResource BlenderButton}"
                                            Command="{Binding AddStationEquationCmd}"
                                            ToolTip="新增桩号方程（走 hyRoadAlnStaEq 命令行）"/>
                                    <Button Content="-" MinWidth="{DynamicResource Metric_ToolButtonMinWidth_XXS}" Margin="1,0"
                                            Style="{StaticResource BlenderButton}"
                                            Command="{Binding DeleteStationEquationCmd}"
                                            ToolTip="删除选中的桩号方程"/>
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <Expander Header="几何点" IsExpanded="False" Style="{StaticResource BlenderExpander}">
                            <ListBox ItemsSource="{Binding GeometryPoints}"
                                     MaxHeight="140"
                                     Style="{StaticResource BlenderListBox}"
                                     DisplayMemberPath="Header"/>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </bui:PropertyEditor>
        </Grid>

        <!-- ============================= 底栏（紧凑版） ============================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush_HeaderBack}"
                BorderBrush="{DynamicResource Brush_BorderDark}"
                BorderThickness="0,1,0,0"
                Padding="{DynamicResource Metric_ButtonPaddingSmall}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!--
                        「应用」按钮在 2026-04-21 工作流简化中移到了顶栏「拾取」旁（工作流三连）。
                        底栏留「撤销」+ 标注类操作（桩号 / 配置 / 几何点）。
                    -->
                    <Button Content="撤销" MinWidth="{DynamicResource Metric_ToolButtonMinWidth_S}" Margin="1,0"
                            Style="{StaticResource BlenderButton}"
                            Command="{Binding RevertPiEditCmd}"
                            ToolTip="放弃当前 PI 未提交的参数改动（仅回滚 PI 三单元编辑器，不影响已定稿的 05_hy_道路_平面线位 Polyline）"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                               Margin="4,2"/>
                    <Button Content="桩号" MinWidth="{DynamicResource Metric_ToolButtonMinWidth_M}" Margin="1,0"
                            Style="{StaticResource BlenderButton}"
                            Command="{Binding DrawStationLabelsCmd}"
                            ToolTip="桩号标注：按当前配置一键桩号标注（等效 hyRoadAlnStation A）"/>
                    <Button Content="配置…" MinWidth="{DynamicResource Metric_ToolButtonMinWidth_S}" Margin="1,0"
                            Style="{StaticResource BlenderButton}"
                            Command="{Binding DrawStationLabelsCmd}"
                            ToolTip="打开桩号标注配置窗口（等效 hyRoadAlnStation C）">
                        <Button.CommandParameter>
                            <sys:Boolean>True</sys:Boolean>
                        </Button.CommandParameter>
                    </Button>
                    <Button Content="几何点" MinWidth="{DynamicResource Metric_ToolButtonMinWidth_L}" Margin="1,0"
                            Style="{StaticResource BlenderButton}"
                            Command="{Binding DrawGeometryPointsCmd}"
                            ToolTip="几何点标注：为当前 DWG 所有 Alignment 生成 BP/BC/EC/TS/SC/CS/ST/EP 标注"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush_TextSecondary}"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
