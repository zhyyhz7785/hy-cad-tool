<bui:BlenderWindow x:Class="HyCADTool.Refactored.Presentation.Views.Road.CrossSectionDesignerWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
                   xmlns:vm="clr-namespace:HyCADTool.Refactored.Presentation.ViewModels.Road"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   Title="标准横断面图设计"
                   HeaderTitle="{Binding Title}"
                   Width="1180" Height="700"
                   MinWidth="1040" MinHeight="600"
                   WindowStartupLocation="CenterOwner">

    <bui:BlenderWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                  自包含 Merge：仅 BlenderTheme + 共享 RoadDesignerStyles。
                  共享样式带：RoadCheckItemTemplate / RoadBandGridStyle /
                              RoadCanvasBorderStyle / InverseBoolConverter / IndexToVisibilityConverter
                -->
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/BlenderTheme.xaml"/>
                <d:ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool.Refactored;component/Presentation/Resources/RoadDesignerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </bui:BlenderWindow.Resources>

    <!-- ========== 标题栏右侧：CJJ37 预设下拉 ========== -->
    <bui:BlenderWindow.HeaderRightContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Text="预设："
                       Foreground="{DynamicResource Brush_TextSecondary}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,0,4,0"/>
            <ComboBox x:Name="PresetCombo"
                      ItemsSource="{Binding Presets}"
                      DisplayMemberPath="DisplayName"
                      Style="{StaticResource BlenderComboBox}"
                      SelectionChanged="PresetCombo_SelectionChanged"
                      MinWidth="180"/>
        </StackPanel>
    </bui:BlenderWindow.HeaderRightContent>

    <!-- ========== 命令栏 ========== -->
    <bui:BlenderWindow.FooterLeftContent>
        <TextBlock VerticalAlignment="Center"
                   FontSize="11" FontFamily="Consolas"
                   Foreground="{DynamicResource Brush_TextSecondary}">
            <Run Text="左半"/>
            <Run Text="{Binding LeftHalfWidth, StringFormat=F2, Mode=OneWay}"/>
            <Run Text="m / 右半"/>
            <Run Text="{Binding RightHalfWidth, StringFormat=F2, Mode=OneWay}"/>
            <Run Text="m / 路幅"/>
            <Run Text="{Binding TotalWidth, StringFormat=F2, Mode=OneWay}"/>
            <Run Text="m"/>
        </TextBlock>
    </bui:BlenderWindow.FooterLeftContent>

    <bui:BlenderWindow.StatusContent>
        <TextBlock VerticalAlignment="Center" FontSize="11">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Brush_Success}"/>
                    <Setter Property="Text" Value="✓ 全部规范项通过"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AllChecksPassed}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush_Warning}"/>
                            <Setter Property="Text" Value="✗ 有规范项未通过（可强制确定）"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </bui:BlenderWindow.StatusContent>

    <bui:BlenderWindow.FooterRightContent>
        <StackPanel Orientation="Horizontal">
            <Button Content="确定并出图"
                    Style="{StaticResource BlenderButton}"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True"
                    MinWidth="100"
                    Margin="4,0"/>
            <Button Content="取消"
                    Style="{StaticResource BlenderButton}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    MinWidth="80"
                    Margin="4,0"/>
        </StackPanel>
    </bui:BlenderWindow.FooterRightContent>

    <!-- ========== 主体：三列 ========== -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 左列：参数 + 条带 ========== -->
        <bui:PropertyEditor Grid.Column="0"
                            Title="横断面参数"
                            ShowSearch="False"
                            ShowPin="False"
                            ShowIconBar="False">

            <StackPanel>
                <!-- ========== 全局参数 ========== -->
                <Expander Header="全局参数" IsExpanded="True" Style="{StaticResource BlenderExpander}">
                    <StackPanel>
                        <bui:PropertyRow Label="设计速度 V (km/h)">
                            <ComboBox ItemsSource="{Binding AvailableSpeeds}"
                                      SelectedItem="{Binding DesignSpeed, Mode=TwoWay}"
                                      Style="{StaticResource BlenderComboBox}"/>
                        </bui:PropertyRow>

                        <bui:PropertyRow Label="比例尺 1 :">
                            <ComboBox ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableScales}"
                                      SelectedItem="{Binding ScaleDenominator, Mode=TwoWay}"
                                      Style="{StaticResource BlenderComboBox}"/>
                        </bui:PropertyRow>

                        <bui:PropertyRow Label="中分带宽 (m)">
                            <bui:NumericSlider Value="{Binding CenterMedianWidth, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="20"
                                               Step="0.5"
                                               Decimals="2"
                                               Unit="m"/>
                        </bui:PropertyRow>

                        <bui:PropertyRow Label="图名标题">
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BlenderTextBox}"/>
                        </bui:PropertyRow>

                        <bui:PropertyRow Label="镜像锁">
                            <CheckBox Content="左右对称"
                                      IsChecked="{Binding IsMirror}"
                                      Style="{StaticResource BlenderCheckBox}"
                                      VerticalAlignment="Center"/>
                        </bui:PropertyRow>
                    </StackPanel>
                </Expander>

                <!-- ========== 条带表格 ========== -->
                <Expander Header="条带（中→外）" IsExpanded="True" Style="{StaticResource BlenderExpander}">
                    <DockPanel>
                        <!-- 工具栏 -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="＋左"
                                    Command="{Binding AddLeftBandCommand}"
                                    Style="{StaticResource BlenderButtonFlat}"
                                    Padding="6,3" Margin="2,0"
                                    ToolTip="在左半末尾追加条带"/>
                            <Button Content="＋右"
                                    Command="{Binding AddRightBandCommand}"
                                    Style="{StaticResource BlenderButtonFlat}"
                                    Padding="6,3" Margin="2,0"
                                    ToolTip="在右半末尾追加条带"/>
                            <Button Content="×删除"
                                    Command="{Binding RemoveBandCommand}"
                                    Style="{StaticResource BlenderButtonFlat}"
                                    Padding="6,3" Margin="2,0"
                                    ToolTip="删除当前选中行"/>
                            <Button Content="↑"
                                    Command="{Binding MoveUpCommand}"
                                    Style="{StaticResource BlenderButtonFlat}"
                                    Padding="6,3" Margin="2,0"
                                    ToolTip="把选中行向内侧移动一格"/>
                            <Button Content="↓"
                                    Command="{Binding MoveDownCommand}"
                                    Style="{StaticResource BlenderButtonFlat}"
                                    Padding="6,3" Margin="2,0"
                                    ToolTip="把选中行向外侧移动一格"/>
                        </StackPanel>

                        <!-- 左右两个 DataGrid -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="160"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="160"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="左半（由中心向外）"
                                       Foreground="{DynamicResource Brush_TextSecondary}"
                                       FontSize="11"
                                       Margin="0,0,0,2"/>
                            <DataGrid Grid.Row="1"
                                      x:Name="LeftGrid"
                                      ItemsSource="{Binding LeftBands}"
                                      SelectionChanged="AnyGrid_SelectionChanged"
                                      Style="{StaticResource RoadBandGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称"
                                                        Binding="{Binding Name}"
                                                        Width="*"/>
                                    <DataGridComboBoxColumn Header="类型"
                                                            ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableKinds}"
                                                            SelectedItemBinding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="100"/>
                                    <DataGridTemplateColumn Header="宽(m)" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <bui:NumericSlider Value="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   Minimum="0.1"
                                                                   Maximum="30"
                                                                   Step="0.1"
                                                                   Decimals="2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="横坡%" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <bui:NumericSlider Value="{Binding CrossSlopePct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   Minimum="-20"
                                                                   Maximum="20"
                                                                   Step="0.1"
                                                                   Decimals="2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="2"
                                       Text="右半（由中心向外）"
                                       Foreground="{DynamicResource Brush_TextSecondary}"
                                       FontSize="11"
                                       Margin="0,6,0,2"/>
                            <DataGrid Grid.Row="3"
                                      x:Name="RightGrid"
                                      ItemsSource="{Binding RightBands}"
                                      SelectionChanged="AnyGrid_SelectionChanged"
                                      Style="{StaticResource RoadBandGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称"
                                                        Binding="{Binding Name}"
                                                        Width="*"/>
                                    <DataGridComboBoxColumn Header="类型"
                                                            ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableKinds}"
                                                            SelectedItemBinding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="100"/>
                                    <DataGridTemplateColumn Header="宽(m)" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <bui:NumericSlider Value="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   Minimum="0.1"
                                                                   Maximum="30"
                                                                   Step="0.1"
                                                                   Decimals="2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="横坡%" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <bui:NumericSlider Value="{Binding CrossSlopePct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   Minimum="-20"
                                                                   Maximum="20"
                                                                   Step="0.1"
                                                                   Decimals="2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </DockPanel>
                </Expander>
            </StackPanel>
        </bui:PropertyEditor>

        <!-- ========== 中列：Canvas 预览 ========== -->
        <bui:PropertyEditor Grid.Column="1"
                            Title="实时预览（单位 m）"
                            ShowSearch="False"
                            ShowPin="False"
                            ShowIconBar="False">
            <Grid>
                <Border Style="{StaticResource RoadCanvasBorderStyle}">
                    <Canvas x:Name="PreviewCanvas"
                            ClipToBounds="True"
                            Background="Transparent"
                            SizeChanged="PreviewCanvas_SizeChanged"/>
                </Border>
                <TextBlock HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,8,4"
                           Foreground="{DynamicResource Brush_TextSecondary}"
                           FontSize="10"
                           FontFamily="Consolas"
                           Text="按 [Alt+N] 新建 / [Alt+L] 载入预设 / [Ctrl+Enter] 确定 / [Esc] 取消"/>
            </Grid>
        </bui:PropertyEditor>

        <!-- ========== 右列：规范检查 ========== -->
        <bui:PropertyEditor Grid.Column="2"
                            Title="规范检查（CJJ 37）"
                            ShowSearch="False"
                            ShowPin="False"
                            ShowIconBar="False">
            <ItemsControl ItemsSource="{Binding CheckItems}"
                          ItemTemplate="{StaticResource RoadCheckItemTemplate}"/>
        </bui:PropertyEditor>
    </Grid>

</bui:BlenderWindow>
