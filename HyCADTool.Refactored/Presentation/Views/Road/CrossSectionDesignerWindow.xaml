<Window x:Class="HyCADTool.Refactored.Presentation.Views.Road.CrossSectionDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helper="clr-namespace:HyCADTool.Refactored.Presentation.Views.Helpers"
        xmlns:vm="clr-namespace:HyCADTool.Refactored.Presentation.ViewModels.Road"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="标准横断面图设计"
        Width="1180" Height="700"
        MinWidth="1040" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#2e3440"
        Foreground="#d8dee9"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool.Refactored;component/Presentation/Resources/LibraryResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#88c0d0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="SectionBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="#4c566a" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Background" Value="#353d4a" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="ParamLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#d8dee9" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="DerivedText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#d8dee9" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Padding" Value="0,0,4,0" />
            </Style>

            <Style x:Key="NumericTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="helper:TextBoxHelper.EnableCustomHandlers" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                        <Setter Property="Background" Value="#2a2e38" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="16,6" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinWidth" Value="80" />
            </Style>

            <Style x:Key="ToolbarBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="MinWidth" Value="30" />
            </Style>

            <Style x:Key="TitleBarBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#d8dee9" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3b4453" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseTitleBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#bf616a" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 规范检查单条模板 -->
            <DataTemplate x:Key="CheckItemTemplate">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Top"
                             Margin="0,6,0,0"
                             HorizontalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#a3be8c" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Passed}" Value="False">
                                        <Setter Property="Fill" Value="#bf616a" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Top"
                               FontSize="12" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#d8dee9" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Passed}" Value="False">
                                        <Setter Property="Foreground" Value="#bf616a" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#a3be8c" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Passed}" Value="False">
                                            <Setter Property="Foreground" Value="#bf616a" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Suggestion}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="#ebcb8b"
                                   Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSuggestion}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- DataGrid 单行样式：让表格贴合暗色主题 -->
            <Style x:Key="BandGridStyle" TargetType="DataGrid">
                <Setter Property="Background" Value="#2a2e38" />
                <Setter Property="Foreground" Value="#d8dee9" />
                <Setter Property="BorderBrush" Value="#4c566a" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="#4c566a" />
                <Setter Property="RowBackground" Value="#2a2e38" />
                <Setter Property="AlternatingRowBackground" Value="#303642" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="RowHeight" Value="26" />
                <Setter Property="ColumnHeaderHeight" Value="24" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#4c566a" BorderThickness="1">
        <DockPanel>

            <!-- ===== 自定义标题栏 ===== -->
            <Border DockPanel.Dock="Top" Background="#1e222a" Height="30">
                <Grid>
                    <TextBlock Text="{Binding Title}" Foreground="#d8dee9" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="✕" Style="{StaticResource CloseTitleBtn}" Click="BtnClose_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 底部按钮行 ===== -->
            <Border DockPanel.Dock="Bottom" Background="#3b4453" Padding="8,6"
                    BorderBrush="#4c566a" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock VerticalAlignment="Center" FontSize="11" FontFamily="Consolas"
                                   Foreground="#808080" Margin="4,0,0,0">
                            <Run Text="左半" />
                            <Run Text="{Binding LeftHalfWidth, StringFormat=F2, Mode=OneWay}" />
                            <Run Text="m / 右半" />
                            <Run Text="{Binding RightHalfWidth, StringFormat=F2, Mode=OneWay}" />
                            <Run Text="m / 路幅" />
                            <Run Text="{Binding TotalWidth, StringFormat=F2, Mode=OneWay}" />
                            <Run Text="m" />
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center" FontSize="11"
                                   Margin="16,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#a3be8c" />
                                    <Setter Property="Text" Value="全部规范项通过" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AllChecksPassed}" Value="False">
                                            <Setter Property="Foreground" Value="#bf616a" />
                                            <Setter Property="Text" Value="有规范项未通过（可强制确定）" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="确定并出图" Style="{StaticResource ActionBtn}"
                                Command="{Binding ConfirmCommand}"
                                IsDefault="True" />
                        <Button Content="取消" Style="{StaticResource ActionBtn}"
                                Command="{Binding CancelCommand}"
                                IsCancel="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 主体：左列参数、中列画布预览、右列规范检查 ===== -->
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <!-- ========== 左列：全局参数 + 条带表格 ========== -->
                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 全局参数栏 -->
                    <Border Grid.Row="0" Style="{StaticResource SectionBorder}">
                        <StackPanel>
                            <TextBlock Text="全局参数" Style="{StaticResource SectionHeader}" />

                            <!-- 预设下拉 -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CJJ 37 预设" Style="{StaticResource ParamLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Presets}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="PresetCombo_SelectionChanged"
                                          x:Name="PresetCombo"
                                          FontSize="12" />
                            </Grid>

                            <!-- 设计速度 -->
                            <Grid Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="设计速度 V(km/h)" Style="{StaticResource ParamLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableSpeeds}"
                                          SelectedItem="{Binding DesignSpeed, Mode=TwoWay}"
                                          FontFamily="Consolas" FontSize="12" />
                            </Grid>

                            <!-- 比例尺 -->
                            <Grid Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="比例尺 1 :" Style="{StaticResource ParamLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableScales}"
                                          SelectedItem="{Binding ScaleDenominator, Mode=TwoWay}"
                                          FontFamily="Consolas" FontSize="12" />
                            </Grid>

                            <!-- 中分带宽 -->
                            <Grid Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="中分带宽 (m)" Style="{StaticResource ParamLabel}" />
                                <TextBox Grid.Column="1" Style="{StaticResource NumericTextBox}"
                                         Text="{Binding CenterMedianWidth, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" />
                            </Grid>

                            <!-- 标题 -->
                            <Grid Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="图名标题" Style="{StaticResource ParamLabel}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" />
                            </Grid>

                            <CheckBox Content="左右对称（镜像锁）" IsChecked="{Binding IsMirror}"
                                      Foreground="#d8dee9" FontSize="12" Margin="0,8,0,4" />
                        </StackPanel>
                    </Border>

                    <!-- 条带表格区 -->
                    <Border Grid.Row="1" Style="{StaticResource SectionBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="条带（中→外）"
                                       Style="{StaticResource SectionHeader}" />

                            <!-- 上方工具栏 -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="＋左" Command="{Binding AddLeftBandCommand}"
                                        Style="{StaticResource ToolbarBtn}" ToolTip="在左半末尾追加条带" />
                                <Button Content="＋右" Command="{Binding AddRightBandCommand}"
                                        Style="{StaticResource ToolbarBtn}" ToolTip="在右半末尾追加条带" />
                                <Button Content="×删除" Command="{Binding RemoveBandCommand}"
                                        Style="{StaticResource ToolbarBtn}" ToolTip="删除当前选中行" />
                                <Button Content="↑" Command="{Binding MoveUpCommand}"
                                        Style="{StaticResource ToolbarBtn}" ToolTip="把选中行向内侧移动一格" />
                                <Button Content="↓" Command="{Binding MoveDownCommand}"
                                        Style="{StaticResource ToolbarBtn}" ToolTip="把选中行向外侧移动一格" />
                            </StackPanel>

                            <!-- 左右两个 DataGrid 并排（上下分栏：左半在上，右半在下） -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="左半（由中心向外）"
                                           Foreground="#88c0d0" FontSize="11" Margin="0,0,0,2" />
                                <DataGrid Grid.Row="1" x:Name="LeftGrid"
                                          ItemsSource="{Binding LeftBands}"
                                          SelectionChanged="AnyGrid_SelectionChanged"
                                          Style="{StaticResource BandGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                        <DataGridComboBoxColumn Header="类型"
                                                                ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableKinds}"
                                                                SelectedItemBinding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="100" />
                                        <DataGridTextColumn Header="宽(m)" Width="60"
                                                            Binding="{Binding Width, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="横坡%" Width="60"
                                                            Binding="{Binding CrossSlopePct, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Grid.Row="2" Text="右半（由中心向外）"
                                           Foreground="#88c0d0" FontSize="11" Margin="0,6,0,2" />
                                <DataGrid Grid.Row="3" x:Name="RightGrid"
                                          ItemsSource="{Binding RightBands}"
                                          SelectionChanged="AnyGrid_SelectionChanged"
                                          Style="{StaticResource BandGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                        <DataGridComboBoxColumn Header="类型"
                                                                ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableKinds}"
                                                                SelectedItemBinding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="100" />
                                        <DataGridTextColumn Header="宽(m)" Width="60"
                                                            Binding="{Binding Width, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="横坡%" Width="60"
                                                            Binding="{Binding CrossSlopePct, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ========== 中列：Canvas 预览 ========== -->
                <Border Grid.Column="1" Style="{StaticResource SectionBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="实时预览（单位 m）"
                                   Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Border Background="#1c1f26" BorderBrush="#4c566a" BorderThickness="1"
                                    CornerRadius="2">
                                <Canvas x:Name="PreviewCanvas" ClipToBounds="True"
                                        Background="Transparent"
                                        SizeChanged="PreviewCanvas_SizeChanged" />
                            </Border>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Margin="0,0,8,4"
                                       Foreground="#5e6779" FontSize="10" FontFamily="Consolas"
                                       Text="按 [N] 新建 / [L] 载入预设 / [Enter] 确定 / [Esc] 取消" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- ========== 右列：规范检查 ========== -->
                <Border Grid.Column="2" Style="{StaticResource SectionBorder}"
                        Margin="8,0,0,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <TextBlock Text="规范检查（CJJ 37）" Style="{StaticResource SectionHeader}" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="SemiBold"
                                       Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#a3be8c" />
                                        <Setter Property="Text" Value="✓ 全部通过" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AllChecksPassed}" Value="False">
                                                <Setter Property="Foreground" Value="#bf616a" />
                                                <Setter Property="Text" Value="✗ 有未通过项" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CheckItems}"
                                          ItemTemplate="{StaticResource CheckItemTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
