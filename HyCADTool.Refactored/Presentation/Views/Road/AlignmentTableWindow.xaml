<bui:BlenderWindow x:Class="HyCADTool.Refactored.Presentation.Views.Road.AlignmentTableWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
                   Title="Alignment 分段表"
                   HeaderTitle="{Binding HeaderTitle}"
                   Width="960" Height="620"
                   MinWidth="760" MinHeight="520"
                   WindowStartupLocation="CenterOwner">

    <bui:BlenderWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/BlenderTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool.Refactored;component/Presentation/Resources/RoadDesignerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </bui:BlenderWindow.Resources>

    <!-- 顶部摘要 + 底部关闭 -->
    <bui:BlenderWindow.FooterLeftContent>
        <TextBlock Foreground="{DynamicResource Brush_TextSecondary}"
                   FontSize="11"
                   FontFamily="Consolas"
                   VerticalAlignment="Center"
                   Text="{Binding AlignmentSummary}"/>
    </bui:BlenderWindow.FooterLeftContent>

    <bui:BlenderWindow.FooterRightContent>
        <StackPanel Orientation="Horizontal">
            <Button Content="关闭"
                    Style="{StaticResource BlenderButton}"
                    Command="{Binding CloseCommand}"
                    IsDefault="True"
                    IsCancel="True"
                    MinWidth="80"
                    Margin="4,0"/>
        </StackPanel>
    </bui:BlenderWindow.FooterRightContent>

    <!-- 主体：PropertyEditor 双 Tab（段表 / 几何点表） -->
    <bui:PropertyEditor Title="Sub-Entity 全表"
                        SelectedTabIndex="0"
                        ShowSearch="False"
                        ShowPin="False"
                        ShowIconBar="True"
                        x:Name="MainEditor">

        <bui:PropertyEditor.Tabs>
            <x:Array Type="{x:Type bui:IconTabItem}">
                <bui:IconTabItem TooltipText="段表（直/缓/圆）">
                    <bui:IconTabItem.Icon>
                        <Path Width="16" Height="16"
                              Data="M 1,4 L 15,4 M 1,8 L 15,8 M 1,12 L 15,12"
                              Stroke="{DynamicResource Brush_TextPrimary}"
                              StrokeThickness="1.4"
                              Fill="Transparent"
                              Stretch="Uniform"/>
                    </bui:IconTabItem.Icon>
                </bui:IconTabItem>
                <bui:IconTabItem TooltipText="几何点表（BP/BC/EC/TS/SC/CS/ST/EP）">
                    <bui:IconTabItem.Icon>
                        <Path Width="16" Height="16"
                              Data="M 2,14 L 6,14 L 6,10 L 2,10 Z  M 10,8 L 14,8 L 14,4 L 10,4 Z  M 6,12 L 10,6"
                              Stroke="{DynamicResource Brush_TextPrimary}"
                              StrokeThickness="1.2"
                              Fill="Transparent"
                              Stretch="Uniform"/>
                    </bui:IconTabItem.Icon>
                </bui:IconTabItem>
            </x:Array>
        </bui:PropertyEditor.Tabs>

        <Grid>
            <!-- Tab 0：段表 -->
            <DataGrid Visibility="{Binding SelectedTabIndex, ElementName=MainEditor, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0}"
                      ItemsSource="{Binding Segments}"
                      SelectedItem="{Binding SelectedSegment, Mode=TwoWay}"
                      Style="{StaticResource RoadBandGridStyle}"
                      IsReadOnly="True"
                      Margin="0,2,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Width="40"
                                        Binding="{Binding DisplayIndex}"/>
                    <DataGridTextColumn Header="类型" Width="48"
                                        Binding="{Binding KindLabel}"/>
                    <DataGridTextColumn Header="起桩号" Width="110"
                                        Binding="{Binding StationStart}"/>
                    <DataGridTextColumn Header="止桩号" Width="110"
                                        Binding="{Binding StationEnd}"/>
                    <DataGridTextColumn Header="长度 (m)" Width="90"
                                        Binding="{Binding Length}"/>
                    <DataGridTextColumn Header="R (m)" Width="90"
                                        Binding="{Binding Radius}"/>
                    <DataGridTextColumn Header="Ls / A" Width="180"
                                        Binding="{Binding LsOrA}"/>
                    <DataGridTextColumn Header="偏角 (°)" Width="90"
                                        Binding="{Binding DeflectionDeg}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Tab 1：几何点表 -->
            <DataGrid Visibility="{Binding SelectedTabIndex, ElementName=MainEditor, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1}"
                      ItemsSource="{Binding GeometryPoints}"
                      Style="{StaticResource RoadBandGridStyle}"
                      IsReadOnly="True"
                      Margin="0,2,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="点名" Width="70"
                                        Binding="{Binding Kind}"/>
                    <DataGridTextColumn Header="桩号" Width="130"
                                        Binding="{Binding Station}"/>
                    <DataGridTextColumn Header="X" Width="140"
                                        Binding="{Binding X}"/>
                    <DataGridTextColumn Header="Y" Width="140"
                                        Binding="{Binding Y}"/>
                    <DataGridTextColumn Header="所属 PI" Width="80"
                                        Binding="{Binding PiIndex}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </bui:PropertyEditor>
</bui:BlenderWindow>
