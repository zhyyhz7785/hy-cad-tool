<bui:BlenderWindow x:Class="HyCADTool.Refactored.Presentation.Views.Road.ProfileEditorWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
                   Title="纵断面设计"
                   HeaderTitle="{Binding Title}"
                   Width="900" Height="640"
                   MinWidth="780" MinHeight="540"
                   WindowStartupLocation="CenterOwner">

    <bui:BlenderWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                  自包含 Merge：仅引入 BlenderTheme + 共享 RoadDesignerStyles。
                  与 PiThreeUnitWindow / CrossSectionDesignerWindow 一致，避免隐式 Style 污染 PaletteSet。
                -->
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/BlenderTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool.Refactored;component/Presentation/Resources/RoadDesignerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </bui:BlenderWindow.Resources>

    <!-- ========== Footer 左：PVI 数 / Alignment 长度 ========== -->
    <bui:BlenderWindow.FooterLeftContent>
        <TextBlock Foreground="{DynamicResource Brush_TextSecondary}"
                   FontSize="11"
                   FontFamily="Consolas"
                   VerticalAlignment="Center">
            <Run Text="PVI "/>
            <Run Text="{Binding Vertices.Count, Mode=OneWay}"/>
            <Run Text="  Aln L="/>
            <Run Text="{Binding AlignmentLength, StringFormat=F2, Mode=OneWay}"/>
            <Run Text="m"/>
        </TextBlock>
    </bui:BlenderWindow.FooterLeftContent>

    <!-- ========== Footer 状态：4 项 + 几何告警摘要 ========== -->
    <bui:BlenderWindow.StatusContent>
        <TextBlock VerticalAlignment="Center"
                   FontSize="11"
                   Text="{Binding SummaryText}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Brush_Success}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AllChecksPassed}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush_Warning}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </bui:BlenderWindow.StatusContent>

    <!-- ========== Footer 右：确定 / 取消 ========== -->
    <bui:BlenderWindow.FooterRightContent>
        <StackPanel Orientation="Horizontal">
            <Button Content="确定"
                    Style="{StaticResource BlenderButton}"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True"
                    MinWidth="80"
                    Margin="4,0"/>
            <Button Content="取消"
                    Style="{StaticResource BlenderButton}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    MinWidth="80"
                    Margin="4,0"/>
        </StackPanel>
    </bui:BlenderWindow.FooterRightContent>

    <!-- ========== 主体：PropertyEditor 三 Tab ========== -->
    <bui:PropertyEditor Title="纵断面设计"
                        SelectedTabIndex="0"
                        ShowSearch="False"
                        ShowPin="False"
                        ShowIconBar="True"
                        x:Name="MainEditor">

        <bui:PropertyEditor.Tabs>
            <x:Array Type="{x:Type bui:IconTabItem}">
                <bui:IconTabItem TooltipText="PVI 表">
                    <bui:IconTabItem.Icon>
                        <!-- 表格图标 -->
                        <Path Width="16" Height="16"
                              Data="M 1,2 L 15,2 L 15,14 L 1,14 Z M 1,6 L 15,6 M 1,10 L 15,10 M 8,2 L 8,14"
                              Stroke="{DynamicResource Brush_TextPrimary}"
                              StrokeThickness="1.0"
                              Fill="Transparent"
                              Stretch="Uniform"/>
                    </bui:IconTabItem.Icon>
                </bui:IconTabItem>
                <bui:IconTabItem TooltipText="规范检查">
                    <bui:IconTabItem.Icon>
                        <Path Width="16" Height="16"
                              Data="M 2,8 L 6,12 L 14,3"
                              Stroke="{DynamicResource Brush_TextPrimary}"
                              StrokeThickness="1.6"
                              Fill="Transparent"
                              Stretch="Uniform"/>
                    </bui:IconTabItem.Icon>
                </bui:IconTabItem>
                <bui:IconTabItem TooltipText="纵断面图">
                    <bui:IconTabItem.Icon>
                        <!-- 折线 + 抛物线 图标 -->
                        <Path Width="16" Height="16"
                              Data="M 1,12 L 5,6 C 6,4 10,4 11,6 L 15,12"
                              Stroke="{DynamicResource Brush_TextPrimary}"
                              StrokeThickness="1.4"
                              Fill="Transparent"
                              Stretch="Uniform"/>
                    </bui:IconTabItem.Icon>
                </bui:IconTabItem>
            </x:Array>
        </bui:PropertyEditor.Tabs>

        <!-- ========== Tab 容器：Grid 内三 Panel 互斥 Visibility ========== -->
        <Grid>
            <!-- ========== Tab 0：PVI 表 ========== -->
            <Grid Visibility="{Binding SelectedTabIndex, ElementName=MainEditor, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部参数行 -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Brush_HeaderBack}"
                        BorderBrush="{DynamicResource Brush_BorderDark}"
                        BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="设计速度 (km/h):"
                                   Style="{StaticResource RoadParamLabelStyle}"
                                   Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableSpeeds}"
                                  SelectedItem="{Binding DesignSpeed, Mode=TwoWay}"
                                  Style="{StaticResource BlenderComboBox}"/>

                        <Button Grid.Column="3"
                                Content="+ 添加 PVI"
                                Style="{StaticResource BlenderButton}"
                                Command="{Binding AddPviCommand}"
                                MinWidth="100"/>
                    </Grid>
                </Border>

                <!-- PVI 表 -->
                <DataGrid Grid.Row="1"
                          x:Name="PviGrid"
                          ItemsSource="{Binding Vertices}"
                          Style="{StaticResource RoadBandGridStyle}"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          AutoGenerateColumns="False"
                          Margin="0,0,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding Index, Mode=OneWay}"
                                            IsReadOnly="True"
                                            Width="36"/>
                        <DataGridTextColumn Header="桩号 K (m)"
                                            Binding="{Binding Station, StringFormat=F3, UpdateSourceTrigger=LostFocus}"
                                            Width="110"/>
                        <DataGridTextColumn Header="高程 H (m)"
                                            Binding="{Binding Elevation, StringFormat=F3, UpdateSourceTrigger=LostFocus}"
                                            Width="110"/>
                        <DataGridTextColumn Header="半径 R (m)"
                                            Binding="{Binding CurveRadius, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                            Width="100"/>
                        <DataGridTextColumn Header="g_in (%)"
                                            Binding="{Binding GradePercentIn, StringFormat=+0.000;-0.000;0.000, Mode=OneWay}"
                                            IsReadOnly="True"
                                            Width="80"/>
                        <DataGridTextColumn Header="g_out (%)"
                                            Binding="{Binding GradePercentOut, StringFormat=+0.000;-0.000;0.000, Mode=OneWay}"
                                            IsReadOnly="True"
                                            Width="80"/>
                        <DataGridTextColumn Header="ω (%)"
                                            Binding="{Binding OmegaPercent, StringFormat=+0.000;-0.000;0.000, Mode=OneWay}"
                                            IsReadOnly="True"
                                            Width="80"/>
                        <DataGridTextColumn Header="L (m)"
                                            Binding="{Binding CurveLength, StringFormat=F2, Mode=OneWay}"
                                            IsReadOnly="True"
                                            Width="80"/>
                        <DataGridTextColumn Header="类型"
                                            Binding="{Binding CurveTypeText, Mode=OneWay}"
                                            IsReadOnly="True"
                                            Width="46"/>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕"
                                            Style="{StaticResource BlenderButton}"
                                            Command="{Binding DataContext.RemovePviCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="删除 PVI（保留至少 2 个端点）"
                                            Margin="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ========== Tab 1：规范检查 ========== -->
            <ScrollViewer Visibility="{Binding SelectedTabIndex, ElementName=MainEditor, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6">
                    <Expander Header="规范检查（CJJ 37 / CJJ 193，4 项）"
                              IsExpanded="True"
                              Style="{StaticResource BlenderExpander}">
                        <ItemsControl ItemsSource="{Binding CheckItems}"
                                      ItemTemplate="{StaticResource RoadCheckItemTemplate}"/>
                    </Expander>

                    <Expander Header="几何告警 / 错误（来自 ProfileFgDesigner）"
                              IsExpanded="True"
                              Style="{StaticResource BlenderExpander}"
                              Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="错误（必须修复才能确定）："
                                       Foreground="{DynamicResource Brush_TextSecondary}"
                                       FontSize="11"
                                       Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding LastFgResult.Errors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{DynamicResource Brush_Warning}"
                                                   FontSize="11"
                                                   Margin="8,1,0,1"
                                                   TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="告警（建议修复，不阻塞）："
                                       Foreground="{DynamicResource Brush_TextSecondary}"
                                       FontSize="11"
                                       Margin="0,8,0,4"/>
                            <ItemsControl ItemsSource="{Binding LastFgResult.Warnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                                   FontSize="11"
                                                   Margin="8,1,0,1"
                                                   TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== Tab 2：纵断面 Canvas ========== -->
            <Grid Visibility="{Binding SelectedTabIndex, ElementName=MainEditor, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=2}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部说明 -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Brush_HeaderBack}"
                        BorderBrush="{DynamicResource Brush_BorderDark}"
                        BorderThickness="0,0,0,1"
                        Padding="8,4">
                    <TextBlock Text="设计线（FG）：直坡 = 蓝色 / 竖曲线 = 橙色；PVI 标记 = 红点"
                               Foreground="{DynamicResource Brush_TextSecondary}"
                               FontSize="11"/>
                </Border>

                <!-- 画布区 -->
                <Border Grid.Row="1"
                        Style="{StaticResource RoadCanvasBorderStyle}"
                        Margin="6"
                        ClipToBounds="True">
                    <Canvas x:Name="ProfileCanvas"
                            Background="{DynamicResource Brush_WindowBack}"
                            SizeChanged="ProfileCanvas_SizeChanged">
                        <!-- 网格背景（在 code-behind 重绘）-->
                        <Path x:Name="GridPath"
                              Stroke="{DynamicResource Brush_BorderDark}"
                              StrokeThickness="0.5"
                              Opacity="0.5"/>
                        <!-- FG 主线（直坡 + 竖曲线）-->
                        <Path x:Name="FgPath"
                              Stroke="{DynamicResource Brush_AccentBlue}"
                              StrokeThickness="2"/>
                        <!-- PVI 标记容器（在 code-behind 动态填充）-->
                        <Canvas x:Name="MarkersLayer"/>
                        <!-- 轴标签容器 -->
                        <Canvas x:Name="LabelsLayer"/>
                    </Canvas>
                </Border>

                <!-- 底部图例 -->
                <Border Grid.Row="2"
                        Background="{DynamicResource Brush_HeaderBack}"
                        BorderBrush="{DynamicResource Brush_BorderDark}"
                        BorderThickness="0,1,0,0"
                        Padding="8,4">
                    <TextBlock Foreground="{DynamicResource Brush_TextSecondary}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Text="坐标系：水平 = 桩号 K（m，左→右）；垂直 = 高程 H（m，下→上）。Canvas 大小变化时自动适配。"/>
                </Border>
            </Grid>
        </Grid>
    </bui:PropertyEditor>
</bui:BlenderWindow>
