<bui:BlenderWindow x:Class="HyCADTool.Refactored.Presentation.Views.Road.AlignmentDefaultsWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   Title="Alignment 默认值"
                   HeaderTitle="{Binding Title}"
                   Width="520" Height="420"
                   MinWidth="480" MinHeight="360"
                   WindowStartupLocation="CenterOwner">

    <bui:BlenderWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/BlenderTheme.xaml"/>
                <d:ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool.Refactored;component/Presentation/Resources/RoadDesignerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </bui:BlenderWindow.Resources>

    <bui:BlenderWindow.FooterLeftContent>
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource Brush_TextSecondary}"
                   VerticalAlignment="Center" FontSize="11"/>
    </bui:BlenderWindow.FooterLeftContent>

    <bui:BlenderWindow.FooterRightContent>
        <StackPanel Orientation="Horizontal">
            <Button Content="恢复默认"
                    Style="{StaticResource BlenderButton}"
                    Command="{Binding ResetCommand}"
                    MinWidth="80" Margin="4,0"/>
            <Button Content="确定"
                    Style="{StaticResource BlenderButton}"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True"
                    MinWidth="80" Margin="4,0"/>
            <Button Content="取消"
                    Style="{StaticResource BlenderButton}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    MinWidth="80" Margin="4,0"/>
        </StackPanel>
    </bui:BlenderWindow.FooterRightContent>

    <bui:PropertyEditor Title="默认参数"
                        SelectedTabIndex="0"
                        ShowSearch="False"
                        ShowPin="False"
                        ShowIconBar="False">
        <Grid>
            <StackPanel>
                <Expander Header="默认值（hy-settings.json）" IsExpanded="True"
                          Style="{StaticResource BlenderExpander}">
                    <StackPanel>
                        <bui:PropertyRow Label="默认半径 R (m)">
                            <bui:NumericSlider Value="{Binding DefaultRadius, Mode=TwoWay}"
                                               Minimum="0" Maximum="5000" Step="5"
                                               Decimals="3" Unit="m"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="默认 Ls_in (m)">
                            <bui:NumericSlider Value="{Binding DefaultSpiralIn, Mode=TwoWay}"
                                               Minimum="0" Maximum="500" Step="1"
                                               Decimals="3" Unit="m"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="默认 Ls_out (m)">
                            <bui:NumericSlider Value="{Binding DefaultSpiralOut, Mode=TwoWay}"
                                               Minimum="0" Maximum="500" Step="1"
                                               Decimals="3" Unit="m"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="默认起桩号 (m)">
                            <bui:NumericSlider Value="{Binding DefaultStartStation, Mode=TwoWay}"
                                               Minimum="-100000" Maximum="1000000" Step="10"
                                               Decimals="3" Unit="m"/>
                        </bui:PropertyRow>
                    </StackPanel>
                </Expander>
                <TextBlock Margin="8,8,8,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush_TextSecondary}" FontSize="10"
                           Text="说明：修改后将写入 %APPDATA%\HyCADTool\hy-settings.json。hyRoadAlnByPi 起始回车值、Alignment.StartStation 初值将从此处读取。"/>
            </StackPanel>
        </Grid>
    </bui:PropertyEditor>

</bui:BlenderWindow>
