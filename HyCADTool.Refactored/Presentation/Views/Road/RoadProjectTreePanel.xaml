<UserControl x:Class="HyCADTool.Refactored.Presentation.Views.Road.RoadProjectTreePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
             xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
             xmlns:vm="clr-namespace:HyCADTool.Refactored.Presentation.ViewModels.Road"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="320"
             d:DataContext="{d:DesignInstance Type=vm:RoadProjectTreeViewModel, IsDesignTimeCreatable=False}"
             Background="{DynamicResource Brush_WindowBack}"
             Foreground="{DynamicResource Brush_TextPrimary}"
             FontFamily="{DynamicResource Font_Main}"
             FontSize="{DynamicResource Metric_FontMain}"
             btmetrics:BlenderMetricsOverlay.Attach="True">

    <!--
        045 / M3：项目树面板（Road Project Tree）

        设计要点（对齐 hycad-project-pitfalls / wpf-paletteset-resource-pitfalls skill）：
        · UserControl 本地 Merge BlenderTheme + RoadDesignerStyles，避免 PaletteSet 宿主隐式 Style 污染；
        · DynamicResource 只用在 Brush/Font/Metric 上；Style 全走 StaticResource（或不取，默认模板）；
        · TreeView 使用单一 HierarchicalDataTemplate（DataType=RoadTreeNode），
          由 ItemsSource 递归展开 RoadTreeNode.Children；
        · 节点双击 / 右键菜单 留给 M4 接入（本阶段仅骨架 + 搜索 + 状态栏）。
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/BlenderTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool.Refactored;component/Presentation/Resources/RoadDesignerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                节点模板：递归 HierarchicalDataTemplate。
                字段绑定：Header / Detail / Children；用 CheckBox 不做（与 Outliner 区分，Outliner 是条带 VM）。
            -->
            <HierarchicalDataTemplate DataType="{x:Type vm:RoadTreeNode}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" ToolTip="{Binding Header}">
                    <TextBlock Text="{Binding Header}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush_TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               Foreground="{DynamicResource Brush_TextSecondary}"
                               FontSize="{DynamicResource Metric_FontSmall}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </HierarchicalDataTemplate>

            <!--
                ItemContainerStyle：把 RoadTreeNode.IsExpanded / IsSelected 与 TreeViewItem 双向绑定，
                保证 ViewModel 主动改选时 TreeView 会跟随（CrossSectionDrawWindow 大纲同款模式）。
                双击 → MouseDoubleClick 路由到 code-behind 再转 VM.OpenCommand。
            -->
            <Style x:Key="Road_TreeViewItemStyle" TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                <Setter Property="Padding" Value="2,1"/>
                <EventSetter Event="MouseDoubleClick" Handler="OnTreeItemDoubleClick"/>
            </Style>

            <!--
                右键 ContextMenu：所有命令都路由到 RoadProjectTreeViewModel 的 RelayCommand，
                由 ICommand.CanExecute 过滤。CommandTarget 用 TreeView.SelectedItem（PlacementTarget.SelectedItem）。
                注意：ContextMenu 不在视觉树内，不能直接 Binding 上游 DataContext —— 必须走 PlacementTarget。
            -->
            <ContextMenu x:Key="Road_TreeNodeContextMenu">
                <MenuItem Header="打开 (双击)"
                          Command="{Binding PlacementTarget.DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <MenuItem Header="定位到图形 (ZoomTo)"
                          Command="{Binding PlacementTarget.DataContext.ZoomToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>
                <MenuItem Header="重命名"
                          Command="{Binding PlacementTarget.DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <MenuItem Header="删除"
                          Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>
                <MenuItem Header="导出 LandXML"
                          Command="{Binding PlacementTarget.DataContext.ExportLandXmlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            </ContextMenu>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：搜索框 + 刷新 -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush_HeaderBack}"
                BorderBrush="{DynamicResource Brush_BorderDark}"
                BorderThickness="0,0,0,1"
                Padding="{DynamicResource Metric_ButtonPaddingSmall}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="刷新"
                        Margin="4,0,0,0"
                        MinWidth="48"
                        Click="OnRefreshClick"
                        ToolTip="从当前 AutoCAD 文档重新加载项目数据"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         VerticalContentAlignment="Center"
                         ToolTip="按节点名搜索（Ctrl+F）"/>
            </DockPanel>
        </Border>

        <!-- 主体：项目树 -->
        <TreeView x:Name="PART_Tree"
                  Grid.Row="1"
                  ItemsSource="{Binding Roots}"
                  ItemContainerStyle="{StaticResource Road_TreeViewItemStyle}"
                  ContextMenu="{StaticResource Road_TreeNodeContextMenu}"
                  BorderThickness="0"
                  Background="Transparent"
                  SelectedItemChanged="OnSelectedItemChanged"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"/>

        <!-- 状态栏：节点计数 / 当前 DWG -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush_HeaderBack}"
                BorderBrush="{DynamicResource Brush_BorderDark}"
                BorderThickness="0,1,0,0"
                Padding="6,2">
            <TextBlock Text="{Binding StatusLine}"
                       Foreground="{DynamicResource Brush_TextSecondary}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
