<bui:BlenderWindow x:Class="HyCADTool.Refactored.Presentation.Views.Road.PiThreeUnitWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
                   Title="三单元（缓-圆-缓）设计"
                   HeaderTitle="{Binding Title}"
                   Width="780" Height="560"
                   MinWidth="700" MinHeight="500"
                   WindowStartupLocation="CenterOwner">

    <bui:BlenderWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                  自包含 Merge：Window 资源仅引用 BlenderTheme 与共享 RoadDesignerStyles。
                  原 LibraryResources.xaml（Nord 配色 + 隐式 TextBox/Button 样式）已弃用，
                  避免与 BlenderUI 命名样式冲突 / 隐式样式污染 PaletteSet 子树。
                  RoadDesignerStyles 已注册 InverseBoolConverter / IndexToVisibilityConverter。
                -->
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/BlenderTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool.Refactored;component/Presentation/Resources/RoadDesignerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </bui:BlenderWindow.Resources>

    <!-- ========== 标题栏右侧（关闭按钮左侧）：暂留空 ========== -->

    <!-- ========== 命令栏：左 = JD 计数 + 状态文字 / 右 = 确定/取消 ========== -->
    <bui:BlenderWindow.FooterLeftContent>
        <TextBlock Foreground="{DynamicResource Brush_TextSecondary}"
                   FontSize="11"
                   FontFamily="Consolas"
                   VerticalAlignment="Center">
            <Run Text="JD"/>
            <Run Text="{Binding PiIndex, Mode=OneWay}"/>
            <Run Text="/"/>
            <Run Text="{Binding TotalPi, Mode=OneWay}"/>
        </TextBlock>
    </bui:BlenderWindow.FooterLeftContent>

    <bui:BlenderWindow.StatusContent>
        <TextBlock VerticalAlignment="Center" FontSize="11">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Brush_Success}"/>
                    <Setter Property="Text" Value="✓ 全部规范项通过"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AllChecksPassed}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush_Warning}"/>
                            <Setter Property="Text" Value="✗ 有规范项未通过（可强制确定）"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </bui:BlenderWindow.StatusContent>

    <bui:BlenderWindow.FooterRightContent>
        <StackPanel Orientation="Horizontal">
            <Button Content="确定"
                    Style="{StaticResource BlenderButton}"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True"
                    MinWidth="80"
                    Margin="4,0"/>
            <Button Content="取消"
                    Style="{StaticResource BlenderButton}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    MinWidth="80"
                    Margin="4,0"/>
        </StackPanel>
    </bui:BlenderWindow.FooterRightContent>

    <!-- ========== 主体：PropertyEditor 三 Tab ========== -->
    <bui:PropertyEditor Title="三单元参数"
                        SelectedTabIndex="0"
                        ShowSearch="False"
                        ShowPin="False"
                        ShowIconBar="True"
                        x:Name="MainEditor">

        <bui:PropertyEditor.Tabs>
            <x:Array Type="{x:Type bui:IconTabItem}">
                <bui:IconTabItem TooltipText="参数">
                    <bui:IconTabItem.Icon>
                        <!-- 滑块图标：类似设置 -->
                        <Path Width="16" Height="16"
                              Data="M 1,4 L 15,4 M 4,4 A 1,1 0 1 1 4,5 M 1,8 L 15,8 M 11,8 A 1,1 0 1 1 11,9 M 1,12 L 15,12 M 7,12 A 1,1 0 1 1 7,13"
                              Stroke="{DynamicResource Brush_TextPrimary}"
                              StrokeThickness="1.2"
                              Fill="Transparent"
                              Stretch="Uniform"/>
                    </bui:IconTabItem.Icon>
                </bui:IconTabItem>
                <bui:IconTabItem TooltipText="规范检查">
                    <bui:IconTabItem.Icon>
                        <!-- 勾号图标 -->
                        <Path Width="16" Height="16"
                              Data="M 2,8 L 6,12 L 14,3"
                              Stroke="{DynamicResource Brush_TextPrimary}"
                              StrokeThickness="1.6"
                              Fill="Transparent"
                              Stretch="Uniform"/>
                    </bui:IconTabItem.Icon>
                </bui:IconTabItem>
                <bui:IconTabItem TooltipText="示意图">
                    <bui:IconTabItem.Icon>
                        <!-- 曲线示意图标 -->
                        <Path Width="16" Height="16"
                              Data="M 1,12 L 5,12 C 7,12 9,4 13,4 L 15,4"
                              Stroke="{DynamicResource Brush_TextPrimary}"
                              StrokeThickness="1.4"
                              Fill="Transparent"
                              Stretch="Uniform"/>
                    </bui:IconTabItem.Icon>
                </bui:IconTabItem>
            </x:Array>
        </bui:PropertyEditor.Tabs>

        <!-- ========== Tab 容器：Grid 内三 Panel 互斥 Visibility ========== -->
        <Grid>
            <!-- ========== Tab 0：参数 ========== -->
            <StackPanel Visibility="{Binding SelectedTabIndex, ElementName=MainEditor, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0}">

                <Expander Header="输入" IsExpanded="True" Style="{StaticResource BlenderExpander}">
                    <StackPanel>
                        <bui:PropertyRow Label="设计速度 V (km/h)">
                            <ComboBox ItemsSource="{Binding AvailableSpeeds}"
                                      SelectedItem="{Binding DesignSpeed, Mode=TwoWay}"
                                      Style="{StaticResource BlenderComboBox}"/>
                        </bui:PropertyRow>

                        <bui:PropertyRow Label="圆曲线半径 R (m)">
                            <bui:NumericSlider Value="{Binding Radius, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="5000"
                                               Step="5"
                                               Decimals="3"
                                               Unit="m"/>
                        </bui:PropertyRow>

                        <bui:PropertyRow Label="对称锁">
                            <CheckBox Content="Ls1 = Ls2（对称）"
                                      IsChecked="{Binding IsSymmetric}"
                                      Style="{StaticResource BlenderCheckBox}"
                                      VerticalAlignment="Center"/>
                        </bui:PropertyRow>

                        <bui:PropertyRow Label="入侧缓长 Ls1 (m)">
                            <bui:NumericSlider Value="{Binding SpiralIn, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="500"
                                               Step="1"
                                               Decimals="3"
                                               Unit="m"/>
                        </bui:PropertyRow>

                        <bui:PropertyRow Label="出侧缓长 Ls2 (m)">
                            <bui:NumericSlider Value="{Binding SpiralOut, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="500"
                                               Step="1"
                                               Decimals="3"
                                               Unit="m"
                                               IsEnabled="{Binding IsSymmetric, Converter={StaticResource InverseBoolConverter}}"/>
                        </bui:PropertyRow>
                    </StackPanel>
                </Expander>

                <Expander Header="派生量（实时）" IsExpanded="True" Style="{StaticResource BlenderExpander}">
                    <StackPanel>
                        <bui:PropertyRow Label="转角 α">
                            <TextBlock Text="{Binding TurnAngleText}"
                                       Style="{StaticResource RoadDerivedTextStyle}"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="入切线 T1 (m)">
                            <TextBlock Text="{Binding T1, StringFormat=F3}"
                                       Style="{StaticResource RoadDerivedTextStyle}"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="出切线 T2 (m)">
                            <TextBlock Text="{Binding T2, StringFormat=F3}"
                                       Style="{StaticResource RoadDerivedTextStyle}"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="圆曲线长 Ly (m)">
                            <TextBlock Text="{Binding Ly, StringFormat=F3}"
                                       Style="{StaticResource RoadDerivedTextStyle}"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="前直线段 (m)">
                            <TextBlock Text="{Binding PrevTangent, StringFormat=F3}"
                                       Style="{StaticResource RoadDerivedSecondaryTextStyle}"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="后直线段 (m)">
                            <TextBlock Text="{Binding NextTangent, StringFormat=F3}"
                                       Style="{StaticResource RoadDerivedSecondaryTextStyle}"/>
                        </bui:PropertyRow>
                    </StackPanel>
                </Expander>

            </StackPanel>

            <!-- ========== Tab 1：规范检查 ========== -->
            <StackPanel Visibility="{Binding SelectedTabIndex, ElementName=MainEditor, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1}">
                <Expander Header="规范检查（6 项）" IsExpanded="True" Style="{StaticResource BlenderExpander}">
                    <ItemsControl ItemsSource="{Binding CheckItems}"
                                  ItemTemplate="{StaticResource RoadCheckItemTemplate}"/>
                </Expander>
            </StackPanel>

            <!-- ========== Tab 2：示意图 ========== -->
            <StackPanel Visibility="{Binding SelectedTabIndex, ElementName=MainEditor, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=2}">
                <Expander Header="示意图" IsExpanded="True" Style="{StaticResource BlenderExpander}">
                    <Border Style="{StaticResource RoadCanvasBorderStyle}" Padding="6">
                        <StackPanel>
                            <Viewbox Stretch="Uniform" StretchDirection="Both" MaxHeight="240">
                                <Canvas Width="320" Height="180" ClipToBounds="True">
                                    <!-- 前切线 -->
                                    <Line X1="10" Y1="120" X2="120" Y2="120"
                                          Stroke="{DynamicResource Brush_AccentBlue}" StrokeThickness="1.2"/>
                                    <TextBlock Canvas.Left="55" Canvas.Top="124" Text="前直线"
                                               Foreground="{DynamicResource Brush_TextSecondary}" FontSize="10"/>
                                    <!-- 缓曲线 1 -->
                                    <Path Stroke="{DynamicResource Brush_Warning}" StrokeThickness="1.4"
                                          Fill="Transparent"
                                          Data="M 120,120 C 140,120 155,112 165,100"/>
                                    <TextBlock Canvas.Left="125" Canvas.Top="100" Text="Ls1"
                                               Foreground="{DynamicResource Brush_Warning}" FontSize="10"/>
                                    <!-- 圆弧 -->
                                    <Path Stroke="{DynamicResource Brush_Success}" StrokeThickness="1.6"
                                          Fill="Transparent"
                                          Data="M 165,100 A 50,50 0 0,1 195,100"/>
                                    <TextBlock Canvas.Left="170" Canvas.Top="72" Text="Ly(R)"
                                               Foreground="{DynamicResource Brush_Success}" FontSize="10"/>
                                    <!-- 缓曲线 2 -->
                                    <Path Stroke="{DynamicResource Brush_Warning}" StrokeThickness="1.4"
                                          Fill="Transparent"
                                          Data="M 195,100 C 205,112 220,120 240,120"/>
                                    <TextBlock Canvas.Left="213" Canvas.Top="100" Text="Ls2"
                                               Foreground="{DynamicResource Brush_Warning}" FontSize="10"/>
                                    <!-- 后切线 -->
                                    <Line X1="240" Y1="120" X2="310" Y2="120"
                                          Stroke="{DynamicResource Brush_AccentBlue}" StrokeThickness="1.2"/>
                                    <TextBlock Canvas.Left="260" Canvas.Top="124" Text="后直线"
                                               Foreground="{DynamicResource Brush_TextSecondary}" FontSize="10"/>

                                    <!-- JD 点 -->
                                    <Ellipse Canvas.Left="176" Canvas.Top="48" Width="6" Height="6"
                                             Fill="{DynamicResource Brush_Warning}"/>
                                    <TextBlock Canvas.Left="185" Canvas.Top="40" Text="JD"
                                               Foreground="{DynamicResource Brush_Warning}" FontSize="10"/>
                                    <!-- 切线虚线 -->
                                    <Line X1="120" Y1="120" X2="180" Y2="54"
                                          Stroke="{DynamicResource Brush_BorderDark}" StrokeThickness="0.6"
                                          StrokeDashArray="2,2"/>
                                    <Line X1="180" Y1="54" X2="240" Y2="120"
                                          Stroke="{DynamicResource Brush_BorderDark}" StrokeThickness="0.6"
                                          StrokeDashArray="2,2"/>

                                    <!-- 标注 -->
                                    <TextBlock Canvas.Left="10" Canvas.Top="8"
                                               Foreground="{DynamicResource Brush_AccentBlue}"
                                               FontSize="11" FontFamily="Consolas">
                                        <Run Text="R = "/>
                                        <Run Text="{Binding Radius, StringFormat=F2, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Canvas.Left="10" Canvas.Top="24"
                                               Foreground="{DynamicResource Brush_Warning}"
                                               FontSize="11" FontFamily="Consolas">
                                        <Run Text="Ls = "/>
                                        <Run Text="{Binding SpiralIn, StringFormat=F2, Mode=OneWay}"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding SpiralOut, StringFormat=F2, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Canvas.Left="10" Canvas.Top="40"
                                               Foreground="{DynamicResource Brush_Success}"
                                               FontSize="11" FontFamily="Consolas">
                                        <Run Text="α = "/>
                                        <Run Text="{Binding TurnAngleText, Mode=OneWay}"/>
                                    </TextBlock>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Foreground="{DynamicResource Brush_TextSecondary}"
                                       FontSize="9"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Text="说明：窗口内真实预览使用 AutoCAD 瞬态图形绘制，此处仅用于结构说明。"/>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </Grid>
    </bui:PropertyEditor>

</bui:BlenderWindow>
