<bui:BlenderWindow x:Class="HyCADTool.Refactored.Presentation.Views.Road.CrossSectionDrawWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
                   xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
                   xmlns:vm="clr-namespace:HyCADTool.Refactored.Presentation.ViewModels.Road"
                   xmlns:road="clr-namespace:HyCADTool.Refactored.Domain.Models.Road;assembly=HyCADTool.Refactored"
                   xmlns:ms="clr-namespace:HyCADTool.Refactored.Domain.Services.Road;assembly=HyCADTool.Refactored"
                   xmlns:behaviors="clr-namespace:HyCADTool.Refactored.Presentation.Behaviors"
                   xmlns:cv="clr-namespace:HyCADTool.Refactored.Presentation.Views.Converters"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   btmetrics:BlenderMetricsOverlay.Attach="True"
                   Title="横断面绘制（v2）"
                   HeaderTitle="{Binding Title}"
                   Width="1340" Height="780"
                   MinWidth="1100" MinHeight="640"
                   WindowStartupLocation="CenterOwner">

    <!--
      v2 BlenderUI workbench 风格四区布局，替代 v1 的 CrossSectionDesignerWindow：
        Row 0  顶部 EditorHeader  - 主操作链（新建/载入/隐藏侧栏/镜像）+ 预设下拉
        Row 1  主体 5 列：
               | Outliner (大纲) | V-Splitter | ViewportArea (Toolbar + Canvas) | V-Splitter | PropertyEditor (属性) |
        Row 2  底部 StatusBar    - 路幅 / 当前选中条带 / 规范检查通过状况

      该窗口与旧 CrossSectionDesignerWindow 共用：
        - CrossSectionDesignerViewModel（基类）业务逻辑；
        - CrossSectionPreviewRenderer 绘制规则。
      区别仅在 UI 拓扑与可显隐侧栏，确保 Stage 1 的 v2 路牙凸起与 Domain 模型在新窗口里直接落地。
    -->

    <bui:BlenderWindow.Resources>
        <ResourceDictionary>
            <cv:DoublePrecisionMultiConverter x:Key="DoublePrecisionMultiConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/BlenderTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool.Refactored;component/Presentation/Resources/RoadDesignerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </bui:BlenderWindow.Resources>

    <!-- ============================================================ -->
    <!--  HeaderRightContent：标题栏右上小工具                            -->
    <!-- ============================================================ -->
    <bui:BlenderWindow.HeaderRightContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <!-- M7.4 绘图模式切换 -->
            <RadioButton Content="厚度轮廓"
                         GroupName="DrawMode"
                         IsChecked="{Binding UseStructureThicknessMode, Mode=TwoWay}"
                         ToolTip="带结构厚度轮廓出图（含面层/基层/垫层/填充）"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0"/>
            <RadioButton Content="单线"
                         GroupName="DrawMode"
                         IsChecked="{Binding UseSingleLineMode, Mode=TwoWay}"
                         ToolTip="仅顶面投影 + 中心线（M7.4，平面图用）"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"/>

            <ToggleButton Content="大纲"
                          ToolTip="显示 / 隐藏 左侧大纲面板（条带列表）"
                          IsChecked="{Binding IsOutlinerVisible}"
                          Style="{StaticResource BlenderToggleButton}"
                          MinWidth="{DynamicResource Metric_InputWidth_XS}" Height="{DynamicResource Metric_RowCompact}" Margin="0,0,4,0"/>
            <ToggleButton Content="属性"
                          ToolTip="显示 / 隐藏 右侧属性面板"
                          IsChecked="{Binding IsPropertyPaneVisible}"
                          Style="{StaticResource BlenderToggleButton}"
                          MinWidth="{DynamicResource Metric_InputWidth_XS}" Height="{DynamicResource Metric_RowCompact}" Margin="0,0,8,0"/>

            <TextBlock Text="预设："
                       Foreground="{DynamicResource Brush_TextSecondary}"
                       FontSize="{DynamicResource Metric_FontSmall}"
                       VerticalAlignment="Center"
                       Margin="0,0,4,0"/>
            <ComboBox x:Name="PresetCombo"
                      ItemsSource="{Binding Presets}"
                      DisplayMemberPath="DisplayName"
                      Style="{StaticResource BlenderComboBox}"
                      SelectionChanged="PresetCombo_SelectionChanged"
                      MinWidth="{DynamicResource Metric_HeaderComboMinWidth}"/>
        </StackPanel>
    </bui:BlenderWindow.HeaderRightContent>

    <!-- ============================================================ -->
    <!--  Footer 三槽：左侧路幅信息 / 中央检查状态 / 右侧 确定 / 取消         -->
    <!-- ============================================================ -->
    <bui:BlenderWindow.FooterLeftContent>
        <TextBlock VerticalAlignment="Center"
                   FontSize="{DynamicResource Metric_FontSmall}" FontFamily="Consolas"
                   Foreground="{DynamicResource Brush_TextSecondary}">
            <Run Text="左半"/>
            <Run>
                <Run.Text>
                    <MultiBinding Mode="OneWay"
                                  Converter="{StaticResource DoublePrecisionMultiConverter}">
                        <Binding Path="LeftHalfWidth"/>
                        <Binding Path="DisplayPrecision"/>
                    </MultiBinding>
                </Run.Text>
            </Run>
            <Run Text="m / 右半"/>
            <Run>
                <Run.Text>
                    <MultiBinding Mode="OneWay"
                                  Converter="{StaticResource DoublePrecisionMultiConverter}">
                        <Binding Path="RightHalfWidth"/>
                        <Binding Path="DisplayPrecision"/>
                    </MultiBinding>
                </Run.Text>
            </Run>
            <Run Text="m / 路幅"/>
            <Run>
                <Run.Text>
                    <MultiBinding Mode="OneWay"
                                  Converter="{StaticResource DoublePrecisionMultiConverter}">
                        <Binding Path="TotalWidth"/>
                        <Binding Path="DisplayPrecision"/>
                    </MultiBinding>
                </Run.Text>
            </Run>
            <Run Text="m"/>
        </TextBlock>
    </bui:BlenderWindow.FooterLeftContent>

    <bui:BlenderWindow.StatusContent>
        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Metric_FontSmall}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Brush_Success}"/>
                    <Setter Property="Text" Value="✓ 全部规范项通过"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AllChecksPassed}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush_Warning}"/>
                            <Setter Property="Text" Value="✗ 有规范项未通过（可强制确定）"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </bui:BlenderWindow.StatusContent>

    <bui:BlenderWindow.FooterRightContent>
        <StackPanel Orientation="Horizontal">
            <Button Content="确定并出图"
                    Style="{StaticResource BlenderButton}"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True"
                    MinWidth="{DynamicResource Metric_InputWidth_ML}"
                    Margin="4,0"/>
            <Button Content="取消"
                    Style="{StaticResource BlenderButton}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    MinWidth="{DynamicResource Metric_DialogButtonWidth}"
                    Margin="4,0"/>
        </StackPanel>
    </bui:BlenderWindow.FooterRightContent>

    <!-- ============================================================ -->
    <!--  主体 Grid：3 行（菜单条 / 主体 / StatusBar）                     -->
    <!-- ============================================================ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====================================================== -->
        <!--  Row 0：EditorHeader 主操作链                            -->
        <!-- ====================================================== -->
        <bui:EditorHeader Grid.Row="0">
            <bui:EditorHeader.LeftContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="新建（Alt+N）"
                            Style="{StaticResource BlenderButtonFlat}"
                            ToolTip="重置为城市主干路标准断面"
                            Click="NewMenu_Click"
                            Padding="{DynamicResource Metric_Padding_8_2}" Margin="2,0"/>
                    <Button Content="载入预设（Alt+L）"
                            Style="{StaticResource BlenderButtonFlat}"
                            ToolTip="展开预设下拉"
                            Click="LoadPresetMenu_Click"
                            Padding="{DynamicResource Metric_Padding_8_2}" Margin="2,0"/>

                    <Separator Margin="6,2"/>

                    <CheckBox Content="左右镜像"
                              IsChecked="{Binding IsMirror}"
                              Style="{StaticResource BlenderCheckBox}"
                              VerticalAlignment="Center"
                              Margin="2,0,8,0"/>

                    <Separator Margin="6,2"/>

                    <Button Content="复制条带"
                            Style="{StaticResource BlenderButtonFlat}"
                            Command="{Binding CopySelectedBandCommand}"
                            Padding="{DynamicResource Metric_ButtonPaddingSmall}" Margin="2,0"/>
                    <Button Content="粘贴"
                            Style="{StaticResource BlenderButtonFlat}"
                            Command="{Binding PasteBandCommand}"
                            IsEnabled="{Binding HasClipboard}"
                            Padding="{DynamicResource Metric_ButtonPaddingSmall}" Margin="2,0"/>
                </StackPanel>
            </bui:EditorHeader.LeftContent>

            <bui:EditorHeader.RightContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedSideLabel}"
                               Foreground="{DynamicResource Brush_TextSecondary}"
                               FontSize="{DynamicResource Metric_FontSmall}"
                               VerticalAlignment="Center"
                               Margin="6,0"/>
                </StackPanel>
            </bui:EditorHeader.RightContent>
        </bui:EditorHeader>

        <!-- ====================================================== -->
        <!--  Row 1：主体 5 列                                       -->
        <!-- ====================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OutlinerColumn" Width="500" MinWidth="420"/>
                <ColumnDefinition x:Name="OutlinerSplitterColumn" Width="4"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition x:Name="PropertySplitterColumn" Width="4"/>
                <ColumnDefinition x:Name="PropertyColumn" Width="340" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- ============================== Col 0：Outliner (TreeView 三段) ============================== -->
            <bui:PropertyEditor Grid.Column="0"
                                x:Name="OutlinerPanel"
                                Title="大纲"
                                ShowSearch="False"
                                ShowPin="False"
                                ShowIconBar="False">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,4">
                        <Button Content="＋ 添加"
                                Click="OutlinerAddButton_Click"
                                Style="{StaticResource BlenderButtonFlat}"
                                Padding="{DynamicResource Metric_Padding_8_2}"
                                ToolTip="在选中行后插入新条带（右键点单种类型）">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="机动车道" Tag="{x:Static road:TemplateComponentKind.Pavement}" Click="OutlinerAddMenuItem_Click"/>
                                    <MenuItem Header="非机动车道" Tag="{x:Static road:TemplateComponentKind.NonMotorized}" Click="OutlinerAddMenuItem_Click"/>
                                    <MenuItem Header="人行道" Tag="{x:Static road:TemplateComponentKind.Sidewalk}" Click="OutlinerAddMenuItem_Click"/>
                                    <MenuItem Header="绿化带" Tag="{x:Static road:TemplateComponentKind.GreenStrip}" Click="OutlinerAddMenuItem_Click"/>
                                    <MenuItem Header="路牙" Tag="{x:Static road:TemplateComponentKind.Kerb}" Click="OutlinerAddMenuItem_Click"/>
                                    <MenuItem Header="中分带" Tag="{x:Static road:TemplateComponentKind.MedianStrip}" Click="OutlinerAddMenuItem_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="− 删除"
                                Command="{Binding RemoveBandCommand}"
                                Margin="4,0,0,0"
                                Style="{StaticResource BlenderButtonFlat}"
                                Padding="{DynamicResource Metric_Padding_8_2}"
                                ToolTip="删除当前选中条带（Del）"/>
                    </StackPanel>
                    <Grid Margin="22,0,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="板块"
                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                   FontSize="{DynamicResource Metric_FontSmall}"/>
                        <TextBlock Grid.Column="1"
                                   Text="宽度"
                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                   FontSize="{DynamicResource Metric_FontSmall}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="横坡"
                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                   FontSize="{DynamicResource Metric_FontSmall}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3"
                                   Text="内端"
                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                   FontSize="{DynamicResource Metric_FontSmall}"
                                   HorizontalAlignment="Center"
                                   ToolTip="内端高差(m)：本行与上一行共享边的 Y 跳变，正值 = 本行内缘更高"/>
                        <TextBlock Grid.Column="4"
                                   Text="外端"
                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                   FontSize="{DynamicResource Metric_FontSmall}"
                                   HorizontalAlignment="Center"
                                   ToolTip="外端高差(m)：本行与下一行共享边的 Y 跳变，正值 = 本行外缘更高"/>
                    </Grid>
                    <TreeView x:Name="OutlinerTree"
                              ItemsSource="{Binding OutlineRoot}"
                              SelectedItemChanged="OutlinerTree_SelectedItemChanged"
                              Style="{StaticResource BlenderOutliner}"
                              BorderThickness="0"
                              Background="Transparent"
                              AllowDrop="True"
                              behaviors:OutlinerDragDropBehavior.Enabled="True">
                    <TreeView.ItemContainerStyle>
                        <!--
                            基于 BlenderOutlinerItem，追加 IsSelected / IsExpanded 两向绑定到节点 VM，
                            使得 VM-侧（Add/Paste 等）改 SelectedBand 时 TreeView 可视化跟随。
                        -->
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource BlenderOutlinerItem}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <TreeView.Resources>
                        <!-- 中央隔离带节点：列式布局，与条带同表头 -->
                        <DataTemplate DataType="{x:Type vm:MedianOutlineNode}">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                                              Style="{StaticResource BlenderCheckBox}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"
                                              ToolTip="启用 / 取消中央隔离带"/>
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               Foreground="{DynamicResource Brush_TextPrimary}"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource Metric_FontMain}"/>
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource BlenderNumField}"
                                         ToolTip="宽度(m)">
                                    <TextBox.Text>
                                        <MultiBinding Mode="TwoWay"
                                                      UpdateSourceTrigger="LostFocus"
                                                      Converter="{StaticResource DoublePrecisionMultiConverter}">
                                            <Binding Path="Width" Mode="TwoWay"/>
                                            <Binding Path="DataContext.DisplayPrecision"
                                                     RelativeSource="{RelativeSource AncestorType={x:Type bui:BlenderWindow}}"/>
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>
                                <TextBox Grid.Column="2"
                                         Style="{StaticResource BlenderNumField}"
                                         IsEnabled="False"
                                         Text=""/>
                                <TextBox Grid.Column="3"
                                         Style="{StaticResource BlenderNumField}"
                                         IsEnabled="False"
                                         Text=""/>
                                <TextBox Grid.Column="4"
                                         Style="{StaticResource BlenderNumField}"
                                         IsEnabled="False"
                                         Text=""/>
                            </Grid>
                        </DataTemplate>

                        <!-- 左/右侧根节点：展开显示子条带 -->
                        <HierarchicalDataTemplate DataType="{x:Type vm:SideOutlineNode}"
                                                  ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding DisplayTitle}"
                                       Foreground="{DynamicResource Brush_TextSecondary}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource Metric_FontMain}"/>
                        </HierarchicalDataTemplate>

                        <!-- 条带节点：板块 / 宽度 / 横坡 / 内端高差 / 外端高差 -->
                        <DataTemplate DataType="{x:Type vm:BandRowViewModel}">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsActive, Mode=TwoWay}"
                                              Style="{StaticResource BlenderCheckBox}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,4,0"
                                              ToolTip="是否启用此条带"/>
                                    <Border Grid.Column="1"
                                            Width="4" Margin="0,2,4,2"
                                            CornerRadius="1"
                                            Background="{Binding Kind, Converter={StaticResource KindToColorBrushConverter}}"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Name}"
                                               Foreground="{DynamicResource Brush_TextPrimary}"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource Metric_FontMain}"/>
                                </Grid>
                                <TextBox Grid.Column="1"
                                         ToolTip="宽度(m)"
                                         Style="{StaticResource BlenderNumField}">
                                    <TextBox.Text>
                                        <MultiBinding Mode="TwoWay"
                                                      UpdateSourceTrigger="LostFocus"
                                                      Converter="{StaticResource DoublePrecisionMultiConverter}">
                                            <Binding Path="Width" Mode="TwoWay"/>
                                            <Binding Path="DataContext.DisplayPrecision"
                                                     RelativeSource="{RelativeSource AncestorType={x:Type bui:BlenderWindow}}"/>
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>
                                <TextBox Grid.Column="2"
                                         ToolTip="横坡(%)"
                                         Style="{StaticResource BlenderNumField}">
                                    <TextBox.Text>
                                        <MultiBinding Mode="TwoWay"
                                                      UpdateSourceTrigger="LostFocus"
                                                      Converter="{StaticResource DoublePrecisionMultiConverter}">
                                            <Binding Path="CrossSlopePct" Mode="TwoWay"/>
                                            <Binding Path="DataContext.DisplayPrecision"
                                                     RelativeSource="{RelativeSource AncestorType={x:Type bui:BlenderWindow}}"/>
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>
                                <TextBox Grid.Column="3"
                                         ToolTip="内端高差(m)：本行与上一行共享边的 Y 跳变，正值=本行内缘更高；相邻两行共享边只应一行填值"
                                         Style="{StaticResource BlenderNumField}">
                                    <TextBox.Text>
                                        <MultiBinding Mode="TwoWay"
                                                      UpdateSourceTrigger="LostFocus"
                                                      Converter="{StaticResource DoublePrecisionMultiConverter}">
                                            <Binding Path="InnerElevationDiff" Mode="TwoWay"/>
                                            <Binding Path="DataContext.DisplayPrecision"
                                                     RelativeSource="{RelativeSource AncestorType={x:Type bui:BlenderWindow}}"/>
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>
                                <TextBox Grid.Column="4"
                                         ToolTip="外端高差(m)：本行与下一行共享边的 Y 跳变，正值=本行外缘更高"
                                         Style="{StaticResource BlenderNumField}">
                                    <TextBox.Text>
                                        <MultiBinding Mode="TwoWay"
                                                      UpdateSourceTrigger="LostFocus"
                                                      Converter="{StaticResource DoublePrecisionMultiConverter}">
                                            <Binding Path="ElevationDiff" Mode="TwoWay"/>
                                            <Binding Path="DataContext.DisplayPrecision"
                                                     RelativeSource="{RelativeSource AncestorType={x:Type bui:BlenderWindow}}"/>
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>
                            </Grid>
                        </DataTemplate>
                    </TreeView.Resources>
                    </TreeView>
                </StackPanel>
            </bui:PropertyEditor>

            <!-- ============================== Col 1：左侧 Splitter ============================== -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource Brush_BorderDark}"
                          ShowsPreview="False"/>

            <!-- ============================== Col 2：ViewportArea ============================== -->
            <Grid Grid.Column="2">
                <!-- Canvas 预览（外裹 PropertyEditor 形成 mini header） -->
                <bui:PropertyEditor
                                    Title="实时预览（单位 m）"
                                    ShowSearch="False"
                                    ShowPin="False"
                                    ShowIconBar="False">
                    <Grid>
                        <Border Style="{StaticResource RoadCanvasBorderStyle}">
                            <Canvas x:Name="PreviewCanvas"
                                    ClipToBounds="True"
                                    Background="Transparent"
                                    SizeChanged="PreviewCanvas_SizeChanged"/>
                        </Border>
                        <TextBlock HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,8,4"
                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                   FontSize="{DynamicResource Metric_FontCaption}"
                                   FontFamily="Consolas"
                                   Text="按 [Alt+N] 新建 / [Alt+L] 预设 / [Ctrl+C/V] 复制粘贴 / [Ctrl+Enter] 出图 / [Esc] 取消"/>
                    </Grid>
                </bui:PropertyEditor>
            </Grid>

            <!-- ============================== Col 3：右侧 Splitter ============================== -->
            <GridSplitter Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource Brush_BorderDark}"
                          ShowsPreview="False"/>

            <!-- ============================== Col 4：PropertyEditor ============================== -->
            <bui:PropertyEditor Grid.Column="4"
                                x:Name="PropertyPanel"
                                Title="属性"
                                ShowSearch="False"
                                ShowPin="False"
                                ShowIconBar="False">
                <StackPanel>
                    <!-- ============================== 公共属性（与 Hy 主面板同级的全局项，总在最上） ============================== -->
                    <Expander Header="公共属性"
                              IsExpanded="True"
                              Style="{StaticResource BlenderExpander}">
                        <StackPanel>
                            <bui:PropertyRow Label="横断面名称">
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BlenderTextBox}"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="设计时速 (km/h)">
                                <ComboBox ItemsSource="{Binding AvailableSpeeds}"
                                          SelectedItem="{Binding DesignSpeed, Mode=TwoWay}"
                                          Style="{StaticResource BlenderComboBox}"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="比例尺 1 :">
                                <ComboBox ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableScales}"
                                          SelectedItem="{Binding ScaleDenominator, Mode=TwoWay}"
                                          Style="{StaticResource BlenderComboBox}"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="小数位">
                                <ComboBox ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableDisplayPrecisions}"
                                          SelectedItem="{Binding DisplayPrecision, Mode=TwoWay}"
                                          Style="{StaticResource BlenderComboBox}"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="中分带宽 (m)">
                                <bui:NumericSlider Value="{Binding CenterMedianWidth, Mode=TwoWay}"
                                                   Minimum="0" Maximum="20"
                                                   Step="0.5" Decimals="2" Unit="m"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="桩号范围 (m)">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding StationRangeRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="22"/>
                                                    </Grid.ColumnDefinitions>
                                                    <bui:NumericSlider Grid.Column="0" Value="{Binding StartM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="200000" Step="1" Decimals="2" Unit="m" Margin="0,0,4,0"/>
                                                    <bui:NumericSlider Grid.Column="1" Value="{Binding EndM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="200000" Step="1" Decimals="2" Unit="m" Margin="0,0,4,0"/>
                                                    <Button Grid.Column="2" Content="✕" ToolTip="删除本段"
                                                            Command="{Binding DataContext.RemoveStationRangeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource BlenderButtonFlat}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="＋ 添加桩号段" Command="{Binding AddStationRangeCommand}" Style="{StaticResource BlenderButton}" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="路面抬升 (m)">
                                <bui:NumericSlider Value="{Binding ProfileElevationOffset, Mode=TwoWay}"
                                                   Minimum="-2" Maximum="2"
                                                   Step="0.05" Decimals="3" Unit="m"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="空装配">
                                <CheckBox IsChecked="{Binding IsEmptyAssembly}"
                                          Style="{StaticResource BlenderCheckBox}"
                                          VerticalAlignment="Center"
                                          Content="标记为占位（不出图）"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="几何拾取">
                                <Button Content="从图形拾取..."
                                        Command="{Binding PickBandGeometryCommand}"
                                        IsEnabled="{Binding HasSelectedBand}"
                                        Style="{StaticResource BlenderButton}"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="拾取对象图层">
                                <TextBlock Text="{Binding LastPickedEntityLayer, TargetNullValue=—, FallbackValue=—}"
                                           Foreground="{DynamicResource Brush_TextSecondary}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </bui:PropertyRow>
                        </StackPanel>
                    </Expander>

                    <!-- ============================== 中央隔离带（选中 Median 时显示） ============================== -->
                    <Expander Header="中央隔离带"
                              IsExpanded="True"
                              Style="{StaticResource BlenderExpander}"
                              Visibility="{Binding SelectedMedianNode, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding MedianNode}">
                            <bui:PropertyRow Label="启用">
                                <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                                          Style="{StaticResource BlenderCheckBox}"
                                          VerticalAlignment="Center"
                                          Content="启用中央隔离带"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="宽度 (m)">
                                <bui:NumericSlider Value="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="0" Maximum="20"
                                                   Step="0.1" Decimals="2" Unit="m"/>
                            </bui:PropertyRow>
                        </StackPanel>
                    </Expander>

                    <!-- ============================== 选中条带：基础参数 ============================== -->
                    <Expander Header="选中条带"
                              IsExpanded="True"
                              Style="{StaticResource BlenderExpander}"
                              Visibility="{Binding ShowNonGreenSelectedBandContent, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding SelectedBand}">
                            <bui:PropertyRow Label="名称">
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BlenderTextBox}"/>
                            </bui:PropertyRow>

                            <bui:PropertyRow Label="类型">
                                <ComboBox ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableKinds}"
                                          SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource BlenderComboBox}"/>
                            </bui:PropertyRow>

                            <bui:PropertyRow Label="宽度 (m)">
                                <bui:NumericSlider Value="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="0.1" Maximum="30"
                                                   Step="0.1" Decimals="2" Unit="m"/>
                            </bui:PropertyRow>

                            <bui:PropertyRow Label="横坡 (%)">
                                <bui:NumericSlider Value="{Binding CrossSlopePct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="-20" Maximum="20"
                                                   Step="0.1" Decimals="2" Unit="%"/>
                            </bui:PropertyRow>

                            <bui:PropertyRow Label="高差 (m)">
                                <bui:NumericSlider Value="{Binding ElevationDiff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="-2" Maximum="2"
                                                   Step="0.005" Decimals="3" Unit="m"/>
                            </bui:PropertyRow>

                            <bui:PropertyRow Label="坡型">
                                <ComboBox ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableSlopeTypes}"
                                          SelectedItem="{Binding SlopeType, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource BlenderComboBox}"/>
                            </bui:PropertyRow>

                            <bui:PropertyRow Label="路拱形式">
                                <ComboBox ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableCrownProfiles}"
                                          SelectedItem="{Binding CrownProfile, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource BlenderComboBox}"/>
                            </bui:PropertyRow>

                            <bui:PropertyRow Label="路面结构">
                                <ComboBox ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableSurfaceLayers}"
                                          SelectedItem="{Binding SurfaceLayer, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource BlenderComboBox}"/>
                            </bui:PropertyRow>

                            <bui:PropertyRow Label="车道数">
                                <bui:NumericSlider Value="{Binding LaneCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="0" Maximum="6"
                                                   Step="1" Decimals="0"/>
                            </bui:PropertyRow>
                        </StackPanel>
                    </Expander>

                    <Expander Header="路面结构"
                              IsExpanded="True"
                              Style="{StaticResource BlenderPropertyGroupLevel1}"
                              Visibility="{Binding SelectedBand.HasStructureLayers, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <StackPanel DataContext="{Binding SelectedBand}">
                            <Expander Header="面层"
                                      IsExpanded="True"
                                      Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding SurfaceLayersView}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander IsExpanded="True" Style="{StaticResource BlenderPropertyGroupLevel3}">
                                                    <Expander.Header>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="24"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding LayerHeaderDisplay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding LayerHeaderDisplay}"/>
                                                            <Button Grid.Column="1" Content="✕" ToolTip="删除本层"
                                                                    Command="{Binding DataContext.RemoveStructureLayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, Mode=FindAncestor, AncestorLevel=1}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource BlenderButtonFlat}"/>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <StackPanel>
                                                        <bui:PropertyRow Label="厚度(cm)">
                                                            <bui:NumericSlider Value="{Binding ThicknessCm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="80" Step="0.5" Decimals="1" Unit="cm"/>
                                                        </bui:PropertyRow>
                                                        <bui:PropertyRow Label="填料">
                                                            <ComboBox IsEditable="True" StaysOpenOnEdit="True"
                                                                      ItemsSource="{Binding Source={x:Static ms:RoadMaterialFillPresets.Surface}}"
                                                                      Text="{Binding FillMaterial, UpdateSourceTrigger=LostFocus}"
                                                                      Style="{StaticResource BlenderComboBox}"/>
                                                        </bui:PropertyRow>
                                                        <bui:PropertyRow Label="填充符号">
                                                            <TextBox Text="{Binding PatternName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BlenderTextBox}"/>
                                                        </bui:PropertyRow>
                                                    </StackPanel>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="＋添加面层" Command="{Binding AddSurfaceLayerCommand}" IsEnabled="{Binding CanAddSurfaceLayer}" Style="{StaticResource BlenderButton}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Expander>

                            <Expander Header="基层"
                                      IsExpanded="True"
                                      Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding BaseLayersView}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander IsExpanded="True" Style="{StaticResource BlenderPropertyGroupLevel3}">
                                                    <Expander.Header>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="24"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding LayerHeaderDisplay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding LayerHeaderDisplay}"/>
                                                            <Button Grid.Column="1" Content="✕" ToolTip="删除本层"
                                                                    Command="{Binding DataContext.RemoveStructureLayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, Mode=FindAncestor, AncestorLevel=1}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource BlenderButtonFlat}"/>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <StackPanel>
                                                        <bui:PropertyRow Label="厚度(cm)">
                                                            <bui:NumericSlider Value="{Binding ThicknessCm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="80" Step="0.5" Decimals="1" Unit="cm"/>
                                                        </bui:PropertyRow>
                                                        <bui:PropertyRow Label="填料">
                                                            <ComboBox IsEditable="True" StaysOpenOnEdit="True"
                                                                      ItemsSource="{Binding Source={x:Static ms:RoadMaterialFillPresets.Base}}"
                                                                      Text="{Binding FillMaterial, UpdateSourceTrigger=LostFocus}"
                                                                      Style="{StaticResource BlenderComboBox}"/>
                                                        </bui:PropertyRow>
                                                        <bui:PropertyRow Label="填充符号">
                                                            <TextBox Text="{Binding PatternName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BlenderTextBox}"/>
                                                        </bui:PropertyRow>
                                                    </StackPanel>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="＋添加基层" Command="{Binding AddBaseLayerCommand}" IsEnabled="{Binding CanAddBaseLayer}" Style="{StaticResource BlenderButton}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Expander>

                            <Expander Header="垫层"
                                      IsExpanded="True"
                                      Style="{StaticResource BlenderPropertyGroupLevel2}">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding SubbaseLayersView}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander IsExpanded="True" Style="{StaticResource BlenderPropertyGroupLevel3}">
                                                    <Expander.Header>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="24"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding LayerHeaderDisplay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding LayerHeaderDisplay}"/>
                                                            <Button Grid.Column="1" Content="✕" ToolTip="删除本层"
                                                                    Command="{Binding DataContext.RemoveStructureLayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, Mode=FindAncestor, AncestorLevel=1}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource BlenderButtonFlat}"/>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <StackPanel>
                                                        <bui:PropertyRow Label="厚度(cm)">
                                                            <bui:NumericSlider Value="{Binding ThicknessCm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="80" Step="0.5" Decimals="1" Unit="cm"/>
                                                        </bui:PropertyRow>
                                                        <bui:PropertyRow Label="填料">
                                                            <ComboBox IsEditable="True" StaysOpenOnEdit="True"
                                                                      ItemsSource="{Binding Source={x:Static ms:RoadMaterialFillPresets.Subbase}}"
                                                                      Text="{Binding FillMaterial, UpdateSourceTrigger=LostFocus}"
                                                                      Style="{StaticResource BlenderComboBox}"/>
                                                        </bui:PropertyRow>
                                                        <bui:PropertyRow Label="填充符号">
                                                            <TextBox Text="{Binding PatternName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BlenderTextBox}"/>
                                                        </bui:PropertyRow>
                                                    </StackPanel>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="＋添加垫层" Command="{Binding AddSubbaseLayerCommand}" IsEnabled="{Binding CanAddSubbaseLayer}" Style="{StaticResource BlenderButton}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Expander>

                    <!-- ============================== 外侧路牙 ============================== -->
                    <Expander Header="外侧路牙"
                              IsExpanded="True"
                              Style="{StaticResource BlenderExpander}"
                              Visibility="{Binding ShowNonGreenSelectedBandContent, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding SelectedBand}">
                            <bui:PropertyRow Label="类型">
                                <ComboBox ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableKerbTypes}"
                                          SelectedItem="{Binding OuterKerbType, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource BlenderComboBox}"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="型号">
                                <TextBox Text="{Binding OuterKerbModel, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BlenderTextBox}"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="高 (m)">
                                <bui:NumericSlider Value="{Binding OuterKerbHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="0" Maximum="0.5"
                                                   Step="0.01" Decimals="3" Unit="m"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="宽 (m)">
                                <bui:NumericSlider Value="{Binding OuterKerbWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="0" Maximum="0.5"
                                                   Step="0.01" Decimals="3" Unit="m"/>
                            </bui:PropertyRow>
                        </StackPanel>
                    </Expander>

                    <!-- ============================== 内侧路牙 ============================== -->
                    <Expander Header="内侧路牙"
                              IsExpanded="False"
                              Style="{StaticResource BlenderExpander}"
                              Visibility="{Binding ShowNonGreenSelectedBandContent, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding SelectedBand}">
                            <bui:PropertyRow Label="类型">
                                <ComboBox ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableKerbTypes}"
                                          SelectedItem="{Binding InnerKerbType, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource BlenderComboBox}"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="型号">
                                <TextBox Text="{Binding InnerKerbModel, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BlenderTextBox}"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="高 (m)">
                                <bui:NumericSlider Value="{Binding InnerKerbHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="0" Maximum="0.5"
                                                   Step="0.01" Decimals="3" Unit="m"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="宽 (m)">
                                <bui:NumericSlider Value="{Binding InnerKerbWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="0" Maximum="0.5"
                                                   Step="0.01" Decimals="3" Unit="m"/>
                            </bui:PropertyRow>
                        </StackPanel>
                    </Expander>

                    <!-- ============================== 规范检查 ============================== -->
                    <Expander Header="规范检查 (CJJ 37)"
                              IsExpanded="True"
                              Style="{StaticResource BlenderExpander}">
                        <ItemsControl ItemsSource="{Binding CheckItems}"
                                      ItemTemplate="{StaticResource RoadCheckItemTemplate}"/>
                    </Expander>
                </StackPanel>
            </bui:PropertyEditor>
        </Grid>

        <!-- ====================================================== -->
        <!--  Row 2：StatusBar                                       -->
        <!-- ====================================================== -->
        <bui:StatusBar Grid.Row="2">
            <bui:StatusBar.LeftContent>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource Brush_TextSecondary}"
                           FontSize="{DynamicResource Metric_FontSmall}"
                           VerticalAlignment="Center"
                           Margin="6,0"/>
            </bui:StatusBar.LeftContent>

            <bui:StatusBar.CenterContent>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush_TextSecondary}"
                           FontSize="{DynamicResource Metric_FontSmall}">
                    <Run Text="比例 1 :"/>
                    <Run Text="{Binding ScaleDenominator, Mode=OneWay}"/>
                    <Run Text="  V ="/>
                    <Run Text="{Binding DesignSpeed, Mode=OneWay}"/>
                    <Run Text="km/h"/>
                </TextBlock>
            </bui:StatusBar.CenterContent>

            <bui:StatusBar.RightContent>
                <TextBlock VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="{DynamicResource Metric_FontSmall}"
                           Margin="6,0"
                           Foreground="{DynamicResource Brush_TextSecondary}">
                    <Run Text="路幅 "/>
                    <Run>
                        <Run.Text>
                            <MultiBinding Mode="OneWay"
                                          Converter="{StaticResource DoublePrecisionMultiConverter}">
                                <Binding Path="TotalWidth"/>
                                <Binding Path="DisplayPrecision"/>
                            </MultiBinding>
                        </Run.Text>
                    </Run>
                    <Run Text=" m"/>
                </TextBlock>
            </bui:StatusBar.RightContent>
        </bui:StatusBar>
    </Grid>
</bui:BlenderWindow>
