<bui:BlenderWindow x:Class="HyCADTool.Refactored.Presentation.Views.Road.CrossSectionDrawWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
                   xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
                   xmlns:vm="clr-namespace:HyCADTool.Refactored.Presentation.ViewModels.Road"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   btmetrics:BlenderMetricsOverlay.Attach="True"
                   Title="横断面绘制（v2）"
                   HeaderTitle="{Binding Title}"
                   Width="1340" Height="780"
                   MinWidth="1100" MinHeight="640"
                   WindowStartupLocation="CenterOwner">

    <!--
      v2 BlenderUI workbench 风格四区布局，替代 v1 的 CrossSectionDesignerWindow：
        Row 0  顶部 EditorHeader  - 主操作链（新建/载入/隐藏侧栏/镜像）+ 预设下拉
        Row 1  主体 5 列：
               | Outliner (大纲) | V-Splitter | ViewportArea (Toolbar + Canvas) | V-Splitter | PropertyEditor (属性) |
        Row 2  底部 StatusBar    - 路幅 / 当前选中条带 / 规范检查通过状况

      该窗口与旧 CrossSectionDesignerWindow 共用：
        - CrossSectionDesignerViewModel（基类）业务逻辑；
        - CrossSectionPreviewRenderer 绘制规则。
      区别仅在 UI 拓扑与可显隐侧栏，确保 Stage 1 的 v2 路牙凸起与 Domain 模型在新窗口里直接落地。
    -->

    <bui:BlenderWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/BlenderTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool.Refactored;component/Presentation/Resources/RoadDesignerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </bui:BlenderWindow.Resources>

    <!-- ============================================================ -->
    <!--  HeaderRightContent：标题栏右上小工具                            -->
    <!-- ============================================================ -->
    <bui:BlenderWindow.HeaderRightContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <!-- M7.4 绘图模式切换 -->
            <RadioButton Content="厚度轮廓"
                         GroupName="DrawMode"
                         IsChecked="{Binding UseStructureThicknessMode, Mode=TwoWay}"
                         ToolTip="带结构厚度轮廓出图（含面层/基层/垫层/填充）"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0"/>
            <RadioButton Content="单线"
                         GroupName="DrawMode"
                         IsChecked="{Binding UseSingleLineMode, Mode=TwoWay}"
                         ToolTip="仅顶面投影 + 中心线（M7.4，平面图用）"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"/>

            <ToggleButton Content="大纲"
                          ToolTip="显示 / 隐藏 左侧大纲面板（条带列表）"
                          IsChecked="{Binding IsOutlinerVisible}"
                          Style="{StaticResource BlenderToggleButton}"
                          MinWidth="{DynamicResource Metric_InputWidth_XS}" Height="{DynamicResource Metric_RowCompact}" Margin="0,0,4,0"/>
            <ToggleButton Content="属性"
                          ToolTip="显示 / 隐藏 右侧属性面板"
                          IsChecked="{Binding IsPropertyPaneVisible}"
                          Style="{StaticResource BlenderToggleButton}"
                          MinWidth="{DynamicResource Metric_InputWidth_XS}" Height="{DynamicResource Metric_RowCompact}" Margin="0,0,8,0"/>

            <TextBlock Text="预设："
                       Foreground="{DynamicResource Brush_TextSecondary}"
                       FontSize="{DynamicResource Metric_FontSmall}"
                       VerticalAlignment="Center"
                       Margin="0,0,4,0"/>
            <ComboBox x:Name="PresetCombo"
                      ItemsSource="{Binding Presets}"
                      DisplayMemberPath="DisplayName"
                      Style="{StaticResource BlenderComboBox}"
                      SelectionChanged="PresetCombo_SelectionChanged"
                      MinWidth="{DynamicResource Metric_HeaderComboMinWidth}"/>
        </StackPanel>
    </bui:BlenderWindow.HeaderRightContent>

    <!-- ============================================================ -->
    <!--  Footer 三槽：左侧路幅信息 / 中央检查状态 / 右侧 确定 / 取消         -->
    <!-- ============================================================ -->
    <bui:BlenderWindow.FooterLeftContent>
        <TextBlock VerticalAlignment="Center"
                   FontSize="{DynamicResource Metric_FontSmall}" FontFamily="Consolas"
                   Foreground="{DynamicResource Brush_TextSecondary}">
            <Run Text="左半"/>
            <Run Text="{Binding LeftHalfWidth, StringFormat=F2, Mode=OneWay}"/>
            <Run Text="m / 右半"/>
            <Run Text="{Binding RightHalfWidth, StringFormat=F2, Mode=OneWay}"/>
            <Run Text="m / 路幅"/>
            <Run Text="{Binding TotalWidth, StringFormat=F2, Mode=OneWay}"/>
            <Run Text="m"/>
        </TextBlock>
    </bui:BlenderWindow.FooterLeftContent>

    <bui:BlenderWindow.StatusContent>
        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Metric_FontSmall}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Brush_Success}"/>
                    <Setter Property="Text" Value="✓ 全部规范项通过"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AllChecksPassed}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush_Warning}"/>
                            <Setter Property="Text" Value="✗ 有规范项未通过（可强制确定）"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </bui:BlenderWindow.StatusContent>

    <bui:BlenderWindow.FooterRightContent>
        <StackPanel Orientation="Horizontal">
            <Button Content="确定并出图"
                    Style="{StaticResource BlenderButton}"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True"
                    MinWidth="{DynamicResource Metric_InputWidth_ML}"
                    Margin="4,0"/>
            <Button Content="取消"
                    Style="{StaticResource BlenderButton}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    MinWidth="{DynamicResource Metric_DialogButtonWidth}"
                    Margin="4,0"/>
        </StackPanel>
    </bui:BlenderWindow.FooterRightContent>

    <!-- ============================================================ -->
    <!--  主体 Grid：3 行（菜单条 / 主体 / StatusBar）                     -->
    <!-- ============================================================ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====================================================== -->
        <!--  Row 0：EditorHeader 主操作链                            -->
        <!-- ====================================================== -->
        <bui:EditorHeader Grid.Row="0">
            <bui:EditorHeader.LeftContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="新建（Alt+N）"
                            Style="{StaticResource BlenderButtonFlat}"
                            ToolTip="重置为城市主干路标准断面"
                            Click="NewMenu_Click"
                            Padding="{DynamicResource Metric_Padding_8_2}" Margin="2,0"/>
                    <Button Content="载入预设（Alt+L）"
                            Style="{StaticResource BlenderButtonFlat}"
                            ToolTip="展开预设下拉"
                            Click="LoadPresetMenu_Click"
                            Padding="{DynamicResource Metric_Padding_8_2}" Margin="2,0"/>

                    <Separator Margin="6,2"/>

                    <CheckBox Content="左右镜像"
                              IsChecked="{Binding IsMirror}"
                              Style="{StaticResource BlenderCheckBox}"
                              VerticalAlignment="Center"
                              Margin="2,0,8,0"/>

                    <Separator Margin="6,2"/>

                    <Button Content="复制条带"
                            Style="{StaticResource BlenderButtonFlat}"
                            Command="{Binding CopySelectedBandCommand}"
                            Padding="{DynamicResource Metric_ButtonPaddingSmall}" Margin="2,0"/>
                    <Button Content="粘贴"
                            Style="{StaticResource BlenderButtonFlat}"
                            Command="{Binding PasteBandCommand}"
                            IsEnabled="{Binding HasClipboard}"
                            Padding="{DynamicResource Metric_ButtonPaddingSmall}" Margin="2,0"/>
                </StackPanel>
            </bui:EditorHeader.LeftContent>

            <bui:EditorHeader.RightContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedSideLabel}"
                               Foreground="{DynamicResource Brush_TextSecondary}"
                               FontSize="{DynamicResource Metric_FontSmall}"
                               VerticalAlignment="Center"
                               Margin="6,0"/>
                </StackPanel>
            </bui:EditorHeader.RightContent>
        </bui:EditorHeader>

        <!-- ====================================================== -->
        <!--  Row 1：主体 5 列                                       -->
        <!-- ====================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OutlinerColumn" Width="280" MinWidth="200"/>
                <ColumnDefinition x:Name="OutlinerSplitterColumn" Width="4"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition x:Name="PropertySplitterColumn" Width="4"/>
                <ColumnDefinition x:Name="PropertyColumn" Width="340" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- ============================== Col 0：Outliner (TreeView 三段) ============================== -->
            <bui:PropertyEditor Grid.Column="0"
                                x:Name="OutlinerPanel"
                                Title="大纲"
                                ShowSearch="False"
                                ShowPin="False"
                                ShowIconBar="False">
                <TreeView x:Name="OutlinerTree"
                          ItemsSource="{Binding OutlineRoot}"
                          SelectedItemChanged="OutlinerTree_SelectedItemChanged"
                          Style="{StaticResource BlenderOutliner}"
                          BorderThickness="0"
                          Background="Transparent">
                    <TreeView.ItemContainerStyle>
                        <!--
                            基于 BlenderOutlinerItem，追加 IsSelected / IsExpanded 两向绑定到节点 VM，
                            使得 VM-侧（Add/Paste 等）改 SelectedBand 时 TreeView 可视化跟随。
                        -->
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource BlenderOutlinerItem}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <TreeView.Resources>
                        <!-- 中央隔离带节点：checkbox + NumericSlider 并排 -->
                        <DataTemplate DataType="{x:Type vm:MedianOutlineNode}">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsActive, Mode=TwoWay}"
                                          Style="{StaticResource BlenderCheckBox}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0"
                                          ToolTip="启用 / 取消中央隔离带"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayTitle}"
                                           Foreground="{DynamicResource Brush_TextPrimary}"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource Metric_FontMain}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Width, StringFormat=F2 m}"
                                           Foreground="{DynamicResource Brush_TextSecondary}"
                                           FontSize="{DynamicResource Metric_FontSmall}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>

                        <!-- 左/右侧根节点：展开显示子条带 -->
                        <HierarchicalDataTemplate DataType="{x:Type vm:SideOutlineNode}"
                                                  ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding DisplayTitle}"
                                       Foreground="{DynamicResource Brush_TextSecondary}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource Metric_FontMain}"/>
                        </HierarchicalDataTemplate>

                        <!-- 条带节点：启用 checkbox + 类型色条 + 名称 + 宽度 -->
                        <DataTemplate DataType="{x:Type vm:BandRowViewModel}">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsActive, Mode=TwoWay}"
                                          Style="{StaticResource BlenderCheckBox}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,4,0"
                                          ToolTip="是否启用此条带"/>
                                <Border Grid.Column="1"
                                        Width="4" Margin="0,2,4,2"
                                        CornerRadius="1"
                                        Background="{Binding Kind, Converter={StaticResource KindToColorBrushConverter}}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Name}"
                                           Foreground="{DynamicResource Brush_TextPrimary}"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource Metric_FontMain}"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Width, StringFormat=F2 m}"
                                           Foreground="{DynamicResource Brush_TextSecondary}"
                                           FontSize="{DynamicResource Metric_FontSmall}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </bui:PropertyEditor>

            <!-- ============================== Col 1：左侧 Splitter ============================== -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource Brush_BorderDark}"
                          ShowsPreview="False"/>

            <!-- ============================== Col 2：ViewportArea ============================== -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧竖直 Toolbar：增删改条带 -->
                <bui:Toolbar Grid.Column="0">
                    <Button ToolTip="在左半末尾追加条带"
                            Command="{Binding AddLeftBandCommand}"
                            Style="{StaticResource BlenderButtonFlat}"
                            Content="＋左"
                            Padding="{DynamicResource Metric_Padding_6_4}" Margin="2"/>
                    <Button ToolTip="在右半末尾追加条带"
                            Command="{Binding AddRightBandCommand}"
                            Style="{StaticResource BlenderButtonFlat}"
                            Content="＋右"
                            Padding="{DynamicResource Metric_Padding_6_4}" Margin="2"/>
                    <Button ToolTip="删除当前选中行（Del）"
                            Command="{Binding RemoveBandCommand}"
                            Style="{StaticResource BlenderButtonFlat}"
                            Content="× 删"
                            Padding="{DynamicResource Metric_Padding_6_4}" Margin="2"/>
                    <Button ToolTip="选中行向内侧移动一格"
                            Command="{Binding MoveUpCommand}"
                            Style="{StaticResource BlenderButtonFlat}"
                            Content="↑ 内"
                            Padding="{DynamicResource Metric_Padding_6_4}" Margin="2"/>
                    <Button ToolTip="选中行向外侧移动一格"
                            Command="{Binding MoveDownCommand}"
                            Style="{StaticResource BlenderButtonFlat}"
                            Content="↓ 外"
                            Padding="{DynamicResource Metric_Padding_6_4}" Margin="2"/>
                </bui:Toolbar>

                <!-- 右侧 Canvas 预览（外裹 PropertyEditor 形成 mini header） -->
                <bui:PropertyEditor Grid.Column="1"
                                    Title="实时预览（单位 m）"
                                    ShowSearch="False"
                                    ShowPin="False"
                                    ShowIconBar="False">
                    <Grid>
                        <Border Style="{StaticResource RoadCanvasBorderStyle}">
                            <Canvas x:Name="PreviewCanvas"
                                    ClipToBounds="True"
                                    Background="Transparent"
                                    SizeChanged="PreviewCanvas_SizeChanged"/>
                        </Border>
                        <TextBlock HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,8,4"
                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                   FontSize="{DynamicResource Metric_FontCaption}"
                                   FontFamily="Consolas"
                                   Text="按 [Alt+N] 新建 / [Alt+L] 预设 / [Ctrl+C/V] 复制粘贴 / [Ctrl+Enter] 出图 / [Esc] 取消"/>
                    </Grid>
                </bui:PropertyEditor>
            </Grid>

            <!-- ============================== Col 3：右侧 Splitter ============================== -->
            <GridSplitter Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource Brush_BorderDark}"
                          ShowsPreview="False"/>

            <!-- ============================== Col 4：PropertyEditor ============================== -->
            <bui:PropertyEditor Grid.Column="4"
                                x:Name="PropertyPanel"
                                Title="属性"
                                ShowSearch="False"
                                ShowPin="False"
                                ShowIconBar="False">
                <StackPanel>
                    <!-- ============================== 中央隔离带（选中 Median 时显示） ============================== -->
                    <Expander Header="中央隔离带"
                              IsExpanded="True"
                              Style="{StaticResource BlenderExpander}"
                              Visibility="{Binding SelectedMedianNode, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding MedianNode}">
                            <bui:PropertyRow Label="启用">
                                <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                                          Style="{StaticResource BlenderCheckBox}"
                                          VerticalAlignment="Center"
                                          Content="启用中央隔离带"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="宽度 (m)">
                                <bui:NumericSlider Value="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="0" Maximum="20"
                                                   Step="0.1" Decimals="2" Unit="m"/>
                            </bui:PropertyRow>
                        </StackPanel>
                    </Expander>

                    <!-- ============================== 选中条带：基础参数 ============================== -->
                    <Expander Header="选中条带"
                              IsExpanded="True"
                              Style="{StaticResource BlenderExpander}"
                              Visibility="{Binding SelectedBand, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding SelectedBand}">
                            <bui:PropertyRow Label="名称">
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BlenderTextBox}"/>
                            </bui:PropertyRow>

                            <bui:PropertyRow Label="类型">
                                <ComboBox ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableKinds}"
                                          SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource BlenderComboBox}"/>
                            </bui:PropertyRow>

                            <bui:PropertyRow Label="宽度 (m)">
                                <bui:NumericSlider Value="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="0.1" Maximum="30"
                                                   Step="0.1" Decimals="2" Unit="m"/>
                            </bui:PropertyRow>

                            <bui:PropertyRow Label="横坡 (%)">
                                <bui:NumericSlider Value="{Binding CrossSlopePct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="-20" Maximum="20"
                                                   Step="0.1" Decimals="2" Unit="%"/>
                            </bui:PropertyRow>

                            <bui:PropertyRow Label="坡型">
                                <ComboBox ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableSlopeTypes}"
                                          SelectedItem="{Binding SlopeType, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource BlenderComboBox}"/>
                            </bui:PropertyRow>

                            <bui:PropertyRow Label="路拱形式">
                                <ComboBox ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableCrownProfiles}"
                                          SelectedItem="{Binding CrownProfile, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource BlenderComboBox}"/>
                            </bui:PropertyRow>

                            <bui:PropertyRow Label="路面结构">
                                <ComboBox ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableSurfaceLayers}"
                                          SelectedItem="{Binding SurfaceLayer, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource BlenderComboBox}"/>
                            </bui:PropertyRow>

                            <bui:PropertyRow Label="车道数">
                                <bui:NumericSlider Value="{Binding LaneCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="0" Maximum="6"
                                                   Step="1" Decimals="0"/>
                            </bui:PropertyRow>
                        </StackPanel>
                    </Expander>

                    <!-- ============================== 路面结构层（面层 / 基层 / 垫层） ============================== -->
                    <!--
                      仅当 SelectedBand.HasStructureLayers = true 时可见（即 Kind ∈ {Pavement,NonMotorized,Sidewalk}）。
                      三路添加按钮 + 上移/下移/删除 + 列表 + 当前层详情（类型 / 厚度 / 名称 / 填料）。
                    -->
                    <Expander Header="路面结构层"
                              IsExpanded="True"
                              Style="{StaticResource BlenderExpander}"
                              Visibility="{Binding SelectedBand.HasStructureLayers, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <StackPanel DataContext="{Binding SelectedBand}">
                            <bui:PropertyRow Label="新增层">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="面层"
                                            Command="{Binding AddSurfaceLayerCommand}"
                                            Style="{StaticResource BlenderButton}"
                                            Margin="0,0,4,0" MinWidth="52"/>
                                    <Button Content="基层"
                                            Command="{Binding AddBaseLayerCommand}"
                                            Style="{StaticResource BlenderButton}"
                                            Margin="0,0,4,0" MinWidth="52"/>
                                    <Button Content="垫层"
                                            Command="{Binding AddSubbaseLayerCommand}"
                                            Style="{StaticResource BlenderButton}"
                                            MinWidth="52"/>
                                </StackPanel>
                            </bui:PropertyRow>

                            <bui:PropertyRow Label="调整顺序">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="上移"
                                            Command="{Binding MoveLayerUpCommand}"
                                            Style="{StaticResource BlenderButton}"
                                            Margin="0,0,4,0" MinWidth="52"/>
                                    <Button Content="下移"
                                            Command="{Binding MoveLayerDownCommand}"
                                            Style="{StaticResource BlenderButton}"
                                            Margin="0,0,4,0" MinWidth="52"/>
                                    <Button Content="删除"
                                            Command="{Binding RemoveSelectedLayerCommand}"
                                            Style="{StaticResource BlenderButton}"
                                            MinWidth="52"/>
                                </StackPanel>
                            </bui:PropertyRow>

                            <ListBox ItemsSource="{Binding StructureLayers}"
                                     SelectedItem="{Binding ActiveStructureLayer, Mode=TwoWay}"
                                     Style="{StaticResource BlenderListBox}"
                                     MinHeight="80" MaxHeight="180"
                                     Margin="0,4,0,4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="64"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="4" Margin="0,2,4,2"
                                                    CornerRadius="1"
                                                    Background="{Binding LayerKind, Converter={StaticResource LayerKindToBrushConverter}}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding LayerKind}"
                                                       Foreground="{DynamicResource Brush_TextSecondary}"
                                                       FontSize="{DynamicResource Metric_FontSmall}"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Name}"
                                                       Foreground="{DynamicResource Brush_TextPrimary}"
                                                       FontSize="{DynamicResource Metric_FontMain}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding ThicknessCm, StringFormat={}{0:F1} cm}"
                                                       Foreground="{DynamicResource Brush_TextSecondary}"
                                                       FontSize="{DynamicResource Metric_FontSmall}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 当前选中层的详情编辑 -->
                            <StackPanel DataContext="{Binding ActiveStructureLayer}"
                                        Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}">
                                <bui:PropertyRow Label="名称">
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource BlenderTextBox}"/>
                                </bui:PropertyRow>
                                <bui:PropertyRow Label="类型">
                                    <ComboBox ItemsSource="{x:Static vm:StructureLayerViewModel.AvailableKinds}"
                                              SelectedItem="{Binding LayerKind, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource BlenderComboBox}"/>
                                </bui:PropertyRow>
                                <bui:PropertyRow Label="厚度 (cm)">
                                    <bui:NumericSlider Value="{Binding ThicknessCm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Minimum="0" Maximum="80"
                                                       Step="0.5" Decimals="1" Unit="cm"/>
                                </bui:PropertyRow>
                                <bui:PropertyRow Label="填料">
                                    <TextBox Text="{Binding FillMaterial, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource BlenderTextBox}"/>
                                </bui:PropertyRow>
                                <bui:PropertyRow Label="填充符号">
                                    <TextBox Text="{Binding PatternName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource BlenderTextBox}"/>
                                </bui:PropertyRow>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- ============================== 外侧路牙 ============================== -->
                    <Expander Header="外侧路牙"
                              IsExpanded="True"
                              Style="{StaticResource BlenderExpander}"
                              Visibility="{Binding SelectedBand, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding SelectedBand}">
                            <bui:PropertyRow Label="类型">
                                <ComboBox ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableKerbTypes}"
                                          SelectedItem="{Binding OuterKerbType, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource BlenderComboBox}"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="型号">
                                <TextBox Text="{Binding OuterKerbModel, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BlenderTextBox}"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="高 (m)">
                                <bui:NumericSlider Value="{Binding OuterKerbHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="0" Maximum="0.5"
                                                   Step="0.01" Decimals="3" Unit="m"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="宽 (m)">
                                <bui:NumericSlider Value="{Binding OuterKerbWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="0" Maximum="0.5"
                                                   Step="0.01" Decimals="3" Unit="m"/>
                            </bui:PropertyRow>
                        </StackPanel>
                    </Expander>

                    <!-- ============================== 内侧路牙 ============================== -->
                    <Expander Header="内侧路牙"
                              IsExpanded="False"
                              Style="{StaticResource BlenderExpander}"
                              Visibility="{Binding SelectedBand, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding SelectedBand}">
                            <bui:PropertyRow Label="类型">
                                <ComboBox ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableKerbTypes}"
                                          SelectedItem="{Binding InnerKerbType, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource BlenderComboBox}"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="型号">
                                <TextBox Text="{Binding InnerKerbModel, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BlenderTextBox}"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="高 (m)">
                                <bui:NumericSlider Value="{Binding InnerKerbHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="0" Maximum="0.5"
                                                   Step="0.01" Decimals="3" Unit="m"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="宽 (m)">
                                <bui:NumericSlider Value="{Binding InnerKerbWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="0" Maximum="0.5"
                                                   Step="0.01" Decimals="3" Unit="m"/>
                            </bui:PropertyRow>
                        </StackPanel>
                    </Expander>

                    <!-- ============================== 全局参数 ============================== -->
                    <Expander Header="全局参数"
                              IsExpanded="True"
                              Style="{StaticResource BlenderExpander}">
                        <StackPanel>
                            <bui:PropertyRow Label="设计速度 V (km/h)">
                                <ComboBox ItemsSource="{Binding AvailableSpeeds}"
                                          SelectedItem="{Binding DesignSpeed, Mode=TwoWay}"
                                          Style="{StaticResource BlenderComboBox}"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="比例尺 1 :">
                                <ComboBox ItemsSource="{x:Static vm:CrossSectionDesignerViewModel.AvailableScales}"
                                          SelectedItem="{Binding ScaleDenominator, Mode=TwoWay}"
                                          Style="{StaticResource BlenderComboBox}"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="中分带宽 (m)">
                                <bui:NumericSlider Value="{Binding CenterMedianWidth, Mode=TwoWay}"
                                                   Minimum="0" Maximum="20"
                                                   Step="0.5" Decimals="2" Unit="m"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="图名标题">
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BlenderTextBox}"/>
                            </bui:PropertyRow>
                        </StackPanel>
                    </Expander>

                    <!-- ============================== 桩号 / 标记 ============================== -->
                    <Expander Header="桩号 / 标记"
                              IsExpanded="False"
                              Style="{StaticResource BlenderExpander}">
                        <StackPanel>
                            <bui:PropertyRow Label="起始桩号 (m)">
                                <bui:NumericSlider Value="{Binding StationStart, Mode=TwoWay}"
                                                   Minimum="0" Maximum="100000"
                                                   Step="10" Decimals="2" Unit="m"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="终止桩号 (m)">
                                <bui:NumericSlider Value="{Binding StationEnd, Mode=TwoWay}"
                                                   Minimum="0" Maximum="100000"
                                                   Step="10" Decimals="2" Unit="m"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="路面抬升 (m)">
                                <bui:NumericSlider Value="{Binding ProfileElevationOffset, Mode=TwoWay}"
                                                   Minimum="-2" Maximum="2"
                                                   Step="0.05" Decimals="3" Unit="m"/>
                            </bui:PropertyRow>
                            <bui:PropertyRow Label="空装配">
                                <CheckBox IsChecked="{Binding IsEmptyAssembly}"
                                          Style="{StaticResource BlenderCheckBox}"
                                          VerticalAlignment="Center"
                                          Content="标记为占位（不出图）"/>
                            </bui:PropertyRow>
                        </StackPanel>
                    </Expander>

                    <!-- ============================== 规范检查 ============================== -->
                    <Expander Header="规范检查 (CJJ 37)"
                              IsExpanded="True"
                              Style="{StaticResource BlenderExpander}">
                        <ItemsControl ItemsSource="{Binding CheckItems}"
                                      ItemTemplate="{StaticResource RoadCheckItemTemplate}"/>
                    </Expander>
                </StackPanel>
            </bui:PropertyEditor>
        </Grid>

        <!-- ====================================================== -->
        <!--  Row 2：StatusBar                                       -->
        <!-- ====================================================== -->
        <bui:StatusBar Grid.Row="2">
            <bui:StatusBar.LeftContent>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource Brush_TextSecondary}"
                           FontSize="{DynamicResource Metric_FontSmall}"
                           VerticalAlignment="Center"
                           Margin="6,0"/>
            </bui:StatusBar.LeftContent>

            <bui:StatusBar.CenterContent>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush_TextSecondary}"
                           FontSize="{DynamicResource Metric_FontSmall}">
                    <Run Text="比例 1 :"/>
                    <Run Text="{Binding ScaleDenominator, Mode=OneWay}"/>
                    <Run Text="  V ="/>
                    <Run Text="{Binding DesignSpeed, Mode=OneWay}"/>
                    <Run Text="km/h"/>
                </TextBlock>
            </bui:StatusBar.CenterContent>

            <bui:StatusBar.RightContent>
                <TextBlock VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="{DynamicResource Metric_FontSmall}"
                           Margin="6,0"
                           Foreground="{DynamicResource Brush_TextSecondary}"
                           Text="{Binding TotalWidth, StringFormat=路幅 {0:F2} m, Mode=OneWay}"/>
            </bui:StatusBar.RightContent>
        </bui:StatusBar>
    </Grid>
</bui:BlenderWindow>
