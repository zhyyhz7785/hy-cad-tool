<UserControl x:Class="HyCADTool.Refactored.Presentation.Views.ReinPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Width="280"
             Background="#3b4453"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HyCADTool.Refactored;component/Presentation/Resources/LibraryResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <ScrollViewer Style="{StaticResource SmallScrollViewer}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="5,10,5,5" Background="#3b4453">
            <!-- 主图形比例 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="主图形比例" />
                <TextBox x:Name="ScaleText"
                         Grid.Column="1"
                         Text="40" />
            </Grid>
            
            <!-- 操作按钮 -->
            <Button x:Name="ApplyButton" Content="设置样式" Click="ApplyButton_Click" />
            <Button x:Name="ResetButton" Content="恢复默认值" Click="ResetButton_Click" />
            <Button x:Name="DrawButton" Content="绘制" Click="DrawButton_Click" />
            
            <!-- 标注按钮组 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button x:Name="DIM1Button" Grid.Column="0" Content="标注钢筋" Click="DIM1Button_Click" />
                <Button x:Name="DIM2Button" Grid.Column="1" Content="标注钢筋" Click="DIM2Button_Click" />
                <Button x:Name="DIM3Button" Grid.Column="2" Content="标注钢筋" Click="DIM3Button_Click" />
            </Grid>
            
            <!-- 标注参数 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="标注:" />
                <TextBlock Grid.Column="1" Text="直径" />
                <TextBox x:Name="RebarDiameterText" Grid.Column="2" Text="12" />
                <TextBlock Grid.Column="3" Text="间距" />
                <TextBox x:Name="RebarSpacingText" Grid.Column="4" Text="200" />
            </Grid>
            
            <!-- 钢筋参数折叠面板 -->
            <Expander Margin="0,5,0,5" Header="钢筋参数" IsExpanded="True">
                <StackPanel Margin="0,5,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="钢筋锚固长度" />
                        <TextBox x:Name="AnchorageLengthText" Grid.Column="1" Text="500" />
                    </Grid>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="点钢筋间距" />
                        <TextBox x:Name="DotSeparationText" Grid.Column="1" Text="200" />
                    </Grid>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="钢筋弯折最小长度" />
                        <TextBox x:Name="BendingLineMinLengthText" Grid.Column="1" Text="150" />
                    </Grid>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="锚固钢筋连接长度" />
                        <TextBox x:Name="AnchorageJoinLengthText" Grid.Column="1" Text="1500" />
                    </Grid>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="弯钩长度" />
                        <TextBox x:Name="HookLengthText" Grid.Column="1" Text="1" />
                    </Grid>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="保护层厚度" />
                        <TextBox x:Name="ProtectionThicknessText" Grid.Column="1" Text="1" />
                    </Grid>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="点钢直径" />
                        <TextBox x:Name="ReinforcementDiameterText" Grid.Column="1" Text="0.35" />
                    </Grid>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="点钢偏移" />
                        <TextBox x:Name="DotReinOffsetText" Grid.Column="1" Text="1.35" />
                    </Grid>
                </StackPanel>
            </Expander>
            
            <!-- 尺寸参数折叠面板 -->
            <Expander Margin="0,5,0,5" Header="尺寸参数">
                <StackPanel Margin="0,5,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="内侧标注距离" />
                        <TextBox x:Name="DimensionDistanceInsideText" Grid.Column="1" Text="6" />
                    </Grid>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="外标注距离" />
                        <TextBox x:Name="DimensionDistanceOutsideText" Grid.Column="1" Text="14" />
                    </Grid>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="标注间距" />
                        <TextBox x:Name="DimensionDistanceWithDimText" Grid.Column="1" Text="6" />
                    </Grid>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="引线距离" />
                        <TextBox x:Name="MleaderDistanceText" Grid.Column="1" Text="6" />
                    </Grid>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="允许距离" />
                        <TextBox x:Name="DimDistanceToleranceText" Grid.Column="1" Text="30" />
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>

