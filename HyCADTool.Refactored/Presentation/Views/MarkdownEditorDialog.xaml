<Window x:Class="HyCADTool.Refactored.Presentation.Views.MarkdownEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HY Markdown → MText"
        Width="1280" Height="780"
        MinWidth="900" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        Foreground="#d4d4d4">

    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#d4d4d4" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3e3e42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#0e639c" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1177bb" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Background" Value="#3c3c3c" />
            <Setter Property="Foreground" Value="#d4d4d4" />
            <Setter Property="BorderBrush" Value="#555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#888" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="Splitter" TargetType="GridSplitter">
            <Setter Property="Background" Value="#3e3e42" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#007ACC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#2d2d30" BorderBrush="#3e3e42" BorderThickness="0,0,0,1">
            <DockPanel Margin="6,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="打开.md" Style="{StaticResource ToolBtn}" Command="{Binding LoadFileCommand}" />
                    <Button Content="保存.md" Style="{StaticResource ToolBtn}" Command="{Binding SaveFileCommand}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="插入CAD" Style="{StaticResource PrimaryBtn}"
                            Command="{Binding InsertCommand}" Click="OnInsertClick" />
                    <Button Content="关闭" Style="{StaticResource ToolBtn}" Click="OnCloseClick" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Foreground="#666" FontSize="11" />
            </DockPanel>
        </Border>

        <!-- 编辑器 + 预览 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：Markdown 编辑 -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Height="28" Background="#252526"
                        BorderBrush="#3e3e42" BorderThickness="0,0,0,1">
                    <TextBlock Text="Markdown编辑" FontSize="12" VerticalAlignment="Center" Margin="10,0" />
                </Border>
                <TextBox Style="{StaticResource DarkInput}"
                         Background="#1e1e1e" BorderThickness="0"
                         FontFamily="Consolas, 'Microsoft YaHei'" FontSize="13"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         Padding="12,8"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Text="{Binding MarkdownText, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <!-- 分隔条 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Style="{StaticResource Splitter}" />

            <!-- 右：分栏预览 -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Height="28" Background="#252526"
                        BorderBrush="#3e3e42" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="分栏预览" FontSize="12" Margin="0,0,14,0" />
                        <TextBlock Style="{StaticResource Lbl}" Text="1:" Margin="0,0,1,0" />
                        <TextBox Width="28" Style="{StaticResource DarkInput}" TextAlignment="Center"
                                 Text="{Binding DrawScale, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Lbl}" Text="栏:" Margin="8,0,1,0" />
                        <TextBox Width="24" Style="{StaticResource DarkInput}" TextAlignment="Center"
                                 Text="{Binding ColumnCount, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Lbl}" Text="间距:" Margin="8,0,1,0" />
                        <TextBox Width="28" Style="{StaticResource DarkInput}" TextAlignment="Center"
                                 Text="{Binding ColumnGutter, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Lbl}" Text="字高:" Margin="8,0,1,0" />
                        <TextBox Width="28" Style="{StaticResource DarkInput}" TextAlignment="Center"
                                 Text="{Binding TextSize, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>
                <WebBrowser x:Name="PreviewBrowser" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
