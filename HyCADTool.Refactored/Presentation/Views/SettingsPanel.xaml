<UserControl x:Class="HyCADTool.Refactored.Presentation.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helper="clr-namespace:HyCADTool.Refactored.Presentation.Views.Helpers"
             Width="280"
             Background="#3b4453"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool.Refactored;component/Presentation/Resources/LibraryResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <TabControl Background="#3b4453" BorderThickness="0">
        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="#2e3440" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="#555" BorderThickness="1,1,1,0"
                                    Padding="10,4" Margin="1,0">
                                <ContentPresenter ContentSource="Header" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#4c566a" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#434c5e" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </TabControl.Resources>

        <!-- ==================== Tab A: 样式设置 ==================== -->
        <TabItem Header="样式设置">
            <ScrollViewer Style="{StaticResource SmallScrollViewer}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="5,10,5,5" Background="#3b4453">

                    <!-- 比例 -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="主图形比例" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" 
                                 Text="{Binding Scale}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>

                    <!-- 动态样式名称预览 -->
                    <Expander Header="样式名称预览" IsExpanded="False" Margin="0,2,0,5">
                        <StackPanel Margin="5,5,0,0">
                            <TextBlock>
                                <Run Text="文字: " /><Run Text="{Binding TextStyleName, Mode=OneWay}" Foreground="#88c0d0" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="标注: " /><Run Text="{Binding DimStyleName, Mode=OneWay}" Foreground="#88c0d0" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="引线: " /><Run Text="{Binding MLeaderStyleName, Mode=OneWay}" Foreground="#88c0d0" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="表格: " /><Run Text="{Binding TableStyleName, Mode=OneWay}" Foreground="#88c0d0" />
                            </TextBlock>
                        </StackPanel>
                    </Expander>

                    <!-- 文字样式 -->
                    <Expander Header="文字样式" IsExpanded="True" Margin="0,2,0,5">
                        <StackPanel Margin="5,5,0,0">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="字体文件" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding FontFileName}" 
                                         helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="大字体" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding BigFontFileName}" 
                                         helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="基础文字高度" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding TextSize}" 
                                         helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="宽度比" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding TextXScale}" 
                                         helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <TextBlock Margin="0,3,0,0" Foreground="#808080" FontSize="10">
                                <Run Text="实际高度: " /><Run Text="{Binding ActualTextHeight, Mode=OneWay, StringFormat=F1}" />
                            </TextBlock>
                        </StackPanel>
                    </Expander>

                    <!-- 标注样式 -->
                    <Expander Header="标注样式" IsExpanded="False" Margin="0,2,0,5">
                        <StackPanel Margin="5,5,0,0">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="文字高度" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Dimtxt}" 
                                         helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="箭头大小" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Dimasz}" 
                                         helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="箭头类型" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding DimArrowName}" 
                                         helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="尺寸线超出" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Dimdle}" 
                                         helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="界线偏移" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Dimexo}" 
                                         helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="界线超出" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Dimexe}" 
                                         helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="文字偏移" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Dimgap}" 
                                         helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <TextBlock Margin="0,3,0,0" Foreground="#808080" FontSize="10">
                                <Run Text="使用 Dimscale=" /><Run Text="{Binding Scale, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Expander>

                    <!-- 引线样式 -->
                    <Expander Header="引线样式" IsExpanded="False" Margin="0,2,0,5">
                        <StackPanel Margin="5,5,0,0">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="箭头大小" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding MLeaderArrowSize}" 
                                         helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="箭头类型" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding MLeaderArrowName}" 
                                         helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="着陆间距" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding MLeaderLandingGap}" 
                                         helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="文字颜色索引" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding MLeaderTextColorIndex}" 
                                         helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <TextBlock Margin="0,3,0,0" Foreground="#808080" FontSize="10">
                                <Run Text="实际箭头: " /><Run Text="{Binding ActualMLeaderArrowSize, Mode=OneWay, StringFormat=F1}" />
                                <Run Text="  间距: " /><Run Text="{Binding ActualMLeaderLandingGap, Mode=OneWay, StringFormat=F1}" />
                            </TextBlock>
                        </StackPanel>
                    </Expander>

                    <!-- 操作按钮 -->
                    <Button Content="应用样式" Command="{Binding ApplyStyleCommand}" Margin="0,8,0,3" />
                    <Button Content="恢复默认" Command="{Binding ResetCommand}" Margin="0,3,0,3" />

                    <!-- 状态信息 -->
                    <TextBlock Text="{Binding StatusMessage}" 
                               Foreground="#a3be8c" FontSize="10" 
                               Margin="0,5,0,0" TextWrapping="Wrap" />

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== Tab B: 钢筋参数 ==================== -->
        <TabItem Header="钢筋">
            <ScrollViewer Style="{StaticResource SmallScrollViewer}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="5,10,5,5" Background="#3b4453">

                    <!-- 操作按钮 -->
                    <Button Content="绘制" Command="{Binding DrawCommand}" Margin="0,0,0,3" />

                    <!-- 标注参数 -->
                    <Grid Margin="0,3,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="标注:" />
                        <TextBlock Grid.Column="1" Text="直径" />
                        <TextBox Grid.Column="2" Text="{Binding RebarDiameter}" 
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                        <TextBlock Grid.Column="3" Text="间距" />
                        <TextBox Grid.Column="4" Text="{Binding RebarSpacing}" 
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>

                    <!-- 钢筋参数 -->
                    <Expander Header="钢筋参数" IsExpanded="True" Margin="0,2,0,5">
                        <StackPanel Margin="5,5,0,0">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="钢筋锚固长度" />
                                <TextBox Grid.Column="1" Text="{Binding AnchorageLength}" helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="点钢筋间距" />
                                <TextBox Grid.Column="1" Text="{Binding DotSeparation}" helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="钢筋弯折最小长度"  />
                                <TextBox Grid.Column="1" Text="{Binding BendingLineMinLength}" helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="锚固钢筋连接长度" />
                                <TextBox Grid.Column="1" Text="{Binding AnchorageJoinLength}" helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="弯钩长度" />
                                <TextBox Grid.Column="1" Text="{Binding HookLength}" helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="保护层厚度" />
                                <TextBox Grid.Column="1" Text="{Binding ProtectionThickness}" helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="点钢直径" />
                                <TextBox Grid.Column="1" Text="{Binding ReinforcementDiameter}" helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="点钢偏移" />
                                <TextBox Grid.Column="1" Text="{Binding DotReinOffset}" helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- 尺寸参数 -->
                    <Expander Header="尺寸参数" IsExpanded="False" Margin="0,2,0,5">
                        <StackPanel Margin="5,5,0,0">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="内侧标注距离" />
                                <TextBox Grid.Column="1" Text="{Binding DimensionDistanceInside}" helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="外标注距离" />
                                <TextBox Grid.Column="1" Text="{Binding DimensionDistanceOutside}" helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="标注间距" />
                                <TextBox Grid.Column="1" Text="{Binding DimensionDistanceWithDim}" helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="引线距离" />
                                <TextBox Grid.Column="1" Text="{Binding MleaderDistance}" helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="允许距离" />
                                <TextBox Grid.Column="1" Text="{Binding DimDistanceTolerance}" helper:TextBoxHelper.EnableCustomHandlers="True" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- 状态 -->
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#a3be8c" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" />

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== Tab C: 预留 ==================== -->
        <TabItem Header="C">
            <StackPanel Margin="10" Background="#3b4453">
                <TextBlock Text="预留标签页 C" Foreground="#808080" />
            </StackPanel>
        </TabItem>

        <!-- ==================== Tab D: 预留 ==================== -->
        <TabItem Header="D">
            <StackPanel Margin="10" Background="#3b4453">
                <TextBlock Text="预留标签页 D" Foreground="#808080" />
            </StackPanel>
        </TabItem>

    </TabControl>
</UserControl>
