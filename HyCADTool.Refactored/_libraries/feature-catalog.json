{
  "$schema": "./feature-catalog.schema.json (v0; informal)",
  "version": "0.1.0",
  "updated": "2026-04-16",
  "description": "市政道路 v1 特征目录（Feature Catalog）。用于语义分类道路线型/点要素，供命令、Xdata、JSON 持久化、代码检测及 Blender 材质映射的共同字典。P0 阶段仅包含最小闭环所需条目，P1~P6 持续扩充。",
  "alignmentKinds": [
    { "code": "tangent",      "label": "直线段",     "geomHint": "Line",    "cn": "直" },
    { "code": "arc",          "label": "圆曲线",     "geomHint": "Arc",     "cn": "圆" },
    { "code": "spiral",       "label": "缓和曲线",   "geomHint": "Clothoid","cn": "缓" },
    { "code": "sCurve",       "label": "S 型反向曲线","geomHint": "Composite","cn": "S" }
  ],
  "profileKinds": [
    { "code": "grade",        "label": "坡段",       "cn": "直坡" },
    { "code": "vcurve",       "label": "竖曲线",     "cn": "凸/凹竖曲线" },
    { "code": "kink",         "label": "转折点 (PVI)","cn": "变坡点" }
  ],
  "templatePointKinds": [
    { "code": "centerline",         "label": "中线",         "role": "anchor",   "cn": "路中线" },
    { "code": "edgeOfTravelledWay", "label": "车行道边缘",   "role": "edge",     "cn": "车行道边" },
    { "code": "curbTop",            "label": "缘石顶",       "role": "edge",     "cn": "缘石顶" },
    { "code": "curbFace",           "label": "缘石面",       "role": "edge",     "cn": "缘石面" },
    { "code": "gutter",             "label": "边沟",         "role": "edge",     "cn": "边沟" },
    { "code": "sidewalk",           "label": "人行道",       "role": "surface",  "cn": "人行道" },
    { "code": "shoulder",           "label": "路肩",         "role": "surface",  "cn": "路肩" },
    { "code": "median",             "label": "中央分隔带",   "role": "surface",  "cn": "中分带" }
  ],
  "componentKinds": [
    { "code": "pavement",     "label": "路面结构",   "cn": "沥青/水泥" },
    { "code": "kerb",         "label": "缘石",       "cn": "立缘/平缘" },
    { "code": "sidewalkSlab", "label": "人行道板",   "cn": "步道板" },
    { "code": "shoulderSlab", "label": "路肩结构",   "cn": "路肩" },
    { "code": "medianSlab",   "label": "中分带结构", "cn": "中分带" }
  ],
  "targetMappingKinds": [
    { "code": "offset",     "label": "偏距目标",   "example": "车行道宽度" },
    { "code": "elevation",  "label": "高程目标",   "example": "边沟高程" },
    { "code": "slope",      "label": "坡度目标",   "example": "路肩横坡" },
    { "code": "surface",    "label": "曲面目标",   "example": "现状地形" }
  ],
  "intersectionKinds": [
    { "code": "tJunction",     "label": "T 型交叉" },
    { "code": "xJunction",     "label": "十字交叉" },
    { "code": "yJunction",     "label": "Y 型交叉" },
    { "code": "roundabout",    "label": "环形交叉" },
    { "code": "gradeSeparated","label": "立体交叉" }
  ],
  "markingKinds": [
    { "code": "crosswalk",         "label": "人行横道",      "cn": "斑马线" },
    { "code": "stopLine",          "label": "停止线",        "cn": "停止线" },
    { "code": "laneLine",          "label": "车道分界线",    "cn": "车道线" },
    { "code": "centerLine",        "label": "道路中心线",    "cn": "中心线" },
    { "code": "arrow",             "label": "导向箭头",      "cn": "箭头" },
    { "code": "guideLine",         "label": "导流线",        "cn": "导流" }
