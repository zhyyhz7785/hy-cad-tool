  "signKinds": [
    { "code": "warning",   "label": "警告标志",    "shape": "triangle" },
    { "code": "prohibit",  "label": "禁令标志",    "shape": "circle" },
    { "code": "indication","label": "指示标志",    "shape": "circle" },
    { "code": "guide",     "label": "指路标志",    "shape": "rectangle" }
