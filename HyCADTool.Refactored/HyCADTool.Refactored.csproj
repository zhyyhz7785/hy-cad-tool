<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>HyCADTool.Refactored</AssemblyName>
    <RootNamespace>HyCADTool.Refactored</RootNamespace>
    <LangVersion>8.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 不自动包含所有 XAML，只编译下面显式列出的 Page，避免被排除的面板 XAML 仍被编译 -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    
    <!-- 禁用自动生成 AssemblyInfo，使用手动的 Properties/AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- 确保 NuGet 依赖 DLL 复制到输出目录（ReCall 热重载需要） -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- AutoCAD 和其他 NuGet 包引用 -->
  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="24.3.0" />
    <PackageReference Include="Autofac" Version="7.1.0" />
    <PackageReference Include="Clipper2" Version="1.4.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="NetTopologySuite" Version="2.5.0" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- 配置文件复制到输出目录 -->
  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- P0 道路：_libraries 字典资源随 DLL 同级部署（v1 不读取，v2/P7 由 Blender Addon 消费） -->
  <ItemGroup>
    <None Include="_libraries\feature-catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="_libraries\blender-material-mapping.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="_libraries\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 排除不需要的文件（如果有） -->
  <ItemGroup>
    <!-- 排除备份文件、临时文件等 -->
    <Compile Remove="**/*.bak" />
    <Compile Remove="**/*.old" />
    <Compile Remove="**/* - 复制.cs" />
    <None Remove="**/*.bak" />
    <None Remove="**/*.old" />
  </ItemGroup>
  <!-- 只编译需要的 XAML（EnableDefaultPageItems=false 时必须显式列出） -->
  <ItemGroup>
    <Page Include="Presentation\Resources\LibraryResources.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Presentation\Resources\BlenderTheme.xaml">
