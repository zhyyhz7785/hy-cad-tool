<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>HyCADTool.Refactored</AssemblyName>
    <RootNamespace>HyCADTool.Refactored</RootNamespace>
    <LangVersion>8.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 不自动包含所有 XAML，只编译下面显式列出的 Page，避免被排除的面板 XAML 仍被编译 -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    
    <!-- 禁用自动生成 AssemblyInfo，使用手动的 Properties/AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- AutoCAD 和其他 NuGet 包引用 -->
  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="24.3.0" />
    <PackageReference Include="Autofac" Version="7.1.0" />
    <PackageReference Include="Clipper2" Version="1.4.0" />
    <PackageReference Include="NetTopologySuite" Version="2.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- 配置文件复制到输出目录 -->
  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Test 入口（C1 调用），显式包含确保参与编译 -->
  <ItemGroup>
    <Compile Include="Test\SimpleLogger.cs" />
    <Compile Include="Test\TestCommand.cs" />
    <Compile Include="Test\TestRunner.cs" />
  </ItemGroup>

  <!-- 排除不需要的文件（如果有） -->
  <ItemGroup>
    <!-- 排除备份文件、临时文件等 -->
    <Compile Remove="**/*.bak" />
    <Compile Remove="**/*.old" />
    <None Remove="**/*.bak" />
    <None Remove="**/*.old" />
  </ItemGroup>

  <!-- 只编译需要的 XAML（EnableDefaultPageItems=false 时必须显式列出） -->
  <ItemGroup>
    <Page Include="Presentation\Resources\LibraryResources.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Presentation\Views\FilterPanel.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Presentation\Views\HyovSettingsWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <!-- 注释掉的面板（暂时排除） -->
  <ItemGroup>
    <Compile Remove="Presentation\Views\ReinPanel.xaml.cs" />
    <Compile Remove="Presentation\Views\BaseReinPanel.xaml.cs" />
    <Compile Remove="Presentation\Views\PilePanel.xaml.cs" />
    <Compile Remove="Presentation\Views\ClusterPanel.xaml.cs" />
    <Compile Remove="Presentation\Commands\ShowPanelCommand.cs" />
    <Compile Remove="Presentation\Commands\ShowMainPanelCommand.cs" />
    <Compile Remove="Presentation\ViewModels\BaseReinPanelViewModel.cs" />
    <Compile Remove="Presentation\ViewModels\ReinPanelViewModel.cs" />
    <Compile Remove="Presentation\ViewModels\PilePanelViewModel.cs" />
    <Compile Remove="Presentation\ViewModels\ClusterPanelViewModel.cs" />
    <Compile Remove="Application\Services\BaseReinforcementService.cs" />
    <Compile Remove="Domain\Interfaces\IBaseReinforcementService.cs" />
    <Compile Remove="Domain\Models\Configuration\BaseReinforcementConfig.cs" />
    
  </ItemGroup>

</Project>
