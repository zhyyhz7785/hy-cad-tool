<bui:BlenderWindow x:Class="HyCAD.BlenderUI.Samples.OperatorKeymapSample"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls"
                   Title="OperatorKeymapSample"
                   HeaderTitle="OperatorRegistry + BlenderInputRouter"
                   Width="480" Height="240"
                   UseCustomChrome="False"
                   Background="{DynamicResource Brush_WindowBack}"
                   FontFamily="{DynamicResource Font_Main}">
    <bui:BlenderWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/BlenderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </bui:BlenderWindow.Resources>
    <StackPanel Margin="12">
        <TextBlock x:Name="Log" TextWrapping="Wrap" Foreground="{DynamicResource Brush_TextSecondary}"/>
        <TextBlock Margin="0,12,0,0" Text="按 Ctrl+Shift+D 触发示例操作" Foreground="{DynamicResource Brush_TextPrimary}"/>
    </StackPanel>
</bui:BlenderWindow>
