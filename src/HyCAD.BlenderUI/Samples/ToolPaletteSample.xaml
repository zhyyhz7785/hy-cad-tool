<Window x:Class="HyCAD.BlenderUI.Samples.ToolPaletteSample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls"
        xmlns:prim="clr-namespace:HyCAD.BlenderUI.Controls.Primitives"
        mc:Ignorable="d"
        Title="HyCAD.BlenderUI — Tool Palette Sample"
        Width="400"
        Height="640"
        Background="{DynamicResource Brush_WindowBack}"
        FontFamily="{DynamicResource Font_Main}"
        FontSize="{DynamicResource Metric_FontMain}"
        Foreground="{DynamicResource Brush_TextPrimary}">

    <!--
      ToolPaletteSample（原 DemoWindow）：单列 PropertyEditor 工具面板形态。
      对应 AutoCAD PaletteSet / Blender 右侧 Properties Editor 的「窄长工具面板」用法。
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/BlenderTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <bui:PropertyEditor Title="Demo Editor"
                        SelectedTabIndex="0"
                        ShowIconBar="True"
                        ShowPin="True"
                        ShowSearch="True">
        <bui:PropertyEditor.Tabs>
            <x:Array Type="{x:Type bui:IconTabItem}">
                <bui:IconTabItem TooltipText="渲染">
                    <bui:IconTabItem.Icon>
                        <Path Width="16"
                              Height="16"
                              Data="M 8,0 A 8,8 0 1 1 8,16 A 8,8 0 1 1 8,0 Z"
                              Fill="{DynamicResource Brush_TextPrimary}"
                              Stretch="Uniform" />
                    </bui:IconTabItem.Icon>
                </bui:IconTabItem>
                <bui:IconTabItem TooltipText="输出">
                    <bui:IconTabItem.Icon>
                        <Path Width="16"
                              Height="16"
                              Data="M 0,2 L 16,2 L 16,14 L 0,14 Z M 3,6 L 13,6 M 3,9 L 13,9 M 3,12 L 10,12"
                              Fill="{DynamicResource Brush_TextPrimary}"
                              Stretch="Uniform" />
                    </bui:IconTabItem.Icon>
                </bui:IconTabItem>
                <bui:IconTabItem TooltipText="场景">
                    <bui:IconTabItem.Icon>
                        <Path Width="16"
                              Height="16"
                              Data="M 2,12 L 8,2 L 14,12 Z"
                              Fill="{DynamicResource Brush_TextPrimary}"
                              Stretch="Uniform" />
                    </bui:IconTabItem.Icon>
                </bui:IconTabItem>
            </x:Array>
        </bui:PropertyEditor.Tabs>

        <StackPanel>

            <Expander Header="基础控件" Style="{StaticResource BlenderExpander}">
                <StackPanel>
                    <bui:PropertyRow Label="Button">
                        <StackPanel Orientation="Horizontal">
                            <Button Margin="0,0,4,0" Content="普通按钮" Style="{StaticResource BlenderButton}" />
                            <Button Content="扁平按钮" Style="{StaticResource BlenderButtonFlat}" />
                        </StackPanel>
                    </bui:PropertyRow>

                    <bui:PropertyRow Label="TextBox">
                        <TextBox Style="{StaticResource BlenderTextBox}" Text="示例文本" />
                    </bui:PropertyRow>

                    <bui:PropertyRow Label="CheckBox">
                        <CheckBox Content="启用阴影" IsChecked="True" Style="{StaticResource BlenderCheckBox}" />
                    </bui:PropertyRow>

                    <bui:PropertyRow Label="ComboBox">
                        <ComboBox SelectedIndex="0" Style="{StaticResource BlenderComboBox}">
                            <ComboBoxItem Content="选项 A" />
                            <ComboBoxItem Content="选项 B" />
                            <ComboBoxItem Content="选项 C" />
                        </ComboBox>
                    </bui:PropertyRow>

                    <bui:PropertyRow Label="NumericSlider">
                        <bui:NumericSlider Decimals="1"
                                           Label="Samples"
                                           Maximum="100"
                                           Minimum="0"
                                           Step="1"
                                           Unit=""
                                           Value="42" />
                    </bui:PropertyRow>
                </StackPanel>
            </Expander>

            <Expander Header="采样" Style="{StaticResource BlenderExpander}">
                <StackPanel>
                    <bui:PropertyRow Label="噪点阈值">
                        <bui:NumericSlider Decimals="2"
                                           Maximum="1"
                                           Minimum="0"
                                           Step="0.01"
                                           Value="0.01" />
                    </bui:PropertyRow>
                    <bui:PropertyRow Label="最大采样数">
                        <bui:NumericSlider Decimals="0"
                                           Maximum="4096"
                                           Minimum="1"
                                           Step="1"
                                           Value="1024" />
                    </bui:PropertyRow>
                    <bui:PropertyRow Label="最小采样数">
                        <bui:NumericSlider Decimals="0"
                                           Maximum="4096"
                                           Minimum="0"
                                           Step="1"
                                           Value="0" />
                    </bui:PropertyRow>
                    <bui:PropertyRow Label="时间限制">
                        <bui:NumericSlider Decimals="0"
                                           Maximum="3600"
                                           Minimum="0"
                                           Step="1"
                                           Unit="s"
                                           Value="0" />
                    </bui:PropertyRow>
                </StackPanel>
            </Expander>

            <Expander Header="Tab / 列表" Style="{StaticResource BlenderExpander}">
                <StackPanel>
                    <TabControl Height="140" Style="{StaticResource BlenderTabControl}">
                        <TabItem Header="通用">
                            <TextBlock Margin="8" Style="{StaticResource BlenderText}" Text="通用 Tab 内容" />
                        </TabItem>
                        <TabItem Header="高级">
                            <TextBlock Margin="8" Style="{StaticResource BlenderText}" Text="高级 Tab 内容" />
                        </TabItem>
                        <TabItem Header="调试">
                            <TextBlock Margin="8" Style="{StaticResource BlenderText}" Text="调试 Tab 内容" />
                        </TabItem>
                    </TabControl>

                    <ListBox Height="100"
                             Margin="0,6,0,0"
                             ItemContainerStyle="{StaticResource BlenderListBoxItem}"
                             Style="{StaticResource BlenderListBox}">
                        <ListBoxItem Content="条目一" />
                        <ListBoxItem Content="条目二" />
                        <ListBoxItem Content="条目三" />
                        <ListBoxItem Content="条目四" />
                    </ListBox>
                </StackPanel>
            </Expander>

        </StackPanel>
    </bui:PropertyEditor>
</Window>
