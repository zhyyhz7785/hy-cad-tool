<bui:BlenderWindow x:Class="HyCAD.BlenderUI.Samples.SplitDesignerSample"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls"
                   mc:Ignorable="d"
                   Title="HyCAD.BlenderUI — Split Designer Sample"
                   HeaderTitle="分屏设计器样本（CrossSection 升级形态）"
                   Width="1100"
                   Height="640"
                   Background="{DynamicResource Brush_WindowBack}"
                   FontFamily="{DynamicResource Font_Main}"
                   FontSize="{DynamicResource Metric_FontMain}"
                   Foreground="{DynamicResource Brush_TextPrimary}">

    <!--
      SplitDesignerSample：BlenderWindow + 3 区横向分屏：
        左 PropertyEditor（参数 Expander） | Splitter | 中 Canvas 预览 | Splitter | 右 BlenderOutliner（规范检查）
      对应生产形态：CrossSectionDesignerWindow（增加可拖动 Splitter 后的形态）。
    -->

    <bui:BlenderWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/BlenderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </bui:BlenderWindow.Resources>

    <bui:BlenderWindow.HeaderRightContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Margin="0,0,6,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush_TextSecondary}"
                       Text="预设："/>
            <ComboBox Width="180" SelectedIndex="0" Style="{StaticResource BlenderComboBox}">
                <ComboBoxItem Content="CJJ37 — 主干路 V=60"/>
                <ComboBoxItem Content="CJJ37 — 次干路 V=40"/>
                <ComboBoxItem Content="CJJ37 — 支路 V=30"/>
            </ComboBox>
        </StackPanel>
    </bui:BlenderWindow.HeaderRightContent>

    <bui:BlenderWindow.FooterLeftContent>
        <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush_TextSecondary}"
                       Text="半幅 12.50 m"/>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush_TextSecondary}"
                       Text="总宽 25.00 m"/>
        </StackPanel>
    </bui:BlenderWindow.FooterLeftContent>

    <bui:BlenderWindow.StatusContent>
        <TextBlock VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush_Success}"
                   Text="规范检查通过"/>
    </bui:BlenderWindow.StatusContent>

    <bui:BlenderWindow.FooterRightContent>
        <StackPanel Orientation="Horizontal">
            <Button Width="120" Margin="0,0,4,0" Content="确定并出图" Style="{StaticResource BlenderButton}"/>
            <Button Width="80" Content="取消" Style="{StaticResource BlenderButton}"/>
        </StackPanel>
    </bui:BlenderWindow.FooterRightContent>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="240"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"  MinWidth="240"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="260" MinWidth="220"/>
        </Grid.ColumnDefinitions>

        <!-- 左：参数 -->
        <bui:PropertyEditor Grid.Column="0"
                            Title="横断面参数"
                            ShowIconBar="False"
                            ShowSearch="False">
            <StackPanel>
                <Expander Header="全局参数" Style="{StaticResource BlenderExpander}">
                    <StackPanel>
                        <bui:PropertyRow Label="比例 1:N">
                            <ComboBox SelectedIndex="1" Style="{StaticResource BlenderComboBox}">
                                <ComboBoxItem Content="100"/>
                                <ComboBoxItem Content="200"/>
                                <ComboBoxItem Content="500"/>
                            </ComboBox>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="设计速度">
                            <ComboBox SelectedIndex="2" Style="{StaticResource BlenderComboBox}">
                                <ComboBoxItem Content="30"/>
                                <ComboBoxItem Content="40"/>
                                <ComboBoxItem Content="60"/>
                            </ComboBox>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="路拱坡度">
                            <bui:NumericSlider Decimals="2"
                                               Maximum="5" Minimum="0" Step="0.5"
                                               Unit="%" Value="2"/>
                        </bui:PropertyRow>
                    </StackPanel>
                </Expander>

                <Expander Header="左半幅条带" IsExpanded="True" Style="{StaticResource BlenderExpander}">
                    <StackPanel>
                        <bui:PropertyRow Label="人行道宽度">
                            <bui:NumericSlider Decimals="2"
                                               Maximum="10" Minimum="0" Step="0.25"
                                               Unit="m" Value="3.00"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="非机动车道">
                            <bui:NumericSlider Decimals="2"
                                               Maximum="10" Minimum="0" Step="0.25"
                                               Unit="m" Value="2.50"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="机非分隔带">
                            <bui:NumericSlider Decimals="2"
                                               Maximum="5" Minimum="0" Step="0.25"
                                               Unit="m" Value="1.00"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="机动车道">
                            <bui:NumericSlider Decimals="2"
                                               Maximum="20" Minimum="0" Step="0.25"
                                               Unit="m" Value="6.00"/>
                        </bui:PropertyRow>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </bui:PropertyEditor>

        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Cursor="SizeWE"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"
                      Style="{StaticResource BlenderSplitter}"/>

        <!-- 中：预览 Canvas -->
        <bui:PropertyEditor Grid.Column="2"
                            Title="预览"
                            ShowIconBar="False"
                            ShowSearch="False">
            <Border Margin="6"
                    Background="{DynamicResource Brush_RegionBack}"
                    BorderBrush="{DynamicResource Brush_BorderDark}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Canvas>
                    <Line X1="50" Y1="220" X2="550" Y2="220"
                          Stroke="{DynamicResource Brush_AccentBlue}" StrokeThickness="2"/>
                    <Line X1="50" Y1="180" X2="50" Y2="220"
                          Stroke="{DynamicResource Brush_BorderDark}" StrokeThickness="1"/>
                    <Line X1="550" Y1="180" X2="550" Y2="220"
                          Stroke="{DynamicResource Brush_BorderDark}" StrokeThickness="1"/>
                    <TextBlock Canvas.Left="40" Canvas.Top="240"
                               Foreground="{DynamicResource Brush_TextSecondary}"
                               Text="3.0 | 2.5 | 1.0 | 6.0 | 6.0 | 1.0 | 2.5 | 3.0  (m)"/>
                    <TextBlock Canvas.Left="240" Canvas.Top="190"
                               Foreground="{DynamicResource Brush_TextPrimary}"
                               Text="路拱 2%"/>
                </Canvas>
            </Border>
        </bui:PropertyEditor>

        <GridSplitter Grid.Column="3"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Cursor="SizeWE"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"
                      Style="{StaticResource BlenderSplitter}"/>

        <!-- 右：规范检查 Outliner -->
        <bui:PropertyEditor Grid.Column="4"
                            Title="规范检查"
                            ShowIconBar="False"
                            ShowSearch="True">
            <TreeView Style="{StaticResource BlenderOutliner}">
                <TreeViewItem Header="路面横坡" IsExpanded="True">
                    <TreeViewItem Header="✓ 机动车道路拱 2% 在 1.5%~3% 范围"/>
                    <TreeViewItem Header="✓ 人行道横坡 1.5%"/>
                </TreeViewItem>
                <TreeViewItem Header="车道宽度" IsExpanded="True">
                    <TreeViewItem Header="✓ 机动车道单车道 ≥ 3.5m"/>
                    <TreeViewItem Header="✓ 非机动车道单向 ≥ 2.5m"/>
                </TreeViewItem>
                <TreeViewItem Header="人行设施" IsExpanded="True">
                    <TreeViewItem Header="✓ 人行道宽度 ≥ 2.0m"/>
                    <TreeViewItem Header="! 建议：靠近商业区时 ≥ 4.0m"/>
                </TreeViewItem>
            </TreeView>
        </bui:PropertyEditor>
    </Grid>
</bui:BlenderWindow>
