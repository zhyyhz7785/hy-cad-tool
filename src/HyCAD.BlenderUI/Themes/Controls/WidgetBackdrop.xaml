<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Colors.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Metrics.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
      widget_draw_backdrop 命名样式（扁平版）
      统一改为纯色底板，移除渐变/浮雕观感。
    -->

    <Style x:Key="BlenderWidgetBackdropIdle" TargetType="{x:Type Border}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Metric_CornerRadius}"/>
        <Setter Property="Background" Value="{DynamicResource Brush_ButtonIdle}"/>
    </Style>

    <Style x:Key="BlenderWidgetBackdropHover" TargetType="{x:Type Border}" BasedOn="{StaticResource BlenderWidgetBackdropIdle}">
        <Setter Property="Background" Value="{DynamicResource Brush_ItemHover}"/>
    </Style>

    <Style x:Key="BlenderWidgetBackdropPressed" TargetType="{x:Type Border}" BasedOn="{StaticResource BlenderWidgetBackdropIdle}">
        <Setter Property="Background" Value="{DynamicResource Brush_PanelBack}"/>
    </Style>

    <Style x:Key="BlenderWidgetBackdropSelected" TargetType="{x:Type Border}" BasedOn="{StaticResource BlenderWidgetBackdropIdle}">
        <Setter Property="Background" Value="{DynamicResource Brush_ItemSelected}"/>
    </Style>

</ResourceDictionary>
