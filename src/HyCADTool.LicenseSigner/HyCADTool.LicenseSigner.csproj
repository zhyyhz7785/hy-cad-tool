<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>HyCADTool.LicenseSigner</RootNamespace>
    <AssemblyName>HyCADTool.LicenseSigner</AssemblyName>
    <UseWPF>true</UseWPF>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Costura：把 HyCADTool.Licensing.dll / Newtonsoft.Json.dll 内嵌进 exe，Release 出单文件 -->
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.8.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HyCADTool.Licensing\HyCADTool.Licensing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="PrivateKey.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Condition="'$(Configuration)'=='Debug' and Exists('$(MSBuildThisFileDirectory)..\..\build\keys\rsa-priv.xml')" Include="..\..\build\keys\rsa-priv.xml" Link="PrivateKey.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
