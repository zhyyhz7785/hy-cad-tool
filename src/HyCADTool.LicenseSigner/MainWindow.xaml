<Window x:Class="HyCADTool.LicenseSigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HyCAD License 签发（仅开发者）" Height="500" Width="650"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12">
      <TextBlock Text="客户 / 说明" />
      <TextBox x:Name="CustomerBox" MinHeight="28" Margin="0,4,0,8" Text="测试客户" />
      <TextBlock Text="机器码（5 段 XXXX-XXXX-…，可从 hyLicense 窗口复制）" />
      <TextBox x:Name="MachineCodeBox" MinHeight="28" Margin="0,4,0,8" Text="" />
      <TextBlock Text="档" />
      <ComboBox x:Name="EditionBox" IsEditable="True" Margin="0,4,0,8" SelectedIndex="0">
        <ComboBoxItem Content="standard" />
        <ComboBoxItem Content="professional" />
        <ComboBoxItem Content="enterprise" />
      </ComboBox>
      <TextBlock Text="期限" />
      <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
        <Button Content="1 年" Click="Y1" Margin="0,0,8,0" Padding="8,4" />
        <Button Content="3 年" Click="Y3" Margin="0,0,8,0" Padding="8,4" />
        <Button Content="终身" Click="Perp" Padding="8,4" />
      </StackPanel>
      <TextBlock x:Name="ExpiryInfo" TextWrapping="Wrap" Margin="0,0,0,8" />
      <TextBlock x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap" MinHeight="32" />
      <Button Content="生成并保存 license.lic" Click="OnSave" Padding="10,6" HorizontalAlignment="Left" />
      <TextBlock Text="私钥：同目录 PrivateKey.xml（从 build/keys/rsa-priv.xml 复制，勿提交）" Foreground="Gray" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Window>
