<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>HyCADTool.UniverEditor</AssemblyName>
    <RootNamespace>HyCADTool.UniverEditor</RootNamespace>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>..\HyCADTool\bin\$(Configuration)\net8\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <WebProjectDir>$(MSBuildProjectDirectory)\Web</WebProjectDir>
    <WebDistDir>$(WebProjectDir)\dist</WebDistDir>
    <WebDistIndex>$(WebDistDir)\index.html</WebDistIndex>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3065.39" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- dist 由 BuildWebAssets 目标生成后再纳入 Content -->
  <ItemGroup>
    <Content Include="Web\dist\**\*.*" Condition="Exists('$(WebDistIndex)')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Web\dist\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <Target Name="BuildWebAssets"
          BeforeTargets="AssignTargetPaths;GetCopyToOutputDirectoryItems"
          Inputs="@(WebSourceFiles)"
          Outputs="$(WebDistIndex)">
    <ItemGroup>
      <WebSourceFiles Include="$(WebProjectDir)\src\**\*.*" />
      <WebSourceFiles Include="$(WebProjectDir)\index.html" />
      <WebSourceFiles Include="$(WebProjectDir)\vite.config.ts" />
      <WebSourceFiles Include="$(WebProjectDir)\package.json" />
      <WebSourceFiles Include="$(WebProjectDir)\package-lock.json" Condition="Exists('$(WebProjectDir)\package-lock.json')" />
      <WebSourceFiles Include="$(WebProjectDir)\tsconfig.json" Condition="Exists('$(WebProjectDir)\tsconfig.json')" />
    </ItemGroup>
    <Message Importance="high" Text="[HyCADTool.UniverEditor] npm run build → $(WebDistDir)" />
    <Exec WorkingDirectory="$(WebProjectDir)" Command="npm run build" />
    <ItemGroup>
      <Content Include="Web\dist\**\*.*">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>Web\dist\%(RecursiveDir)%(Filename)%(Extension)</Link>
      </Content>
    </ItemGroup>
  </Target>

  <Target Name="CopyWebView2NativeLoader" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)runtimes\win-x64\native\WebView2Loader.dll"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutputPath)runtimes\win-x64\native\WebView2Loader.dll')" />
  </Target>

</Project>
