<Window x:Class="HyCADTool.UniverEditor.Views.UniverEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="HyCAD Univer 表格编辑器 (PoC)"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#2e3440"
        Foreground="#eceff4">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#3b4252">
            <StackPanel Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Menu Background="Transparent"
                      Foreground="#eceff4">
                    <MenuItem Header="文件"
                              Padding="8,2">
                        <MenuItem Header="新建空表" Click="OnNewEmptyTableClick" />
                        <MenuItem Header="加载人员样表" Click="OnLoadPersonnelSampleClick" />
                        <Separator />
                        <MenuItem Header="导入 xlsx..." Click="OnImportXlsxClick" />
                        <MenuItem Header="导出 xlsx..." Click="OnExportXlsxClick" />
                        <MenuItem Header="导出 JSON 快照..." Click="OnExportJsonClick" />
                        <Separator />
                        <MenuItem Header="拾取 HyTable" Click="OnPickClick" />
                        <MenuItem Header="落图到 CAD" Click="OnPublishClick" />
                    </MenuItem>
                </Menu>
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="HyCAD Univer 表格编辑器 (PoC)" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton"
                        Width="40"
                        Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="—"
                        Foreground="#eceff4"
                        Click="OnMinimizeClick" />
                <Button x:Name="MaximizeButton"
                        Width="40"
                        Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="□"
                        Foreground="#eceff4"
                        Click="OnMaximizeClick" />
                <Button x:Name="CloseButton"
                        Width="40"
                        Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="✕"
                        Foreground="#eceff4"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Padding="8,0"
                Background="#434c5e"
                BorderBrush="#4c566a"
                BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center"
                        Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Margin="0,0,6,0"
                        Padding="10,4"
                        Click="OnNewEmptyTableClick"
                        Content="新建" />
                <Button Margin="0,0,6,0"
                        Padding="10,4"
                        Click="OnLoadPersonnelSampleClick"
                        Content="人员样表" />
                <Button Margin="0,0,6,0"
                        Padding="10,4"
                        Click="OnPublishClick"
                        Content="落图" />
                <Button Margin="0,0,12,0"
                        Padding="10,4"
                        Click="OnPickClick"
                        Content="拾取" />
                <TextBlock x:Name="SummaryTextBlock"
                           VerticalAlignment="Center"
                           Foreground="#d8dee9"
                           Text="未加载表格" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Background="#ffffff">
            <wv2:WebView2 x:Name="UniverWebView" />
            <Border x:Name="LoadingOverlay"
                    Background="#eef2f7"
                    Visibility="Visible">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#2e3440"
                               Text="正在加载 Univer Sheets..." />
                    <TextBlock x:Name="StatusTextBlock"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#5e6775"
                               Text="初始化 WebView2..." />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Padding="10,0"
                Background="#434c5e"
                BorderBrush="#4c566a"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="FooterStatusTextBlock"
                       VerticalAlignment="Center"
                       Foreground="#a3be8c"
                       Text="等待 Univer 就绪..." />
        </Border>
    </Grid>
</Window>
