    </PackageReference>
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyCAD.Tables\HyCAD.Tables.csproj" />
  </ItemGroup>

</Project>
