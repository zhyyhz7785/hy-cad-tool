<Window x:Class="HyCAD.BlenderUI.TestHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HyCAD.BlenderUI TestHost" Height="520" Width="460">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="工具栏位置：" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ToolbarPosCombo" Width="160" VerticalAlignment="Center"
                      SelectionChanged="OnToolbarPosChanged">
                <ComboBoxItem Content="上侧 (Top)" Tag="Top"/>
                <ComboBoxItem Content="侧面 (Side)" Tag="Side"/>
            </ComboBox>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="选择示例窗口：" Margin="0,0,0,8"/>
        <ListBox x:Name="List" Grid.Row="2" MouseDoubleClick="OnOpen"/>
    </Grid>
</Window>
