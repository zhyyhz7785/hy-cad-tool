<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>HyCADTool</AssemblyName>
    <RootNamespace>HyCADTool</RootNamespace>
    <LangVersion>8.0</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- AnyCPU 供 VS WPF 设计器（32 位）加载；AutoCAD 与 AcSeamless 等为 AMD64 → MSB3270。运行时由 64 位 CAD 进程加载，架构一致。 -->
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 不自动包含所有 XAML，只编译下面显式列出的 Page，避免被排除的面板 XAML 仍被编译 -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    
    <!-- 禁用自动生成 AssemblyInfo，使用手动的 App/Properties/AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- 确保 NuGet 依赖 DLL 复制到输出目录（ReCall 热重载需要） -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- ====================================================================
       Production 构建配置：用于发出客户安装包的"真·NETLOAD HyCADTool.dll"路径。
       ====================================================================
       与 Debug/Release 的差异：
         - 定义编译常量 HYCAD_PRODUCTION，激活 Production 文件夹下的：
             * [assembly: ExtensionApplication(typeof(ProductionExtension))] —— AutoCAD NETLOAD 直调 Initialize
             * [assembly: CommandClass(typeof(ProductionCommandFacade))]    —— 144 条 [CommandMethod] 入口
         - 把 ReCall 的 commands.json 作为 None 拷贝到输出目录（生产期 Refactored 自己读）
         - 不依赖 ReCall.dll；最终安装包只需要 HyCADTool.dll + 它的 NuGet 依赖 + commands.json
       使用：dotnet build HyCADTool\HyCADTool.csproj -c Production
       AutoCAD 中：NETLOAD 该 dll → 命令直接可用，无 ReCall 热重载壳层。 -->
  <PropertyGroup Condition="'$(Configuration)'=='Production'">
    <DefineConstants>TRACE;HYCAD_PRODUCTION</DefineConstants>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)'=='Production'">
    <None Include="..\ReCall\commands.json" Link="commands.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- AutoCAD 和其他 NuGet 包引用 -->
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.4.3" />
    <PackageReference Include="AutoCAD.NET" Version="24.3.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Autofac" Version="7.1.0" />
    <PackageReference Include="Clipper2" Version="1.4.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="NetTopologySuite" Version="2.5.0" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- 引用 Blender WPF 控件库（主题 + NumericSlider / PropertyRow / IconTabBar 等） -->
  <ItemGroup>
    <ProjectReference Include="..\HYFEA\HYFEA.Core\HYFEA.Core.csproj" />
    <ProjectReference Include="..\HyCAD.Geometry\HyCAD.Geometry.csproj" />
    <ProjectReference Include="..\HyCAD.Tables\HyCAD.Tables.csproj" />
    <ProjectReference Include="..\HyCADTool.Licensing\HyCADTool.Licensing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HyCAD.BlenderUI\HyCAD.BlenderUI.csproj">
      <Project>{D4B7E1A2-5C3F-4A8E-9B62-7F1E2C3D4E5F}</Project>
      <Name>HyCAD.BlenderUI</Name>
    </ProjectReference>
  </ItemGroup>

  <!-- 配置文件复制到输出目录 -->
  <ItemGroup>
    <None Update="App\config.json" Link="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- HyCAD 标准线型：随 DLL 部署到 Resources\，启动时注入当前图形线型表 -->
  <ItemGroup>
    <None Include="App\Resources\HyCAD-Linetypes.lin" Link="Resources\HyCAD-Linetypes.lin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- P0 道路：_libraries 字典资源随 DLL 同级部署（v1 不读取，v2/P7 由 Blender Addon 消费） -->
  <ItemGroup>
    <None Include="App\_libraries\feature-catalog.json" Link="_libraries\feature-catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="App\_libraries\blender-material-mapping.json" Link="_libraries\blender-material-mapping.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="App\_libraries\README.md" Link="_libraries\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 排除不需要的文件（如果有） -->
  <ItemGroup>
    <!-- 排除备份文件、临时文件等 -->
    <Compile Remove="**/*.bak" />
    <Compile Remove="**/*.old" />
    <Compile Remove="**/* - 复制.cs" />
    <None Remove="**/*.bak" />
    <None Remove="**/*.old" />
  </ItemGroup>
