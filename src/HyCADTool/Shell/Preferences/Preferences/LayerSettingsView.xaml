<UserControl x:Class="HyCADTool.Shell.Views.Preferences.LayerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="520"
             btmetrics:BlenderMetricsOverlay.Attach="True"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="{DynamicResource Metric_SectionInset}">
        <DataGrid x:Name="LayerGrid"
                  Style="{StaticResource BlenderDataGrid}"
                  ItemsSource="{Binding Settings.LayerCatalogItems}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  MaxHeight="280"
                  CellEditEnding="LayerGrid_OnCellEditEnding"
                  MinHeight="120"
                  ToolTip="语义 ID 稳定不变；可改图层名 / ACI 色 / 线型 / 线宽（-1=随层）。改后若开启自动保存会写入 hy-settings。">
            <DataGrid.Columns>
                <DataGridTextColumn Header="语义 ID" Binding="{Binding SemanticId}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="图层名" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.2*"/>
                <DataGridTextColumn Header="ACI" Binding="{Binding AciColor, UpdateSourceTrigger=PropertyChanged}" Width="40" MinWidth="36"/>
                <DataGridTextColumn Header="线型" Binding="{Binding LinetypeName, UpdateSourceTrigger=PropertyChanged}" Width="60" MinWidth="48"/>
                <DataGridTextColumn Header="线宽" Binding="{Binding LineWeightRaw, UpdateSourceTrigger=PropertyChanged}" Width="40" MinWidth="36"/>
                <DataGridCheckBoxColumn Header="出图" Binding="{Binding IsPlottable, UpdateSourceTrigger=PropertyChanged}" Width="40" MinWidth="36">
                    <DataGridCheckBoxColumn.ElementStyle>
                        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BlenderCheckBox}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Content" Value="{x:Null}"/>
                        </Style>
                    </DataGridCheckBoxColumn.ElementStyle>
                    <DataGridCheckBoxColumn.EditingElementStyle>
                        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BlenderCheckBox}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Content" Value="{x:Null}"/>
                        </Style>
                    </DataGridCheckBoxColumn.EditingElementStyle>
                </DataGridCheckBoxColumn>
            </DataGrid.Columns>
        </DataGrid>
        <UniformGrid Columns="2" Margin="0,8,0,0">
            <Button Style="{StaticResource BlenderButton}"
                    Content="恢复到默认层表"
                    Margin="0,0,4,0"
                    Padding="{DynamicResource Metric_ButtonPaddingSmall}"
                    Command="{Binding Settings.RestoreDefaultLayerCatalogCommand}"/>
            <Button Style="{StaticResource BlenderButton}"
                    Content="应用图层到当前图纸"
                    Margin="4,0,0,0"
                    Padding="{DynamicResource Metric_ButtonPaddingSmall}"
                    Command="{Binding Settings.ApplyLayerCatalogToDocumentCommand}"/>
        </UniformGrid>
    </StackPanel>
</UserControl>
