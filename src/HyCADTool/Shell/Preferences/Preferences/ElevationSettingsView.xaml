<UserControl x:Class="HyCADTool.Presentation.Views.Preferences.ElevationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:bc="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
             xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="420"
             btmetrics:BlenderMetricsOverlay.Attach="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ElevationPropertyRow" TargetType="{x:Type bc:PropertyRow}">
                <Setter Property="LabelWidth" Value="120"/>
            </Style>

            <!-- 标高：符号样式（当前通用使用 Settings.Scale / Settings.TextSize 推导 → 只读展示） -->
            <DataTemplate x:Key="Section_ElevationSymbol">
                <StackPanel Margin="{DynamicResource Metric_PropertyListMargin}">
                    <TextBlock Text="（当前标高符号从设置→样式预览派生；此处预留将来符号高度/三角/线粗独立参数。）"
                               Foreground="{DynamicResource Brush_TextDisabled}"
                               FontSize="{DynamicResource Metric_FontSmall}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <bc:PropertyRow Label="比例 Scale（只读）" Style="{StaticResource ElevationPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}"
                                 IsReadOnly="True"
                                 Text="{Binding Settings.Scale, Mode=OneWay, FallbackValue=40}"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="字高 TextSize（只读）" Style="{StaticResource ElevationPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}"
                                 IsReadOnly="True"
                                 Text="{Binding Settings.TextSize, Mode=OneWay, FallbackValue=2.5}"/>
                    </bc:PropertyRow>
                </StackPanel>
            </DataTemplate>

            <!-- 标高：文字样式（引用 Settings 文字参数） -->
            <DataTemplate x:Key="Section_ElevationText">
                <StackPanel Margin="{DynamicResource Metric_PropertyListMargin}">
                    <bc:PropertyRow Label="文字样式名" Style="{StaticResource ElevationPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}"
                                 IsReadOnly="True"
                                 Text="{Binding Settings.TextStyleName, Mode=OneWay, FallbackValue=0-hy-说明-S}"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="Title 字体 (StyleT)" Style="{StaticResource ElevationPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}"
                                 Text="{Binding Settings.StyleTFont, UpdateSourceTrigger=LostFocus, FallbackValue=微软雅黑}"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="Std 字体 (StyleS)" Style="{StaticResource ElevationPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}"
                                 Text="{Binding Settings.StyleSFont, UpdateSourceTrigger=LostFocus, FallbackValue=tssdeng.shx}"/>
                    </bc:PropertyRow>
                </StackPanel>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <ContentControl x:Name="Host"/>
</UserControl>
