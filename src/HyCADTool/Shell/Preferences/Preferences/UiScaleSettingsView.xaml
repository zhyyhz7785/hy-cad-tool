<UserControl x:Class="HyCADTool.Presentation.Views.Preferences.UiScaleSettingsView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:HyCADTool.Presentation.Views"
             xmlns:bc="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
             xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="480"
             btmetrics:BlenderMetricsOverlay.Attach="True">

    <!--
      本控件插在 ItemsControl/DataTemplate 内时，子元素 DataContext 会下探成 SettingsGroupVm。
      因此 NumericSlider 显式绑定到当前 UserControl（Root）的 DataContext.Settings.*，
      避免子元素继承链把绑定路径冲掉。范围 0.7~1.3，使 1.0 位于行程正中。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="UiScalePropertyRow" TargetType="{x:Type bc:PropertyRow}">
                <Setter Property="LabelWidth" Value="120"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="{DynamicResource Metric_PropertyListMargin}">
        <TextBlock Text="界面尺寸预设" FontSize="{DynamicResource Metric_FontMain}" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush_TextPrimary}" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="紧凑" Style="{StaticResource BlenderButton}" MinWidth="{DynamicResource Metric_DialogButtonWidth}" Margin="0,0,6,0"
                    Padding="{DynamicResource Metric_ButtonPaddingSmall}" Click="OnPresetCompactClick"/>
            <Button Content="标准" Style="{StaticResource BlenderButton}" MinWidth="{DynamicResource Metric_DialogButtonWidth}" Margin="0,0,6,0"
                    Padding="{DynamicResource Metric_ButtonPaddingSmall}" Click="OnPresetStandardClick"/>
            <Button Content="舒适" Style="{StaticResource BlenderButton}" MinWidth="{DynamicResource Metric_DialogButtonWidth}" Margin="0,0,6,0"
                    Padding="{DynamicResource Metric_ButtonPaddingSmall}" Click="OnPresetComfortClick"/>
        </StackPanel>

        <bc:PropertyRow Label="字号比例" Style="{StaticResource UiScalePropertyRow}">
            <bc:NumericSlider Minimum="0.7" Maximum="1.3" Step="0.05" Decimals="2" Unit="x"
                              Value="{Binding DataContext.Settings.UiFontScale, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </bc:PropertyRow>
        <bc:PropertyRow Label="行高/间距比" Style="{StaticResource UiScalePropertyRow}">
            <bc:NumericSlider Minimum="0.7" Maximum="1.3" Step="0.05" Decimals="2" Unit="x"
                              Value="{Binding DataContext.Settings.UiDensityScale, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </bc:PropertyRow>
        <bc:PropertyRow Label="输入框/列宽比" Style="{StaticResource UiScalePropertyRow}">
            <bc:NumericSlider Minimum="0.7" Maximum="1.3" Step="0.05" Decimals="2" Unit="x"
                              Value="{Binding DataContext.Settings.UiInputWidthScale, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </bc:PropertyRow>

        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource Metric_FontCaption}"
                   Foreground="{DynamicResource Brush_TextSecondary}" Margin="0,6,0,10">
            提示：滑块会即时尝试刷新已打开面板的 Metric；若个别布局未更新，请关闭并重新打开 Hy 面板或相关窗口。点「应用并写入」将当前比例保存到 hy-settings.json。
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="恢复 1.0" Style="{StaticResource BlenderButton}" MinWidth="{DynamicResource Metric_DialogButtonWidth}" Margin="0,0,8,0"
                    Padding="{DynamicResource Metric_ButtonPaddingSmall}" Click="OnResetScalesClick"/>
            <Button Content="应用并写入" Style="{StaticResource BlenderButton}" MinWidth="{DynamicResource Metric_DialogButtonWidth}"
                    Padding="{DynamicResource Metric_ButtonPaddingSmall}" Click="OnApplySaveClick"/>
        </StackPanel>
    </StackPanel>
</UserControl>
