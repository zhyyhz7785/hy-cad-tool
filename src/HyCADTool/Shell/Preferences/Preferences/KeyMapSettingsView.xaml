<UserControl x:Class="HyCADTool.Shell.Views.Preferences.KeyMapSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HyCADTool.Shell.ViewModels"
             xmlns:bc="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
             xmlns:bw="clr-namespace:HyCAD.BlenderUI.Controls.Widgets;assembly=HyCAD.BlenderUI"
             mc:Ignorable="d"
             Background="{DynamicResource Brush_RegionBack}"
             d:DesignHeight="400" d:DesignWidth="520"
             d:DataContext="{d:DesignInstance Type=vm:KeyMapSettingsViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        「快捷键」面板：
          - 列表式展示当前 KeyMap 条目（3 条内置 UI 键位 + 将来可扩展的 hy.cmd.* 条目）；
          - 点击 BlenderKeyEventField 聚焦后按任意键录入；VM 在 Save 时把 Text 解析回 Key/Modifiers；
          - 状态栏显示最近操作（加载/保存/恢复默认）结果。
    -->
    <Grid Margin="{DynamicResource Metric_SectionInset}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="快捷键 / UI 键位映射"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush_TextPrimary}"
                   Margin="0,0,0,6"/>

        <!-- 键位列表 -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:KeyMapBindingVm}">
                    <bc:PropertyRow Label="{Binding OperatorId}" LabelWidth="180">
                        <bw:BlenderKeyEventField Text="{Binding Display, Mode=OneWay}"
                                                 MinWidth="160"
                                                 ToolTip="点击后按目标快捷键（支持 Ctrl / Alt / Shift 组合）"/>
                    </bc:PropertyRow>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 状态 -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource Brush_TextSecondary}"
                   FontSize="{DynamicResource Metric_FontSmall}"
                   Margin="0,6,0,0"/>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="恢复默认"
                    Command="{Binding RestoreDefaultsCommand}"
                    Margin="0,0,6,0"/>
            <Button Content="保存到 hy-keymap.json"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
