<UserControl x:Class="HyCADTool.Presentation.Views.Preferences.ReinSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:bc="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
             xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="420"
             btmetrics:BlenderMetricsOverlay.Attach="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ReinPropertyRow" TargetType="{x:Type bc:PropertyRow}">
                <Setter Property="LabelWidth" Value="120"/>
            </Style>

            <!-- 钢筋参数 -->
            <DataTemplate x:Key="Section_Rein">
                <StackPanel Margin="{DynamicResource Metric_PropertyListMargin}">
                    <bc:PropertyRow Label="锚固长度" Style="{StaticResource ReinPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}" Text="500"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="点钢筋间距" Style="{StaticResource ReinPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}" Text="200"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="最小弯折长度" Style="{StaticResource ReinPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}" Text="150"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="锚固连接长度" Style="{StaticResource ReinPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}" Text="1500"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="弯钩长度" Style="{StaticResource ReinPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}" Text="1.0"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="保护层厚度" Style="{StaticResource ReinPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}" Text="1.0"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="点钢筋绘制直径" Style="{StaticResource ReinPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}" Text="0.35"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="点钢筋偏移" Style="{StaticResource ReinPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}" Text="1.35"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="多段线宽" Style="{StaticResource ReinPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}" Text="0"/>
                    </bc:PropertyRow>
                </StackPanel>
            </DataTemplate>

            <!-- 尺寸参数（钢筋相关） -->
            <DataTemplate x:Key="Section_ReinDim">
                <StackPanel Margin="{DynamicResource Metric_PropertyListMargin}">
                    <bc:PropertyRow Label="内部尺寸距离" Style="{StaticResource ReinPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}" Text="7"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="外部尺寸距离" Style="{StaticResource ReinPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}" Text="10"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="带尺寸距离" Style="{StaticResource ReinPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}" Text="14"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="引线距离" Style="{StaticResource ReinPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}" Text="5"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="距离容差" Style="{StaticResource ReinPropertyRow}">
                        <TextBox Style="{StaticResource BlenderTextBox}" Text="1"/>
                    </bc:PropertyRow>
                </StackPanel>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <ContentControl x:Name="Host"
                    d:ContentTemplate="{StaticResource Section_Rein}"
                    d:Content=" " />
</UserControl>
