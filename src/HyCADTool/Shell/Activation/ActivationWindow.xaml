<Window x:Class="HyCADTool.Shell.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
        Title="HyCAD 许可与激活"
        Width="560" MinWidth="480" Height="680" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        Background="{DynamicResource Brush_WindowBack}"
        Foreground="{DynamicResource Brush_TextPrimary}"
        btmetrics:BlenderMetricsOverlay.Attach="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{DynamicResource Metric_ButtonHeight}"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/LibraryResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#88c0d0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#7a8295" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="#2b2d31" />
                <Setter Property="BorderBrush" Value="#3a3d44" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style x:Key="MonoBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="TitleBarBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#d8dee9" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3b4453" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CloseTitleBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#bf616a" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#4c566a" BorderThickness="1">
        <DockPanel>
            <!-- 标题栏 -->
            <Border DockPanel.Dock="Top" Background="#1e222a" Height="{DynamicResource Metric_ButtonHeight}">
                <Grid>
                    <TextBlock Text="HyCAD 许可与激活" Foreground="#d8dee9"
                               FontSize="{DynamicResource Metric_FontHeader}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="—" Style="{StaticResource TitleBarBtn}" Click="BtnMinimize_Click" />
                        <Button Content="□" Style="{StaticResource TitleBarBtn}" Click="BtnMaximize_Click" />
                        <Button Content="✕" Style="{StaticResource CloseTitleBtn}" Click="BtnClose_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,18,16">
                <StackPanel>
                    <TextBlock Text="将本机机器码发给销售/代理商，获取 license.lic 或授权码后在此激活。"
                               Style="{StaticResource Hint}" Margin="0,0,0,12" />

                    <!-- 状态 -->
                    <Border Style="{StaticResource Card}" Padding="12,10">
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#ebcb8b" FontSize="12" />
                    </Border>

                    <!-- 机器码 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="① 本机机器码" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="复制后发给开发者签发；机器码与本机硬件绑定。" />
                            <TextBox x:Name="MachineCodeText" Style="{StaticResource MonoBox}"
                                     IsReadOnly="True" MinHeight="40" Background="#17181b"
                                     BorderBrush="#3a3d44" Foreground="#eceff4" />
                            <Button Content="复制机器码" Style="{StaticResource GhostBtn}"
                                    Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnCopy" />
                        </StackPanel>
                    </Border>

                    <!-- 二维码 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="② 微信扫码（可选）" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="若二维码未显示，请使用上方「复制机器码」。" />
                            <Border Background="White" Padding="8" HorizontalAlignment="Left" CornerRadius="4">
                                <Image x:Name="QrImage" Width="168" Height="168" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 激活 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="③ 导入授权" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="推荐导入 license.lic 文件；也可粘贴完整授权 JSON 后点「确定激活」。" />
                            <TextBox x:Name="LicenseCodeBox" Style="{StaticResource MonoBox}"
                                     MinHeight="88" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="11" Background="#17181b"
                                     BorderBrush="#3a3d44" Foreground="#d8dee9"
                                     TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="确定激活" Style="{StaticResource AccentBtn}"
                                        Click="OnActivate" />
                                <Button Content="从文件导入…" Style="{StaticResource GhostBtn}"
                                        Click="OnImport" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="激活后写入：%ProgramData%\HyCAD\license.lic" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
