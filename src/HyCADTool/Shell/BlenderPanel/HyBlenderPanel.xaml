<UserControl x:Class="HyCADTool.Shell.Views.HyBlenderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:HyCADTool.Shell.Views"
             xmlns:sponge="clr-namespace:HyCADTool.Features.SpongeCity.Views"
             xmlns:rein="clr-namespace:HyCADTool.Features.Reinforcement.Views"
             xmlns:pile="clr-namespace:HyCADTool.Features.Pile.Views"
             xmlns:baserein="clr-namespace:HyCADTool.Features.BaseRein.Views"
             xmlns:vm="clr-namespace:HyCADTool.Shell.ViewModels"
             xmlns:bc="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
             xmlns:bp="clr-namespace:HyCAD.BlenderUI.Controls.Primitives;assembly=HyCAD.BlenderUI"
             xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
             mc:Ignorable="d"
             btmetrics:BlenderMetricsOverlay.Attach="True"
             Background="{DynamicResource Brush_WindowBack}"
             d:DesignHeight="650" d:DesignWidth="320"
             d:DataContext="{d:DesignInstance Type=vm:HyBlenderPanelViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="HyIconTabItemStyle" TargetType="{x:Type bc:IconTabItem}">
                <Setter Property="Icon" Value="{Binding Icon}"/>
                <Setter Property="TooltipText" Value="{Binding Name}"/>
                <Setter Property="FontSize" Value="{DynamicResource Metric_FontIconLarge}"/>
            </Style>

            <Style x:Key="EditorTypeMenuButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BlenderButtonFlat}">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="EditorMenuItemButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BlenderButtonFlat}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Margin" Value="0,1"/>
            </Style>

            <Style x:Key="CommandRowButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BlenderButtonFlat}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Height" Value="{DynamicResource Metric_RowHeight}"/>
                <Setter Property="Margin" Value="0,1"/>
            </Style>

            <Style x:Key="CommandListBoxStyle" TargetType="{x:Type ListBox}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="CommandItemTemplate" DataType="{x:Type vm:CommandItemVm}">
                <Button Style="{StaticResource CommandRowButton}"
                        Command="{Binding ExecuteCommand}"
                        ToolTip="{Binding Tooltip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                   Foreground="{DynamicResource Brush_TextPrimary}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding KeyCaption}"
                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                   FontSize="{DynamicResource Metric_FontSmall}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </DataTemplate>

            <CollectionViewSource x:Key="GlobalSearchResultsView"
                                  Source="{Binding GlobalSearchResults}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Category"/>
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>

            <DataTemplate x:Key="RoadPanelSectionTemplate" DataType="{x:Type vm:CommandSectionVm}">
                <Expander Style="{StaticResource BlenderExpander}"
                          IsExpanded="{Binding IsExpanded}">
                    <Expander.Header>
                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <ListBox ItemsSource="{Binding Items}"
                             ItemTemplate="{StaticResource CommandItemTemplate}"
                             Style="{StaticResource CommandListBoxStyle}"
                             MaxHeight="320"/>
                </Expander>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 命令编辑器：左侧分类 IconTabBar -->
        <bc:IconTabBar Grid.Column="0"
                       ItemsSource="{Binding Tabs}"
                       SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                       ItemContainerStyle="{StaticResource HyIconTabItemStyle}"
                       Visibility="{Binding ShowCommandIconTabBar, Converter={StaticResource BoolToVis}}"/>

        <!-- 右侧：顶栏 EditorHeader + 内容区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Blender 编辑器顶栏：类型下拉 + 面包屑 + 搜索 -->
            <bc:EditorHeader Grid.Row="0">
                <bc:EditorHeader.EditorTypeIcon>
                    <Grid>
                        <Button x:Name="EditorTypeButton"
                                Style="{StaticResource EditorTypeMenuButton}"
                                Click="OnEditorTypeButtonClick"
                                ToolTip="切换编辑器类型">
                            <TextBlock Text="{Binding CurrentEditorIcon}"
                                       FontSize="{DynamicResource Metric_FontIconLarge}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Button>
                        <Popup x:Name="EditorMenuPopup"
                               PlacementTarget="{Binding ElementName=EditorTypeButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="False">
                            <Border Background="{DynamicResource Brush_PanelBack}"
                                    BorderBrush="{DynamicResource Brush_BorderDark}"
                                    BorderThickness="1"
                                    Padding="6"
                                    MinWidth="200"
                                    MaxHeight="360">
                                <ScrollViewer Style="{StaticResource BlenderScrollViewer}"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding EditorMenuSections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:EditorMenuSectionVm}">
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Header}"
                                                               Foreground="{DynamicResource Brush_TextDisabled}"
                                                               FontSize="{DynamicResource Metric_FontCaption}"
                                                               Margin="4,2,4,4"/>
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:EditorMenuItemVm}">
                                                                <Button Style="{StaticResource EditorMenuItemButton}"
                                                                        Command="{Binding DataContext.SelectEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding Key}"
                                                                        Click="OnEditorMenuItemClick">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="22"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{Binding Icon}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Name}"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </bc:EditorHeader.EditorTypeIcon>
                <bc:EditorHeader.LeftContent>
                    <TextBlock Text="{Binding BreadcrumbText}"
                               Foreground="{DynamicResource Brush_TextSecondary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </bc:EditorHeader.LeftContent>
                <bc:EditorHeader.RightContent>
                    <Grid MinWidth="120" MaxWidth="200" Margin="0,0,4,0">
                        <!-- 设置编辑器搜索 -->
                        <bp:SearchBox x:Name="PrefsSearchBox"
                                      Text="{Binding PreferencesVm.SettingsSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Placeholder="搜索设置…">
                            <bp:SearchBox.Style>
                                <Style TargetType="{x:Type bp:SearchBox}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreferencesMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </bp:SearchBox.Style>
                        </bp:SearchBox>
                        <!-- 命令编辑器搜索 -->
                        <bp:SearchBox x:Name="SearchBox"
                                      Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Placeholder="搜索命令…">
                            <bp:SearchBox.Style>
                                <Style TargetType="{x:Type bp:SearchBox}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCommandEditorMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </bp:SearchBox.Style>
                        </bp:SearchBox>
                    </Grid>
                </bc:EditorHeader.RightContent>
            </bc:EditorHeader>

            <!-- ===== 内容区 ===== -->
            <Grid Grid.Row="1" Background="{DynamicResource Brush_RegionBack}">

                <!-- 设置面板 -->
                <ContentControl Content="{Binding PreferencesPanelHost}">
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreferencesMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:HyBlenderPanelViewModel}">
                            <views:HyPreferencesView DataContext="{Binding PreferencesVm}"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- 过滤面板 -->
                <ContentControl Content="{Binding FilterPanelHost}">
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:HyBlenderPanelViewModel}">
                            <views:FilterPanel DataContext="{Binding FilterVm}"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- 海绵城市面板 -->
                <ContentControl Content="{Binding SpongeCityPanelHost}">
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSpongeCityMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:HyBlenderPanelViewModel}">
                            <sponge:SpongeCityPanel DataContext="{Binding SpongeCityVm}"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- 钢筋面板 -->
                <rein:ReinToolPanel>
                    <rein:ReinToolPanel.Style>
                        <Style TargetType="{x:Type rein:ReinToolPanel}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsReinMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </rein:ReinToolPanel.Style>
                </rein:ReinToolPanel>

                <!-- 桩基面板 -->
                <ContentControl Content="{Binding PilePanelHost}">
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPileMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:HyBlenderPanelViewModel}">
                            <pile:PilePanel DataContext="{Binding PileVm}"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- 基础钢筋面板 -->
                <ContentControl Content="{Binding BaseReinPanelHost}">
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBaseReinMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:HyBlenderPanelViewModel}">
                            <baserein:BaseReinPanel DataContext="{Binding BaseReinVm}"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- 螺栓聚类面板 -->
                <ContentControl Content="{Binding ClusterPanelHost}">
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsClusterMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:HyBlenderPanelViewModel}">
                            <views:ClusterPanel DataContext="{Binding ClusterVm}"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- 命令列表 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCommandListMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <!-- 搜索中：全局结果 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource BlenderScrollViewer}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="{DynamicResource Metric_ButtonPaddingSmall}">
                                <TextBlock Text="搜索结果（全部分类）"
                                           Foreground="{DynamicResource Brush_TextSecondary}"
                                           FontSize="{DynamicResource Metric_FontSmall}"
                                           Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding Source={StaticResource GlobalSearchResultsView}}"
                                              ItemTemplate="{StaticResource CommandItemTemplate}">
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,6,0,2"
                                                            Padding="2,2,2,2"
                                                            BorderBrush="{DynamicResource Brush_BorderDark}"
                                                            BorderThickness="0,0,0,1">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                                                   FontSize="{DynamicResource Metric_FontSmall}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                </ItemsControl>
                                <TextBlock Text="（无匹配命令）"
                                           Foreground="{DynamicResource Brush_TextDisabled}"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GlobalSearchResults.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 正常浏览 -->
                        <Grid Margin="{DynamicResource Metric_ButtonPaddingSmall}">
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSearching}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Style>
                                    <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource BlenderScrollViewer}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab.HasRoadPanelGroups}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <ItemsControl ItemTemplate="{StaticResource RoadPanelSectionTemplate}"
                                              ItemsSource="{Binding SelectedTab.RoadPanelGroups}"/>
                            </ScrollViewer>

                            <Expander IsExpanded="True">
                                <Expander.Style>
                                    <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource BlenderExpander}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab.HasRoadPanelGroups}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Expander.Style>
                                <Expander.Header>
                                    <TextBlock Text="{Binding SelectedTab.Name}" FontWeight="SemiBold"/>
                                </Expander.Header>
                                <ListBox ItemsSource="{Binding FilteredItems}"
                                         ItemTemplate="{StaticResource CommandItemTemplate}"
                                         Style="{StaticResource CommandListBoxStyle}"/>
                            </Expander>
                        </Grid>
                    </Grid>

                    <bc:StatusBar Grid.Row="1" CenterContent="{Binding StatusMessage}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
