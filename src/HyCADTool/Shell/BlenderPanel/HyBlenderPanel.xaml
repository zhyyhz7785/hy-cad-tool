<UserControl x:Class="HyCADTool.Presentation.Views.HyBlenderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:HyCADTool.Presentation.Views"
             xmlns:sponge="clr-namespace:HyCADTool.Features.SpongeCity.Views"
             xmlns:rein="clr-namespace:HyCADTool.Features.Reinforcement.Views"
             xmlns:pile="clr-namespace:HyCADTool.Features.Pile.Views"
             xmlns:vm="clr-namespace:HyCADTool.Presentation.ViewModels"
             xmlns:bc="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
             xmlns:bp="clr-namespace:HyCAD.BlenderUI.Controls.Primitives;assembly=HyCAD.BlenderUI"
             xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
             mc:Ignorable="d"
             btmetrics:BlenderMetricsOverlay.Attach="True"
             Background="{DynamicResource Brush_WindowBack}"
             d:DesignHeight="650" d:DesignWidth="320"
             d:DataContext="{d:DesignInstance Type=vm:HyBlenderPanelViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 左侧图标 Tab 容器样式：把 CategoryTabVm 的 Icon/Name 映射到 IconTabItem -->
            <Style x:Key="HyIconTabItemStyle" TargetType="{x:Type bc:IconTabItem}">
                <Setter Property="Icon" Value="{Binding Icon}"/>
                <Setter Property="TooltipText" Value="{Binding Name}"/>
                <Setter Property="FontSize" Value="{DynamicResource Metric_FontIconLarge}"/>
            </Style>

            <Style x:Key="CommandRowButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BlenderButtonFlat}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Height" Value="{DynamicResource Metric_RowHeight}"/>
                <Setter Property="Margin" Value="0,1"/>
            </Style>

            <Style x:Key="CommandListBoxStyle" TargetType="{x:Type ListBox}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="CommandItemTemplate" DataType="{x:Type vm:CommandItemVm}">
                <Button Style="{StaticResource CommandRowButton}"
                        Command="{Binding ExecuteCommand}"
                        ToolTip="{Binding Tooltip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                   Foreground="{DynamicResource Brush_TextPrimary}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding KeyCaption}"
                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                   FontSize="{DynamicResource Metric_FontSmall}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </DataTemplate>

            <!-- 全局搜索结果：按 Category 分组视图源 -->
            <CollectionViewSource x:Key="GlobalSearchResultsView"
                                  Source="{Binding GlobalSearchResults}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Category"/>
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>

            <!-- 道路 Tab：五区折叠（工程/路线/纵断/道路/工具） -->
            <DataTemplate x:Key="RoadPanelSectionTemplate" DataType="{x:Type vm:CommandSectionVm}">
                <Expander Style="{StaticResource BlenderExpander}"
                          IsExpanded="{Binding IsExpanded}">
                    <Expander.Header>
                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <ListBox ItemsSource="{Binding Items}"
                             ItemTemplate="{StaticResource CommandItemTemplate}"
                             Style="{StaticResource CommandListBoxStyle}"
                             MaxHeight="320"/>
                </Expander>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧：BlenderUI 原生 IconTabBar ===== -->
        <bc:IconTabBar Grid.Column="0"
                       ItemsSource="{Binding Tabs}"
                       SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                       ItemContainerStyle="{StaticResource HyIconTabItemStyle}"/>

        <!-- ===== 右侧内容区 ===== -->
        <Grid Grid.Column="1" Background="{DynamicResource Brush_RegionBack}">

            <!-- ========== 模式 1：设置面板（IsPreferencesMode=True） ========== -->
            <views:HyPreferencesView DataContext="{Binding PreferencesVm}">
                <views:HyPreferencesView.Style>
                    <Style TargetType="{x:Type views:HyPreferencesView}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsPreferencesMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:HyPreferencesView.Style>
            </views:HyPreferencesView>

            <!-- ========== 模式 2：过滤面板（IsFilterMode=True） ========== -->
            <views:FilterPanel DataContext="{Binding FilterVm}">
                <views:FilterPanel.Style>
                    <Style TargetType="{x:Type views:FilterPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsFilterMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:FilterPanel.Style>
            </views:FilterPanel>

            <!-- ========== 模式 4：海绵城市面板（IsSpongeCityMode=True） ========== -->
            <sponge:SpongeCityPanel DataContext="{Binding SpongeCityVm}">
                <sponge:SpongeCityPanel.Style>
                    <Style TargetType="{x:Type sponge:SpongeCityPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsSpongeCityMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </sponge:SpongeCityPanel.Style>
            </sponge:SpongeCityPanel>

            <!-- ========== 模式 5：钢筋面板（IsReinMode=True） ========== -->
            <rein:ReinToolPanel>
                <rein:ReinToolPanel.Style>
                    <Style TargetType="{x:Type rein:ReinToolPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsReinMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </rein:ReinToolPanel.Style>
            </rein:ReinToolPanel>

            <!-- ========== 模式 6：桩基面板（IsPileMode=True） ========== -->
            <pile:PilePanel DataContext="{Binding PileVm}">
                <pile:PilePanel.Style>
                    <Style TargetType="{x:Type pile:PilePanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsPileMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </pile:PilePanel.Style>
            </pile:PilePanel>

            <!-- ========== 模式 3：命令列表（IsCommandListMode=True） ========== -->
        <Grid>
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCommandListMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部搜索框：BlenderUI 原生 SearchBox -->
            <Border Grid.Row="0" Padding="{DynamicResource Metric_ButtonPaddingSmall}" Background="{DynamicResource Brush_HeaderBack}">
                <bp:SearchBox x:Name="SearchBox"
                              Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Placeholder="搜索命令…"/>
            </Border>

            <!-- 中部内容：搜索中显示全局扁平结果，否则显示当前分类列表 -->
            <Grid Grid.Row="1">
                <!-- 状态 A：搜索中 → 全局扁平结果 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource BlenderScrollViewer}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="{DynamicResource Metric_ButtonPaddingSmall}">
                        <TextBlock Text="搜索结果（全部分类）"
                                   Foreground="{DynamicResource Brush_TextSecondary}"
                                   FontSize="{DynamicResource Metric_FontSmall}"
                                   Margin="0,0,0,4"/>
                        <!-- 按 Category 分组，每组一个 SemiBold Header -->
                        <ItemsControl ItemsSource="{Binding Source={StaticResource GlobalSearchResultsView}}"
                                      ItemTemplate="{StaticResource CommandItemTemplate}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,6,0,2"
                                                    Padding="2,2,2,2"
                                                    BorderBrush="{DynamicResource Brush_BorderDark}"
                                                    BorderThickness="0,0,0,1">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush_TextSecondary}"
                                                           FontSize="{DynamicResource Metric_FontSmall}"/>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                        </ItemsControl>
                        <TextBlock Text="（无匹配命令）"
                                   Foreground="{DynamicResource Brush_TextDisabled}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GlobalSearchResults.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- 状态 B：正常浏览 → 当前 Tab 的命令列表 -->
                <Grid Margin="{DynamicResource Metric_ButtonPaddingSmall}">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- 道路：五区多 Expander（外层可滚动） -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource BlenderScrollViewer}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab.HasRoadPanelGroups}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemTemplate="{StaticResource RoadPanelSectionTemplate}"
                                      ItemsSource="{Binding SelectedTab.RoadPanelGroups}"/>
                    </ScrollViewer>

                    <!-- 其他分类：单 Expander + 虚拟化列表 -->
                    <Expander IsExpanded="True">
                        <Expander.Style>
                            <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource BlenderExpander}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab.HasRoadPanelGroups}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <Expander.Header>
                            <TextBlock Text="{Binding SelectedTab.Name}" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <ListBox ItemsSource="{Binding FilteredItems}"
                                 ItemTemplate="{StaticResource CommandItemTemplate}"
                                 Style="{StaticResource CommandListBoxStyle}"/>
                    </Expander>
                </Grid>
            </Grid>

            <!-- 底部：BlenderUI 原生 StatusBar -->
            <bc:StatusBar Grid.Row="2" CenterContent="{Binding StatusMessage}"/>
        </Grid>
        </Grid>
    </Grid>
</UserControl>
