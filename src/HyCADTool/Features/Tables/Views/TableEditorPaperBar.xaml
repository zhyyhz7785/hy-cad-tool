<UserControl x:Class="HyCADTool.Features.Tables.Views.TableEditorPaperBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helper="clr-namespace:HyCADTool.Shared.UI.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="40"
             d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="8,6"
            Background="{DynamicResource Brush_RegionBack}"
            BorderBrush="#4c566a"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Text="纸型" />
            <ComboBox Grid.Column="1"
                      Margin="0,0,12,0"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{Binding PaperPresetOptions}"
                      SelectedItem="{Binding SelectedPaperPresetOption}"
                      Style="{StaticResource BlenderComboBox}" />
            <TextBlock Grid.Column="2"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Text="宽 mm" />
            <TextBox Grid.Column="3"
                     Margin="0,0,12,0"
                     Style="{StaticResource BlenderTextBox}"
                     helper:TextBoxHelper.EnableCustomHandlers="True"
                     Text="{Binding TargetWidthMm, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="4"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush_TextSecondary}"
                       Text="{Binding PaperSummaryText}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</UserControl>
