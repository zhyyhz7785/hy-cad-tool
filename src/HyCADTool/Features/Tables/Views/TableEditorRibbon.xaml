<UserControl x:Class="HyCADTool.Features.Tables.Views.TableEditorRibbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tables="clr-namespace:HyCADTool.Features.Tables.Views"
             mc:Ignorable="d"
             d:DesignHeight="120"
             d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="8,4"
            Background="#2e3440"
            BorderBrush="#4c566a"
            BorderThickness="0,0,0,1">
        <TabControl Style="{StaticResource BlenderTabControl}">
            <TabItem Header="开始">
                <tables:TableEditorHomeTab DataContext="{Binding}" />
            </TabItem>
            <TabItem Header="布局">
                <tables:TableEditorLayoutTab DataContext="{Binding}" />
            </TabItem>
            <TabItem Header="页面">
                <tables:TableEditorPageTab DataContext="{Binding}" />
            </TabItem>
        </TabControl>
    </Border>
</UserControl>
