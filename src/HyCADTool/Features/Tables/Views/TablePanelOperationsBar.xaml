<UserControl x:Class="HyCADTool.Features.Tables.Views.TablePanelOperationsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helper="clr-namespace:HyCADTool.Shared.UI.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="120"
             d:DesignWidth="320">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,8">
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="0,0,4,0"
                       VerticalAlignment="Center"
                       Text="行" />
            <TextBox Grid.Column="1"
                     Margin="0,0,8,0"
                     Style="{StaticResource BlenderTextBox}"
                     helper:TextBoxHelper.EnableCustomHandlers="True"
                     Text="{Binding RowCount, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2"
                       Margin="0,0,4,0"
                       VerticalAlignment="Center"
                       Text="列" />
            <TextBox Grid.Column="3"
                     Margin="0,0,8,0"
                     Style="{StaticResource BlenderTextBox}"
                     helper:TextBoxHelper.EnableCustomHandlers="True"
                     Text="{Binding ColCount, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="4"
                       Margin="0,0,4,0"
                       VerticalAlignment="Center"
                       Text="行高" />
            <TextBox Grid.Column="5"
                     Margin="0,0,8,0"
                     Style="{StaticResource BlenderTextBox}"
                     helper:TextBoxHelper.EnableCustomHandlers="True"
                     Text="{Binding DefaultRowHeightMm, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="6"
                       Margin="0,0,4,0"
                       VerticalAlignment="Center"
                       Text="列宽" />
            <TextBox Grid.Column="7"
                     Style="{StaticResource BlenderTextBox}"
                     helper:TextBoxHelper.EnableCustomHandlers="True"
                     Text="{Binding DefaultColWidthMm, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <StackPanel Margin="0,0,0,6"
                    Orientation="Horizontal">
            <Button Margin="0,0,4,0"
                    Padding="8,4"
                    Command="{Binding NewEmptyTableCommand}"
                    Content="新建空表"
                    Style="{StaticResource BlenderButtonFlat}" />
            <ComboBox MinWidth="72"
                      Margin="0,0,4,0"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{Binding TemplateOptions}"
                      SelectedItem="{Binding SelectedTemplate}"
                      Style="{StaticResource BlenderComboBox}" />
            <Button Padding="8,4"
                    Command="{Binding LoadTemplateCommand}"
                    Content="从模板加载"
                    Style="{StaticResource BlenderButtonFlat}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <Button Margin="0,0,4,0"
                    Padding="8,4"
                    Command="{Binding PickCommand}"
                    Content="拾取表"
                    Style="{StaticResource BlenderButtonFlat}" />
            <Button Padding="8,4"
                    Command="{Binding PublishCommand}"
                    Content="写入图面"
                    Style="{StaticResource BlenderButtonFlat}" />
        </StackPanel>
    </StackPanel>
</UserControl>
