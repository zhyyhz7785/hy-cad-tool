<UserControl x:Class="HyCADTool.Features.Tables.Views.TableEditorPageTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helper="clr-namespace:HyCADTool.Shared.UI.Helpers"
             xmlns:layout="clr-namespace:HyCAD.Tables.Layout;assembly=HyCAD.Tables"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="72"
             d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="GroupCaption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Brush_TextSecondary}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,3,0,0" />
            </Style>

            <Style x:Key="RibbonBtn" TargetType="Button" BasedOn="{StaticResource BlenderButtonFlat}">
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="Margin" Value="1" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="4,6,0,4" Orientation="Horizontal">
        <StackPanel Margin="0,0,16,0">
            <ComboBox MinWidth="88"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{Binding PaperPresetOptions}"
                      SelectedItem="{Binding SelectedPaperPresetOption}"
                      Style="{StaticResource BlenderComboBox}" />
            <TextBlock Style="{StaticResource GroupCaption}" Text="纸型" />
        </StackPanel>

        <StackPanel Margin="0,0,16,0">
            <ComboBox MinWidth="72"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding PaperOrientation}">
                <ComboBoxItem Content="横向" Tag="{x:Static layout:PaperOrientation.Landscape}" />
                <ComboBoxItem Content="纵向" Tag="{x:Static layout:PaperOrientation.Portrait}" />
            </ComboBox>
            <TextBlock Style="{StaticResource GroupCaption}" Text="方向" />
        </StackPanel>

        <StackPanel Margin="0,0,16,0">
            <TextBox Width="64"
                     Style="{StaticResource BlenderTextBox}"
                     helper:TextBoxHelper.EnableCustomHandlers="True"
                     Text="{Binding TargetWidthMm, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource GroupCaption}" Text="宽 mm" />
        </StackPanel>

        <StackPanel>
            <TextBox Width="48"
                     Style="{StaticResource BlenderTextBox}"
                     helper:TextBoxHelper.EnableCustomHandlers="True"
                     Text="{Binding MarginMm, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource GroupCaption}" Text="边距 mm" />
        </StackPanel>

        <Separator Margin="2,2,8,2" Background="#4c566a" Style="{x:Null}">
            <Separator.LayoutTransform>
                <RotateTransform Angle="90" />
            </Separator.LayoutTransform>
        </Separator>

        <StackPanel Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
                <ComboBox MinWidth="100"
                          Margin="0,0,4,0"
                          DisplayMemberPath="DisplayName"
                          ItemsSource="{Binding StylePresetOptions}"
                          SelectedItem="{Binding SelectedStylePreset}"
                          Style="{StaticResource BlenderComboBox}" />
                <Button Padding="8,4"
                        Command="{Binding ApplyTableStylePresetCommand}"
                        Content="应用样式"
                        Style="{StaticResource RibbonBtn}" />
            </StackPanel>
            <TextBlock Style="{StaticResource GroupCaption}" Text="表样式" />
        </StackPanel>

        <StackPanel>
            <Button Command="{Binding FitColumnsToPaperCommand}"
                    Content="列宽适配纸宽"
                    Style="{StaticResource RibbonBtn}"
                    ToolTip="按目标纸宽与边距等比缩放全部列宽" />
            <TextBlock Style="{StaticResource GroupCaption}" Text="缩放" />
        </StackPanel>
    </StackPanel>
</UserControl>
