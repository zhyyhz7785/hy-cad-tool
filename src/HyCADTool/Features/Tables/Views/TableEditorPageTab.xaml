<UserControl x:Class="HyCADTool.Features.Tables.Views.TableEditorPageTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helper="clr-namespace:HyCADTool.Shared.UI.Helpers"
             xmlns:layout="clr-namespace:HyCAD.Tables.Layout;assembly=HyCAD.Tables"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="72"
             d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="GroupCaption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Brush_TextSecondary}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,3,0,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="4,6,0,4" Orientation="Horizontal">
        <StackPanel Margin="0,0,16,0">
            <ComboBox MinWidth="88"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{Binding PaperPresetOptions}"
                      SelectedItem="{Binding SelectedPaperPresetOption}"
                      Style="{StaticResource BlenderComboBox}" />
            <TextBlock Style="{StaticResource GroupCaption}" Text="纸型" />
        </StackPanel>

        <StackPanel Margin="0,0,16,0">
            <ComboBox MinWidth="72"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding PaperOrientation}">
                <ComboBoxItem Content="横向" Tag="{x:Static layout:PaperOrientation.Landscape}" />
                <ComboBoxItem Content="纵向" Tag="{x:Static layout:PaperOrientation.Portrait}" />
            </ComboBox>
            <TextBlock Style="{StaticResource GroupCaption}" Text="方向" />
        </StackPanel>

        <StackPanel Margin="0,0,16,0">
            <TextBox Width="64"
                     Style="{StaticResource BlenderTextBox}"
                     helper:TextBoxHelper.EnableCustomHandlers="True"
                     Text="{Binding TargetWidthMm, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource GroupCaption}" Text="宽 mm" />
        </StackPanel>

        <StackPanel>
            <TextBox Width="48"
                     Style="{StaticResource BlenderTextBox}"
                     helper:TextBoxHelper.EnableCustomHandlers="True"
                     Text="{Binding MarginMm, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource GroupCaption}" Text="边距 mm" />
        </StackPanel>
    </StackPanel>
</UserControl>
