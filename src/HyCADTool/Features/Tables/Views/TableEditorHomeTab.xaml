<UserControl x:Class="HyCADTool.Features.Tables.Views.TableEditorHomeTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="72"
             d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="AlignBtn" TargetType="Button" BasedOn="{StaticResource BlenderButtonFlat}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="1" />
                <Setter Property="FontSize" Value="11" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="0,6,0,4" Orientation="Horizontal">
        <StackPanel Margin="0,0,16,0">
            <TextBlock Margin="0,0,0,4"
                       Foreground="{DynamicResource Brush_TextSecondary}"
                       Text="对齐" />
            <UniformGrid Columns="3" Rows="3">
                <Button Command="{Binding ApplyAlignmentCommand}"
                        CommandParameter="Start,Start"
                        Content="↖"
                        Style="{StaticResource AlignBtn}"
                        ToolTip="左上" />
                <Button Command="{Binding ApplyAlignmentCommand}"
                        CommandParameter="Center,Start"
                        Content="↑"
                        Style="{StaticResource AlignBtn}"
                        ToolTip="中上" />
                <Button Command="{Binding ApplyAlignmentCommand}"
                        CommandParameter="End,Start"
                        Content="↗"
                        Style="{StaticResource AlignBtn}"
                        ToolTip="右上" />
                <Button Command="{Binding ApplyAlignmentCommand}"
                        CommandParameter="Start,Center"
                        Content="←"
                        Style="{StaticResource AlignBtn}"
                        ToolTip="左中" />
                <Button Command="{Binding ApplyAlignmentCommand}"
                        CommandParameter="Center,Center"
                        Content="●"
                        Style="{StaticResource AlignBtn}"
                        ToolTip="居中" />
                <Button Command="{Binding ApplyAlignmentCommand}"
                        CommandParameter="End,Center"
                        Content="→"
                        Style="{StaticResource AlignBtn}"
                        ToolTip="右中" />
                <Button Command="{Binding ApplyAlignmentCommand}"
                        CommandParameter="Start,End"
                        Content="↙"
                        Style="{StaticResource AlignBtn}"
                        ToolTip="左下" />
                <Button Command="{Binding ApplyAlignmentCommand}"
                        CommandParameter="Center,End"
                        Content="↓"
                        Style="{StaticResource AlignBtn}"
                        ToolTip="中下" />
                <Button Command="{Binding ApplyAlignmentCommand}"
                        CommandParameter="End,End"
                        Content="↘"
                        Style="{StaticResource AlignBtn}"
                        ToolTip="右下" />
            </UniformGrid>
        </StackPanel>

        <StackPanel VerticalAlignment="Bottom">
            <CheckBox Margin="0,0,0,4"
                      Content="自动换行 (Wrap)"
                      IsChecked="{Binding SelectedAllowWrap}"
                      IsEnabled="{Binding HasSelection}" />
            <TextBlock Foreground="{DynamicResource Brush_TextSecondary}"
                       Text="M1：Wrap 写入 Domain，落图渲染留 M2"
                       TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
