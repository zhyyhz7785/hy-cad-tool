<UserControl x:Class="HyCADTool.Features.Tables.Views.TableEditorLayoutRibbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helper="clr-namespace:HyCADTool.Shared.UI.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="88"
             d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="8,4"
            Background="#2e3440"
            BorderBrush="#4c566a"
            BorderThickness="0,0,0,1">
        <TabControl Style="{StaticResource BlenderTabControl}">
            <TabItem Header="布局">
                <StackPanel Margin="0,6,0,4">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   Text="行" />
                        <TextBox Grid.Column="1"
                                 Margin="0,0,8,0"
                                 Style="{StaticResource BlenderTextBox}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Text="{Binding RowCount, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   Text="列" />
                        <TextBox Grid.Column="3"
                                 Margin="0,0,8,0"
                                 Style="{StaticResource BlenderTextBox}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Text="{Binding ColCount, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="4"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   Text="行高(mm)" />
                        <TextBox Grid.Column="5"
                                 Margin="0,0,8,0"
                                 Style="{StaticResource BlenderTextBox}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Text="{Binding DefaultRowHeightMm, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="6"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   Text="列宽(mm)" />
                        <TextBox Grid.Column="7"
                                 Margin="0,0,12,0"
                                 Style="{StaticResource BlenderTextBox}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True"
                                 Text="{Binding DefaultColWidthMm, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="8"
                                Padding="10,4"
                                Command="{Binding NewEmptyTableCommand}"
                                Content="新建空表"
                                Style="{StaticResource BlenderButtonFlat}" />
                    </Grid>
                    <TextBlock Foreground="{DynamicResource Brush_TextSecondary}"
                               Text="{Binding SummaryText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Border>
</UserControl>
