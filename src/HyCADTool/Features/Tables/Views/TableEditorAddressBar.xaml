<UserControl x:Class="HyCADTool.Features.Tables.Views.TableEditorAddressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="32"
             d:DesignWidth="800">
    <Border Padding="8,4"
            Background="#eceff4"
            BorderBrush="#d8dee9"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#2e3440"
                       Text="名称框" />
            <TextBox Grid.Column="1"
                     Margin="0,0,12,0"
                     VerticalContentAlignment="Center"
                     Background="#ffffff"
                     BorderBrush="#d8dee9"
                     FontWeight="SemiBold"
                     Foreground="#2e3440"
                     IsReadOnly="True"
                     Text="{Binding SelectedCellAddressText, Mode=OneWay}" />
            <TextBlock Grid.Column="2"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#2e3440"
                       Text="内容" />
            <TextBox Grid.Column="3"
                     VerticalContentAlignment="Center"
                     Background="#ffffff"
                     BorderBrush="#d8dee9"
                     Foreground="#2e3440"
                     IsReadOnly="True"
                     Text="{Binding SelectedCellPreviewText, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
