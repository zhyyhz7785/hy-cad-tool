<UserControl x:Class="HyCADTool.Features.Tables.Views.TablePanel"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

             xmlns:helper="clr-namespace:HyCADTool.Shared.UI.Helpers"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             xmlns:tables="clr-namespace:HyCADTool.Features.Tables.Views"

             mc:Ignorable="d"

             d:DesignHeight="520"

             d:DesignWidth="320"

             Background="{DynamicResource Brush_RegionBack}"

             Foreground="{DynamicResource Brush_TextPrimary}">

    <UserControl.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml" />

                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml" />

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </UserControl.Resources>



    <Grid Margin="8">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>



        <TextBlock Grid.Row="0"

                   Margin="0,0,0,6"

                   FontWeight="Bold"

                   Text="HyTable" />



        <TextBlock Grid.Row="1"

                   Margin="0,0,0,8"

                   Text="{Binding SummaryText}"

                   TextWrapping="Wrap" />



        <tables:TablePanelOperationsBar Grid.Row="2" />



        <tables:TableFillGridView Grid.Row="3" />



        <TextBlock Grid.Row="4"

                   Margin="0,6,0,0"

                   Foreground="{DynamicResource Brush_TextSecondary}"

                   Text="{Binding StatusMessage}"

                   TextWrapping="Wrap" />

    </Grid>

</UserControl>


