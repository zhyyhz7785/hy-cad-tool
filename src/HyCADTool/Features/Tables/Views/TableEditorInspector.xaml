<UserControl x:Class="HyCADTool.Features.Tables.Views.TableEditorInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#2e3440"
            BorderBrush="#4c566a"
            BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8,6">
                <TextBlock Margin="0,0,0,6"
                           FontWeight="SemiBold"
                           Text="Inspector" />

                <Expander Margin="0,0,0,4"
                          Header="角色"
                          IsExpanded="True">
                    <TextBlock Margin="4,2,0,4"
                               Foreground="{DynamicResource Brush_TextSecondary}"
                               Text="{Binding SelectedRoleText, Mode=OneWay}" />
                </Expander>

                <Expander Margin="0,0,0,4"
                          Header="FieldKey"
                          IsExpanded="True">
                    <TextBlock Margin="4,2,0,4"
                               Foreground="{DynamicResource Brush_TextSecondary}"
                               Text="{Binding SelectedFieldKey, Mode=OneWay}" />
                </Expander>

                <Expander Margin="0,0,0,4"
                          Header="合并跨度"
                          IsExpanded="True">
                    <StackPanel Margin="4,2,0,4">
                        <TextBlock Foreground="{DynamicResource Brush_TextSecondary}">
                            <Run Text="RowSpan=" />
                            <Run Text="{Binding SelectedRowSpan, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource Brush_TextSecondary}">
                            <Run Text="ColSpan=" />
                            <Run Text="{Binding SelectedColSpan, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Expander>

                <Expander Header="对齐（只读预览）"
                          IsExpanded="False">
                    <StackPanel Margin="4,2,0,4">
                        <TextBlock Foreground="{DynamicResource Brush_TextSecondary}">
                            <Run Text="HAlign=" />
                            <Run Text="{Binding SelectedHAlign, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource Brush_TextSecondary}">
                            <Run Text="VAlign=" />
                            <Run Text="{Binding SelectedVAlign, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource Brush_TextSecondary}">
                            <Run Text="Wrap=" />
                            <Run Text="{Binding SelectedAllowWrap, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
