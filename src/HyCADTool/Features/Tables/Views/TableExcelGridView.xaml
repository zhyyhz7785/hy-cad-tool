<UserControl x:Class="HyCADTool.Features.Tables.Views.TableExcelGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helper="clr-namespace:HyCADTool.Shared.UI.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="ExcelColumnHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#F3F3F3" />
                <Setter Property="Foreground" Value="#333333" />
                <Setter Property="BorderBrush" Value="#D4D4D4" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="ExcelRowHeader" TargetType="DataGridRowHeader">
                <Setter Property="Background" Value="#F3F3F3" />
                <Setter Property="Foreground" Value="#333333" />
                <Setter Property="BorderBrush" Value="#D4D4D4" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Width" Value="36" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="11" />
            </Style>

            <Style x:Key="ExcelCellTextBlock" TargetType="TextBlock">
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                        <Setter Property="Background" Value="#E8E8E8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ExcelCellTextBox" TargetType="TextBox">
                <Setter Property="helper:TextBoxHelper.EnableCustomHandlers" Value="True" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                        <Setter Property="IsReadOnly" Value="True" />
                        <Setter Property="Background" Value="#E8E8E8" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                        <Setter Property="IsReadOnly" Value="True" />
                        <Setter Property="Background" Value="#E8E8E8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ExcelDataGrid" TargetType="DataGrid">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#000000" />
                <Setter Property="RowBackground" Value="#FFFFFF" />
                <Setter Property="AlternatingRowBackground" Value="#FFFFFF" />
                <Setter Property="GridLinesVisibility" Value="All" />
                <Setter Property="HorizontalGridLinesBrush" Value="#D4D4D4" />
                <Setter Property="VerticalGridLinesBrush" Value="#D4D4D4" />
                <Setter Property="BorderBrush" Value="#D4D4D4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="HeadersVisibility" Value="All" />
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource ExcelColumnHeader}" />
                <Setter Property="RowHeaderStyle" Value="{StaticResource ExcelRowHeader}" />
                <Setter Property="RowHeight" Value="22" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="CanUserReorderColumns" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="SelectionUnit" Value="Cell" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DataGrid x:Name="MatrixGrid"
              AutoGenerateColumns="False"
              BeginningEdit="OnBeginningEdit"
              IsReadOnly="False"
              ItemsSource="{Binding MatrixRows}"
              LoadingRow="OnLoadingRow"
              Style="{StaticResource ExcelDataGrid}" />
</UserControl>
