<Window x:Class="HyCADTool.Features.Tables.Views.TableEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
        xmlns:conv="clr-namespace:HyCADTool.Shared.UI.Converters"
        xmlns:tables="clr-namespace:HyCADTool.Features.Tables.Views"
        Title="HyTable 表格编辑器"
        Width="1060"
        Height="740"
        MinWidth="860"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Brush_WindowBack}"
        Foreground="{DynamicResource Brush_TextPrimary}"
        btmetrics:BlenderMetricsOverlay.Attach="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{DynamicResource Metric_ButtonHeight}"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/LibraryResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TitleBarBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#d8dee9" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3b4453" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseTitleBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#bf616a" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource BlenderButtonFlat}">
                <Setter Property="Padding" Value="16,6" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="MinWidth" Value="88" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#4c566a" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Height="{DynamicResource Metric_ButtonHeight}"
                    Background="#1e222a">
                <Grid>
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource Metric_FontHeader}"
                               FontWeight="SemiBold"
                               Text="HyTable 表格编辑器" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Click="BtnMinimize_Click"
                                Content="—"
                                Style="{StaticResource TitleBarBtn}" />
                        <Button Click="BtnMaximize_Click"
                                Content="□"
                                Style="{StaticResource TitleBarBtn}" />
                        <Button Click="BtnClose_Click"
                                Content="✕"
                                Style="{StaticResource CloseTitleBtn}" />
                    </StackPanel>
                </Grid>
            </Border>

            <tables:TableEditorPaperBar Grid.Row="1" DataContext="{Binding}" />
            <tables:TableEditorRibbon Grid.Row="2" DataContext="{Binding}" />
            <tables:TableEditorAddressBar Grid.Row="3" DataContext="{Binding}" />

            <Grid Grid.Row="4" Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        BorderBrush="#4c566a"
                        BorderThickness="1">
                    <Grid>
                        <tables:ExcelGridControl DataContext="{Binding}" />
                        <Border Background="#252b34"
                                Visibility="{Binding HasTable, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#d8dee9"
                                           Text="尚未创建表格" />
                                <TextBlock Margin="0,4,0,12"
                                           HorizontalAlignment="Center"
                                           Foreground="#88909e"
                                           Text="在「布局」选项卡新建空表，或从模板加载" />
                                <StackPanel HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                    <Button Command="{Binding NewEmptyTableCommand}"
                                            Content="新建空表"
                                            Style="{StaticResource ActionBtn}" />
                                    <Button Command="{Binding LoadSampleCommand}"
                                            Content="加载人员样表"
                                            Style="{StaticResource ActionBtn}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <tables:TableEditorInspector Grid.Column="1"
                                             DataContext="{Binding}" />
            </Grid>

            <Border Grid.Row="5"
                    Padding="{DynamicResource Metric_Padding_8_6}"
                    Background="#3b4453"
                    BorderBrush="#4c566a"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock MaxWidth="520"
                               VerticalAlignment="Center"
                               Foreground="#a3be8c"
                               Text="{Binding StatusMessage}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Command="{Binding PickCommand}"
                                Content="拾取表"
                                Style="{StaticResource ActionBtn}" />
                        <Button Command="{Binding PublishCommand}"
                                Content="插入图面"
                                IsEnabled="{Binding HasTable}"
                                Style="{StaticResource ActionBtn}" />
                        <Button Click="BtnClose_Click"
                                Content="取消"
                                Style="{StaticResource ActionBtn}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
