<UserControl x:Class="HyCADTool.Features.DataExchange.Hyob.Presentation.Views.HyobHistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HyCADTool.Features.DataExchange.Hyob.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="420"
             d:DataContext="{d:DesignInstance Type=vm:HyobHistoryPanelViewModel, IsDesignTimeCreatable=False}"
             Background="#1E1E1E"
             Foreground="#DDDDDD"
             FontFamily="Consolas, Microsoft YaHei UI, Segoe UI"
             FontSize="12">

    <!--
        M10：hyob 历史面板。设计要点：
        · 不依赖 BlenderUI 主题字典，纯本地灰色调（hycad-project-pitfalls B11/B12 规避）
        · 顶部：分支 + 状态栏；
        · 工具按钮：刷新 / 双 commit 对比 / WIP / 自检 / 清除 pin；
        · 中部：commit 列表（DataGrid），单击 = 选中，Ctrl+点击 = pin 为 from/to；
        · 底部：diff 文本（多行只读 TextBox + 等宽字体）。
    -->

    <UserControl.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F3F"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#666"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：分支与状态 -->
        <Border Grid.Row="0" Background="#2A2A2A" Padding="8,4" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical" Grid.Column="0">
                    <TextBlock Text="hyob 历史" FontWeight="Bold" Foreground="#FFE695"/>
                    <TextBlock Text="{Binding RepoPath}" FontSize="10" Foreground="#888"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding BranchName, StringFormat='[{0}]'}"
                           Foreground="#9DC8FF" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </Grid>
        </Border>

        <!-- 工具按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="6,4,6,4">
            <Button Style="{StaticResource ToolBtn}" Content="刷新"     Command="{Binding RefreshCommand}"/>
            <Button Style="{StaticResource ToolBtn}" Content="对比 A↔B" Command="{Binding DiffSelectedPairCommand}"/>
            <Button Style="{StaticResource ToolBtn}" Content="WIP"      Command="{Binding DiffWipCommand}"/>
            <Button Style="{StaticResource ToolBtn}" Content="自检"     Command="{Binding RoundTripCommand}"/>
            <Button Style="{StaticResource ToolBtn}" Content="清除 pin" Command="{Binding ClearComparePinsCommand}"/>
        </StackPanel>

        <!-- commit 列表 -->
        <DataGrid x:Name="CommitGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding Commits}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  RowHeight="20"
                  GridLinesVisibility="None"
                  Background="#1E1E1E"
                  Foreground="#DDDDDD"
                  RowBackground="#1E1E1E"
                  AlternatingRowBackground="#23232A"
                  BorderThickness="0"
                  CanUserResizeRows="False"
                  CanUserAddRows="False"
                  PreviewMouseLeftButtonDown="OnGridPreviewMouseDown"
                  SelectionMode="Single">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2A2A2A"/>
                    <Setter Property="Foreground" Value="#DDDDDD"/>
                    <Setter Property="BorderBrush" Value="#3A3A3A"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="Padding" Value="4,2"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="4,1"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3D5A80"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="hash"  Binding="{Binding ShortHash, Mode=OneWay}"   Width="84"/>
                <DataGridTextColumn Header="time"  Binding="{Binding TimeText, Mode=OneWay}"    Width="110"/>
                <DataGridTextColumn Header="cmd"   Binding="{Binding Command, Mode=OneWay}"     Width="60"/>
                <DataGridTextColumn Header="ents"  Binding="{Binding EntityCount, Mode=OneWay}" Width="60"/>
                <DataGridTextColumn Header="msg"   Binding="{Binding Message, Mode=OneWay}"     Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- pin 状态条 -->
        <Border Grid.Row="3" Background="#262626" Padding="6,2" BorderBrush="#3A3A3A" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Run.Text 默认为 TwoWay，CompareLeft 变化时会向只读 ShortHash 写回 → InvalidOperationException，必须 OneWay -->
                <TextBlock Grid.Column="0">
                    <Run Text="A: " Foreground="#888"/>
                    <Run Text="{Binding CompareLeft.ShortHash, Mode=OneWay, FallbackValue='— 未 pin', TargetNullValue='— 未 pin'}"/>
                </TextBlock>
                <TextBlock Grid.Column="1">
                    <Run Text="B: " Foreground="#888"/>
                    <Run Text="{Binding CompareRight.ShortHash, Mode=OneWay, FallbackValue='— 未 pin', TargetNullValue='— 未 pin'}"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- diff 文本 -->
        <TextBox Grid.Row="4"
                 Text="{Binding DiffText, Mode=OneWay}"
                 IsReadOnly="True"
                 Background="#161616"
                 Foreground="#C8D8C8"
                 FontFamily="Consolas"
                 FontSize="11"
                 BorderThickness="0"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Padding="6,4"/>
    </Grid>
</UserControl>
