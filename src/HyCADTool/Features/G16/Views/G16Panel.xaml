<UserControl x:Class="HyCADTool.Features.G16.Views.G16Panel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:bc="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
             xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
             xmlns:local="clr-namespace:HyCADTool.Features.G16.Views"
             xmlns:vm="clr-namespace:HyCADTool.Features.G16.ViewModels"
             Background="{DynamicResource Brush_RegionBack}"
             Foreground="{DynamicResource Brush_TextPrimary}"
             mc:Ignorable="d"
             btmetrics:BlenderMetricsOverlay.Attach="True"
             d:DesignHeight="700"
             d:DesignWidth="320">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="G16PropertyRow" TargetType="{x:Type bc:PropertyRow}">
                <Setter Property="LabelWidth" Value="112"/>
            </Style>

            <Style x:Key="G16InputBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BlenderTextBox}">
                <Setter Property="MinWidth" Value="72"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
            </Style>

            <HierarchicalDataTemplate DataType="{x:Type vm:G16CatalogTreeItemVm}" ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding DisplayName}"/>
            </HierarchicalDataTemplate>

            <DataTemplate DataType="{x:Type vm:G16ParamValueVm}">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Label}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush_TextSecondary}"
                               TextTrimming="CharacterEllipsis"/>
                    <ContentControl Grid.Column="1">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <TextBox Style="{StaticResource G16InputBox}"
                                                 Text="{Binding NumberText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Boolean">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <CheckBox IsChecked="{Binding BoolValue}"
                                                          VerticalAlignment="Center"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource BlenderScrollViewer}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource Metric_ButtonPaddingSmall}">

            <TextBlock Text="16G101 参数化构造大样 — 严格遵照图集，无依据不绘制。"
                       Foreground="{DynamicResource Brush_TextSecondary}"
                       FontSize="{DynamicResource Metric_FontCaption}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>

            <Expander Style="{StaticResource BlenderExpander}" Header="全局设定" IsExpanded="True" Margin="0,2,0,3">
                <StackPanel Margin="{DynamicResource Metric_PropertyListMargin}">
                    <bc:PropertyRow Label="砼强度" Style="{StaticResource G16PropertyRow}">
                        <ComboBox ItemsSource="{Binding ConcreteGradeChoices}"
                                  SelectedItem="{Binding Global.ConcreteGrade}"
                                  Style="{StaticResource BlenderComboBox}"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="钢筋牌号" Style="{StaticResource G16PropertyRow}">
                        <ComboBox ItemsSource="{Binding RebarGradeChoices}"
                                  SelectedItem="{Binding Global.RebarGrade}"
                                  Style="{StaticResource BlenderComboBox}"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="抗震等级" Style="{StaticResource G16PropertyRow}">
                        <ComboBox ItemsSource="{Binding SeismicGradeChoices}"
                                  SelectedItem="{Binding Global.SeismicGrade}"
                                  Style="{StaticResource BlenderComboBox}"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="环境类别" Style="{StaticResource G16PropertyRow}">
                        <ComboBox ItemsSource="{Binding EnvironmentClassChoices}"
                                  SelectedItem="{Binding Global.EnvironmentClass}"
                                  Style="{StaticResource BlenderComboBox}"/>
                    </bc:PropertyRow>
                    <bc:PropertyRow Label="主筋直径 d" Style="{StaticResource G16PropertyRow}">
                        <TextBox Style="{StaticResource G16InputBox}"
                                 Text="{Binding Global.RebarDiameter, UpdateSourceTrigger=PropertyChanged}"/>
                    </bc:PropertyRow>
                    <TextBlock Text="{Binding LookupSummary}"
                               Foreground="{DynamicResource Brush_TextSecondary}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Expander>

            <Expander Style="{StaticResource BlenderExpander}" Header="构件目录（16G101）" IsExpanded="True" Margin="0,2,0,3">
                <TreeView ItemsSource="{Binding CatalogTree}"
                          SelectedItemChanged="TreeView_SelectedItemChanged"
                          Style="{StaticResource BlenderOutliner}"
                          Background="Transparent"
                          BorderThickness="0"
                          MaxHeight="200"
                          Margin="0,4,0,0"/>
            </Expander>

            <Expander Style="{StaticResource BlenderExpander}" Header="构件参数" IsExpanded="True" Margin="0,2,0,3">
                <StackPanel Margin="{DynamicResource Metric_PropertyListMargin}">
                    <TextBlock Text="{Binding AtlasRefText}"
                               Foreground="{DynamicResource Brush_TextSecondary}"
                               FontSize="11"
                               Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Parameters}"/>
                </StackPanel>
            </Expander>

            <Expander Style="{StaticResource BlenderExpander}" Header="示意预览" IsExpanded="True" Margin="0,2,0,3">
                <local:G16PreviewControl Sketch="{Binding PreviewSketch}"
                                         Height="160"
                                         Margin="0,4,0,0"/>
            </Expander>

            <UniformGrid Columns="2" Margin="0,6,0,0">
                <Button Content="刷新预览"
                        Command="{Binding RefreshPreviewCommand}"
                        Style="{StaticResource BlenderButton}"
                        Margin="1"/>
                <Button Content="绘制大样"
                        Command="{Binding DrawCommand}"
                        Style="{StaticResource BlenderButton}"
                        Margin="1"/>
            </UniformGrid>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource Brush_TextSecondary}"
                       FontSize="10"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
