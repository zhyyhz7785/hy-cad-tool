<UserControl x:Class="HyCADTool.Features.Elevation.Views.Structure3DPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helper="clr-namespace:HyCADTool.Shared.UI.Helpers"
             xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
             d:DesignWidth="230"
             Background="{DynamicResource Brush_RegionBack}"
             Foreground="{DynamicResource Brush_TextPrimary}"
             mc:Ignorable="d"
             btmetrics:BlenderMetricsOverlay.Attach="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="0">
        <!--  第一分区：参数  -->
        <Expander Style="{StaticResource BlenderExpander}"
                  Margin="5"
                  Header="参数"
                  IsExpanded="True">
            <StackPanel>
                <!--  墙体厚度  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Foreground="{DynamicResource Brush_TextPrimary}"
                               Text="墙厚 (mm)" />
                    <TextBox Grid.Column="1" Style="{StaticResource BlenderTextBox}"
                             Height="{DynamicResource Metric_StatusBarHeight}"
                             helper:TextBoxHelper.EnableCustomHandlers="True"
                             Text="{Binding WallThicknessText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!--  筏板厚度  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Foreground="{DynamicResource Brush_TextPrimary}"
                               Text="筏板厚 (mm)" />
                    <TextBox Grid.Column="1" Style="{StaticResource BlenderTextBox}"
                             Height="{DynamicResource Metric_StatusBarHeight}"
                             helper:TextBoxHelper.EnableCustomHandlers="True"
                             Text="{Binding RaftThicknessText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!--  剖面位移  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Foreground="{DynamicResource Brush_TextPrimary}"
                               Text="剖面位移 (mm)" />
                    <TextBox Grid.Column="1" Style="{StaticResource BlenderTextBox}"
                             Height="{DynamicResource Metric_StatusBarHeight}"
                             helper:TextBoxHelper.EnableCustomHandlers="True"
                             Text="{Binding SectionDisplacementText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock Foreground="{DynamicResource Brush_TextDisabled}"
                           FontSize="{DynamicResource Metric_FontCaption}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Text="模型空间坐标 1:1 实际 mm；参数不乘出图比例。剖切符号大小取设置面板出图比例。"/>
            </StackPanel>
        </Expander>

        <!--  第二分区：工作流  -->
        <Expander Style="{StaticResource BlenderExpander}"
                  Margin="5"
                  Header="工作流"
                  IsExpanded="True">
            <StackPanel>
                <Button Style="{StaticResource BlenderButton}"
                        Command="{Binding StepOneCommand}"
                        Content="① 整理底图 (DCEL)" />
                <TextBlock Foreground="{DynamicResource Brush_TextDisabled}"
                           FontSize="{DynamicResource Metric_FontCaption}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Text="选择基础轮廓曲线，生成 dcelOuter / dcelInner 闭合多段线。"/>

                <Button Style="{StaticResource BlenderButton}"
                        Command="{Binding StepTwoCommand}"
                        Content="② 生成 3D 模型" />
                <TextBlock Foreground="{DynamicResource Brush_TextDisabled}"
                           FontSize="{DynamicResource Metric_FontCaption}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Text="先选 dcel 多边形，再选标高文本（TEXT），按上方墙厚/筏板厚生成 3D 墙体与筏板。"/>

                <Button Style="{StaticResource BlenderButton}"
                        Command="{Binding StepThreeCommand}"
                        Content="③ 生成剖面设计图" />
                <TextBlock Foreground="{DynamicResource Brush_TextDisabled}"
                           FontSize="{DynamicResource Metric_FontCaption}"
                           TextWrapping="Wrap"
                           Text="先选剖切线（LINE，X向编号1,2,3 / Y向编号A,B,C），再选 3D 实体；按剖面位移在图旁排布 2D 剖面图，自动加剖切符号与「N-N 剖面图」标签。"/>
            </StackPanel>
        </Expander>

        <!--  状态栏  -->
        <TextBlock Foreground="{DynamicResource Brush_TextDisabled}"
                   FontSize="{DynamicResource Metric_FontCaption}"
                   TextWrapping="Wrap"
                   Margin="10,2,10,6"
                   Text="{Binding StatusMessage}"/>
    </StackPanel>
</UserControl>
