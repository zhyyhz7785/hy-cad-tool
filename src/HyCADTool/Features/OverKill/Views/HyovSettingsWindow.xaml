<Window x:Class="HyCADTool.Features.OverKill.Views.HyovSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
        mc:Ignorable="d"
        btmetrics:BlenderMetricsOverlay.Attach="True"
        Title="HYOV 参数设置" Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush_WindowBack}"
        Foreground="{DynamicResource Brush_TextPrimary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 参数设置区域 -->
        <ScrollViewer Grid.Row="0" Style="{StaticResource BlenderScrollViewer}" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 绘图单位选择 -->
                <GroupBox Style="{StaticResource BlenderGroupBox}" Header="绘图单位" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="当前单位：" Width="{DynamicResource Metric_LabelWidth_L}" Foreground="{DynamicResource Brush_TextPrimary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbDrawingUnit" Style="{StaticResource BlenderComboBox}" Width="{DynamicResource Metric_InputWidth_XL}" SelectionChanged="CmbDrawingUnit_SelectionChanged">
                                <ComboBoxItem Content="毫米 (mm)" Tag="Millimeter" IsSelected="True"/>
                                <ComboBoxItem Content="米 (m)" Tag="Meter"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="切换单位时，所有参数值将自动换算（1m = 1000mm）" Margin="{DynamicResource Metric_FormHintIndent}" Foreground="{DynamicResource Brush_Warning}" FontSize="{DynamicResource Metric_FontSmall}" FontWeight="Bold"/>
                    </StackPanel>
                </GroupBox>

                <!-- OVERKILL 基础清理 -->
                <GroupBox Style="{StaticResource BlenderGroupBox}" Header="OVERKILL 基础清理" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="chkEnablePreClean" Style="{StaticResource BlenderCheckBox}" Content="启用预清理（合并重叠和平行线）" IsChecked="True" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="几何容差：" Width="{DynamicResource Metric_LabelWidth_L}" Foreground="{DynamicResource Brush_TextPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtGeometricTolerance" Style="{StaticResource BlenderTextBox}" Width="{DynamicResource Metric_InputWidth_ML}" Text="0.000001"/>
                            <TextBlock Text=" (推荐 1e-6)" Foreground="{DynamicResource Brush_TextSecondary}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="平行线合并距离：" Width="{DynamicResource Metric_LabelWidth_L}" Foreground="{DynamicResource Brush_TextPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtParallelMergeDistance" Style="{StaticResource BlenderTextBox}" Width="{DynamicResource Metric_InputWidth_ML}" Text="1.0"/>
                            <TextBlock Text=" (单位)" Foreground="{DynamicResource Brush_TextSecondary}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- FILLET 自动连接 -->
                <GroupBox Style="{StaticResource BlenderGroupBox}" Header="FILLET 自动连接" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="chkEnableBreakLines" Style="{StaticResource BlenderCheckBox}" Content="启用打断相交线段" IsChecked="True" Margin="0,0,0,5"/>
                        <CheckBox x:Name="chkEnableExtendEndpoints" Style="{StaticResource BlenderCheckBox}" Content="启用端点延伸" IsChecked="True" Margin="0,0,0,5"/>
                        <CheckBox x:Name="chkEnableExtendToLine" Style="{StaticResource BlenderCheckBox}" Content="启用端点到线延伸" IsChecked="True" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="最小线段长度：" Width="{DynamicResource Metric_LabelWidth_L}" Foreground="{DynamicResource Brush_TextPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtMinLineLength" Style="{StaticResource BlenderTextBox}" Width="{DynamicResource Metric_InputWidth_ML}" Text="5.0"/>
                            <TextBlock Text=" (单位)" Foreground="{DynamicResource Brush_TextSecondary}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="长度 &lt; 此值的线段将被删除，≥ 此值的线段将被保留" Margin="{DynamicResource Metric_FormHintIndent}" Foreground="{DynamicResource Brush_TextSecondary}" FontSize="{DynamicResource Metric_FontSmall}"/>
                        <TextBlock Text="（推荐：mm单位 5.0，m单位 0.005）" Margin="{DynamicResource Metric_FormHintIndent}" Foreground="{DynamicResource Brush_Warning}" FontSize="{DynamicResource Metric_FontSmall}" FontWeight="Bold"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                            <TextBlock Text="端点延伸最大距离：" Width="{DynamicResource Metric_LabelWidth_L}" Foreground="{DynamicResource Brush_TextPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtMaxExtendDistance" Style="{StaticResource BlenderTextBox}" Width="{DynamicResource Metric_InputWidth_ML}" Text="10.0"/>
                            <TextBlock Text=" (单位)" Foreground="{DynamicResource Brush_TextSecondary}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="端点距离小于此值时自动延伸连接" Margin="{DynamicResource Metric_FormHintIndent}" Foreground="{DynamicResource Brush_TextSecondary}" FontSize="{DynamicResource Metric_FontSmall}"/>
                    </StackPanel>
                </GroupBox>

                <!-- 独立端点标记 -->
                <GroupBox Style="{StaticResource BlenderGroupBox}" Header="独立端点标记" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="chkShowIndependentEndpoints" Style="{StaticResource BlenderCheckBox}" Content="显示独立端点标记" IsChecked="True" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="端点检测容差：" Width="{DynamicResource Metric_LabelWidth_L}" Foreground="{DynamicResource Brush_TextPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtIndependentEndpointTolerance" Style="{StaticResource BlenderTextBox}" Width="{DynamicResource Metric_InputWidth_ML}" Text="1.0"/>
                            <TextBlock Text=" (单位)" Foreground="{DynamicResource Brush_TextSecondary}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="距离小于此值的端点视为连接" Margin="{DynamicResource Metric_FormHintIndent}" Foreground="{DynamicResource Brush_TextSecondary}" FontSize="{DynamicResource Metric_FontSmall}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                            <TextBlock Text="标记缩放倍数：" Width="{DynamicResource Metric_LabelWidth_L}" Foreground="{DynamicResource Brush_TextPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtMarkerScale" Style="{StaticResource BlenderTextBox}" Width="{DynamicResource Metric_InputWidth_ML}" Text="20.0"/>
                            <TextBlock Text=" (倍)" Foreground="{DynamicResource Brush_TextSecondary}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="标记显示大小（基准：长10，宽3）" Margin="{DynamicResource Metric_FormHintIndent}" Foreground="{DynamicResource Brush_TextSecondary}" FontSize="{DynamicResource Metric_FontSmall}"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnReset" Style="{StaticResource BlenderButtonFlat}" Content="重置默认" Width="{DynamicResource Metric_DialogButtonWidth}" Height="{DynamicResource Metric_ButtonHeight}" Margin="0,0,10,0" Click="BtnReset_Click"/>
            <Button x:Name="btnOK" Style="{StaticResource BlenderButton}" Content="确定" Width="{DynamicResource Metric_DialogButtonWidth}" Height="{DynamicResource Metric_ButtonHeight}" Margin="0,0,10,0" IsDefault="True" Click="BtnOK_Click"/>
            <Button x:Name="btnCancel" Style="{StaticResource BlenderButtonFlat}" Content="取消" Width="{DynamicResource Metric_DialogButtonWidth}" Height="{DynamicResource Metric_ButtonHeight}" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
