<bui:BlenderWindow x:Class="HyCADTool.Features.Road.PlanAlignment.Views.StationLabelConfigWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
                   xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   btmetrics:BlenderMetricsOverlay.Attach="True"
                   Title="桩号标注配置"
                   HeaderTitle="{Binding Title}"
                   Width="560" Height="540"
                   MinWidth="500" MinHeight="440"
                   WindowStartupLocation="CenterOwner">
    <bui:BlenderWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/BlenderTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/RoadDesignerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </bui:BlenderWindow.Resources>

    <bui:BlenderWindow.FooterLeftContent>
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource Brush_TextSecondary}"
                   VerticalAlignment="Center" FontSize="{DynamicResource Metric_FontSmall}"/>
    </bui:BlenderWindow.FooterLeftContent>

    <bui:BlenderWindow.FooterRightContent>
        <StackPanel Orientation="Horizontal">
            <Button Content="恢复默认" Style="{StaticResource BlenderButton}"
                    Command="{Binding ResetCommand}" MinWidth="{DynamicResource Metric_DialogButtonWidth}" Margin="4,0"/>
            <Button Content="确定" Style="{StaticResource BlenderButton}"
                    Command="{Binding ConfirmCommand}" IsDefault="True" MinWidth="{DynamicResource Metric_DialogButtonWidth}" Margin="4,0"/>
            <Button Content="取消" Style="{StaticResource BlenderButton}"
                    Command="{Binding CancelCommand}" IsCancel="True" MinWidth="{DynamicResource Metric_DialogButtonWidth}" Margin="4,0"/>
        </StackPanel>
    </bui:BlenderWindow.FooterRightContent>

    <bui:PropertyEditor Title="桩号参数"
                        SelectedTabIndex="0"
                        ShowSearch="False" ShowPin="False" ShowIconBar="False">
        <Grid>
            <StackPanel>
                <Expander Header="间隔" IsExpanded="True" Style="{StaticResource BlenderExpander}">
                    <StackPanel>
                        <bui:PropertyRow Label="主桩间隔 (m)">
                            <bui:NumericSlider Value="{Binding MainInterval, Mode=TwoWay}"
                                               Minimum="1" Maximum="500" Step="5" Decimals="3" Unit="m"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="副桩间隔 (m)">
                            <bui:NumericSlider Value="{Binding SubInterval, Mode=TwoWay}"
                                               Minimum="0" Maximum="200" Step="1" Decimals="3" Unit="m"/>
                        </bui:PropertyRow>
                    </StackPanel>
                </Expander>

                <Expander Header="刻度线" IsExpanded="True" Style="{StaticResource BlenderExpander}">
                    <StackPanel>
                        <bui:PropertyRow Label="主桩刻度线 (m)">
                            <bui:NumericSlider Value="{Binding TickLengthMain, Mode=TwoWay}"
                                               Minimum="0" Maximum="50" Step="0.5" Decimals="3" Unit="m"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="副桩刻度线 (m)">
                            <bui:NumericSlider Value="{Binding TickLengthSub, Mode=TwoWay}"
                                               Minimum="0" Maximum="50" Step="0.5" Decimals="3" Unit="m"/>
                        </bui:PropertyRow>
                    </StackPanel>
                </Expander>

                <Expander Header="文字" IsExpanded="True" Style="{StaticResource BlenderExpander}">
                    <StackPanel>
                        <bui:PropertyRow Label="文字高度 (m)">
                            <bui:NumericSlider Value="{Binding TextHeight, Mode=TwoWay}"
                                               Minimum="0.1" Maximum="50" Step="0.5" Decimals="3" Unit="m"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="文字距刻度外侧 (m)">
                            <bui:NumericSlider Value="{Binding TextMargin, Mode=TwoWay}"
                                               Minimum="0" Maximum="10" Step="0.1" Decimals="3" Unit="m"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="沿切向旋转">
                            <CheckBox Content="文字随中心线方向旋转"
                                      IsChecked="{Binding RotateTextAlongTangent, Mode=TwoWay}"
                                      Style="{StaticResource BlenderCheckBox}"
                                      VerticalAlignment="Center"/>
                        </bui:PropertyRow>
                        <bui:PropertyRow Label="文字侧别">
                            <CheckBox Content="在行进方向"
                                      IsChecked="{Binding SideIsLeft, Mode=TwoWay}"
                                      Style="{StaticResource BlenderCheckBox}"
                                      VerticalAlignment="Center"
                                      ToolTip="勾选=左侧（国标默认）；不勾=右侧"/>
                        </bui:PropertyRow>
                    </StackPanel>
                </Expander>

                <TextBlock Margin="8,8,8,0" TextWrapping="Wrap" FontSize="{DynamicResource Metric_FontCaption}"
                           Foreground="{DynamicResource Brush_TextSecondary}"
                           Text="说明：确定后写入 %APPDATA%\HyCADTool\hy-settings.json；hyRoadAlnStation 与 hyRoadAlnStation/A 会从这里读配置。"/>
            </StackPanel>
        </Grid>
    </bui:PropertyEditor>
</bui:BlenderWindow>
