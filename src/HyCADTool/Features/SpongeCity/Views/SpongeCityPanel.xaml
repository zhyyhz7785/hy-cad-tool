<UserControl x:Class="HyCADTool.Features.SpongeCity.Views.SpongeCityPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helper="clr-namespace:HyCADTool.Shared.UI.Helpers"
             xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
             Background="{DynamicResource Brush_RegionBack}"
             Foreground="{DynamicResource Brush_TextPrimary}"
             mc:Ignorable="d"
             btmetrics:BlenderMetricsOverlay.Attach="True"
             d:DesignHeight="800" d:DesignWidth="320">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Shell/Resources/BlenderTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource BlenderScrollViewer}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="5,8,5,5">

            <!-- ===== 顶部摘要 ===== -->
            <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource Brush_AccentBlueHover}" FontSize="{DynamicResource Metric_FontCaption}"
                       Text="{Binding ResultSummary}" TextWrapping="Wrap" />

            <!-- ===== 1. 项目信息 ===== -->
            <Expander Style="{StaticResource BlenderExpander}" Header="项目信息" IsExpanded="True" Margin="0,2,0,3">
                <StackPanel Margin="5,5,0,0">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="项目名称" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="建设地点" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="地区" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Style="{StaticResource BlenderComboBox}" SelectedIndex="{Binding RegionIndex}">
                            <ComboBoxItem Content="北京市" />
                            <ComboBoxItem Content="天津市" />
                            <ComboBoxItem Content="河北省" />
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="用地性质" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Style="{StaticResource BlenderComboBox}" SelectedIndex="{Binding ProjectTypeIndex}">
                            <ComboBoxItem Content="新建住宅小区" />
                            <ComboBoxItem Content="新建商业(绿≥25%)" />
                            <ComboBoxItem Content="新建商业(绿&lt;25%)" />
                            <ComboBoxItem Content="改扩建老旧小区" />
                            <ComboBoxItem Content="改扩建其他小区" />
                            <ComboBoxItem Content="改扩建公共建筑" />
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="总用地 F (m²)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding TotalAreaM2, UpdateSourceTrigger=LostFocus, StringFormat=F0}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="建筑屋面(m²)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding BuildingFootprintM2, UpdateSourceTrigger=LostFocus, StringFormat=F0}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="绿地率(0~1)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding GreenRatio, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- ===== 2. 设计控制目标 ===== -->
            <Expander Style="{StaticResource BlenderExpander}" Header="设计控制目标" IsExpanded="True" Margin="0,2,0,3">
                <StackPanel Margin="5,5,0,0">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="α 目标(0~1)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding AlphaTarget, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="h_y (mm)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding DesignRainfallMm, UpdateSourceTrigger=LostFocus, StringFormat=F1}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="η_SS 目标" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding EtaSsTarget, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="弃流厚(mm)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding InitialDiscardMm, UpdateSourceTrigger=LostFocus, StringFormat=F1}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="单方造价" VerticalAlignment="Center" ToolTip="元/m²" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding UnitSpongeCost, UpdateSourceTrigger=LostFocus, StringFormat=F0}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- ===== 3. 下垫面统计 ===== -->
            <Expander Style="{StaticResource BlenderExpander}" Header="下垫面统计 (10 类)" IsExpanded="True" Margin="0,2,0,3">
                <StackPanel Margin="5,5,0,0">
                    <UniformGrid Columns="3" Margin="0,0,0,4">
                        <Button Style="{StaticResource BlenderButton}" Content="画样线"
                                Command="{Binding DrawLinesCommand}"
                                ToolTip="对 10 类下垫面图层在拾取基点画样线，标尺线 a 缓存供合计文字定位（hyscDL）"
                                Margin="1" Padding="{DynamicResource Metric_CommandGridButtonPadding}" />
                        <Button Style="{StaticResource BlenderButton}" Content="读面积"
                                Command="{Binding ReadAreaCommand}"
                                ToolTip="扫描 10 类下垫面图层闭合 Polyline 并汇总面积回填（hyscRA）"
                                Margin="1" Padding="{DynamicResource Metric_CommandGridButtonPadding}" />
                        <Button Style="{StaticResource BlenderButton}" Content="写面积"
                                Command="{Binding WriteAreaCommand}"
                                ToolTip="在每条 Polyline 形心写面积文字 + 在样线 a 旁写合计（hyscWA）"
                                Margin="1" Padding="{DynamicResource Metric_CommandGridButtonPadding}" />
                    </UniformGrid>

                    <DataGrid Style="{StaticResource BlenderDataGrid}"
                              ItemsSource="{Binding Surfaces}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" IsReadOnly="False"
                              MaxHeight="260"
                              FontSize="{DynamicResource Metric_FontSmall}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Code}" Width="32" IsReadOnly="True" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="70" IsReadOnly="True" />
                            <DataGridTextColumn Header="图层名" Binding="{Binding LayerName}" Width="*" />
                            <DataGridTextColumn Header="面积 m²" Binding="{Binding Area, StringFormat=F0}" Width="56" />
                            <DataGridTextColumn Header="ψ" Binding="{Binding Psi, StringFormat=F2}" Width="40" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Style="{StaticResource BlenderButton}" Content="重算 ψ_z / W / 校核"
                            Command="{Binding CalculateCommand}"
                            Margin="0,4,0,0" Padding="{DynamicResource Metric_CommandGridButtonPadding}" />
                </StackPanel>
            </Expander>

            <!-- ===== 4. 设施配置 ===== -->
            <Expander Style="{StaticResource BlenderExpander}" Header="LID 设施配置 (8 类)" IsExpanded="False" Margin="0,2,0,3">
                <DataGrid Style="{StaticResource BlenderDataGrid}"
                          ItemsSource="{Binding Facilities}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" IsReadOnly="False"
                          MaxHeight="240"
                          FontSize="{DynamicResource Metric_FontSmall}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Code}" Width="32" IsReadOnly="True" />
                        <DataGridTextColumn Header="设施" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="40" IsReadOnly="True" />
                        <DataGridTextColumn Header="规模" Binding="{Binding Quantity, StringFormat=F0}" Width="55" />
                        <DataGridTextColumn Header="单位调蓄" Binding="{Binding UnitVolumeFactor, StringFormat=F2}" Width="55" />
                        <DataGridTextColumn Header="η_SS" Binding="{Binding EtaSs, StringFormat=F2}" Width="42" />
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>

            <!-- ===== 5. 校核结果 ===== -->
            <Expander Style="{StaticResource BlenderExpander}" Header="强制性指标校核" IsExpanded="True" Margin="0,2,0,3">
                <DataGrid Style="{StaticResource BlenderDataGrid}"
                          ItemsSource="{Binding Checks}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" IsReadOnly="True"
                          MaxHeight="220"
                          FontSize="{DynamicResource Metric_FontSmall}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="校核项" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="实际" Binding="{Binding ActualText}" Width="75" />
                        <DataGridTextColumn Header="目标" Binding="{Binding TargetText}" Width="70" />
                        <DataGridTextColumn Header="判定" Binding="{Binding Passed}" Width="42" />
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>

            <!-- ===== 6. 输出 ===== -->
            <Expander Style="{StaticResource BlenderExpander}" Header="输出" IsExpanded="True" Margin="0,2,0,3">
                <StackPanel Margin="5,5,0,0">
                    <Button Style="{StaticResource BlenderButton}" Content="导出计算表 Excel (hyscExC)"
                            Command="{Binding ExportCalcExcelCommand}"
                            Margin="0,2" Padding="{DynamicResource Metric_CommandGridButtonPadding}" />
                    <Button Style="{StaticResource BlenderButton}" Content="导出预算表 Excel (hyscExB)"
                            Command="{Binding ExportBudgetExcelCommand}"
                            Margin="0,2" Padding="{DynamicResource Metric_CommandGridButtonPadding}" />
                    <Button Style="{StaticResource BlenderButton}" Content="导出 md 计算书 (hyscExM)"
                            Command="{Binding ExportMdReportCommand}"
                            Margin="0,2" Padding="{DynamicResource Metric_CommandGridButtonPadding}" />
                </StackPanel>
            </Expander>

            <Separator Style="{StaticResource BlenderSeparator}" Margin="0,2,0,4" />
            <Button Style="{StaticResource BlenderButton}" Content="恢复默认参数"
                    Command="{Binding ResetCommand}" Margin="0,2,0,4" />

            <!-- ===== 7. 状态 ===== -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource Brush_Success}" FontSize="{DynamicResource Metric_FontCaption}"
                       Margin="0,4,0,0" TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
