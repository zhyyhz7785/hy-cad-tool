<Window x:Class="HyCADTool.MarkdownEditor.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:helper="clr-namespace:HyCADTool.MarkdownEditor.Views.Helpers"
        Title="HY Markdown Editor"
        Width="1280" Height="780"
        MinWidth="900" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        Foreground="#d4d4d4">

    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#d4d4d4" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3e3e42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#0e639c" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1177bb" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumInput" TargetType="TextBox">
            <Setter Property="Background" Value="#3c3c3c" />
            <Setter Property="Foreground" Value="#d4d4d4" />
            <Setter Property="BorderBrush" Value="#555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Width" Value="30" />
            <Setter Property="helper:TextBoxHelper.EnableCustomHandlers" Value="True" />
            <Setter Property="helper:TextBoxHelper.ScrollStep" Value="0.1" />
        </Style>

        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Background" Value="#3c3c3c" />
            <Setter Property="Foreground" Value="#d4d4d4" />
            <Setter Property="BorderBrush" Value="#555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#888" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="SLbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="Splitter" TargetType="GridSplitter">
            <Setter Property="Background" Value="#3e3e42" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#007ACC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#1e1e1e" BorderBrush="#3e3e42" BorderThickness="0,0,0,1">
            <DockPanel Margin="6,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="打开.md" Style="{StaticResource ToolBtn}" Command="{Binding LoadFileCommand}" />
                    <Button Content="保存.md" Style="{StaticResource ToolBtn}" Command="{Binding SaveFileCommand}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="插入CAD" Style="{StaticResource PrimaryBtn}" Click="OnConfirmClick" />
                    <Button Content="关闭" Style="{StaticResource ToolBtn}" Click="OnCloseClick" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Foreground="#666" FontSize="11" />
            </DockPanel>
        </Border>

        <!-- 编辑器 + 预览 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- 左：Vditor WYSIWYG 编辑器（WebView2） -->
            <wv2:WebView2 x:Name="EditorWebView" Grid.Column="0" />

            <!-- 分隔条 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Style="{StaticResource Splitter}" />

            <!-- 右：分栏预览 -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="#1e1e1e"
                        BorderBrush="#3e3e42" BorderThickness="0,0,0,1" Padding="8,4">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Lbl}" Text="预览" FontSize="12" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource Lbl}" Text="1:" Margin="0,0,1,0" />
                        <TextBox Style="{StaticResource NumInput}" Width="28"
                                 helper:TextBoxHelper.ScrollStep="1"
                                 Text="{Binding DrawScale, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Lbl}" Text="栏:" Margin="6,0,1,0" />
                        <TextBox Style="{StaticResource NumInput}" Width="24"
                                 helper:TextBoxHelper.ScrollStep="1"
                                 Text="{Binding ColumnCount, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Lbl}" Text="间距:" Margin="6,0,1,0" />
                        <TextBox Style="{StaticResource NumInput}" Width="28"
                                 helper:TextBoxHelper.ScrollStep="1"
                                 Text="{Binding ColumnGutter, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Lbl}" Text="字高:" Margin="6,0,1,0" />
                        <TextBox Style="{StaticResource NumInput}" Width="28"
                                 Text="{Binding TextSize, UpdateSourceTrigger=PropertyChanged}" />

                        <Border Width="1" Height="14" Background="#3e3e42" Margin="8,0" />

                        <TextBlock Style="{StaticResource SLbl}" Text="H1" Margin="0,0,1,0" />
                        <TextBox Style="{StaticResource NumInput}" Width="26"
                                 Text="{Binding H1SpaceBefore, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource SLbl}" Text="/" Margin="0" />
                        <TextBox Style="{StaticResource NumInput}" Width="26"
                                 Text="{Binding H1SpaceAfter, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource SLbl}" Text="H2" Margin="4,0,1,0" />
                        <TextBox Style="{StaticResource NumInput}" Width="26"
                                 Text="{Binding H2SpaceBefore, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource SLbl}" Text="/" Margin="0" />
                        <TextBox Style="{StaticResource NumInput}" Width="26"
                                 Text="{Binding H2SpaceAfter, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource SLbl}" Text="H3" Margin="4,0,1,0" />
                        <TextBox Style="{StaticResource NumInput}" Width="26"
                                 Text="{Binding H3SpaceBefore, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource SLbl}" Text="/" Margin="0" />
                        <TextBox Style="{StaticResource NumInput}" Width="26"
                                 Text="{Binding H3SpaceAfter, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource SLbl}" Text="P" Margin="4,0,1,0" />
                        <TextBox Style="{StaticResource NumInput}" Width="26"
                                 Text="{Binding PSpaceAfter, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource SLbl}" Text="Li" Margin="4,0,1,0" />
                        <TextBox Style="{StaticResource NumInput}" Width="26"
                                 Text="{Binding LiSpaceAfter, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource SLbl}" Text="Q" Margin="4,0,1,0" />
                        <TextBox Style="{StaticResource NumInput}" Width="26"
                                 Text="{Binding QuoteSpaceBefore, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource SLbl}" Text="/" Margin="0" />
                        <TextBox Style="{StaticResource NumInput}" Width="26"
                                 Text="{Binding QuoteSpaceAfter, UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>
                </Border>

                <WebBrowser x:Name="PreviewBrowser" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
