<Window x:Class="HyCADTool.MarkdownEditor.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:controls="clr-namespace:HyCADTool.MarkdownEditor.Views.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="HY Markdown Editor"
        Width="1280"
        Height="780"
        MinWidth="900"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeBgRootBrush}"
        Foreground="{DynamicResource ThemeTextPrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/EditorTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:TitleBarControl x:Name="TitleBar" Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PreviewMainRow" Height="*" />
                <RowDefinition x:Name="BottomPanelSplitterRow" Height="0" />
                <RowDefinition x:Name="BottomPanelRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OutlineCol" Width="220" />
                <ColumnDefinition x:Name="OutlineSplitterCol" Width="0" />
                <ColumnDefinition x:Name="EditorCol" Width="*" />
                <ColumnDefinition x:Name="SplitterCol" Width="0" />
                <ColumnDefinition x:Name="PreviewCol" Width="0" />
            </Grid.ColumnDefinitions>

            <controls:LeftPanelControl x:Name="LeftPanel" Grid.RowSpan="3" Grid.Column="0" />

            <GridSplitter x:Name="OutlineSplitter"
                          Grid.RowSpan="3"
                          Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          Style="{StaticResource Splitter}"
                          DragCompleted="OnOutlineSplitterDragCompleted" />

            <wv2:WebView2 x:Name="EditorWebView" Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" />

            <GridSplitter x:Name="PreviewSplitter"
                          Grid.Row="0"
                          Grid.Column="3"
                          Grid.RowSpan="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          Style="{StaticResource Splitter}"
                          Visibility="Collapsed"
                          DragCompleted="OnPreviewSplitterDragCompleted" />

            <controls:PreviewPanelControl x:Name="PreviewPanel"
                                          Grid.Row="0"
                                          Grid.Column="4"
                                          Visibility="Collapsed" />

            <GridSplitter x:Name="BottomPanelSplitter"
                          Grid.Row="1"
                          Grid.Column="4"
                          Grid.RowSpan="2"
                          Height="4"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Style="{StaticResource Splitter}"
                          Visibility="Collapsed"
                          Margin="0,0,0,-4"
                          DragCompleted="OnBottomPanelSplitterDragCompleted" />

            <controls:BottomPanelControl x:Name="BottomPanelHost"
                                         Grid.Row="2"
                                         Grid.Column="4"
                                         Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
