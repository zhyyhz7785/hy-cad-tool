<Window x:Class="HyCADTool.MarkdownEditor.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:controls="clr-namespace:HyCADTool.MarkdownEditor.Views.Controls"
        xmlns:helper="clr-namespace:HyCADTool.MarkdownEditor.Views.Helpers"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="HY Markdown Editor"
        Width="1280" Height="780"
        MinWidth="900" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeBgRootBrush}"
        Foreground="{DynamicResource ThemeTextPrimaryBrush}">

    <Window.Resources>
        <!-- 主题色：默认黑色为主（可在代码里切到白色为主） -->
        <SolidColorBrush x:Key="ThemeBgRootBrush" Color="#111418" />
        <SolidColorBrush x:Key="ThemeBgPanelBrush" Color="#161b22" />
        <SolidColorBrush x:Key="ThemeBgSurfaceBrush" Color="#1c2128" />
        <SolidColorBrush x:Key="ThemeBgInputBrush" Color="#0d1117" />
        <SolidColorBrush x:Key="ThemeBorderBrush" Color="#24292e" />
        <SolidColorBrush x:Key="ThemeBorderStrongBrush" Color="#30363d" />
        <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#c9d1d9" />
        <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#8b949e" />
        <SolidColorBrush x:Key="ThemeTextMutedBrush" Color="#6e7681" />
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#0e639c" />
        <SolidColorBrush x:Key="ThemeAccentHoverBrush" Color="#1177bb" />
        <SolidColorBrush x:Key="ThemeOnAccentBrush" Color="#ffffff" />
        <SolidColorBrush x:Key="ThemeHoverBrush" Color="#30363d" />
        <SolidColorBrush x:Key="ThemeSelectionBrush" Color="#263545" />

        <!-- 普通按钮（带 hover） -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccentBrush}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 切换按钮 -->
        <Style x:Key="ToggleBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
            <Setter Property="Padding" Value="5,4" />
        </Style>

        <!-- 主按钮（带 hover） -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 自定义标题栏窗口控制按钮 -->
        <Style x:Key="TitleBarWinBtn" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarWinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="Margin" Value="6,0" />
        </Style>

        <!-- 分隔条（hover 蓝） -->
        <Style x:Key="Splitter" TargetType="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenu" TargetType="Menu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- 顶层菜单项 -->
        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <!-- 全局 MenuItem 弹出层深色 -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource ThemeBorderStrongBrush}" />
            <Setter Property="Margin" Value="4,2" />
        </Style>

        <!-- ContextMenu / 弹出层 Popup 背景 -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ThemeBgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <!-- 系统颜色覆盖 — 让 MenuItem 弹出层变深色 -->
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#1c2128" />
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#c9d1d9" />
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#30363d" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#30363d" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#ffffff" />
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#161b22" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1c2128" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#c9d1d9" />

        <!-- ComboBox 下拉列表项 hover -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="Padding" Value="6,3" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 参数输入框（暗底 + 白光标 + 滚轮增减） -->
        <Style x:Key="ParamInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeBgInputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Width" Value="36" />
            <Setter Property="helper:TextBoxHelper.EnableCustomHandlers" Value="True" />
            <Setter Property="helper:TextBoxHelper.ScrollStep" Value="0.1" />
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="ParamSmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <!-- 暗色 ComboBox -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeBgInputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="22" />
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部一体化标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeBgPanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="4,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="HY"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="8,0,10,0"
                               shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Border Style="{StaticResource Sep}" Margin="0,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Menu Style="{StaticResource DarkMenu}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <MenuItem Header="文件" Style="{StaticResource DarkMenuItem}">
                            <MenuItem Header="打开" Command="{Binding LoadFileCommand}" />
                            <MenuItem Header="保存" Command="{Binding SaveFileCommand}" />
                            <Separator />
                            <MenuItem Header="关闭" Click="OnCloseClick" />
                        </MenuItem>
                        <MenuItem Header="编辑" Style="{StaticResource DarkMenuItem}">
                            <MenuItem Header="撤消" Click="OnMenuUndo" />
                            <MenuItem Header="重做" Click="OnMenuRedo" />
                            <Separator />
                            <MenuItem Header="剪切" Click="OnMenuCut" />
                            <MenuItem Header="复制" Click="OnMenuCopy" />
                            <MenuItem Header="粘贴" Click="OnMenuPaste" />
                            <MenuItem Header="全选" Click="OnMenuSelectAll" />
                            <Separator />
                            <MenuItem Header="查找替换" Click="OnMenuFindReplace" />
                        </MenuItem>
                        <MenuItem Header="段落" Style="{StaticResource DarkMenuItem}">
                            <MenuItem Header="标题 1" Click="OnMenuH1" />
                            <MenuItem Header="标题 2" Click="OnMenuH2" />
                            <MenuItem Header="标题 3" Click="OnMenuH3" />
                            <MenuItem Header="标题 4" Click="OnMenuH4" />
                            <MenuItem Header="普通段落" Click="OnMenuParagraph" />
                            <Separator />
                            <MenuItem Header="引用" Click="OnMenuQuote" />
                            <MenuItem Header="有序列表" Click="OnMenuOrderedList" />
                            <MenuItem Header="无序列表" Click="OnMenuUnorderedList" />
                            <MenuItem Header="任务列表" Click="OnMenuTaskList" />
                            <Separator />
                            <MenuItem Header="表格" Click="OnMenuTable" />
                            <MenuItem Header="代码块" Click="OnMenuCodeBlock" />
                            <MenuItem Header="数学块" Click="OnMenuMathBlock" />
                            <MenuItem Header="目录 [toc]" Click="OnMenuToc" />
                            <MenuItem Header="脚注" Click="OnMenuFootnote" />
                            <MenuItem Header="分割线" Click="OnMenuHorizontalRule" />
                        </MenuItem>
                        <MenuItem Header="格式" Style="{StaticResource DarkMenuItem}">
                            <MenuItem Header="加粗" Click="OnMenuBold" />
                            <MenuItem Header="斜体" Click="OnMenuItalic" />
                            <MenuItem Header="删除线" Click="OnMenuStrikethrough" />
                            <MenuItem Header="行内代码" Click="OnMenuInlineCode" />
                            <MenuItem Header="下划线" Click="OnMenuUnderline" />
                            <MenuItem Header="高亮" Click="OnMenuHighlight" />
                            <MenuItem Header="上标" Click="OnMenuSuperscript" />
                            <MenuItem Header="下标" Click="OnMenuSubscript" />
                            <MenuItem Header="注释" Click="OnMenuComment" />
                            <MenuItem Header="行内数学" Click="OnMenuInlineMath" />
                            <MenuItem Header="链接" Click="OnMenuLink" />
                            <Separator />
                            <MenuItem Header="清除样式" Click="OnMenuClearFormatting" />
                        </MenuItem>
                        <MenuItem Header="主题" Style="{StaticResource DarkMenuItem}">
                            <MenuItem Header="黑色为主" Click="OnThemeDark" />
                            <MenuItem Header="白色为主" Click="OnThemeLight" />
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="Transparent"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown"
                        MouseRightButtonUp="OnTitleBarMouseRightButtonUp">
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextMutedBrush}"
                               FontSize="11" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button x:Name="OutlineToggleBtn"
                                Style="{StaticResource ToggleBtn}"
                                Click="OnToggleOutline"
                                ToolTip="大纲"
                                Padding="5,4"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Width="16" Height="12">
                                <Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1" RadiusX="1" RadiusY="1" />
                                <Rectangle Width="5" HorizontalAlignment="Left"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Opacity="0.45" RadiusX="1" RadiusY="1" />
                            </Grid>
                        </Button>
                        <Button x:Name="BottomPanelToggleBtn"
                                Style="{StaticResource ToggleBtn}"
                                Click="OnToggleBottomPanel"
                                ToolTip="底部面板"
                                Padding="5,4"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Width="16" Height="12">
                                <Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1" RadiusX="1" RadiusY="1" />
                                <Rectangle Height="4" VerticalAlignment="Bottom"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Opacity="0.45" RadiusX="1" RadiusY="1" />
                            </Grid>
                        </Button>
                        <Button x:Name="PreviewToggleBtn"
                                Style="{StaticResource ToggleBtn}"
                                Click="OnTogglePreview"
                                ToolTip="预览"
                                Padding="5,4"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Width="16" Height="12">
                                <Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1" RadiusX="1" RadiusY="1" />
                                <Rectangle Width="5" HorizontalAlignment="Right"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Opacity="0.45" RadiusX="1" RadiusY="1" />
                            </Grid>
                        </Button>
                        <Border Style="{StaticResource Sep}" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="插入CAD"
                                Style="{StaticResource PrimaryBtn}"
                                Click="OnConfirmClick"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>

                    <Button x:Name="MinimizeWindowBtn"
                            Style="{StaticResource TitleBarWinBtn}"
                            ToolTip="最小化"
                            Click="OnMinimizeWindowClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE921;" />
                    </Button>
                    <Button x:Name="MaxRestoreWindowBtn"
                            Style="{StaticResource TitleBarWinBtn}"
                            ToolTip="最大化"
                            Click="OnMaxRestoreWindowClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="MaxRestoreGlyph" Text="&#xE922;" />
                    </Button>
                    <Button x:Name="CloseWindowBtn"
                            Style="{StaticResource TitleBarCloseBtn}"
                            ToolTip="关闭"
                            Click="OnCloseClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 阶段1骨架：下左大纲 + 下中编辑 + 右侧可切换预览 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PreviewMainRow" Height="*" />
                <RowDefinition x:Name="BottomPanelSplitterRow" Height="0" />
                <RowDefinition x:Name="BottomPanelRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OutlineCol" Width="220" />
                <!-- 0 表示左侧面板与编辑区无额外缝隙 -->
                <ColumnDefinition x:Name="OutlineSplitterCol" Width="0" />
                <ColumnDefinition Width="53*" />
                <ColumnDefinition Width="13*"/>
                <ColumnDefinition x:Name="SplitterCol" Width="0" />
                <ColumnDefinition x:Name="PreviewCol" Width="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.RowSpan="3" Grid.Column="0" Background="{DynamicResource ThemeBgPanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FileTabBtn" Grid.Column="0" Content="文件"
                                Click="OnShowFileTab"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                        <Button x:Name="OutlineTabBtn" Grid.Column="1" Content="大纲"
                                Click="OnShowOutlineTab"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    </Grid>

                    <!-- 文件树 -->
                    <TreeView x:Name="FileTree" Grid.Row="1"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12"
                              SelectedItemChanged="OnFileTreeSelectedItemChanged"
                              MouseDoubleClick="OnFileTreeDoubleClick">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                                <Setter Property="Padding" Value="2,1" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="IsExpanded" Value="False" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ThemeSelectionBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="打开" Click="OnCtxOpen" />
                                <Separator />
                                <MenuItem Header="新建文件" Click="OnCtxNewFile" />
                                <MenuItem Header="新建文件夹" Click="OnCtxNewFolder" />
                                <Separator />
                                <MenuItem Header="重命名" Click="OnCtxRename" />
                                <MenuItem Header="创建副本" Click="OnCtxDuplicate" />
                                <Separator />
                                <MenuItem Header="删除" Click="OnCtxDelete" />
                                <Separator />
                                <MenuItem Header="复制文件路径" Click="OnCtxCopyPath" />
                                <MenuItem Header="打开文件位置" Click="OnCtxOpenFolder" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>

                    <!-- 大纲列表 -->
                    <ListBox x:Name="OutlineList" Grid.Row="1"
                             Visibility="Collapsed"
                             SelectionChanged="OnOutlineSelectionChanged"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12" />
                </Grid>
            </Border>

            <Border x:Name="OutlineDivider" Grid.RowSpan="3" Grid.Column="1" Background="{DynamicResource ThemeBorderBrush}" />

            <wv2:WebView2 x:Name="EditorWebView" Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Grid.ColumnSpan="2" />

            <GridSplitter x:Name="PreviewSplitter" Grid.Row="0" Grid.Column="5" Width="4"
                          HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Style="{StaticResource Splitter}" Visibility="Collapsed" Margin="0,0,-4,0" Grid.RowSpan="3" />

            <Grid x:Name="PreviewRulerGrid" Grid.Row="0" Grid.Column="4" Visibility="Collapsed" Grid.ColumnSpan="2" Grid.RowSpan="3"
                  MinWidth="280">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition x:Name="RulerRow" Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RulerCol" Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource ThemeBgPanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid ClipToBounds="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                            <TextBlock Style="{StaticResource ParamLabel}" Text="图纸" Margin="0,0,4,0" />
                            <ComboBox Style="{StaticResource DarkComboBox}" Width="62"
                                      ItemsSource="{Binding PageOrientations}"
                                      SelectedItem="{Binding PageOrientation, Mode=TwoWay}" />
                            <ComboBox Style="{StaticResource DarkComboBox}" Width="92"
                                      Margin="4,0,0,0"
                                      ItemsSource="{Binding PagePresets}"
                                      SelectedItem="{Binding PagePreset, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource ParamLabel}" Text="1:" Margin="8,0,2,0" />
                            <TextBox Style="{StaticResource ParamInput}" Width="34"
                                     helper:TextBoxHelper.ScrollStep="1"
                                     Text="{Binding DrawScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ParamLabel}" Text="栏" Margin="8,0,2,0" />
                            <TextBox Style="{StaticResource ParamInput}" Width="28"
                                     helper:TextBoxHelper.ScrollStep="1"
                                     Text="{Binding ColumnCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ParamLabel}" Text="间距" Margin="8,0,2,0" />
                            <TextBox Style="{StaticResource ParamInput}"
                                     Text="{Binding ColumnGutter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ParamLabel}" Text="字高" Margin="8,0,2,0" />
                            <TextBox Style="{StaticResource ParamInput}"
                                     Text="{Binding TextSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ParamLabel}" Text="字宽" Margin="8,0,2,0" />
                            <TextBox Style="{StaticResource ParamInput}"
                                     Text="{Binding TextXScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ParamLabel}" Text="缩放" Margin="8,0,2,0" />
                            <TextBox Style="{StaticResource ParamInput}"
                                     Text="{Binding PreviewScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Border Style="{StaticResource Sep}" Margin="8,0" />

                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="a" Margin="0,0,2,0" />
                            <TextBox Style="{StaticResource ParamInput}" IsReadOnly="True" Width="30"
                                     helper:TextBoxHelper.EnableCustomHandlers="False"
                                     Text="{Binding MarginLeftMm, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="c" Margin="4,0,2,0" />
                            <TextBox Style="{StaticResource ParamInput}" IsReadOnly="True" Width="30"
                                     helper:TextBoxHelper.EnableCustomHandlers="False"
                                     Text="{Binding MarginTopMm, Mode=OneWay}" />
                            <Border Style="{StaticResource Sep}" Margin="8,0" />

                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="H1" Margin="0,0,2,0" />
                            <TextBox Style="{StaticResource ParamInput}" Width="30"
                                     Text="{Binding H1SpaceBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="/" Margin="1,0" />
                            <TextBox Style="{StaticResource ParamInput}" Width="30"
                                     Text="{Binding H1SpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="H2" Margin="6,0,2,0" />
                            <TextBox Style="{StaticResource ParamInput}" Width="30"
                                     Text="{Binding H2SpaceBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="/" Margin="1,0" />
                            <TextBox Style="{StaticResource ParamInput}" Width="30"
                                     Text="{Binding H2SpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="H3" Margin="6,0,2,0" />
                            <TextBox Style="{StaticResource ParamInput}" Width="30"
                                     Text="{Binding H3SpaceBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="/" Margin="1,0" />
                            <TextBox Style="{StaticResource ParamInput}" Width="30"
                                     Text="{Binding H3SpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="P" Margin="6,0,2,0" />
                            <TextBox Style="{StaticResource ParamInput}" Width="30"
                                     Text="{Binding PSpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="Li" Margin="6,0,2,0" />
                            <TextBox Style="{StaticResource ParamInput}" Width="30"
                                     Text="{Binding LiSpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="Q" Margin="6,0,2,0" />
                            <TextBox Style="{StaticResource ParamInput}" Width="30"
                                     Text="{Binding QuoteSpaceBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="/" Margin="1,0" />
                            <TextBox Style="{StaticResource ParamInput}" Width="30"
                                     Text="{Binding QuoteSpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="RulerCorner" Grid.Row="1" Grid.Column="0" Background="{DynamicResource ThemeBgPanelBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,1,1" />
                <controls:RulerControl x:Name="PreviewHRuler" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" />
                <controls:RulerControl x:Name="PreviewVRuler" Grid.Row="2" Grid.Column="0" Orientation="Vertical" />
                <WebBrowser x:Name="PreviewBrowser" Grid.Row="2" Grid.Column="1" />
            </Grid>

            <GridSplitter x:Name="BottomPanelSplitter" Grid.Row="1" Grid.Column="4" Height="4"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          Style="{StaticResource Splitter}" Visibility="Collapsed"
                          DragCompleted="OnBottomPanelSplitterDragCompleted" Grid.ColumnSpan="2" Margin="0,0,0,-4" Grid.RowSpan="2" />

            <Border x:Name="BottomPanelHost" Grid.Row="2" Grid.Column="4"
                    Background="{DynamicResource ThemeBgPanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0"
                    Visibility="Collapsed" Grid.ColumnSpan="2">
                <Grid>
                    <TextBlock Text="底部预留区域（阶段重建）"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
