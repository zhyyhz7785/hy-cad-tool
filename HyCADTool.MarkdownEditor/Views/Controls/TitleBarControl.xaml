<UserControl x:Class="HyCADTool.MarkdownEditor.Views.Controls.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/EditorTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource ThemeBgPanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="HY"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="8,0,10,0"
                           shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Border Style="{StaticResource Sep}" Margin="0,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Menu Style="{StaticResource DarkMenu}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="文件" Style="{StaticResource DarkMenuItem}">
                        <MenuItem Header="打开" Command="{Binding LoadFileCommand}" />
                        <MenuItem Header="保存" Command="{Binding SaveFileCommand}" />
                        <Separator />
                        <MenuItem Header="关闭" Click="OnCloseClick" />
                    </MenuItem>
                    <MenuItem Header="编辑" Style="{StaticResource DarkMenuItem}">
                        <MenuItem Header="撤消" Command="{Binding EditorActionCommand}" CommandParameter="Undo" InputGestureText="Ctrl+Z" />
                        <MenuItem Header="重做" Command="{Binding EditorActionCommand}" CommandParameter="Redo" InputGestureText="Ctrl+Y" />
                        <Separator />
                        <MenuItem Header="剪切" Command="{Binding EditorActionCommand}" CommandParameter="Cut" InputGestureText="Ctrl+X" />
                        <MenuItem Header="复制" Command="{Binding EditorActionCommand}" CommandParameter="Copy" InputGestureText="Ctrl+C" />
                        <MenuItem Header="粘贴" Command="{Binding EditorActionCommand}" CommandParameter="Paste" InputGestureText="Ctrl+V" />
                        <MenuItem Header="全选" Command="{Binding EditorActionCommand}" CommandParameter="SelectAll" InputGestureText="Ctrl+A" />
                        <Separator />
                        <MenuItem Header="查找替换" Command="{Binding EditorActionCommand}" CommandParameter="FindReplace" InputGestureText="Ctrl+F" />
                    </MenuItem>
                    <MenuItem Header="段落" Style="{StaticResource DarkMenuItem}">
                        <MenuItem Header="一级标题" Command="{Binding EditorActionCommand}" CommandParameter="H1" InputGestureText="Ctrl+1" />
                        <MenuItem Header="二级标题" Command="{Binding EditorActionCommand}" CommandParameter="H2" InputGestureText="Ctrl+2" />
                        <MenuItem Header="三级标题" Command="{Binding EditorActionCommand}" CommandParameter="H3" InputGestureText="Ctrl+3" />
                        <MenuItem Header="四级标题" Command="{Binding EditorActionCommand}" CommandParameter="H4" InputGestureText="Ctrl+4" />
                        <MenuItem Header="五级标题" Command="{Binding EditorActionCommand}" CommandParameter="H5" InputGestureText="Ctrl+5" />
                        <MenuItem Header="六级标题" Command="{Binding EditorActionCommand}" CommandParameter="H6" InputGestureText="Ctrl+6" />
                        <MenuItem Header="段落" Command="{Binding EditorActionCommand}" CommandParameter="Paragraph" InputGestureText="Ctrl+0" />
                        <Separator />
                        <MenuItem Header="提升标题级别" Command="{Binding EditorActionCommand}" CommandParameter="PromoteHeading" InputGestureText="Ctrl+=" />
                        <MenuItem Header="降低标题级别" Command="{Binding EditorActionCommand}" CommandParameter="DemoteHeading" InputGestureText="Ctrl+-" />
                        <Separator />
                        <MenuItem Header="表格" Command="{Binding EditorActionCommand}" CommandParameter="Table" />
                        <MenuItem Header="公式块" Command="{Binding EditorActionCommand}" CommandParameter="MathBlock" InputGestureText="Ctrl+Shift+M" />
                        <MenuItem Header="代码块" Command="{Binding EditorActionCommand}" CommandParameter="CodeBlock" InputGestureText="Ctrl+Shift+K" />
                        <MenuItem Header="代码工具" ToolTip="代码相关扩展">
                            <MenuItem Header="行内代码" Command="{Binding EditorActionCommand}" CommandParameter="InlineCode" InputGestureText="Ctrl+Shift+`" />
                        </MenuItem>
                        <MenuItem Header="警告框">
                            <MenuItem Header="引用" Command="{Binding EditorActionCommand}" CommandParameter="Quote" InputGestureText="Ctrl+Shift+Q" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="引用" Command="{Binding EditorActionCommand}" CommandParameter="Quote" InputGestureText="Ctrl+Shift+Q" />
                        <Separator />
                        <MenuItem Header="有序列表" Command="{Binding EditorActionCommand}" CommandParameter="OrderedList" InputGestureText="Ctrl+Shift+[" />
                        <MenuItem Header="无序列表" Command="{Binding EditorActionCommand}" CommandParameter="UnorderedList" InputGestureText="Ctrl+Shift+]" />
                        <MenuItem Header="任务列表" Command="{Binding EditorActionCommand}" CommandParameter="TaskList" InputGestureText="Ctrl+Shift+X" />
                        <MenuItem Header="任务状态">
                            <MenuItem Header="切换完成状态" Command="{Binding EditorActionCommand}" CommandParameter="ToggleTaskStatus" />
                        </MenuItem>
                        <MenuItem Header="列表缩进">
                            <MenuItem Header="增加缩进" Command="{Binding EditorActionCommand}" CommandParameter="IndentList" InputGestureText="Tab" />
                            <MenuItem Header="减少缩进" Command="{Binding EditorActionCommand}" CommandParameter="OutdentList" InputGestureText="Shift+Tab" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="在上方插入段落" Command="{Binding EditorActionCommand}" CommandParameter="InsertParagraphAbove" />
                        <MenuItem Header="在下方插入段落" Command="{Binding EditorActionCommand}" CommandParameter="InsertParagraphBelow" />
                        <Separator />
                        <MenuItem Header="链接引用" Command="{Binding EditorActionCommand}" CommandParameter="LinkReference" />
                        <MenuItem Header="脚注" Command="{Binding EditorActionCommand}" CommandParameter="Footnote" />
                        <Separator />
                        <MenuItem Header="水平分割线" Command="{Binding EditorActionCommand}" CommandParameter="HorizontalRule" />
                        <MenuItem Header="内容目录" Command="{Binding EditorActionCommand}" CommandParameter="Toc" />
                    </MenuItem>
                    <MenuItem Header="格式" Style="{StaticResource DarkMenuItem}">
                        <MenuItem Header="加粗" Command="{Binding EditorActionCommand}" CommandParameter="Bold" InputGestureText="Ctrl+B" />
                        <MenuItem Header="斜体" Command="{Binding EditorActionCommand}" CommandParameter="Italic" InputGestureText="Ctrl+I" />
                        <MenuItem Header="下划线" Command="{Binding EditorActionCommand}" CommandParameter="Underline" InputGestureText="Ctrl+U" />
                        <MenuItem Header="代码" Command="{Binding EditorActionCommand}" CommandParameter="InlineCode" InputGestureText="Ctrl+Shift+`" />
                        <Separator />
                        <MenuItem Header="内联公式" Command="{Binding EditorActionCommand}" CommandParameter="InlineMath" />
                        <MenuItem Header="删除线" Command="{Binding EditorActionCommand}" CommandParameter="Strikethrough" InputGestureText="Alt+Shift+5" />
                        <MenuItem Header="高亮" Command="{Binding EditorActionCommand}" CommandParameter="Highlight" />
                        <MenuItem Header="上标" Command="{Binding EditorActionCommand}" CommandParameter="Superscript" />
                        <MenuItem Header="下标" Command="{Binding EditorActionCommand}" CommandParameter="Subscript" />
                        <MenuItem Header="注释" Command="{Binding EditorActionCommand}" CommandParameter="Comment" />
                        <Separator />
                        <MenuItem Header="超链接" Command="{Binding EditorActionCommand}" CommandParameter="Link" InputGestureText="Ctrl+K" />
                        <MenuItem Header="链接操作">
                            <MenuItem Header="链接引用" Command="{Binding EditorActionCommand}" CommandParameter="LinkReference" />
                        </MenuItem>
                        <MenuItem Header="图像">
                            <MenuItem Header="插入图像" Command="{Binding EditorActionCommand}" CommandParameter="InsertImage" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="清除样式" Command="{Binding EditorActionCommand}" CommandParameter="ClearFormatting" InputGestureText="Ctrl+\" />
                    </MenuItem>
                    <MenuItem Header="主题" Style="{StaticResource DarkMenuItem}">
                        <MenuItem Header="黑色为主" Click="OnThemeDarkClick" />
                        <MenuItem Header="白色为主" Click="OnThemeLightClick" />
                    </MenuItem>
                    <MenuItem Header="视图" Style="{StaticResource DarkMenuItem}">
                        <MenuItem Header="写作模式" Click="OnWorkspaceWritingClick" />
                        <MenuItem Header="排版模式" Click="OnWorkspaceLayoutClick" />
                        <MenuItem Header="校对模式" Click="OnWorkspaceProofreadClick" />
                    </MenuItem>
                </Menu>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="Transparent"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown"
                    MouseRightButtonUp="OnTitleBarMouseRightButtonUp">
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource ThemeTextMutedBrush}"
                           FontSize="11" />
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="RulerToggleBtn"
                            Style="{StaticResource ToggleBtn}"
                            Click="OnToggleRulerClick"
                            ToolTip="标线"
                            Padding="5,4"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="16" Height="12">
                            <Line X1="1" Y1="6" X2="15" Y2="6"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" />
                            <Line X1="8" Y1="1" X2="8" Y2="11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" />
                            <Rectangle Width="3" Height="3"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       RadiusX="1" RadiusY="1" />
                        </Grid>
                    </Button>
                    <Button x:Name="OutlineToggleBtn"
                            Style="{StaticResource ToggleBtn}"
                            Click="OnToggleOutlineClick"
                            ToolTip="大纲"
                            Padding="5,4"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="16" Height="12">
                            <Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1" RadiusX="1" RadiusY="1" />
                            <Rectangle Width="5" HorizontalAlignment="Left"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Opacity="0.45" RadiusX="1" RadiusY="1" />
                        </Grid>
                    </Button>
                    <Button x:Name="BottomPanelToggleBtn"
                            Style="{StaticResource ToggleBtn}"
                            Click="OnToggleBottomPanelClick"
                            ToolTip="底部面板"
                            Padding="5,4"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="16" Height="12">
                            <Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1" RadiusX="1" RadiusY="1" />
                            <Rectangle Height="4" VerticalAlignment="Bottom"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Opacity="0.45" RadiusX="1" RadiusY="1" />
                        </Grid>
                    </Button>
                    <Button x:Name="PreviewToggleBtn"
                            Style="{StaticResource ToggleBtn}"
                            Click="OnTogglePreviewClick"
                            ToolTip="预览"
                            Padding="5,4"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="16" Height="12">
                            <Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1" RadiusX="1" RadiusY="1" />
                            <Rectangle Width="5" HorizontalAlignment="Right"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Opacity="0.45" RadiusX="1" RadiusY="1" />
                        </Grid>
                    </Button>
                    <Border Style="{StaticResource Sep}" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="设置"
                            Style="{StaticResource ToolBtn}"
                            Click="OnSettingsClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="同步CAD"
                            Style="{StaticResource PrimaryBtn}"
                            Click="OnInsertCadClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="完成并关闭"
                            Style="{StaticResource ToolBtn}"
                            Click="OnConfirmClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>

                <Button x:Name="MinimizeWindowBtn"
                        Style="{StaticResource TitleBarWinBtn}"
                        ToolTip="最小化"
                        Click="OnMinimizeWindowClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE921;" />
                </Button>
                <Button x:Name="MaxRestoreWindowBtn"
                        Style="{StaticResource TitleBarWinBtn}"
                        ToolTip="最大化"
                        Click="OnMaxRestoreWindowClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock x:Name="MaxRestoreGlyph" Text="&#xE922;" />
                </Button>
                <Button x:Name="CloseWindowBtn"
                        Style="{StaticResource TitleBarCloseBtn}"
                        ToolTip="关闭"
                        Click="OnCloseClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
