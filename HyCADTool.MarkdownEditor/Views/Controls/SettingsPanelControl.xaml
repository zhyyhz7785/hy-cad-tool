<UserControl x:Class="HyCADTool.MarkdownEditor.Views.Controls.SettingsPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HyCADTool.MarkdownEditor.ViewModels">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/EditorTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource ThemeBgPanelBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8,8,8,12">
                <TextBlock Text="排版设置"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <Border Background="{DynamicResource ThemeBgSurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="字体与比例"
                                   Style="{StaticResource ParamLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <WrapPanel ItemWidth="88">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="出图比例" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         Text="{Binding DrawScaleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="字高" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         Text="{Binding TextSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="字宽" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         Text="{Binding TextXScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="预览缩放" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         Text="{Binding PreviewScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel ItemWidth="170" Margin="0,2,0,0">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="预览字体(TrueType)" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="154"
                                         Text="{Binding PreviewFontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ThemeBgSurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="文字样式(CAD)"
                                   Style="{StaticResource ParamLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <!-- 图1 风格：按钮式转入样式，显示当前样式+字体 -->
                        <Border Background="Transparent" CornerRadius="3" Padding="6,2" Margin="0,0,0,4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox Style="{StaticResource StyleComboBtn}" MinWidth="110"
                                         ItemsSource="{Binding CadStyleNames}"
                                         Text="{Binding CadSyncStyleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEditable="True" />
                                <TextBlock Text="{Binding CurrentSyncFontDisplay}" Margin="8,0,0,0"
                                           FontSize="10" Foreground="{DynamicResource ThemeTextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="样式1 0-hy-说明-T（TrueType 标题/说明）" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="10" Margin="0,4,0,2" />
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="样式名称" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Style="{StaticResource ParamInput}" Text="{Binding StyleTName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <!-- 图2 风格：标签+圆角下拉，显示当前字体 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="字体名称" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource FontCombo}"
                                     ItemsSource="{Binding Source={x:Static vm:EditorViewModel.TrueTypeFontOptions}}"
                                     Text="{Binding StyleTFont, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEditable="True"
                                     ToolTip="{Binding StyleTFont}" />
                        </Grid>
                        <TextBlock Text="样式2 0-hy-说明-S（SHX 标注/引线/表格）" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="10" Margin="0,4,0,2" />
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="样式名称" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Style="{StaticResource ParamInput}" Text="{Binding StyleSName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="字体文件" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource FontCombo}"
                                     ItemsSource="{Binding Source={x:Static vm:EditorViewModel.ShxFontOptions}}"
                                     Text="{Binding StyleSFont, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEditable="True"
                                     ToolTip="{Binding StyleSFont}" />
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="大字体" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource FontCombo}"
                                     ItemsSource="{Binding Source={x:Static vm:EditorViewModel.BigFontOptions}}"
                                     Text="{Binding StyleSBigFont, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEditable="True"
                                     ToolTip="{Binding StyleSBigFont}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ThemeBgSurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="页边距(mm)"
                                   Style="{StaticResource ParamLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <WrapPanel ItemWidth="78">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="L" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="64"
                                         Text="{Binding MarginLeftMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="R" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="64"
                                         Text="{Binding MarginRightMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="T" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="64"
                                         Text="{Binding MarginTopMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="B" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="64"
                                         Text="{Binding MarginBottomMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel ItemWidth="88" Margin="0,4,0,0">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="图框宽度" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         Text="{Binding BorderWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="栏内边距" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         Text="{Binding ColumnInnerPaddingMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ThemeBgSurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="栏拉伸条"
                                   Style="{StaticResource ParamLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <WrapPanel ItemWidth="88">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="默认宽度" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         Text="{Binding HandleWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="选中宽度" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         Text="{Binding HandleActiveWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ThemeBgSurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="段前后间距"
                                   Style="{StaticResource ParamLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="H1 前/后" />
                                <WrapPanel>
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding H1SpaceBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding H1SpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="H2 前/后" />
                                <WrapPanel>
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding H2SpaceBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding H2SpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="H3 前/后" />
                                <WrapPanel>
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding H3SpaceBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding H3SpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="P / Li" />
                                <WrapPanel>
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding PSpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding LiSpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="Q 前/后" />
                                <WrapPanel>
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding QuoteSpaceBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding QuoteSpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </WrapPanel>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
