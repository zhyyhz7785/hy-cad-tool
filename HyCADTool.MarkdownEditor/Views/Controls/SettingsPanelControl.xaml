<UserControl x:Class="HyCADTool.MarkdownEditor.Views.Controls.SettingsPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HyCADTool.MarkdownEditor.ViewModels"
             xmlns:helper="clr-namespace:HyCADTool.MarkdownEditor.Views.Helpers">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/EditorTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource ThemeBgPanelBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8,8,8,12">
                <TextBlock Text="排版设置"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <WrapPanel Margin="0,0,0,8">
                    <Button Style="{StaticResource ToolBtn}"
                            Content="恢复默认"
                            Command="{Binding ResetAllDefaultsCommand}"
                            ToolTip="恢复全部配置为默认值并保存"
                            Margin="0,0,6,4" />
                    <Button Style="{StaticResource ToolBtn}"
                            Content="存为默认"
                            Command="{Binding SaveAsDefaultCommand}"
                            ToolTip="将当前配置保存为默认（下次启动加载）"
                            Margin="0,0,6,4" />
                    <Button Style="{StaticResource ToolBtn}"
                            Content="存为设置文档"
                            Command="{Binding SaveToFileCommand}"
                            ToolTip="将当前配置保存到用户选择的 JSON 文件"
                            Margin="0,0,6,4" />
                    <Button Style="{StaticResource ToolBtn}"
                            Content="读取设置文档"
                            Command="{Binding LoadFromFileCommand}"
                            ToolTip="从用户选择的 JSON 文件加载配置"
                            Margin="0,0,0,4" />
                </WrapPanel>

                <Border Background="{DynamicResource ThemeBgSurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="字体与比例"
                                   Style="{StaticResource ParamLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <WrapPanel ItemWidth="88">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="出图比例" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         Text="{Binding DrawScaleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="字高" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         Text="{Binding TextSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="字宽" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         Text="{Binding TextXScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="预览缩放" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         Text="{Binding PreviewScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel ItemWidth="170" Margin="0,2,0,0">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="预览字体(TrueType)" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="154"
                                         Text="{Binding PreviewFontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ThemeBgSurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="文字样式(CAD)"
                                   Style="{StaticResource ParamLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="转入样式" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="{Binding CadSyncStyleName}"
                                    Command="{Binding ToggleCadSyncStyleCommand}"
                                    Style="{StaticResource ToolBtn}"
                                    Height="22"
                                    Padding="6,2"
                                    ToolTip="点击切换 0-hy-说明-T / 0-hy-说明-S" />
                        </Grid>
                        <TextBlock Text="样式1 0-hy-说明-T（TrueType 标题/说明）" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="10" Margin="0,4,0,2" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="字体名称" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                     MinWidth="120"
                                     ItemsSource="{Binding StyleTFontOptionsWithCurrent}"
                                     SelectedItem="{Binding StyleTFont, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Text="样式2 0-hy-说明-S（SHX 标注/引线/表格）" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="10" Margin="0,4,0,2" />
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="字体文件" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                     MinWidth="120"
                                     ItemsSource="{Binding StyleSFontOptionsWithCurrent}"
                                     SelectedItem="{Binding StyleSFont, Mode=TwoWay}" />
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="大字体" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                     MinWidth="120"
                                     ItemsSource="{Binding StyleSBigFontOptionsWithCurrent}"
                                     SelectedItem="{Binding StyleSBigFont, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Text="MText 显示" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="10" Margin="0,8,0,2" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="对齐点" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                     MinWidth="120"
                                     ItemsSource="{Binding MTextAttachmentOptions}"
                                     SelectedItem="{Binding MTextAttachment, Mode=TwoWay}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="行间距" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                     MinWidth="120"
                                     ItemsSource="{Binding MTextLineSpacingStyleOptions}"
                                     SelectedItem="{Binding MTextLineSpacingStyle, Mode=TwoWay}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="倾斜角(°)" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Style="{StaticResource ParamInput}"
                                     Width="72"
                                     Text="{Binding MTextObliquingAngle, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="字符间距" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Style="{StaticResource ParamInput}"
                                     Width="72"
                                     Text="{Binding MTextCharSpacing, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ParamSmallLabel}" Text="段落对齐" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                     MinWidth="120"
                                     ItemsSource="{Binding MTextParagraphAlignOptions}"
                                     SelectedItem="{Binding MTextParagraphAlign, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ThemeBgSurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="页边距(mm)"
                                   Style="{StaticResource ParamLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <WrapPanel ItemWidth="78">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="L" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="64"
                                         Text="{Binding MarginLeftMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="R" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="64"
                                         Text="{Binding MarginRightMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="T" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="64"
                                         Text="{Binding MarginTopMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="B" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="64"
                                         Text="{Binding MarginBottomMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel ItemWidth="88" Margin="0,4,0,0">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="图框宽度" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         Text="{Binding BorderWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="栏内边距" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         Text="{Binding ColumnInnerPaddingMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ThemeBgSurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="栏约束"
                                   Style="{StaticResource ParamLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <WrapPanel ItemWidth="88">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="栏最大数量" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         helper:TextBoxHelper.ScrollStep="1"
                                         Text="{Binding MaxColumnCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="最小栏宽(px)" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         helper:TextBoxHelper.ScrollStep="1"
                                         Text="{Binding MinColumnWidthPx, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="最小栏高(px)" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         helper:TextBoxHelper.ScrollStep="1"
                                         Text="{Binding MinColumnHeightPx, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ThemeBgSurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="栏拉伸条"
                                   Style="{StaticResource ParamLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <WrapPanel ItemWidth="88">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="默认宽度" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         Text="{Binding HandleWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="选中宽度" />
                                <TextBox Style="{StaticResource ParamInput}"
                                         Width="72"
                                         Text="{Binding HandleActiveWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ThemeBgSurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="段前后间距"
                                   Style="{StaticResource ParamLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="H1 前/后" />
                                <WrapPanel>
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding H1SpaceBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding H1SpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="H2 前/后" />
                                <WrapPanel>
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding H2SpaceBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding H2SpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="H3 前/后" />
                                <WrapPanel>
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding H3SpaceBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding H3SpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="P / Li" />
                                <WrapPanel>
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding PSpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding LiSpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource ParamSmallLabel}" Text="Q 前/后" />
                                <WrapPanel>
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding QuoteSpaceBefore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Style="{StaticResource ParamInput}" Width="58"
                                             Text="{Binding QuoteSpaceAfter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </WrapPanel>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
