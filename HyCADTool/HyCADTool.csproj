  <ItemGroup>
    <ProjectReference Include="..\HyCAD.BlenderUI\HyCAD.BlenderUI.csproj">
      <Project>{D4B7E1A2-5C3F-4A8E-9B62-7F1E2C3D4E5F}</Project>
      <Name>HyCAD.BlenderUI</Name>
    </ProjectReference>
  </ItemGroup>

  <!-- 配置文件复制到输出目录 -->
  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- HyCAD 标准线型：随 DLL 部署到 Resources\，启动时注入当前图形线型表 -->
  <ItemGroup>
    <None Include="Resources\HyCAD-Linetypes.lin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- P0 道路：_libraries 字典资源随 DLL 同级部署（v1 不读取，v2/P7 由 Blender Addon 消费） -->
  <ItemGroup>
    <None Include="_libraries\feature-catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="_libraries\blender-material-mapping.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="_libraries\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 排除不需要的文件（如果有） -->
  <ItemGroup>
    <!-- 排除备份文件、临时文件等 -->
    <Compile Remove="**/*.bak" />
    <Compile Remove="**/*.old" />
    <Compile Remove="**/* - 复制.cs" />
    <None Remove="**/*.bak" />
    <None Remove="**/*.old" />
