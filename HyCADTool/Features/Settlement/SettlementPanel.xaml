<UserControl x:Class="HyCADTool.Features.Settlement.SettlementPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helper="clr-namespace:HyCADTool.Presentation.Views.Helpers"
             xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
             Background="{DynamicResource Brush_RegionBack}"
             Foreground="{DynamicResource Brush_TextPrimary}"
             mc:Ignorable="d"
             btmetrics:BlenderMetricsOverlay.Attach="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Presentation/Resources/BlenderTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource BlenderScrollViewer}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="5,8,5,5">

            <!-- ===== 当前比例 ===== -->
            <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Brush_TextSecondary}" FontSize="{DynamicResource Metric_FontCaption}">
                <Run Text="当前比例: " /><Run Text="{Binding CurrentScale, Mode=OneWay}" Foreground="{DynamicResource Brush_AccentBlueHover}" />
                <Run Text="（在[设置]页修改）" />
            </TextBlock>

            <!-- ===== 高程参数 ===== -->
            <Expander Style="{StaticResource BlenderExpander}" Header="高程参数" IsExpanded="True" Margin="0,2,0,3">
                <StackPanel Margin="5,5,0,0">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="孔点高程 (m)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding BoreholeElevation, UpdateSourceTrigger=PropertyChanged}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="结构±0.000 (m)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding StructureZeroElevation, UpdateSourceTrigger=PropertyChanged}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="基础埋深 (m)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding FoundationDepth, UpdateSourceTrigger=PropertyChanged}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                    <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Brush_AccentBlueHover}" FontSize="{DynamicResource Metric_FontCaption}">
                        <Run Text="相对高程: " />
                        <Run Text="{Binding RelativeElevation, Mode=OneWay, StringFormat=F3}" />
                        <Run Text=" m" />
                    </TextBlock>
                </StackPanel>
            </Expander>

            <!-- ===== 基础参数 ===== -->
            <Expander Style="{StaticResource BlenderExpander}" Header="基础参数" IsExpanded="True" Margin="0,2,0,3">
                <StackPanel Margin="5,5,0,0">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="计算类型" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Style="{StaticResource BlenderComboBox}" SelectedIndex="{Binding FoundationTypeIndex}">
                            <ComboBoxItem Content="天然基础" />
                            <ComboBoxItem Content="复合地基" />
                            <ComboBoxItem Content="桩基础" />
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="基础长度 l (m)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding FoundationLength, UpdateSourceTrigger=PropertyChanged}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="基础宽度 b (m)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding FoundationWidth, UpdateSourceTrigger=PropertyChanged}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="附加压力 p₀(kPa)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding AdditionalPressure, UpdateSourceTrigger=PropertyChanged}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="承载力 fak(kPa)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding BearingCapacity, UpdateSourceTrigger=PropertyChanged}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- ===== 复合地基参数 ===== -->
            <Expander Style="{StaticResource BlenderExpander}" Header="复合地基参数" IsExpanded="True" Margin="0,2,0,3"
                      Visibility="{Binding IsCompositeVisible, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel Margin="5,5,0,0">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="fspk (kPa)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding CompositeBearingCapacity, UpdateSourceTrigger=PropertyChanged}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="加固层深度 (m)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding TreatedDepth, UpdateSourceTrigger=PropertyChanged}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- ===== 桩基参数 ===== -->
            <Expander Style="{StaticResource BlenderExpander}" Header="桩基参数" IsExpanded="True" Margin="0,2,0,3"
                      Visibility="{Binding IsPileVisible, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel Margin="5,5,0,0">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="桩长 (m)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding PileLength, UpdateSourceTrigger=PropertyChanged}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                        <TextBlock Grid.Column="2" Text="桩径 (m)" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="3"
                                 Text="{Binding PileDiameter, UpdateSourceTrigger=PropertyChanged}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="桩距 (m)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding PileSpacing, UpdateSourceTrigger=PropertyChanged}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                        <TextBlock Grid.Column="2" Text="桩数" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="3"
                                 Text="{Binding TotalPileCount, UpdateSourceTrigger=PropertyChanged}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="承台长 (m)" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="1"
                                 Text="{Binding CapLength, UpdateSourceTrigger=PropertyChanged}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                        <TextBlock Grid.Column="2" Text="台宽(m)" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBox Style="{StaticResource BlenderTextBox}" Grid.Column="3"
                                 Text="{Binding CapWidth, UpdateSourceTrigger=PropertyChanged}"
                                 helper:TextBoxHelper.EnableCustomHandlers="True" />
                    </Grid>
                </StackPanel>
            </Expander>

            <Separator Style="{StaticResource BlenderSeparator}" Margin="0,2,0,4" />

            <!-- ===== 地层数据 ===== -->
            <Expander Style="{StaticResource BlenderExpander}" Header="地层数据（粘贴 Markdown 表格）" IsExpanded="True" Margin="0,2,0,3">
                <StackPanel Margin="5,5,0,0">
                    <TextBlock Foreground="{DynamicResource Brush_TextSecondary}" FontSize="{DynamicResource Metric_FontMicro}" Margin="0,0,0,2"
                               Text="格式：| 编号 | 名称 | 平均厚度(m) | Es(MPa) | 描述 |" />
                    <TextBox Style="{StaticResource BlenderTextBox}"
                             Text="{Binding SoilLayerMarkdown, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" MinLines="4" MaxLines="12"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="{DynamicResource Metric_FontSmall}" />
                    <Button Style="{StaticResource BlenderButtonFlat}" Content="解析表格" Command="{Binding ParseTableCommand}"
                            Margin="0,3,0,3" Padding="{DynamicResource Metric_CommandGridButtonPadding}" />

                    <!-- 解析后的土层 DataGrid (保留自定义色以避免宿主 DataGrid 样式冲突) -->
                    <DataGrid ItemsSource="{Binding ParsedSoilLayers}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" IsReadOnly="False"
                              Background="{DynamicResource Brush_PanelSubBack}" Foreground="{DynamicResource Brush_TextPrimary}"
                              RowBackground="{DynamicResource Brush_PanelSubBack}" AlternatingRowBackground="{DynamicResource Brush_PanelBack}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource Brush_BorderMid}"
                              BorderThickness="0" MaxHeight="200"
                              FontSize="{DynamicResource Metric_FontSmall}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="45" IsReadOnly="True" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="65" IsReadOnly="True" />
                            <DataGridTextColumn Header="厚度(m)" Binding="{Binding Thickness, StringFormat=F2}" Width="55" />
                            <DataGridTextColumn Header="Es(MPa)" Binding="{Binding Es, StringFormat=F1}" Width="60" />
                            <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Expander>

            <!-- ===== 命令按钮 ===== -->
            <UniformGrid Columns="2" Margin="0,4,0,4">
                <Button Style="{StaticResource BlenderButton}" Content="计算沉降" Command="{Binding CalculateCommand}" Margin="1" Padding="{DynamicResource Metric_CommandGridButtonPadding}" />
                <Button Style="{StaticResource BlenderButtonFlat}" Content="绘制结果表格" Command="{Binding DrawTableCommand}" Margin="1" Padding="{DynamicResource Metric_CommandGridButtonPadding}" />
            </UniformGrid>

            <!-- ===== 结果汇总 ===== -->
            <TextBlock Text="{Binding ResultSummary}" Foreground="{DynamicResource Brush_AccentBlueHover}" FontSize="{DynamicResource Metric_FontCaption}"
                       Margin="0,0,0,4" TextWrapping="Wrap" />

            <!-- ===== 计算结果 DataGrid ===== -->
            <Expander Style="{StaticResource BlenderExpander}" Header="逐层计算结果" IsExpanded="False" Margin="0,2,0,3">
                <DataGrid ItemsSource="{Binding CalculationResults}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" IsReadOnly="True"
                          Background="{DynamicResource Brush_PanelSubBack}" Foreground="{DynamicResource Brush_TextPrimary}"
                          RowBackground="{DynamicResource Brush_PanelSubBack}" AlternatingRowBackground="{DynamicResource Brush_PanelBack}"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource Brush_BorderMid}"
                          BorderThickness="0" MaxHeight="250"
                          FontSize="{DynamicResource Metric_FontCaption}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="25" />
                        <DataGridTextColumn Header="地层" Binding="{Binding LayerId}" Width="35" />
                        <DataGridTextColumn Header="z(m)" Binding="{Binding Zi, StringFormat=F2}" Width="45" />
                        <DataGridTextColumn Header="α" Binding="{Binding Alpha, StringFormat=F4}" Width="50" />
                        <DataGridTextColumn Header="ᾱ" Binding="{Binding AlphaBar, StringFormat=F4}" Width="50" />
                        <DataGridTextColumn Header="Es" Binding="{Binding Es, StringFormat=F1}" Width="40" />
                        <DataGridTextColumn Header="Δs'(mm)" Binding="{Binding DeltaS, StringFormat=F3}" Width="55" />
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>

            <!-- ===== 操作 ===== -->
            <Button Style="{StaticResource BlenderButtonFlat}" Content="恢复默认" Command="{Binding ResetCommand}" Margin="0,4,0,2" />

            <!-- 状态 -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource Brush_Success}" FontSize="{DynamicResource Metric_FontCaption}"
                       Margin="0,4,0,0" TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
