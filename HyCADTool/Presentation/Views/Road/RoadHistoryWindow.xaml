<bui:BlenderWindow x:Class="HyCADTool.Presentation.Views.Road.RoadHistoryWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:bui="clr-namespace:HyCAD.BlenderUI.Controls;assembly=HyCAD.BlenderUI"
                   xmlns:btmetrics="clr-namespace:HyCAD.BlenderUI.Theming;assembly=HyCAD.BlenderUI"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   btmetrics:BlenderMetricsOverlay.Attach="True"
                   Title="数据还原"
                   HeaderTitle="{Binding HeaderTitle}"
                   Width="760" Height="460"
                   MinWidth="640" MinHeight="360"
                   WindowStartupLocation="CenterOwner">

    <bui:BlenderWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/Palettes/BlenderDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCAD.BlenderUI;component/Themes/BlenderTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HyCADTool;component/Presentation/Resources/RoadDesignerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </bui:BlenderWindow.Resources>

    <!-- 状态栏（左）：条数 / 目录 / 最新 -->
    <bui:BlenderWindow.FooterLeftContent>
        <TextBlock Foreground="{DynamicResource Brush_TextSecondary}"
                   FontSize="{DynamicResource Metric_FontSmall}"
                   FontFamily="Consolas"
                   VerticalAlignment="Center"
                   Text="{Binding StatusText}"/>
    </bui:BlenderWindow.FooterLeftContent>

    <!-- 底部按钮（右）：还原 / 取消 -->
    <bui:BlenderWindow.FooterRightContent>
        <StackPanel Orientation="Horizontal">
            <Button Content="还原"
                    Style="{StaticResource BlenderButton}"
                    Command="{Binding RestoreCommand}"
                    IsEnabled="{Binding CanRestore}"
                    IsDefault="True"
                    MinWidth="{DynamicResource Metric_DialogButtonWidth}"
                    Margin="4,0"/>
            <Button Content="删除"
                    Style="{StaticResource BlenderButton}"
                    Command="{Binding DeleteCommand}"
                    IsEnabled="{Binding CanRestore}"
                    MinWidth="{DynamicResource Metric_DialogButtonWidth}"
                    Margin="4,0"/>
            <Button Content="取消"
                    Style="{StaticResource BlenderButton}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    MinWidth="{DynamicResource Metric_DialogButtonWidth}"
                    Margin="4,0"/>
        </StackPanel>
    </bui:BlenderWindow.FooterRightContent>

    <!-- 主体：标题 + DataGrid（图 1 三列：编号 / 时间 / 描述） -->
    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="还原点："
                   Margin="12,10,12,4"
                   FontSize="{DynamicResource Metric_FontMain}"
                   Foreground="{DynamicResource Brush_TextSecondary}"/>

        <DataGrid ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  Style="{StaticResource RoadBandGridStyle}"
                  IsReadOnly="True"
                  Margin="10,0,10,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="编号"
                                    Width="80"
                                    Binding="{Binding SeqNo}"/>
                <DataGridTextColumn Header="时间"
                                    Width="160"
                                    Binding="{Binding TimeText}"/>
                <DataGridTextColumn Header="描述"
                                    Width="*"
                                    Binding="{Binding Description}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</bui:BlenderWindow>
